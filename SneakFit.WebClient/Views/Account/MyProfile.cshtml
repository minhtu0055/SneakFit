@using SneakFit.ViewModels.Catalog.HoaDonClient
@using SneakFit.ViewModels.Catalog.TraHang
@using SneakFit.Data.Enums
@model SneakFit.WebClient.Models.AccountViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Danh Sách Đơn Hàng - SneakFit";
    var trangThaiSelected = Context.Request.Query["trangThai"].ToString();
    var trangThaiList = new[] {
        new { Value = ((int)TrangThaiHoaDon.ChoXacNhan).ToString(), Text = "Chờ xác nhận" },
        new { Value = ((int)TrangThaiHoaDon.DaXacNhan).ToString(), Text = "Đã xác nhận" },
        new { Value = ((int)TrangThaiHoaDon.ChoVanChuyen).ToString(), Text = "Chờ vận chuyển" },
        new { Value = ((int)TrangThaiHoaDon.DangVanChuyen).ToString(), Text = "Đang vận chuyển" },
        new { Value = ((int)TrangThaiHoaDon.DaThanhToan).ToString(), Text = "Đã thanh toán" },
        new { Value = ((int)TrangThaiHoaDon.ThanhCong).ToString(), Text = "Thành công" },
        new { Value = ((int)TrangThaiHoaDon.DaHuy).ToString(), Text = "Đã hủy" },
        new { Value = ((int)TrangThaiHoaDon.TraHang).ToString(), Text = "Trả hàng" }
    };

    var selectedTrangThai = Context.Request.Query["trangThai"].ToString();
    var slTheoTrangThai = Model.SoLuongTheoTrangThai;
    var daChonTrangThai = !string.IsNullOrEmpty(selectedTrangThai);

    // Biến cho trả hàng
    var trangThaiReturnsSelected = Context.Request.Query["trangThaiReturns"].ToString();
    var selectedTrangThaiReturns = Context.Request.Query["trangThaiReturns"].ToString();
    var slTheoTrangThaiReturns = Model.SoLuongTheoTrangThaiReturns ?? new Dictionary<int, int>();
    var daChonTrangThaiReturns = !string.IsNullOrEmpty(selectedTrangThaiReturns);
}

@functions {
    public string GetReturnStatusText(ReturnStatus status)
    {
        switch (status)
        {
            case ReturnStatus.ChapNhanDuyetHangHoan:
                return "Chờ duyệt";
            case ReturnStatus.LayHangHoan:
                return "Lấy hàng hoàn";
            case ReturnStatus.HoanHang:
                return "Hoàn hàng (check hàng hoàn)";
            case ReturnStatus.ThanhCong:
                return "Thành công";
            case ReturnStatus.TuChoi:
                return "Từ chối";
            default:
                return "Không xác định";
        }
    }
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Tài Khoản</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Trang chủ</a></li>
                    <li class="current">Tài Khoản</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Account Section -->
    <section id="account" class="account section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Mobile Menu Toggle -->
            <div class="mobile-menu d-lg-none mb-4">
                <button class="mobile-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#profileMenu">
                    <i class="bi bi-grid"></i>
                    <span>Menu</span>
                </button>
            </div>

            <div class="row g-4">
                <!-- Profile Menu -->
                <div class="col-lg-3">
                    <div class="profile-menu collapse d-lg-block" id="profileMenu">
                        <!-- User Info -->
                        <div class="user-info" data-aos="fade-right">
                            <div class="user-avatar">
                                <img src="@(string.IsNullOrEmpty(User.FindFirst("UrlHinhAnh")?.Value) ? Url.Content("~/assets/img/ava.jpg") : $"{Configuration["BaseAddress"]}{User.FindFirst("UrlHinhAnh")?.Value}")" class="rounded-circle" width="100" />
                                <span class="status-badge"><i class="bi bi-shield-check"></i></span>
                            </div>
                            <h4>@ViewBag.HoVaTen</h4>
                        </div>

                        <!-- Navigation Menu -->
                        <nav class="menu-nav">
                            <ul class="nav flex-column" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#orders">
                                        <i class="bi bi-box-seam"></i>
                                        <span>Đơn hàng</span>
                                        <span class="badge">@(Model.hoaDonClientViewModels?.Count ?? 0)</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#returns">
                                        <i class="bi bi-arrow-return-left"></i>
                                        <span>Trả hàng</span>
                                        <span class="badge">@(Model?.returnsViewModels?.Count ?? 0)</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#addresses">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>Địa chỉ</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#settings">
                                        <i class="bi bi-gear"></i>
                                        <span>Cài đặt tài khoản</span>
                                    </a>
                                </li>
                            </ul>

                            <div class="menu-footer">
                                <a class="dropdown-item d-flex align-items-center"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        </nav>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="col-lg-9">
                    <div class="content-area">
                        <div class="tab-content">
                            <!-- Orders Tab -->
                            <div class="tab-pane fade show active" id="orders">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>Đơn hàng của tôi</h2>
                                </div>

                                <div class="orders-grid">
                                    <!-- Timeline Section - Hiển thị khi chưa chọn trạng thái -->
                                    <div id="timeline-section" class="@(daChonTrangThai ? "d-none" : "")">
                                        <div class="card shadow rounded-4 border-0">
                                            <div class="card-body p-4">
                                                <div class="container">
                                                    <div class="progress-container">
                                                        <div class="progress-timeline">
                                                            <!-- Mũi tên progress bar với màu sắc mới -->
                                                            <div class="arrow-progress">
                                                                <div class="arrow-segment royal-blue">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment indigo">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment purple">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment orange">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment emerald">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                            </div>

                                                            <!-- Các bước với màu sắc và connector tương ứng -->
                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.ChoXacNhan).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.ChoXacNhan))">
                                                                <div class="step-icon royal-blue icon-file">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.ChoXacNhan) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoXacNhan] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoXacNhan]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector royal-blue"></div>
                                                                <div class="step-title">Chờ xác nhận</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.ChoVanChuyen).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.ChoVanChuyen))">
                                                                <div class="step-icon indigo icon-truck">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.ChoVanChuyen) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoVanChuyen] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoVanChuyen]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector indigo"></div>
                                                                <div class="step-title">Chờ vận chuyển</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.DangVanChuyen).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.DangVanChuyen))">
                                                                <div class="step-icon purple icon-delivery">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.DangVanChuyen) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DangVanChuyen] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DangVanChuyen]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector purple"></div>
                                                                <div class="step-title">Đang vận chuyển</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.DaThanhToan).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.DaThanhToan))">
                                                                <div class="step-icon orange icon-payment">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.DaThanhToan) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DaThanhToan] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DaThanhToan]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector orange"></div>
                                                                <div class="step-title">Đã thanh toán</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.ThanhCong).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.ThanhCong))">
                                                                <div class="step-icon emerald icon-check">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.ThanhCong) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ThanhCong] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ThanhCong]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector emerald"></div>
                                                                <div class="step-title">Hoàn thành</div>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Orders List Section - Hiển thị khi đã chọn trạng thái -->
                                    <div id="orders-list-section" class="@(!daChonTrangThai ? "d-none" : "")" style="padding-top: 8px; ">
                                        <!-- Back to Timeline Button -->
                                        <div class="mb-3 d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-outline-secondary" onclick="showTimeline()">
                                                <i class="bi bi-arrow-left"></i> Quay lại Timeline
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" onclick="loadOrdersByStatus('all')">
                                                <i class="bi bi-list-ul"></i> Xem tất cả đơn hàng
                                            </button>
                                        </div>

                                        <!-- Orders Table -->
                                        <div id="orders-table-container">
                                            @if (daChonTrangThai)
                                            {
                                                @if (Model == null || !Model.hoaDonClientViewModels.Any())
                                                {
                                                    <div class="section-box text-center p-4">
                                                        <p class="text-muted">Không có đơn hàng nào ở trạng thái này.</p>
                                                        <button type="button" class="btn btn-primary mt-3" onclick="showTimeline()">Quay lại Timeline</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="section-box">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="border-right: none; ">Mã Đơn Hàng</th>
                                                                        <th style="border-right: none; ">Ngày Đặt Hàng</th>
                                                                        <th style="border-right: none; ">Tổng Thanh Toán</th>
                                                                        <th style="border-right: none; ">Trạng Thái</th>
                                                                        <th>Hành Động</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var item in Model.hoaDonClientViewModels)
                                                                    {
                                                                        <tr>
                                                                            <td style="border-right: none; ">@item.MaHoaDon</td>
                                                                            <td style="border-right: none; ">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                                                            <td style="border-right: none; ">@item.TongTien.ToString("N0") ₫</td>
                                                                            <td style="border-right: none; ">
                                                                                <span class="status-badge">@item.TrangThai</span>
                                                                            </td>
                                                                            <td>
                                                                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="loadOrderDetails('@item.Id')">Xem Chi Tiết</button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- Order Details Section - Hiển thị chi tiết hóa đơn -->
                                    <div id="order-details-section" class="d-none">
                                        <!-- Back to Orders Button -->
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-secondary" onclick="showOrdersList()">
                                                <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn hàng
                                            </button>
                                        </div>

                                        <!-- Order Details Container -->
                                        <div id="order-details-container">
                                            <!-- Nội dung chi tiết hóa đơn sẽ được load ở đây -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Returns Tab -->
                            <div class="tab-pane fade" id="returns">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>Yêu cầu trả hàng của tôi</h2>
                                </div>

                                <div class="returns-grid">
                                    <!-- Timeline Section - Hiển thị khi chưa chọn trạng thái -->
                                    <div id="returns-timeline-section" class="@(daChonTrangThaiReturns ? "d-none" : "")">
                                        <div class="card shadow rounded-4 border-0">
                                            <div class="card-body p-4">
                                                <div class="container">
                                                    <div class="progress-container">
                                                        <div class="progress-timeline">
                                                            <!-- Mũi tên progress bar với màu sắc mới -->
                                                            <div class="arrow-progress">
                                                                <div class="arrow-segment warning">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment info">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment primary">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment success">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment danger">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                            </div>

                                                            <!-- Các bước với màu sắc và connector tương ứng -->
                                                            <a class="progress-step text-decoration-none @(selectedTrangThaiReturns == ((int)ReturnStatus.ChapNhanDuyetHangHoan).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadReturnsByStatus('@ReturnStatus.ChapNhanDuyetHangHoan')">
                                                                <div class="step-icon warning icon-file">
                                                                    @if (Model.SoLuongTheoTrangThaiReturns.ContainsKey((int)ReturnStatus.ChapNhanDuyetHangHoan) && Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.ChapNhanDuyetHangHoan] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.ChapNhanDuyetHangHoan]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector warning"></div>
                                                                <div class="step-title">Chờ duyệt</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThaiReturns == ((int)ReturnStatus.LayHangHoan).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadReturnsByStatus('@ReturnStatus.LayHangHoan')">
                                                                <div class="step-icon info icon-truck">
                                                                    @if (Model.SoLuongTheoTrangThaiReturns.ContainsKey((int)ReturnStatus.LayHangHoan) && Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.LayHangHoan] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.LayHangHoan]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector info"></div>
                                                                <div class="step-title">Lấy hàng hoàn</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThaiReturns == ((int)ReturnStatus.HoanHang).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadReturnsByStatus('@ReturnStatus.HoanHang')">
                                                                <div class="step-icon primary icon-delivery">
                                                                    @if (Model.SoLuongTheoTrangThaiReturns.ContainsKey((int)ReturnStatus.HoanHang) && Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.HoanHang] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.HoanHang]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector primary"></div>
                                                                <div class="step-title">Hoàn hàng</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThaiReturns == ((int)ReturnStatus.ThanhCong).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadReturnsByStatus('@ReturnStatus.ThanhCong')">
                                                                <div class="step-icon success icon-check">
                                                                    @if (Model.SoLuongTheoTrangThaiReturns.ContainsKey((int)ReturnStatus.ThanhCong) && Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.ThanhCong] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.ThanhCong]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector success"></div>
                                                                <div class="step-title">Thành công</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThaiReturns == ((int)ReturnStatus.TuChoi).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadReturnsByStatus('@ReturnStatus.TuChoi')">
                                                                <div class="step-icon danger icon-times">
                                                                    @if (Model.SoLuongTheoTrangThaiReturns.ContainsKey((int)ReturnStatus.TuChoi) && Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.TuChoi] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThaiReturns[(int)ReturnStatus.TuChoi]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector danger"></div>
                                                                <div class="step-title">Từ chối</div>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>

                                                @*                                                 <!-- Nút xem tất cả yêu cầu trả hàng -->
                                                <div class="text-center mt-4">
                                                <button type="button" class="btn btn-outline-primary" onclick="loadReturnsByStatus('all')">
                                                <i class="bi bi-list-ul"></i> Xem tất cả yêu cầu trả hàng
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary ms-2" onclick="testLoadReturns()">
                                                <i class="bi bi-bug"></i> Test Load Returns
                                                </button>
                                                <button type="button" class="btn btn-outline-danger ms-2" onclick="testDirectCall()">
                                                <i class="bi bi-bug"></i> Test Direct Call
                                                </button>
                                                </div>

                                                <!-- Hiển thị khi không có yêu cầu trả hàng nào -->
                                                @if (Model.returnsViewModels == null || !Model.returnsViewModels.Any())
                                                {
                                                <div class="section-box text-center p-4 mt-4">
                                                <i class="bi bi-box-seam" style="font-size: 3rem; color: #ccc;"></i>
                                                <p class="text-muted mt-3">Chưa có yêu cầu trả hàng nào</p>
                                                <p class="text-muted small">Khi bạn có yêu cầu trả hàng, chúng sẽ hiển thị ở đây</p>
                                                </div>
                                                } *@
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Returns List Section - Hiển thị khi đã chọn trạng thái -->
                                    <div id="returns-list-section" class="@(!daChonTrangThaiReturns ? "d-none" : "")" style="padding-top: 8px; ">
                                        <!-- Back to Timeline Button -->
                                        <div class="mb-3 d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-outline-secondary" onclick="showReturnsTimeline()">
                                                <i class="bi bi-arrow-left"></i> Quay lại Timeline
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" onclick="loadReturnsByStatus('all')">
                                                <i class="bi bi-list-ul"></i> Xem tất cả yêu cầu trả hàng
                                            </button>
                                        </div>

                                        <!-- Returns Table -->
                                        <div id="returns-table-container">
                                            @if (daChonTrangThaiReturns)
                                            {
                                                @if (Model == null || !Model.returnsViewModels.Any())
                                                {
                                                    <div class="section-box text-center p-4">
                                                        <p class="text-muted">Không có yêu cầu trả hàng nào ở trạng thái này.</p>
                                                        <button type="button" class="btn btn-primary mt-3" onclick="showReturnsTimeline()">Quay lại Timeline</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="section-box">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="border-right: none; ">Mã Yêu Cầu</th>
                                                                        <th style="border-right: none; ">Ngày Tạo</th>
                                                                        <th style="border-right: none; ">Lý Do</th>
                                                                        <th style="border-right: none; ">Trạng Thái</th>
                                                                        <th>Hành Động</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
