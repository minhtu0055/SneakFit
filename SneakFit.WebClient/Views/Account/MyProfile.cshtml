                    $(this).trigger('input');
                }
            });

            // Real-time validation for required fields
            $('#modal-receiver-name, #modal-detail-address').on('input', function () {
                const value = $(this).val();
                const fieldId = $(this).attr('id');

                if (validateRequired(value, fieldId)) {
                    showFieldSuccess(fieldId);
                } else {
                    showFieldError(fieldId, 'Trường này là bắt buộc');
                }
            });

            // Validation for dropdowns
            $('#modal-province, #modal-district, #modal-ward').on('change', function () {
                const value = $(this).val();
                const fieldId = $(this).attr('id');

                if (validateRequired(value, fieldId)) {
                    showFieldSuccess(fieldId);
                } else {
                    showFieldError(fieldId, 'Vui lòng chọn ' + $(this).prev('label').text().toLowerCase());
                }
            });

            // Validation for editAddressModal
            $('#edit-phone-number').on('input', function () {
                let phone = $(this).val();
                phone = phone.replace(/[^0-9]/g, '');
                if (phone.length === 0) {
                    phone = '0';
                } else if (phone.length > 0 && phone.charAt(0) !== '0') {
                    phone = '0' + phone;
                }
                if (phone.length > 10) {
                    phone = phone.substring(0, 10);
                }
                $(this).val(phone);
                $(this).removeClass('is-invalid is-valid');
                $('#edit-phone-validation-icon').removeClass('bi-check-circle-fill bi-x-circle-fill valid invalid');
                $('#edit-phone-number-error').text('');
            });

            $('#edit-phone-number').on('blur', function () {
                const phone = $(this).val();
                const icon = $('#edit-phone-validation-icon');
                if (phone.length === 0 || phone === '0') {
                    $(this).removeClass('is-invalid is-valid');
                    icon.removeClass('bi-check-circle-fill bi-x-circle-fill valid invalid');
                    $('#edit-phone-number-error').text('');
                    return;
                }
                if (validatePhoneNumber(phone)) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                    icon.removeClass('bi-x-circle-fill invalid').addClass('bi-check-circle-fill valid');
                    $('#edit-phone-number-error').text('');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                    icon.removeClass('bi-check-circle-fill valid').addClass('bi-x-circle-fill invalid');
                    if (phone.length < 10) {
                        $('#edit-phone-number-error').text('Số điện thoại phải có 10 chữ số');
                    } else {
                        $('#edit-phone-number-error').text('Số điện thoại không hợp lệ');
                    }
                }
            });

            $('#edit-phone-number').on('paste', function (e) {
                e.preventDefault();
                const pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                const numericOnly = pastedText.replace(/[^0-9]/g, '');
                let currentValue = $(this).val();
                const numericCurrent = currentValue.replace(/[^0-9]/g, '');
                let combined = numericCurrent + numericOnly;
                if (combined.length > 0 && combined.charAt(0) !== '0') {
                    combined = '0' + combined;
                }
                if (combined.length > 10) {
                    combined = combined.substring(0, 10);
                }
                $(this).val(combined);
                $(this).trigger('input');
            });

            $('#edit-phone-number').on('keydown', function (e) {
                if ([8, 9, 27, 13, 46, 37, 38, 39, 40].indexOf(e.keyCode) !== -1 ||
                    (e.keyCode === 65 && e.ctrlKey === true) ||
                    (e.keyCode === 67 && e.ctrlKey === true) ||
                    (e.keyCode === 86 && e.ctrlKey === true) ||
                    (e.keyCode === 88 && e.ctrlKey === true)) {
                    return;
                }
                if ((e.keyCode >= 48 && e.keyCode <= 57) || (e.keyCode >= 96 && e.keyCode <= 105)) {
                    return;
                }
                e.preventDefault();
            });

