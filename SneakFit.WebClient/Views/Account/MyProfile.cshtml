                data: { trangThai: 'all' }, // Lấy tất cả
                success: function (data) {
                    console.log('Test returns data loaded successfully');
                    console.log('Response data:', data);
                    $('#returns-table-container').html(data);
                },
                error: function (xhr, status, error) {
                    console.error('Test error loading returns:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                    $('#returns-table-container').html('<div class="section-box text-center p-4"><p class="text-muted">Test: Có lỗi xảy ra khi tải dữ liệu.</p><button type="button" class="btn btn-primary mt-3" onclick="showReturnsTimeline()">Quay lại Timeline</button></div>');
                }
            });
        }

        // Test function để gọi trực tiếp API
        function testDirectCall() {
            console.log('Testing direct API call...');

            // Hiển thị loading
            $('#returns-table-container').html('<div class="text-center p-4"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');

            // Ẩn timeline, hiển thị returns list
            $('#returns-timeline-section').addClass('d-none');
            $('#returns-list-section').removeClass('d-none');

            // Gọi AJAX để lấy dữ liệu
            $.ajax({
                url: '/Account/GetReturnsByStatus',
                type: 'GET',
                data: { trangThai: 'all' }, // Lấy tất cả
                success: function (data) {
                    console.log('Direct call success');
                    console.log('Response data:', data);
                    $('#returns-table-container').html(data);
                },
                error: function (xhr, status, error) {
                    console.error('Direct call error:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                    $('#returns-table-container').html('<div class="section-box text-center p-4"><p class="text-muted">Direct call failed.</p><button type="button" class="btn btn-primary mt-3" onclick="showReturnsTimeline()">Quay lại Timeline</button></div>');
                }
            });
        }

        // Filter orders by status
        function filterOrders(status) {
            // Gửi AJAX để lấy dữ liệu
            $.ajax({
                url: '@Url.Action("GetOrdersByStatus", "Account")',
                type: 'GET',
                data: { trangThai: status },
                success: function (data) {
                    $('#orders-table-container').html(data);

                    // Cập nhật trạng thái active sau khi load xong
                    setTimeout(function () {
                        // Xoá class active ở tất cả button
                        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));

                        // Chuyển đổi số thành string tương ứng nếu cần
                        let statusString = status;
                        if (!isNaN(status)) {
                            const statusMap = {
                                0: 'ChoXacNhan',
                                1: 'DaXacNhan',
                                2: 'ChoVanChuyen',
                                3: 'DangVanChuyen',
                                4: 'DaThanhToan',
                                5: 'ThanhCong',
                                6: 'DaHuy',
                                7: 'TraHang'
                            };
                            statusString = statusMap[status] || status;
                        }
                        else if (status === "all") {
                            statusString = "all";
                        }
                        else {
                            statusString = status;
                        }

                        // Thêm class active vào button được chọn
                        const selectedBtn = document.querySelector(`.filter-btn[data-status="${statusString}"]`);
                        if (selectedBtn) selectedBtn.classList.add('active');
                    }, 100);
                },
                error: function () {
                    alert('Không thể tải danh sách hóa đơn.');
                }
            });
        }

        // trả hàng
        $(".return-status").click(function () {
            var status = $(this).data("status");
            loadReturns(status);
        });

        function loadReturns(status) {
            $.ajax({
                url: '/Return/GetByStatus',
                type: 'GET',
                data: { status: status },
                success: function (data) {
                    $("#ReturnList").html(data);
                },
                error: function () {
                    alert("Không load được danh sách trả hàng");
                }
            });
        }
    </script>
}
