        // Hàm load tỉnh/thành - SỬA LẠI ENDPOINT
        function loadProvinces(selector, callback) {
            $.ajax({
                url: 'https://localhost:7277/api/ghn/provinces',
                type: 'GET',
                success: function (response) {
                    const items = response.data || response;
                    let options = `<option value="">Chọn tỉnh / thành</option>`;
                    items.forEach(item => {
                        options += `<option value="${item.ProvinceID}" data-name="${item.ProvinceName}">${item.ProvinceName}</option>`;
                    });
                    $(selector).html(options);
                    if (callback) callback();
                },
                error: function (xhr, status, error) {
                    console.error('Lỗi load provinces:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                }
            });
        }

        // Hàm load quận/huyện - SỬA LẠI ENDPOINT
        function loadDistricts(provinceId, districtSelector, wardSelector, callback) {
            if (!provinceId) {
                $(districtSelector).html('<option value="">Chọn quận / huyện</option>').prop('disabled', true);
                $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                if (callback) callback();
                return;
            }
            $(districtSelector).prop('disabled', false);
            $.ajax({
                url: 'https://localhost:7277/api/ghn/districts',
                type: 'GET',
                success: function (response) {
                    const allDistricts = response.data || response;
                    const filteredDistricts = allDistricts.filter(d => d.ProvinceID == provinceId);
                    let options = '<option value="">Chọn quận / huyện</option>';
                    filteredDistricts.forEach(d => {
                        options += `<option value="${d.DistrictID}" data-name="${d.DistrictName}">${d.DistrictName}</option>`;
                    });
                    $(districtSelector).html(options);
                    if (callback) callback();
                },
                error: function (xhr, status, error) {
                    console.error('Lỗi load districts:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                }
            });
            $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
        }

        // Hàm load phường/xã - SỬA LẠI ENDPOINT
        function loadWards(districtId, wardSelector, callback) {
            if (!districtId) {
                $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                if (callback) callback();
                return;
            }
            $(wardSelector).prop('disabled', false);
            $.ajax({
                url: `https://localhost:7277/api/ghn/wards/${districtId}`,
                type: 'GET',
                success: function (response) {
                    const items = response.data || response;
                    let options = `<option value="">Chọn phường / xã</option>`;
                    items.forEach(item => {
                        options += `<option value="${item.WardCode}" data-name="${item.WardName}">${item.WardName}</option>`;
                    });
                    $(wardSelector).html(options);
                    if (callback) callback();
                },
                error: function (xhr, status, error) {
                    console.error('Lỗi load wards:', error);
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);
                }
            });
        }

