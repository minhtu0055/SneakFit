@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script>
        // Toggle password visibility for Đổi mật khẩu
        $(document).ready(function () {
            console.log('Document ready - checking returns data...');
            console.log('Returns count from model:', @(Model?.returnsViewModels?.Count ?? 0));
            console.log('Returns status count:', @(Model?.SoLuongTheoTrangThaiReturns?.Count ?? 0));

            // Nếu URL có hash #addresses thì mở tab Địa chỉ sau khi load trang
            function showAddressesTab() {
                try {
                    const triggerEl = document.querySelector('.menu-nav a[href="#addresses"]');
                    if (triggerEl && window.bootstrap && bootstrap.Tab) {
                        const tab = new bootstrap.Tab(triggerEl);
                        tab.show();
                    } else {
                        // Fallback nếu Bootstrap Tab API không khả dụng
                        $('.menu-nav a.nav-link').removeClass('active');
                        $('.tab-pane').removeClass('show active');
                        $('.menu-nav a[href="#addresses"]').addClass('active');
                        $('#addresses').addClass('show active');
                    }
                } catch (e) {
                    // Fallback an toàn
                    $('.menu-nav a.nav-link').removeClass('active');
                    $('.tab-pane').removeClass('show active');
                    $('.menu-nav a[href="#addresses"]').addClass('active');
                    $('#addresses').addClass('show active');
                }
            }

            if (window.location.hash === '#addresses') {
                showAddressesTab();
            }
            $('#toggleCurrentPassword').on('click', function () {
                var input = $('#currentPassword');
                var icon = $('#toggleCurrentPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
            $('#toggleNewPassword').on('click', function () {
                var input = $('#newPassword');
                var icon = $('#toggleNewPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
            $('#toggleConfirmPassword').on('click', function () {
                var input = $('#confirmPassword');
                var icon = $('#toggleConfirmPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });

            // Hiện modal khi bấm nút thêm địa chỉ
            $('#btnShowAddAddressModal').click(function () {
                $('#addAddressModal').modal('show');
                loadProvinces('#modal-province');
                $('#modal-district').html('<option value="">Chọn quận / huyện</option>').prop('disabled', true);
                $('#modal-ward').html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
            });

            // Sự kiện change cho dropdown trong modal
            $('#addAddressModal').on('change', '#modal-province', function () {
                loadDistricts($(this).val(), '#modal-district', '#modal-ward');
            });

            $('#addAddressModal').on('change', '#modal-district', function () {
                loadWards($(this).val(), '#modal-ward');
            });

            // Load provinces cho modal sửa địa chỉ khi modal được mở
            $('#editAddressModal').on('show.bs.modal', function () {
                const addressId = $(this).data('address-id');
                if (addressId) {
                    loadAddressToEditModal(addressId);
                }
            });

            // Sự kiện change cho dropdown trong modal chỉnh sửa
            $('#editAddressModal').on('change', '#edit-province', function () {
                loadDistricts($(this).val(), '#edit-district', '#edit-ward');
            });

            $('#editAddressModal').on('change', '#edit-district', function () {
                loadWards($(this).val(), '#edit-ward');
            });

            // Xử lý click nút chỉnh sửa địa chỉ
            $('.btn-edit-address').on('click', function () {
                const addressId = $(this).data('address-id');
                $('#editAddressModal').data('address-id', addressId);
                $('#editAddressModal').modal('show');
            });

            // Xử lý lưu địa chỉ từ modal
            // Validation functions
            function validatePhoneNumber(phone) {
                const phoneRegex = /^0[0-9]{9}$/;
                return phoneRegex.test(phone);
            }

            function validateRequired(value, fieldName) {
                return value && value.trim().length > 0;
            }

            function showFieldError(fieldId, message) {
                $(`#${fieldId}`).addClass('is-invalid').removeClass('is-valid');
                $(`#${fieldId}-error`).text(message);
            }

            function showFieldSuccess(fieldId) {
                $(`#${fieldId}`).addClass('is-valid').removeClass('is-invalid');
                $(`#${fieldId}-error`).text('');
            }

            function clearAllErrors() {
                $('.form-control, .form-select').removeClass('is-invalid is-valid');
                $('.invalid-feedback').text('');
                $('.validation-icon').removeClass('bi-check-circle-fill bi-x-circle-fill valid invalid');
            }

            // Real-time validation for phone number
            // Enhanced phone number validation with auto-0 and number-only input
            // Enhanced phone number validation with auto-0 and number-only input (NO real-time validation)
            $('#modal-phone-number').on('input', function () {
                let phone = $(this).val();

                // Remove all non-numeric characters
                phone = phone.replace(/[^0-9]/g, '');

                // Auto-add 0 if empty or doesn't start with 0
                if (phone.length === 0) {
                    phone = '0';
                } else if (phone.length > 0 && phone.charAt(0) !== '0') {
                    phone = '0' + phone;
                }

                // Limit to 10 digits
                if (phone.length > 10) {
                    phone = phone.substring(0, 10);
                }

                // Update the input value
                $(this).val(phone);

                // Clear any existing validation states during input
                $(this).removeClass('is-invalid is-valid');
                $('#phone-validation-icon').removeClass('bi-check-circle-fill bi-x-circle-fill valid invalid');
                $('#phone-number-error').text('');
            });

            // Validation on blur (when user leaves the field)
            $('#modal-phone-number').on('blur', function () {
                const phone = $(this).val();
                const icon = $('#phone-validation-icon');

                if (phone.length === 0 || phone === '0') {
                    $(this).removeClass('is-invalid is-valid');
                    icon.removeClass('bi-check-circle-fill bi-x-circle-fill valid invalid');
                    $('#phone-number-error').text('');
                    return;
                }

                if (validatePhoneNumber(phone)) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                    icon.removeClass('bi-x-circle-fill invalid').addClass('bi-check-circle-fill valid');
                    $('#phone-number-error').text('');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                    icon.removeClass('bi-check-circle-fill valid').addClass('bi-x-circle-fill invalid');
                    if (phone.length < 10) {
                        $('#phone-number-error').text('Số điện thoại phải có 10 chữ số');
                    } else {
                        $('#phone-number-error').text('Số điện thoại không hợp lệ');
                    }
                }
            });

            // Prevent paste of non-numeric characters
            $('#modal-phone-number').on('paste', function (e) {
                e.preventDefault();
                const pastedText = (e.originalEvent || e).clipboardData.getData('text/plain');
                const numericOnly = pastedText.replace(/[^0-9]/g, '');

                let currentValue = $(this).val();
                const numericCurrent = currentValue.replace(/[^0-9]/g, '');

                // Combine and process
                let combined = numericCurrent + numericOnly;
                if (combined.length > 0 && combined.charAt(0) !== '0') {
                    combined = '0' + combined;
                }
                if (combined.length > 10) {
                    combined = combined.substring(0, 10);
                }

                $(this).val(combined);
                $(this).trigger('input'); // Trigger validation
            });

            // Prevent keydown of non-numeric keys (except navigation keys)
            $('#modal-phone-number').on('keydown', function (e) {
                // Allow: backspace, delete, tab, escape, enter, navigation keys
                if ([8, 9, 27, 13, 46, 37, 38, 39, 40].indexOf(e.keyCode) !== -1 ||
                    // Allow Ctrl+A, Ctrl+C, Ctrl+V, Ctrl+X
                    (e.keyCode === 65 && e.ctrlKey === true) ||
                    (e.keyCode === 67 && e.ctrlKey === true) ||
                    (e.keyCode === 86 && e.ctrlKey === true) ||
                    (e.keyCode === 88 && e.ctrlKey === true)) {
                    return;
                }

                // Allow only numeric keys (0-9)
                if ((e.keyCode >= 48 && e.keyCode <= 57) || (e.keyCode >= 96 && e.keyCode <= 105)) {
                    return;
                }

                // Prevent all other keys
                e.preventDefault();
            });

            // Auto-focus and add 0 when field gets focus
            $('#modal-phone-number').on('focus', function () {
