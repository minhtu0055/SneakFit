@using SneakFit.ViewModels.Catalog.HoaDonClient
@using SneakFit.Data.Enums
@model SneakFit.WebClient.Models.AccountViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Danh Sách Đơn Hàng - SneakFit";
    var trangThaiSelected = Context.Request.Query["trangThai"].ToString();
    var trangThaiList = new[] {
        new { Value = ((int)TrangThaiHoaDon.ChoXacNhan).ToString(), Text = "Chờ xác nhận" },
        new { Value = ((int)TrangThaiHoaDon.DaXacNhan).ToString(), Text = "Đã xác nhận" },
        new { Value = ((int)TrangThaiHoaDon.ChoVanChuyen).ToString(), Text = "Chờ vận chuyển" },
        new { Value = ((int)TrangThaiHoaDon.DangVanChuyen).ToString(), Text = "Đang vận chuyển" },
        new { Value = ((int)TrangThaiHoaDon.DaThanhToan).ToString(), Text = "Đã thanh toán" },
        new { Value = ((int)TrangThaiHoaDon.ThanhCong).ToString(), Text = "Thành công" },
        new { Value = ((int)TrangThaiHoaDon.DaHuy).ToString(), Text = "Đã hủy" },
        new { Value = ((int)TrangThaiHoaDon.TraHang).ToString(), Text = "Trả hàng" }
    };

    var selectedTrangThai = Context.Request.Query["trangThai"].ToString();
    var slTheoTrangThai = Model.SoLuongTheoTrangThai;
    var daChonTrangThai = !string.IsNullOrEmpty(selectedTrangThai);
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Tài Khoản</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Tài Khoản</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Account Section -->
    <section id="account" class="account section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Mobile Menu Toggle -->
            <div class="mobile-menu d-lg-none mb-4">
                <button class="mobile-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#profileMenu">
                    <i class="bi bi-grid"></i>
                    <span>Menu</span>
                </button>
            </div>

            <div class="row g-4">
                <!-- Profile Menu -->
                <div class="col-lg-3">
                    <div class="profile-menu collapse d-lg-block" id="profileMenu">
                        <!-- User Info -->
                        <div class="user-info" data-aos="fade-right">
                            <div class="user-avatar">
                                <img src="@(string.IsNullOrEmpty(User.FindFirst("UrlHinhAnh")?.Value) ? Url.Content("~/assets/img/ava.jpg") : $"{Configuration["BaseAddress"]}{User.FindFirst("UrlHinhAnh")?.Value}")" class="rounded-circle" width="100" />
                                <span class="status-badge"><i class="bi bi-shield-check"></i></span>
                            </div>
                            <h4>@ViewBag.HoVaTen</h4>
                        </div>

                        <!-- Navigation Menu -->
                        <nav class="menu-nav">
                            <ul class="nav flex-column" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#orders">
                                        <i class="bi bi-box-seam"></i>
                                        <span>Đơn hàng</span>
                                        <span class="badge">3</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#addresses">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>Địa chỉ</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#settings">
                                        <i class="bi bi-gear"></i>
                                        <span>Cài đặt tài khoản</span>
                                    </a>
                                </li>
                            </ul>

                            <div class="menu-footer">
                                <a class="dropdown-item d-flex align-items-center"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        </nav>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="col-lg-9">
                    <div class="content-area">
                        <div class="tab-content">
                            <!-- Orders Tab -->
                            <div class="tab-pane fade show active" id="orders">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>Đơn hàng của tôi</h2>
                                </div>

                                <div class="orders-grid">
                                    <!-- Timeline Section - Hiển thị khi chưa chọn trạng thái -->
                                    <div id="timeline-section" class="@(daChonTrangThai ? "d-none" : "")">
                                        <div class="card shadow rounded-4 border-0">
                                            <div class="card-body p-4">
                                                <div class="container">
                                                    <div class="progress-container">
                                                        <div class="progress-timeline">
                                                            <!-- Mũi tên progress bar với màu sắc mới -->
                                                            <div class="arrow-progress">
                                                                <div class="arrow-segment royal-blue">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment indigo">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment purple">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment orange">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                                <div class="arrow-segment emerald">
                                                                    <div class="arrow-dot"></div>
                                                                </div>
                                                            </div>

                                                            <!-- Các bước với màu sắc và connector tương ứng -->
                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.ChoXacNhan).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.ChoXacNhan))">
                                                                <div class="step-icon royal-blue icon-file">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.ChoXacNhan) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoXacNhan] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoXacNhan]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector royal-blue"></div>
                                                                <div class="step-title">Chờ xác nhận</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.ChoVanChuyen).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.ChoVanChuyen))">
                                                                <div class="step-icon indigo icon-truck">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.ChoVanChuyen) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoVanChuyen] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ChoVanChuyen]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector indigo"></div>
                                                                <div class="step-title">Chờ vận chuyển</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.DangVanChuyen).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.DangVanChuyen))">
                                                                <div class="step-icon purple icon-delivery">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.DangVanChuyen) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DangVanChuyen] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DangVanChuyen]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector purple"></div>
                                                                <div class="step-title">Đang vận chuyển</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.DaThanhToan).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.DaThanhToan))">
                                                                <div class="step-icon orange icon-payment">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.DaThanhToan) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DaThanhToan] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.DaThanhToan]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector orange"></div>
                                                                <div class="step-title">Đã thanh toán</div>
                                                            </a>

                                                            <a class="progress-step text-decoration-none @(selectedTrangThai == ((int)TrangThaiHoaDon.ThanhCong).ToString() ? "active-step" : "")"
                                                               href="javascript:void(0)" onclick="loadOrdersByStatus(@((int)TrangThaiHoaDon.ThanhCong))">
                                                                <div class="step-icon emerald icon-check">
                                                                    @if (Model.SoLuongTheoTrangThai.ContainsKey(TrangThaiHoaDon.ThanhCong) && Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ThanhCong] > 0)
                                                                    {
                                                                        <span class="step-count">@Model.SoLuongTheoTrangThai[TrangThaiHoaDon.ThanhCong]</span>
                                                                    }
                                                                </div>
                                                                <div class="step-connector emerald"></div>
                                                                <div class="step-title">Hoàn thành</div>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Orders List Section - Hiển thị khi đã chọn trạng thái -->
                                    <div id="orders-list-section" class="@(!daChonTrangThai ? "d-none" : "")">
                                        <!-- Back to Timeline Button -->
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-secondary" onclick="showTimeline()">
                                                <i class="bi bi-arrow-left"></i> Quay lại Timeline
                                            </button>
                                        </div>

                                        <!-- Orders Table -->
                                        <div id="orders-table-container">
                                            @if (daChonTrangThai)
                                            {
                                                @if (Model == null || !Model.hoaDonClientViewModels.Any())
                                                {
                                                    <div class="section-box text-center p-4">
                                                        <p class="text-muted">Không có đơn hàng nào ở trạng thái này.</p>
                                                        <button type="button" class="btn btn-primary mt-3" onclick="showTimeline()">Quay lại Timeline</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="section-box">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="border-right: none; ">Mã Đơn Hàng</th>
                                                                        <th style="border-right: none; ">Ngày Đặt Hàng</th>
                                                                        <th style="border-right: none; ">Tổng Thanh Toán</th>
                                                                        <th style="border-right: none; ">Trạng Thái</th>
                                                                        <th>Hành Động</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var item in Model.hoaDonClientViewModels)
                                                                    {
                                                                        <tr>
                                                                            <td style="border-right: none; ">@item.MaHoaDon</td>
                                                                            <td style="border-right: none; ">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                                                            <td style="border-right: none; ">@item.TongTien.ToString("N0") ₫</td>
                                                                            <td style="border-right: none; ">
                                                                                <span class="status-badge">@item.TrangThai</span>
                                                                            </td>
                                                                            <td>
                                                                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="loadOrderDetails('@item.Id')">Xem Chi Tiết</button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- Order Details Section - Hiển thị chi tiết hóa đơn -->
                                    <div id="order-details-section" class="d-none">
                                        <!-- Back to Orders Button -->
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-secondary" onclick="showOrdersList()">
                                                <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn hàng
                                            </button>
                                        </div>

                                        <!-- Order Details Container -->
                                        <div id="order-details-container">
                                            <!-- Nội dung chi tiết hóa đơn sẽ được load ở đây -->
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Addresses Tab -->
                            <div class="tab-pane fade" id="addresses">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>ĐỊA CHỈ</h2>
                                </div>

                                <div class="addresses-grid">
                                    <!-- Address Card 1 -->
                                    <div class="address-card default" data-aos="fade-up" data-aos-delay="100">
                                        <div class="card-header">
                                            <h4>Home</h4>
                                            <span class="default-badge">Default</span>
                                        </div>
                                        <div class="card-body">
                                            <p class="address-text">
                                                @(Model.User?.DiaChi?.TenDiaChi ?? "")<br>
                                                @(Model.User?.DiaChi?.TenXa ?? "")<br>
                                                @(Model.User?.DiaChi?.TenHuyen ?? "")<br>
                                                @(Model.User?.DiaChi?.TenThanhPho ?? "")<br>
                                            </p>
                                            <div class="contact-info">
                                                <div><i class="bi bi-person"></i> @(Model.User?.HoVaTen ?? "")</div>
                                                <div><i class="bi bi-telephone"></i> @(Model.User?.SoDienThoai ?? "")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Settings Tab -->
                            <div class="tab-pane fade" id="settings">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>Account Settings</h2>
                                </div>

                                <div class="settings-content">
                                    <!-- Personal Information -->
                                    <div class="settings-section" data-aos="fade-up">
                                        <h3>THÔNG TIN TÀI KHOẢN</h3>
                                        <form class="php-email-form settings-form">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label for="firstName" class="form-label">First Name</label>
                                                    <input type="text" class="form-control" id="firstName" value="@(Model.User?.HoVaTen ?? "")" readonly>

                                                </div>
                                                <div class="col-md-6">
                                                    <label for="email" class="form-label">Email</label>
                                                    <input type="email" class="form-control" id="email" value="@(Model.User?.Email ?? "")" readonly>

                                                </div>
                                                <div class="col-md-6">
                                                    <label for="phone" class="form-label">Phone</label>
                                                    <input type="tel" class="form-control" id="phone" value="@(Model.User?.SoDienThoai ?? "")" readonly>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Security Settings -->
                                    <div class="settings-section" data-aos="fade-up" data-aos-delay="200">
                                        @if (TempData["error"] != null)
                                        {
                                            <div class="alert alert-danger">@TempData["error"]</div>
                                        }
                                        @if (TempData["SuccessMessage"] != null)
                                        {
                                            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                                        }
                                        <h3>ĐỔI MẬT KHẨU</h3>
                                        <form asp-action="DoiMatKhau" asp-controller="Account" method="post">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="row g-3">
                                                <div class="col-md-12">
                                                    <label asp-for="DoiMatKhauRequest.MatKhauHienTai" class="form-label"></label>
                                                    <div class="input-group">
                                                        <input asp-for="DoiMatKhauRequest.MatKhauHienTai" class="form-control" type="password" id="currentPassword" />
                                                        <span class="input-group-text" id="toggleCurrentPassword" style="cursor:pointer;">
                                                            <i class="bi bi-eye-slash" id="toggleCurrentPasswordIcon"></i>
                                                        </span>
                                                    </div>
                                                    <span asp-validation-for="DoiMatKhauRequest.MatKhauHienTai" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="DoiMatKhauRequest.MatKhauMoi" class="form-label"></label>
                                                    <div class="input-group">
                                                        <input asp-for="DoiMatKhauRequest.MatKhauMoi" class="form-control" type="password" id="newPassword" />
                                                        <span class="input-group-text" id="toggleNewPassword" style="cursor:pointer;">
                                                            <i class="bi bi-eye-slash" id="toggleNewPasswordIcon"></i>
                                                        </span>
                                                    </div>
                                                    <span asp-validation-for="DoiMatKhauRequest.MatKhauMoi" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="DoiMatKhauRequest.XacNhanMatKhau" class="form-label"></label>
                                                    <div class="input-group">
                                                        <input asp-for="DoiMatKhauRequest.XacNhanMatKhau" class="form-control" type="password" id="confirmPassword" />
                                                        <span class="input-group-text" id="toggleConfirmPassword" style="cursor:pointer;">
                                                            <i class="bi bi-eye-slash" id="toggleConfirmPasswordIcon"></i>
                                                        </span>
                                                    </div>
                                                    <span asp-validation-for="DoiMatKhauRequest.XacNhanMatKhau" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <div class="form-buttons">
                                                <button type="submit" class="btn btn-primary">Save</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section><!-- /Account Section -->

</main>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script>
        // Toggle password visibility for Đổi mật khẩu
        $(document).ready(function () {
            $('#toggleCurrentPassword').on('click', function () {
                var input = $('#currentPassword');
                var icon = $('#toggleCurrentPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
            $('#toggleNewPassword').on('click', function () {
                var input = $('#newPassword');
                var icon = $('#toggleNewPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
            $('#toggleConfirmPassword').on('click', function () {
                var input = $('#confirmPassword');
                var icon = $('#toggleConfirmPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
        });

        // Hiển thị thông báo thành công
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage) {
            Swal.fire({
                title: 'Thành công!',
                text: successMessage,
                icon: 'SuccessMessage',
                confirmButtonText: 'Đóng'
            });
        }

        // Load orders by status
        function loadOrdersByStatus(trangThai) {
            // Hiển thị loading
            $('#orders-table-container').html('<div class="text-center p-4"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');

            // Ẩn timeline, hiển thị orders list
            $('#timeline-section').addClass('d-none');
            $('#orders-list-section').removeClass('d-none');

            // Gọi AJAX để lấy dữ liệu
            $.ajax({
                url: '@Url.Action("GetOrdersByStatus", "Account")',
                type: 'GET',
                data: { trangThai: trangThai },
                success: function (data) {
                    $('#orders-table-container').html(data);
                },
                error: function () {
                    $('#orders-table-container').html('<div class="section-box text-center p-4"><p class="text-muted">Có lỗi xảy ra khi tải dữ liệu.</p><button type="button" class="btn btn-primary mt-3" onclick="showTimeline()">Quay lại Timeline</button></div>');
                }
            });
        }

        // Show timeline
        function showTimeline() {
            $('#orders-list-section').addClass('d-none');
            $('#order-details-section').addClass('d-none');
            $('#timeline-section').removeClass('d-none');
        }

        // Show orders list
        function showOrdersList() {
            $('#order-details-section').addClass('d-none');
            $('#orders-list-section').removeClass('d-none');
        }

        // Load order details
        function loadOrderDetails(orderId) {
            // Hiển thị loading
            $('#order-details-container').html('<div class="text-center p-4"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');

            // Ẩn orders list, hiển thị order details
            $('#orders-list-section').addClass('d-none');
            $('#order-details-section').removeClass('d-none');

            // Gọi AJAX để lấy chi tiết hóa đơn
            $.ajax({
                url: '@Url.Action("GetOrderDetails", "Account")',
                type: 'GET',
                data: { id: orderId },
                success: function (data) {
                    $('#order-details-container').html(data);
                },
                error: function () {
                    $('#order-details-container').html('<div class="section-box text-center p-4"><p class="text-muted">Có lỗi xảy ra khi tải chi tiết đơn hàng.</p><button type="button" class="btn btn-primary mt-3" onclick="showOrdersList()">Quay lại danh sách</button></div>');
                }
            });
        }
    </script>
}
<style>
    .main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-box {
        position: relative;
        background-color: #FFFFFF;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

    .table {
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 0; /* Loại bỏ margin bottom mặc định */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            padding: 12px;
