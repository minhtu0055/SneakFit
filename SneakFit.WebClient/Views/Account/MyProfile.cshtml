@using SneakFit.ViewModels.Catalog.HoaDonClient
@using SneakFit.Data.Enums
@model SneakFit.WebClient.Models.AccountViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Danh Sách Đơn Hàng - SneakFit";
    var trangThaiSelected = Context.Request.Query["trangThai"].ToString();
    var trangThaiList = new[] {
        new { Value = ((int)TrangThaiHoaDon.ChoXacNhan).ToString(), Text = "Chờ xác nhận" },
        new { Value = ((int)TrangThaiHoaDon.DaXacNhan).ToString(), Text = "Đã xác nhận" },
        new { Value = ((int)TrangThaiHoaDon.ChoVanChuyen).ToString(), Text = "Chờ vận chuyển" },
        new { Value = ((int)TrangThaiHoaDon.DangVanChuyen).ToString(), Text = "Đang vận chuyển" },
        new { Value = ((int)TrangThaiHoaDon.DaThanhToan).ToString(), Text = "Đã thanh toán" },
        new { Value = ((int)TrangThaiHoaDon.ThanhCong).ToString(), Text = "Thành công" },
        new { Value = ((int)TrangThaiHoaDon.DaHuy).ToString(), Text = "Đã hủy" },
        new { Value = ((int)TrangThaiHoaDon.TraHang).ToString(), Text = "Trả hàng" }
    };
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Tài Khoản</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Tài Khoản</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Account Section -->
    <section id="account" class="account section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Mobile Menu Toggle -->
            <div class="mobile-menu d-lg-none mb-4">
                <button class="mobile-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#profileMenu">
                    <i class="bi bi-grid"></i>
                    <span>Menu</span>
                </button>
            </div>

            <div class="row g-4">
                <!-- Profile Menu -->
                <div class="col-lg-3">
                    <div class="profile-menu collapse d-lg-block" id="profileMenu">
                        <!-- User Info -->
                        <div class="user-info" data-aos="fade-right">
                            <div class="user-avatar">
                                <img src="@(string.IsNullOrEmpty(User.FindFirst("UrlHinhAnh")?.Value) ? Url.Content("~/assets/img/ava.jpg") : $"{Configuration["BaseAddress"]}{User.FindFirst("UrlHinhAnh")?.Value}")" class="rounded-circle" width="100" />
                                <span class="status-badge"><i class="bi bi-shield-check"></i></span>
                            </div>
                            <h4>@ViewBag.HoVaTen</h4>
                        </div>

                        <!-- Navigation Menu -->
                        <nav class="menu-nav">
                            <ul class="nav flex-column" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#orders">
                                        <i class="bi bi-box-seam"></i>
                                        <span>Đơn hàng</span>
                                        <span class="badge">3</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#addresses">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>Địa chỉ</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#settings">
                                        <i class="bi bi-gear"></i>
                                        <span>Cài đặt tài khoản</span>
                                    </a>
                                </li>
                            </ul>

                            <div class="menu-footer">
                                <a class="dropdown-item d-flex align-items-center"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        </nav>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="col-lg-9">
                    <div class="content-area">
                        <div class="tab-content">
                            <!-- Orders Tab -->
                            <div class="tab-pane fade show active" id="orders">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>Đơn hàng của tôi</h2>
                                </div>

                                <div class="orders-grid">
                                    <!-- Order Card 1 -->
                                    <div class="card shadow rounded-4 border-0">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-4 text-center text-primary">My Orders</h5>
                                            <div class="container">
                                                <h2 class="text-center mb-4" style="color: #1E3A8A; font-weight: 600;">Danh Sách Đơn Hàng Của Bạn</h2>

                                                <!-- Bộ lọc trạng thái -->
                                                <div class="mb-3 text-center">
                                                    @foreach (var tt in trangThaiList)
                                                    {
                                                        <a href="@Url.Action("MyProfile", new { trangThai = tt.Value })" class="btn btn-sm @(trangThaiSelected == tt.Value ? "btn-primary" : "btn-outline-primary") mx-1">@tt.Text</a>
                                                    }
                                                    @if (!string.IsNullOrEmpty(trangThaiSelected))
                                                    {
                                                        <a href="@Url.Action("MyProfile")" class="btn btn-sm btn-secondary mx-1">Bỏ lọc</a>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrEmpty(trangThaiSelected))
                                                {
                                                    var trangThaiText = trangThaiList.FirstOrDefault(x => x.Value == trangThaiSelected)?.Text;
                                                    <div class="alert alert-info text-center"><b>@trangThaiText</b></div>
                                                }


                                                @if (Model?.hoaDonClientViewModels == null || !Model.hoaDonClientViewModels.Any())
                                                {
                                                    <div class="section-box text-center p-4">
                                                        <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
                                                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Quay về trang chủ</a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="section-box">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="border-right: none; ">Mã Đơn Hàng</th>
                                                                        <th style="border-right: none; ">Ngày Đặt Hàng</th>
                                                                        <th style="border-right: none; ">Tổng Thanh Toán</th>
                                                                        <th style="border-right: none; ">Trạng Thái</th>
                                                                        <th>Hành Động</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var item in Model.hoaDonClientViewModels)
                                                                    {
                                                                        <tr>
                                                                            <td style="border-right: none; ">@item.MaHoaDon</td>
                                                                            <td style="border-right: none; ">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                                                            <td style="border-right: none; ">@item.TongTien.ToString("N0") ₫</td>
                                                                            <td style="border-right: none; ">
                                                                                <a href="@Url.Action("Index", new { trangThai = ((int)item.TrangThai) })" class="status-link">@item.TrangThai</a>
                                                                            </td>
                                                                            <td>
                                                                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-outline-primary btn-sm">Xem Chi Tiết</a>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <!-- Addresses Tab -->
                            <div class="tab-pane fade" id="addresses">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>ĐỊA CHỈ</h2>
                                </div>

                                <div class="addresses-grid">
                                    <!-- Address Card 1 -->
                                    <div class="address-card default" data-aos="fade-up" data-aos-delay="100">
                                        <div class="card-header">
                                            <h4>Home</h4>
                                            <span class="default-badge">Default</span>
                                        </div>
                                        <div class="card-body">
                                            <p class="address-text">
                                                @(Model.User?.DiaChi?.TenDiaChi ?? "")<br>
                                                @(Model.User?.DiaChi?.TenXa ?? "")<br>
                                                @(Model.User?.DiaChi?.TenHuyen ?? "")<br>
                                                @(Model.User?.DiaChi?.TenThanhPho ?? "")<br>
                                            </p>
                                            <div class="contact-info">
                                                <div><i class="bi bi-person"></i> @(Model.User?.HoVaTen ?? "")</div>
                                                <div><i class="bi bi-telephone"></i> @(Model.User?.SoDienThoai ?? "")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Settings Tab -->
                            <div class="tab-pane fade" id="settings">
                                <div class="section-header" data-aos="fade-up">
                                    <h2>Account Settings</h2>
                                </div>

                                <div class="settings-content">
                                    <!-- Personal Information -->
                                    <div class="settings-section" data-aos="fade-up">
                                        <h3>THÔNG TIN TÀI KHOẢN</h3>
                                        <form class="php-email-form settings-form">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label for="firstName" class="form-label">First Name</label>
                                                    <input type="text" class="form-control" id="firstName" value="@(Model.User?.HoVaTen ?? "")" readonly>

                                                </div>
                                                <div class="col-md-6">
                                                    <label for="email" class="form-label">Email</label>
                                                    <input type="email" class="form-control" id="email" value="@(Model.User?.Email ?? "")" readonly>

                                                </div>
                                                <div class="col-md-6">
                                                    <label for="phone" class="form-label">Phone</label>
                                                    <input type="tel" class="form-control" id="phone" value="@(Model.User?.SoDienThoai ?? "")" readonly>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Security Settings -->
                                    <div class="settings-section" data-aos="fade-up" data-aos-delay="200">
                                        @if (TempData["error"] != null)
                                        {
                                            <div class="alert alert-danger">@TempData["error"]</div>
                                        }
                                        @if (TempData["SuccessMessage"] != null)
                                        {
                                            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                                        }
                                        <h3>ĐỔI MẬT KHẨU</h3>
                                        <form asp-action="DoiMatKhau" asp-controller="Account" method="post" class="php-email-form settings-form">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="row g-3">
                                                <div class="col-md-12">
                                                    <label asp-for="DoiMatKhauRequest.MatKhauHienTai" class="form-label"></label>
                                                    <div class="input-group">
                                                        <input asp-for="DoiMatKhauRequest.MatKhauHienTai" class="form-control" type="password" id="currentPassword" />
                                                        <span class="input-group-text" id="toggleCurrentPassword" style="cursor:pointer;">
                                                            <i class="bi bi-eye-slash" id="toggleCurrentPasswordIcon"></i>
                                                        </span>
                                                    </div>
                                                    <span asp-validation-for="DoiMatKhauRequest.MatKhauHienTai" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="DoiMatKhauRequest.MatKhauMoi" class="form-label"></label>
                                                    <div class="input-group">
                                                        <input asp-for="DoiMatKhauRequest.MatKhauMoi" class="form-control" type="password" id="newPassword" />
                                                        <span class="input-group-text" id="toggleNewPassword" style="cursor:pointer;">
                                                            <i class="bi bi-eye-slash" id="toggleNewPasswordIcon"></i>
                                                        </span>
                                                    </div>
                                                    <span asp-validation-for="DoiMatKhauRequest.MatKhauMoi" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="DoiMatKhauRequest.XacNhanMatKhau" class="form-label"></label>
                                                    <div class="input-group">
                                                        <input asp-for="DoiMatKhauRequest.XacNhanMatKhau" class="form-control" type="password" id="confirmPassword" />
                                                        <span class="input-group-text" id="toggleConfirmPassword" style="cursor:pointer;">
                                                            <i class="bi bi-eye-slash" id="toggleConfirmPasswordIcon"></i>
                                                        </span>
                                                    </div>
                                                    <span asp-validation-for="DoiMatKhauRequest.XacNhanMatKhau" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <div class="form-buttons">
                                                <button type="submit" class="btn-save">Update Password</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section><!-- /Account Section -->

</main>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script>
        // Toggle password visibility for Đổi mật khẩu
        $(document).ready(function () {
            $('#toggleCurrentPassword').on('click', function () {
                var input = $('#currentPassword');
                var icon = $('#toggleCurrentPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
            $('#toggleNewPassword').on('click', function () {
                var input = $('#newPassword');
                var icon = $('#toggleNewPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
            $('#toggleConfirmPassword').on('click', function () {
                var input = $('#confirmPassword');
                var icon = $('#toggleConfirmPasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
        });
        // Hiển thị thông báo thành công
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage) {
            Swal.fire({
                title: 'Thành công!',
                text: successMessage,
                icon: 'SuccessMessage',
                confirmButtonText: 'Đóng'
            });
        }
    </script>
}
<style>
    .main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-box {
        position: relative;
        background-color: #FFFFFF;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

    .table {
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 0; /* Loại bỏ margin bottom mặc định */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            padding: 12px;
            text-align: center;
            background-color: #1E3A8A;
            color: #FFFFFF;
            border: 1px solid #60A5FA;
        }

            .table thead th:first-child {
                border-top-left-radius: 8px;
            }

            .table thead th:last-child {
                border-top-right-radius: 8px;
            }

            .table thead th:hover {
                text-decoration: none;
                background-color: #1E3A8A;
            }

        .table tbody {
            /* border: 1px solid #60A5FA; */
            border-top: none;
        }

            .table tbody td {
                padding: 12px;
                text-align: center;
                vertical-align: middle;
                color: #4B5563;
                border: 1px solid #60A5FA;
                border-top: none;
            }

            .table tbody tr {
                background-color: #FFFFFF;
            }

                .table tbody tr:hover {
                    background-color: #F8FAFC;
                }

                /* Áp dụng border-radius cho dòng cuối cùng */
                .table tbody tr:last-child td:first-child {
                    border-bottom-left-radius: 8px;
                }

                .table tbody tr:last-child td:last-child {
                    border-bottom-right-radius: 8px;
                }

    /* Loại bỏ hiệu ứng sọc của table-striped */
    .table-striped tbody tr:nth-child(odd) {
        background-color: #FFFFFF;
    }

    .table-striped tbody tr:nth-child(even) {
        background-color: #FFFFFF;
    }

    .btn-outline-primary {
        border-color: #60A5FA;
        color: #60A5FA;
        padding: 6px 12px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-outline-primary:hover {
            background-color: #60A5FA;
            color: #FFFFFF;
            transform: scale(1.05);
        }

    .btn-primary {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        border: none;
        color: #FFFFFF;
        padding: 10px 20px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #3B82F6, #163172);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
        }
</style>
