        // Load orders by status
        function loadOrdersByStatus(trangThai) {
            // Hiển thị loading
            $('#orders-table-container').html('<div class="text-center p-4"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');

            // Ẩn timeline, hiển thị orders list
            $('#timeline-section').addClass('d-none');
            $('#orders-list-section').removeClass('d-none');

            // Gọi AJAX để lấy dữ liệu
            $.ajax({
                url: '@Url.Action("GetOrdersByStatus", "Account")',
                type: 'GET',
                data: { trangThai: trangThai },
                success: function (data) {
                    $('#orders-table-container').html(data);

                    // Cập nhật trạng thái active sau khi load xong
                    setTimeout(function () {
                        // Xoá class active ở tất cả button
                        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));

                        // Chuyển đổi số thành string tương ứng nếu cần
                        let statusString = trangThai;
                        if (!isNaN(trangThai)) {
                            const statusMap = {
                                0: 'ChoXacNhan',
                                1: 'DaXacNhan',
                                2: 'ChoVanChuyen',
                                3: 'DangVanChuyen',
                                4: 'DaThanhToan',
                                5: 'ThanhCong',
                                6: 'DaHuy',
                                7: 'TraHang'
                            };
                            statusString = statusMap[trangThai] || trangThai;
                        }
                        else if (trangThai === "all") {
                            statusString = "all";
                        }
                        else {
                            statusString = trangThai;
                        }

                        // Thêm class active vào button được chọn
                        const selectedBtn = document.querySelector(`.filter-btn[data-status="${statusString}"]`);
                        if (selectedBtn) selectedBtn.classList.add('active');
                    }, 100);
                },
                error: function () {
                    $('#orders-table-container').html('<div class="section-box text-center p-4"><p class="text-muted">Có lỗi xảy ra khi tải dữ liệu.</p><button type="button" class="btn btn-primary mt-3" onclick="showTimeline()">Quay lại Timeline</button></div>');
                }
            });
        }

