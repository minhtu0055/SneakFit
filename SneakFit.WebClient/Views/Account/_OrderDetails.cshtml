@model OrderConfirmationViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Chi Tiết Đơn Hàng - SneakFit";
    int step = -1;
    switch ((SneakFit.Data.Enums.TrangThaiHoaDon)Model.HoaDonClient.TrangThai)
    {
        // ChoXacNhan = 0,
        // DaXacNhan = 1,
        // ChoVanChuyen = 2,
        // DangVanChuyen = 3,
        // DaThanhToan = 4,
        // ThanhCong = 5,
        // DaHuy = 6,
        // TraHang = 7
        case SneakFit.Data.Enums.TrangThaiHoaDon.ChoXacNhan: step = 0; break;
        case SneakFit.Data.Enums.TrangThaiHoaDon.DaXacNhan: step = 1; break;
        case SneakFit.Data.Enums.TrangThaiHoaDon.ChoVanChuyen: step = 2; break;
        case SneakFit.Data.Enums.TrangThaiHoaDon.DangVanChuyen: step = 3; break;
        case SneakFit.Data.Enums.TrangThaiHoaDon.DaThanhToan: step = 4; break;
        case SneakFit.Data.Enums.TrangThaiHoaDon.ThanhCong: step = 5; break;
        default: step = -1; break;
    }
    bool isInactive = step == -1;
}

<main class="main py-4 bg-light">
    <div class="container">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        else if (Model.HoaDonClient == null)
        {
            <div class="section-box text-center p-4">
                <p class="text-muted">Không tìm thấy đơn hàng.</p>
                <a href="@Url.Action("Index", "Account")" class="btn btn-primary mt-3">Quay về danh sách</a>
            </div>
        }
        else
        {
            <!-- Thông báo xác nhận -->
            <div class="section-box confirmation-message mb-4 text-center">
                <div class="progress-timeline" style="border-bottom: 2px solid #60A5FA;">
                    <!-- Mũi tên progress bar với màu sắc mới -->
                    <div class="arrow-progress">
                        <div class="arrow-segment royal-blue @(isInactive || step < 0 ? "step-inactive" : "")">
                            <div class="arrow-dot"></div>
                        </div>
                        <div class="arrow-segment royal-blue @(isInactive || step < 1 ? "step-inactive" : "")">
                            <div class="arrow-dot"></div>
                        </div>
                        <div class="arrow-segment indigo @(isInactive || step < 2 ? "step-inactive" : "")">
                            <div class="arrow-dot"></div>
                        </div>
                        <div class="arrow-segment purple @(isInactive || step < 3 ? "step-inactive" : "")">
                            <div class="arrow-dot"></div>
                        </div>
                        @if (Model.HoaDonClient.PhuongThucThanhToan == SneakFit.Data.Enums.PhuongThucThanhToan.COD && Model.HoaDonClient.LoaiHoaDon == SneakFit.Data.Enums.LoaiHoaDon.Online)
                        {
                            <div class="arrow-segment orange @(isInactive || step < 4 ? "step-inactive" : "")">
                                <div class="arrow-dot"></div>
                            </div>
                            <div class="arrow-segment emerald @(isInactive || step < 5 ? "step-inactive" : "")">
                                <div class="arrow-dot"></div>
                            </div>
                        }
                        else
                        {
                            <div class="arrow-segment emerald @(isInactive || step < 5 ? "step-inactive" : "")">
                                <div class="arrow-dot"></div>
                            </div>
                        }
                    </div>
                    <!-- Các bước với màu sắc và connector tương ứng -->
                    <div class="progress-step">
                        <div class="step-icon royal-blue icon-file @(isInactive || step < 0 ? "step-inactive" : "")"></div>
                        <div class="step-connector royal-blue @(isInactive || step < 0 ? "step-inactive" : "")"></div>
                        <div class="step-title @(isInactive || step < 0 ? "step-inactive" : "")">Chờ xác nhận</div>
                        <div class="step-description @(isInactive || step < 0 ? "step-inactive" : "")">Chờ xác nhận</div>
                    </div>
                    <div class="progress-step">
                        <div class="step-icon royal-blue icon-file @(isInactive || step < 1 ? "step-inactive" : "")"></div>
                        <div class="step-connector royal-blue @(isInactive || step < 1 ? "step-inactive" : "")"></div>
                        <div class="step-title @(isInactive || step < 1 ? "step-inactive" : "")">Đã xác nhận</div>
                        <div class="step-description @(isInactive || step < 1 ? "step-inactive" : "")">Đã xác nhận</div>
                    </div>
                    <div class="progress-step">
                        <div class="step-icon indigo icon-truck @(isInactive || step < 2 ? "step-inactive" : "")"></div>
                        <div class="step-connector indigo @(isInactive || step < 2 ? "step-inactive" : "")"></div>
                        <div class="step-title @(isInactive || step < 2 ? "step-inactive" : "")">Chờ vận chuyển</div>
                        <div class="step-description @(isInactive || step < 2 ? "step-inactive" : "")">Chờ vận chuyển</div>
                    </div>
                    <div class="progress-step">
                        <div class="step-icon purple icon-delivery @(isInactive || step < 3 ? "step-inactive" : "")"></div>
                        <div class="step-connector purple @(isInactive || step < 3 ? "step-inactive" : "")"></div>
                        <div class="step-title @(isInactive || step < 3 ? "step-inactive" : "")">Đang vận chuyển</div>
                        <div class="step-description @(isInactive || step < 3 ? "step-inactive" : "")">Đã bàn giao cho đơn vị vận chuyển</div>
                    </div>
                    @if (Model.HoaDonClient.PhuongThucThanhToan == SneakFit.Data.Enums.PhuongThucThanhToan.COD && Model.HoaDonClient.LoaiHoaDon == SneakFit.Data.Enums.LoaiHoaDon.Online)
                    {
                        <div class="progress-step">
                            <div class="step-icon orange icon-payment @(isInactive || step < 4 ? "step-inactive" : "")"></div>
                            <div class="step-connector orange @(isInactive || step < 4 ? "step-inactive" : "")"></div>
                            <div class="step-title @(isInactive || step < 4 ? "step-inactive" : "")">Đã thanh toán</div>
                            <div class="step-description @(isInactive || step < 4 ? "step-inactive" : "")">Đã thanh toán</div>
                        </div>
                        <div class="progress-step">
                            <div class="step-icon emerald icon-check @(isInactive || step < 5 ? "step-inactive" : "")"></div>
                            <div class="step-connector emerald @(isInactive || step < 5 ? "step-inactive" : "")"></div>
                            <div class="step-title @(isInactive || step < 5 ? "step-inactive" : "")">Thành công</div>
                            <div class="step-description @(isInactive || step < 5 ? "step-inactive" : "")">Đơn hàng đã được giao thành công</div>
                        </div>
                    }
                    else
                    {
                        <div class="progress-step">
                            <div class="step-icon emerald icon-check @(isInactive || step < 5 ? "step-inactive" : "")"></div>
                            <div class="step-connector emerald @(isInactive || step < 5 ? "step-inactive" : "")"></div>
                            <div class="step-title @(isInactive || step < 5 ? "step-inactive" : "")">Thành công</div>
                            <div class="step-description @(isInactive || step < 5 ? "step-inactive" : "")">Đơn hàng đã được giao thành công</div>
                        </div>
                    }
                </div>
                <p>Mã đơn hàng: <strong>@Model.HoaDonClient.MaHoaDon</strong></p>
            </div>

            <!-- Thông tin hóa đơn -->
            <div class="section-box order-info mb-4">
                <h5>Thông tin đơn hàng</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Người nhận:</strong> @Model.HoaDonClient.HoTen</p>
                        <p><strong>Số điện thoại:</strong> @Model.HoaDonClient.SoDienThoai</p>
                        <p><strong>Email:</strong> @Model.HoaDonClient.Email</p>
                        <p><strong>Địa chỉ giao hàng:</strong> @(string.IsNullOrEmpty(Model.HoaDonClient.DiaChi) ? "" : Model.HoaDonClient.DiaChi)</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày đặt hàng:</strong> @Model.HoaDonClient.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Phương thức thanh toán:</strong> @Model.HoaDonClient.PhuongThucThanhToan</p>
                        <p><strong>Trạng thái:</strong> @Model.HoaDonClient.TrangThai</p>
                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="section-box product-list mb-4">
                <h5>Sản phẩm trong đơn hàng</h5>
                @if (Model.ChiTietHoaDonClient != null && Model.ChiTietHoaDonClient.Any())
                {
                    @foreach (var item in Model.ChiTietHoaDonClient)
                    {
                        <div class="product-item d-flex align-items-center mb-3" style="border-radius: 10px;">
                            @{
                                var defaultImage = $"{baseUrl}/images/Default_Logo.png";
                                string imageUrl = defaultImage;
                                if (!string.IsNullOrEmpty(item.AnhSanPham) && item.AnhSanPham != "/images/Default_Logo.png")
                                {
                                    imageUrl = $"{baseUrl}{item.AnhSanPham}";
                                }
                            }
                            <img src="@imageUrl" class="product-img" style="margin-left: 10px;" onerror="this.src='@defaultImage'" />
                            <div class="product-info" style="align-items: center;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <p class="mb-0 fw-semibold">
                                        <span style="font-weight: bold; color: #1E3A8A;">@(string.IsNullOrEmpty(item.TenSanPham) ? "Tên sản phẩm không xác định" : item.TenSanPham)</span> ( @item.TenMauSac, @item.MaKichThuoc )
                                    </p>
                                    @if (item.KhuyenMaiId != null && item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0 && item.GiaKhuyenMai.Value < item.GiaBan)
                                    {
                                        <span class="discount" style="font-size: 0.85rem; margin-bottom: 1.5px;">Giảm @item.KhuyenMaiPhanTram%</span>
                                    }
                                </div>
                                <small class="text-muted" style="font-weight: bold; font-size: 15px">Số lượng: @item.SoLuong</small>
                            </div>
                            <div class="product-price ms-auto" style="margin-right: 10px;">
                                @if (item.KhuyenMaiId != null && item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0 && item.GiaKhuyenMai.Value < item.GiaGoc)
                                {
                                    <span class="text-danger">@item.GiaKhuyenMai.Value.ToString("N0") ₫</span>
                                    <br />
                                    <span class="text-muted text-decoration-line-through">@item.GiaGoc.Value.ToString("N0") ₫</span>
                                }
                                else
                                {
                                    <span>@item.GiaGoc?.ToString("N0") ₫</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Không có sản phẩm trong đơn hàng này.</p>
                }
            </div>

            <!-- Voucher đã sử dụng (section-box style) -->
            @if (Model.UsedVoucher != null)
            {
                <div class="section-box order-info mb-4">
                    <h5 class="voucher-info-title">
                        <i class="bi bi-ticket-perforated voucher-icon me-2"></i>Voucher đã sử dụng
                    </h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p>
                                <strong>Mã voucher:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.MaVoucher</span>
                            </p>
                            <p>
                                <strong>Loại giảm giá:</strong>
                                <span class="order-info-value">@(Model.UsedVoucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ? "Phần trăm" : "Số tiền")</span>
                            </p>
                            <p>
                                <strong>Giá trị giảm:</strong>
                                <span class="order-info-value">
                                    @(Model.UsedVoucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ?
                                        ($"{Model.UsedVoucher.GiaTriGiamGia}%") : ($"{Model.UsedVoucher.GiaTriGiamGia:N0} ₫"))
                                </span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p>
                                <strong>Điều kiện áp dụng:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.DieuKienApDung.ToString("N0") ₫</span>
                            </p>
                            <p>
                                <strong>Giá trị tối đa:</strong>
                                <span class="order-info-value">@(Model.UsedVoucher.GiaTriToiDa > 0 ? Model.UsedVoucher.GiaTriToiDa.ToString("N0") + " ₫" : "Không giới hạn")</span>
                            </p>
                            <p>
                                <strong>Hiệu lực:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.ThoiGianBatDau.ToString("dd/MM/yyyy") - @Model.UsedVoucher.ThoiGianKetThuc.ToString("dd/MM/yyyy")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Tóm tắt thanh toán (giống Checkout) -->
            <div class="section-box order-summary mb-4">
                <h5 style="color: #1E3A8A; border-bottom: 2px solid #60A5FA; padding-bottom: 10px;">Tóm tắt thanh toán</h5>
                <div class="summary-item">
                    <span>Tổng tiền hàng</span>
                    <span id="summary-products">@Model.HoaDonClient.TongTienSanPham.ToString("N0") ₫</span>
                </div>
                @if (Model.HoaDonClient.VoucherDiscount.HasValue && Model.HoaDonClient.VoucherDiscount.Value > 0)
                {
                    <div class="summary-item" id="summary-voucher">
                        <span>Áp dụng voucher</span>
                        <span class="text-danger" id="summary-voucher-amount">-@((Model.HoaDonClient.VoucherDiscount ?? 0).ToString("N0")) ₫</span>
                    </div>
                }
                <div class="summary-item">
                    <span>Phí vận chuyển</span>
                    <span id="summary-shipping">@(Model.HoaDonClient.PhiVanChuyen.ToString("N0")) ₫</span>
                </div>
                <hr />
                <div class="summary-item fw-bold fs-5">
                    <span>Tổng thanh toán</span>
                    <span id="summary-total" style="color: #1E3A8A;">@(Model.HoaDonClient.TongTien.ToString("N0")) ₫</span>
                </div>
            </div>

            <!-- Hành động -->
            <div class="section-box actions text-center">
                <a href="@Url.Action("MyProfile", "Account")" class="btn btn-primary">Quay về danh sách</a>
                @if ((int)Model.HoaDonClient.TrangThai == 0) // ChoXacNhan
                {
                    <form method="post" action="@Url.Action("CancelOrder", "ThanhToan", new { id = Model.HoaDonClient.Id })" style="display:inline-block;">
                        <button type="submit" class="btn btn-warning" onclick="return confirm('Bạn có chắc chắn muốn hủy hóa đơn này?');">Hủy hóa đơn</button>
                    </form>
                }
                @if ((int)Model.HoaDonClient.TrangThai == 5) // ThanhCong
                {
                    <form method="post" action="@Url.Action("ReturnOrder", "ThanhToan", new { id = Model.HoaDonClient.Id })" style="display:inline-block;">
                        <button type="submit" class="btn btn-warning" onclick="return confirm('Bạn có chắc chắn muốn trả hàng cho hóa đơn này?');">Trả hàng</button>
                    </form>
                }
            </div>
        }
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
}

<style>
    /* Định dạng chính */
    .main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-box {
        background-color: #FFFFFF;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

        .section-box:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .section-box h5 {
            font-weight: 600;
            margin-bottom: 15px;
            color: #1E3A8A;
            font-size: 1.4rem;
            border-bottom: 2px solid #60A5FA;
            padding-bottom: 10px;
        }

            .section-box h5 i {
                margin-right: 10px;
                font-size: 1.5rem;
            }

    .confirmation-message {
        background-color: #E6F3FA;
        padding: 30px;
        border-radius: 10px;
    }

        .confirmation-message h5 {
            font-size: 1.6rem;
            color: #1E3A8A;
        }

        .confirmation-message p {
            font-size: 1.1rem;
            color: #4B5563;
            margin: 10px 0;
        }

    /* Timeline */
    .progress-timeline {
        display: flex;
        align-items: flex-start;
        position: relative;
        max-width: 950px;
        margin: 0 auto;
        min-height: 170px;
    }

    /* Thanh mũi tên tiến trình */
    .arrow-progress {
        display: flex;
        align-items: center;
        position: absolute;
        top: 100px;
        left: 0;
        right: 0;
        height: 20px;
        z-index: 1;
    }

    .arrow-segment {
        height: 100%;
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
        /* hiệu ứng */
        transition: background-color 0.3s;
    }

        .arrow-segment::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            right: 0;
            bottom: 0;
            clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 50%, calc(100% - 10px) 100%, 0 100%, 10px 50%);
            background-color: inherit;
            transition: background-color 0.3s;
        }

        .arrow-segment:first-child::before {
            clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 50%, calc(100% - 10px) 100%, 0 100%);
        }

        /* Màu sắc khi hoàn thành */
        .arrow-segment.royal-blue::before {
            background-color: #3b82f6;
        }

        .arrow-segment.indigo::before {
            background-color: #6366f1;
        }

        .arrow-segment.purple::before {
            background-color: #8b5cf6;
        }

        .arrow-segment.orange::before {
            background-color: #f59e0b;
        }

        .arrow-segment.emerald::before {
            background-color: #10b981;
        }

        /* Màu xám cho bước chưa tới */
        .arrow-segment.step-inactive::before {
            background-color: #d6d6d6 !important;
        }

    /* Dot trắng trên thanh tiến trình */
    .arrow-dot {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: white;
        border-radius: 50%;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        border: 2px solid #fff;
        box-shadow: 0 0 2px #bbb;
    }

    .arrow-segment.step-inactive .arrow-dot {
        background-color: #bbb !important;
        border: 2px solid #eee;
        box-shadow: none;
    }

    /* Bước (icon - title - desc) */
    .progress-step {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 3;
    }

    .step-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        margin-bottom: 15px;
        position: relative;
        z-index: 4;
        background-color: #bbb; /* default gray */
        transition: background 0.3s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

        .step-icon.royal-blue {
            background-color: #3b82f6;
        }

        .step-icon.indigo {
            background-color: #6366f1;
        }

        .step-icon.purple {
            background-color: #8b5cf6;
        }

        .step-icon.orange {
            background-color: #f59e0b;
        }

        .step-icon.emerald {
            background-color: #10b981;
        }

        .step-icon.step-inactive {
            background-color: #d6d6d6 !important;
            color: #fff !important;
            filter: none !important;
        }

    .step-connector {
        width: 2px;
        height: 30px;
        position: absolute;
        top: 70px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        background-color: #bbb;
    }

        .step-connector.royal-blue {
            background-color: #3b82f6;
        }

        .step-connector.indigo {
            background-color: #6366f1;
        }

        .step-connector.purple {
            background-color: #8b5cf6;
        }

        .step-connector.orange {
            background-color: #f59e0b;
        }

        .step-connector.emerald {
            background-color: #10b981;
        }

        .step-connector.step-inactive {
            background-color: #bbb !important;
        }

    /* Chữ bước hoàn thành - đen, chưa hoàn thành - nhạt */
    .step-title {
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 8px;
        text-align: center;
        white-space: nowrap;
        margin-top: 60px;
        color: #222;
        transition: color 0.3s;
    }

    .step-description {
        font-size: 13px;
        color: #666;
        text-align: center;
        line-height: 1.4;
        margin-bottom: 5px;
        max-width: 140px;
        transition: color 0.3s;
    }

    .progress-step .step-title.step-inactive,
    .progress-step .step-description.step-inactive {
        color: #9ca3af !important;
    }

    /* ICON SVG giữ nguyên */

    /* --- Các thành phần khác của page (giữ nguyên như cũ) --- */
    .order-info p {
        font-size: 1rem;
        color: #4B5563;
        margin-bottom: 10px;
    }

        .order-info p strong {
            color: #1E3A8A;
        }

    .product-list .product-item {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        padding: 15px 0;
        border-bottom: 1px solid #E5E7EB;
        transition: background 0.3s ease;
    }

        .product-list .product-item:hover {
            background-color: #F1F5F9;
        }

    .product-img {
        width: 80px;
