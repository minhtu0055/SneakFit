@model SneakFit.ViewModels.Catalog.TraHang.ReturnViewModel
@using SneakFit.Data.Enums

<div class="section-box">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-arrow-return-left text-primary"></i>
                        Thông tin yêu cầu trả hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Mã yêu cầu:</strong> <span class="badge bg-primary">@Model.Code</span></p>
                            <p><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <p><strong>Cập nhật lần cuối:</strong> @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <p><strong>Lý do trả hàng:</strong> <span class="text-danger">@Model.Reason</span></p>
                            <p><strong>Hình thức hoàn:</strong> <span class="badge bg-success">Chuyển khoản ngân hàng</span></p>
                            @if (!string.IsNullOrEmpty(Model.ShippingCarrier))
                            {
                                <p><strong>Đơn vị vận chuyển:</strong> @Model.ShippingCarrier</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShippingCode))
                            {
                                <p><strong>Mã vận đơn:</strong> <span class="badge bg-info">@Model.ShippingCode</span></p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin đơn hàng (bảng 3 cột) -->
            @{
                var tongThanhToan = Model?.OrderDetails?.Sum(x => x.Price * x.Quantity) ?? 0M;
            }
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="bi bi-receipt text-info"></i>
                        Hoá đơn trả hàng
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Mã hoá đơn</th>
                                    <th>Ngày đặt đơn</th>
                                    <th>Tổng thanh toán</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@(string.IsNullOrEmpty(Model.MaHoaDon) ? Model.OrderId.ToString() : Model.MaHoaDon)</td>
                                    <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@tongThanhToan.ToString("N0") ₫</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle text-info"></i>
                        Trạng thái hiện tại
                    </h5>
                </div>
                <div class="card-body text-center">
                    <span class="status-badge bg-@GetReturnStatusColor(Model.Status) fs-6 px-3 py-2">@GetReturnStatusText(Model.Status)</span>
                    
                    <!-- Timeline trạng thái -->
                    <div class="mt-3">
                        <div class="progress-timeline-vertical">
                            <div class="timeline-step @(Model.Status >= ReturnStatus.ChapNhanDuyetHangHoan ? "completed" : "")">
                                <div class="timeline-icon bg-warning">
                                    <i class="bi bi-check text-white"></i>
                                </div>
                                <div class="timeline-content">
                                    <small class="text-muted">Chấp nhận duyệt hàng hoàn</small>
                                </div>
                            </div>
                            <div class="timeline-step @(Model.Status >= ReturnStatus.LayHangHoan ? "completed" : "")">
                                <div class="timeline-icon bg-info">
                                    <i class="bi bi-check text-white"></i>
                                </div>
                                <div class="timeline-content">
                                    <small class="text-muted">Lấy hàng hoàn</small>
                                </div>
                            </div>
                            <div class="timeline-step @(Model.Status >= ReturnStatus.HoanHang ? "completed" : "")">
                                <div class="timeline-icon bg-primary">
                                    <i class="bi bi-check text-white"></i>
                                </div>
                                <div class="timeline-content">
                                    <small class="text-muted">Hoàn hàng (check hàng hoàn)</small>
                                </div>
                            </div>
                            <div class="timeline-step @(Model.Status >= ReturnStatus.ThanhCong ? "completed" : "")">
                                <div class="timeline-icon bg-success">
                                    <i class="bi bi-check text-white"></i>
                                </div>
                                <div class="timeline-content">
                                    <small class="text-muted">Thành công</small>
                                </div>
                            </div>
                            <div class="timeline-step @(Model.Status == ReturnStatus.TuChoi ? "completed" : "")">
                                <div class="timeline-icon bg-danger">
                                    <i class="bi bi-x text-white"></i>
                                </div>
                                <div class="timeline-content">
                                    <small class="text-muted">Từ chối</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .progress-timeline-vertical {
        position: relative;
        padding-left: 20px;
    }

    .timeline-step {
        position: relative;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .timeline-step.completed {
        opacity: 1;
    }

    .timeline-step::before {
        content: '';
        position: absolute;
        left: -20px;
        top: 8px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #e5e7eb;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #e5e7eb;
    }

    .timeline-step.completed::before {
        background-color: #10b981;
        box-shadow: 0 0 0 2px #10b981;
    }

    .timeline-icon {
        position: absolute;
        left: -26px;
        top: 4px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
    }

    .timeline-content {
        margin-left: 10px;
    }
</style>

@functions {
    public string GetReturnStatusText(ReturnStatus status)
    {
        switch (status)
        {
            case ReturnStatus.ChapNhanDuyetHangHoan:
                return "Chấp nhận duyệt hàng hoàn";
            case ReturnStatus.LayHangHoan:
                return "Lấy hàng hoàn";
            case ReturnStatus.HoanHang:
                return "Hoàn hàng (check hàng hoàn)";
            case ReturnStatus.ThanhCong:
                return "Thành công";
            case ReturnStatus.TuChoi:
                return "Từ chối";
            default:
                return "Không xác định";
        }
    }

    public string GetReturnStatusColor(ReturnStatus status)
    {
        switch (status)
        {
            case ReturnStatus.ChapNhanDuyetHangHoan:
                return "warning";
            case ReturnStatus.LayHangHoan:
                return "info";
            case ReturnStatus.HoanHang:
                return "primary";
            case ReturnStatus.ThanhCong:
                return "success";
            case ReturnStatus.TuChoi:
                return "danger";
            default:
                return "secondary";
        }
    }
}
