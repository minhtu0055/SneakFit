@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.DanhMucSPCTViewModel
@using System.Linq
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentKeyword = ViewBag.Keyword ?? "";
    var currentCategoryId = ViewBag.CategoryId ?? "";
    var currentMinPrice = ViewBag.MinPrice ?? 0;
    var currentMaxPrice = ViewBag.MaxPrice ?? 10000000;
    var currentBrands = new List<Guid>();
    var currentColors = new List<Guid>();
    var currentCategories = new List<Guid>();

    if (ViewBag.SelectedBrands is List<Guid> brands)
    {
        currentBrands = brands;
    }

    if (ViewBag.SelectedColors is List<Guid> colors)
    {
        currentColors = colors;
    }

    if (ViewBag.SelectedCategories is List<Guid> categories)
    {
        currentCategories = categories;
    }
}
<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Sản Phẩm</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Sản Phẩm</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <div class="container">
        <div class="row">

            <div class="col-lg-4 sidebar">

                <div class="widgets-container" style="border-radius: 8px">

                    <!-- Product Categories Widget -->
                    <div class="category-filter-widget widget-item">
                        <h3 class="widget-title">Danh Mục</h3>
                        <div class="category-list">
                            @foreach (var cat in Model.DanhMucs)
                            {
                                <div class="category-item">
                                    <div class="form-check">
                                        <input class="form-check-input category-checkbox" type="checkbox"
                                               id="category@cat.Id" value="@cat.Id"
                                        @(currentCategories.Contains(cat.Id) ? "checked" : "")>
                                        <label class="form-check-label" for="category@cat.Id">
                                            @cat.TenDanhMuc
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!--/Product Categories Widget -->
                    <!-- Pricing Range Widget -->
                    <div class="pricing-range-widget widget-item">
                        <h3 class="widget-title">Khoảng Giá</h3>
                        <div class="price-range-container">
                            <div class="current-range mb-3">
                                <span class="min-price">@currentMinPrice.ToString("N0")đ</span>
                                <span class="max-price float-end">@currentMaxPrice.ToString("N0")đ</span>
                            </div>

                            <div class="range-slider position-relative" style="height: 40px;">
                                <input type="range" id="min-range" class="styled-range position-absolute start-0 w-100 min-range"
                                       min="0" max="10000000" step="10000" value="@currentMinPrice" style="z-index: 2;">
                                <input type="range" id="max-range" class="styled-range position-absolute start-0 w-100 max-range"
                                       min="0" max="10000000" step="10000" value="@currentMaxPrice" style="z-index: 1;">
                            </div>

                            <div class="price-inputs mt-3">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">đ</span>
                                            <input type="number" id="min-price-input" class="form-control min-price-input"
                                                   min="0" max="10000000" step="10000" value="@currentMinPrice"
                                                   title="Giá thấp nhất">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">đ</span>
                                            <input type="number" id="max-price-input" class="form-control max-price-input"
                                                   min="0" max="10000000" step="10000" value="@currentMaxPrice"
                                                   title="Giá cao nhất">
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Nhập giá từ 0đ đến 10.000.000đ
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--/Pricing Range Widget -->
                    <!-- Color Filter Widget -->
                    <div class="color-filter-widget widget-item">
                        <h3 class="widget-title">Màu Sắc</h3>
                        <div class="color-options">
                            @foreach (var color in Model.MauSacs)
                            {
                                <span class="color-circle @(currentColors.Contains(color.Id) ? "selected" : "")"
                                      title="@color.TenMauSac"
                                      data-color="@color.MaMauSac"
                                      data-id="@color.Id"
                                      style="background:@color.MaMauSac"></span>
                            }
                        </div>
                    </div>
                    <!--/Color Filter Widget -->
                    <!-- Brand Filter Widget -->
                    <div class="brand-filter-widget widget-item">
                        <h3 class="widget-title">Thương Hiệu</h3>
                        <div class="brand-list">
                            @foreach (var brand in Model.ThuongHieus)
                            {
                                <div class="brand-item">
                                    <div class="form-check">
                                        <input class="form-check-input brand-checkbox" type="checkbox"
                                               id="brand@brand.Id" value="@brand.Id"
                                        @(currentBrands.Contains(brand.Id) ? "checked" : "")>
                                        <label class="form-check-label" for="brand@brand.Id">
                                            @brand.TenThuongHieu
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!--/Brand Filter Widget -->
                    <!-- Apply Filters Button -->
                    <div class="filter-actions mt-4">
                        <button type="button" class="btn btn-primary w-100 apply-filters-btn">
                            <i class="bi bi-funnel me-2"></i>Áp Dụng Bộ Lọc
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100 mt-2 clear-filters-btn" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
                            <i class="bi bi-x-circle me-2"></i>Xóa Tất Cả
                        </button>
                    </div>

                </div>

            </div>

            <div class="col-lg-8">

                <!-- Enhanced Search Section -->
                <section id="search-section" class="search-section mb-4">
                    <div class="search-container" data-aos="fade-up">
                        <form id="searchForm" asp-action="Index" method="get" class="search-form">
                            <div class="row g-3">
                                @* <div class="col-12 col-md-8"> *@
                                <div class="col-12">
                                    <div class="search-input-group">
                                        <div class="input-group">
                                            <span class="input-group-text search-icon">
                                                <i class="bi bi-search"></i>
                                            </span>
                                            <input type="text" name="tuKhoa" value="@currentKeyword"
                                                   class="form-control search-input"
                                                   placeholder="Tìm sản phẩm theo tên">
                                            <button class="btn btn-primary search-btn" type="submit">
                                                <i class="bi bi-search me-1"></i>Tìm Kiếm
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                @* <div class="col-12 col-md-4">
                                    <div class="search-options">
                                        <select class="form-select" name="sortBy" id="sortBy">
                                            <option value="">Sắp xếp theo</option>
                                            <option value="name_asc">Tên A-Z</option>
                                            <option value="name_desc">Tên Z-A</option>
                                            <option value="price_asc">Giá tăng dần</option>
                                            <option value="price_desc">Giá giảm dần</option>
                                            <option value="newest">Mới nhất</option>
                                            <option value="popular">Phổ biến</option>
                                        </select>
                                    </div>
                                </div> *@
                            </div>

                            <!-- Hidden inputs for filters -->
                            <input type="hidden" name="categoryId" id="categoryIdInput" value="@currentCategoryId">
                            <input type="hidden" name="minPrice" id="minPriceInput" value="@currentMinPrice">
                            <input type="hidden" name="maxPrice" id="maxPriceInput" value="@currentMaxPrice">
                            <input type="hidden" name="selectedCategories" id="selectedCategoriesInput" value="@string.Join(",", currentCategories)">
                            <input type="hidden" name="selectedBrands" id="selectedBrandsInput" value="@string.Join(",", currentBrands)">
                            <input type="hidden" name="selectedColors" id="selectedColorsInput" value="@string.Join(",", currentColors)">
                        </form>
                    </div>
                </section>

                <!-- Active Filters Display -->
                @if (!string.IsNullOrEmpty(currentKeyword) || currentCategories.Count > 0 || currentBrands.Count > 0 || currentColors.Count > 0 || (currentMinPrice > 0 || currentMaxPrice < 10000000))
                {
                    <section id="active-filters" class="active-filters-section mb-4" data-aos="fade-up" data-aos-delay="100">
                        <div class="active-filters-container">
                            <div class="d-flex align-items-center justify-content-between">
                                <h6 class="active-filter-label mb-0">
                                    <i class="bi bi-funnel-fill me-2"></i>Bộ lọc đang áp dụng:
                                </h6>
                                <button type="button" class="btn btn-sm btn-outline-danger clear-all-filters-btn" style="font-size: 0.875rem; padding: 0.375rem 0.75rem;">
                                    <i class="bi bi-x-circle me-1"></i>Xóa tất cả
                                </button>
                            </div>
                            <div class="filter-tags mt-2">
                                @if (!string.IsNullOrEmpty(currentKeyword))
                                {
                                    <span class="filter-tag">
                                        <i class="bi bi-search me-1"></i>"@currentKeyword"
                                        <button class="filter-remove" data-type="keyword">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                                @if (currentCategoryId != "")
                                {
                                    var category = Model.DanhMucs.FirstOrDefault(c => c.Id.ToString() == currentCategoryId);
                                    if (category != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-tag me-1"></i>@category.TenDanhMuc
                                            <button class="filter-remove" data-type="category" data-id="@category.Id">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                                @foreach (var categoryId in currentCategories)
                                {
                                    var category = Model.DanhMucs.FirstOrDefault(c => c.Id == categoryId);
                                    if (category != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-tag me-1"></i>@category.TenDanhMuc
                                            <button class="filter-remove" data-type="category" data-id="@categoryId">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                                @if ((currentMinPrice > 0 && currentMinPrice != 0) || (currentMaxPrice < 10000000 && currentMaxPrice != 10000000))
                                {
                                    <span class="filter-tag">
                                        <i class="bi bi-currency-dollar me-1"></i>@currentMinPrice.ToString("N0")đ - @currentMaxPrice.ToString("N0")đ
                                        <button class="filter-remove" data-type="price" data-id="">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                                @foreach (var brandId in currentBrands)
                                {
                                    var brand = Model.ThuongHieus.FirstOrDefault(b => b.Id == brandId);
                                    if (brand != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-shop me-1"></i>@brand.TenThuongHieu
                                            <button class="filter-remove" data-type="brand" data-id="@brandId">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                                @foreach (var colorId in currentColors)
                                {
                                    var color = Model.MauSacs.FirstOrDefault(c => c.Id == colorId);
                                    if (color != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-palette me-1"></i>@color.TenMauSac
                                            <button class="filter-remove" data-type="color" data-id="@colorId">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </section>
                }

                <!-- Product List Container -->
                <div id="product-list-container">
                    @await Html.PartialAsync("_ProductList", Model)
                </div>
            </div>

        </div>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-color/2.1.2/jquery.color.min.js"></script>
    <link rel="stylesheet" href="~/assets/css/Products.css" />

    <script>

           // ===== MODAL FUNCTIONS =====
        let currentProductId = null;
        let selectedColorId = null;
        let selectedSizeId = null;
        let productSpctData = [];
        let listMauCoSPCT = [];
        let listSizeCoSPCT = [];

        // Mở modal chọn sản phẩm
        function openProductModal(productId, productName) {
            console.log('Opening modal for product:', productId, productName);

            // Reset modal state
            selectedColorId = null;
            selectedSizeId = null;
            $('#quantityInput').val(1);

            currentProductId = productId;
            $('#modalProductName').text(productName);

            // Lấy ảnh sản phẩm
               // Lấy ảnh sản phẩm
            const productBox = $(`[onclick*="openProductModal('${productId}'"]`).closest('.product-box');
            const productImage = productBox.find('.product-thumb .img img').attr('src');
            $('#modalProductImage').attr('src', productImage);

            // Hiển thị modal trước
            try {
                const modal = new bootstrap.Modal(document.getElementById('productModal'), {
                    backdrop: true,
                    keyboard: true,
                    focus: true
                });
                modal.show();
                console.log('Modal opened successfully');
            } catch (error) {
                console.error('Error opening modal:', error);
                // Fallback cho jQuery
                $('#productModal').modal({
                    backdrop: true,
                    keyboard: true,
                    show: true
                });
            }

            // Load SPCT data từ API
            loadProductSpctDataFromAPI(productId);
        }

        // Load dữ liệu SPCT cho sản phẩm từ API
        function loadProductSpctDataFromAPI(productId) {
            // Hiển thị loading
            $('#colorOptions').html('<p class="text-muted">Đang tải...</p>');
            $('#sizeOptions').html('<p class="text-muted">Đang tải...</p>');

            $.ajax({
                url: '@Url.Action("GetProductModalData", "Home")',
                type: 'GET',
                data: { productId: productId },
                success: function(response) {
                    console.log('API Response:', response);

                    if (response.success) {
                        // Lưu dữ liệu
                        productSpctData = response.spctList;
                        console.log('productSpctData saved:', productSpctData);

                        // Chuẩn hóa để fill tất cả màu/kích thước
                        listMauCoSPCT = productSpctData.map(x => x.mauSacId);
                        listSizeCoSPCT = productSpctData.map(x => x.kichThuocId);

                        console.log('listMauCoSPCT:', listMauCoSPCT);
                        console.log('listSizeCoSPCT:', listSizeCoSPCT);

                        // Render color options
                        renderColorOptionsFromAPI(response.colors, response.spctList);

                        // Render size options
                        renderSizeOptionsFromAPI(response.sizes, response.spctList);

                        // Khởi tạo UI
                        updateStatusShowHide();
                        updateUI();
                        // Thêm dòng này để cập nhật mô tả
                        const motaFromProduct = (response.product?.mota || '').trim();
                        const motaFromSpct = (response.spctList?.find(x => x.moTa)?.moTa || '').trim();
                        const motaToShow = motaFromProduct || motaFromSpct;
                        $('#mo-ta-text').text(motaToShow || 'Không có mô tả');

                        console.log('Modal data loaded successfully');
                    } else {
                        console.error('API Error:', response.message);
                        $('#colorOptions').html('<p class="text-danger">Lỗi: ' + response.message + '</p>');
                        $('#sizeOptions').html('<p class="text-danger">Lỗi: ' + response.message + '</p>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', error);
                    $('#colorOptions').html('<p class="text-danger">Lỗi kết nối</p>');
                    $('#sizeOptions').html('<p class="text-danger">Lỗi kết nối</p>');
                }
            });
        }

        // Render color options từ API data
        function renderColorOptionsFromAPI(colors, spctList) {
            try {
                const colorOptions = $('#colorOptions');
                colorOptions.empty();

                console.log('Available colors from API:', colors);
                console.log('listMauCoSPCT:', listMauCoSPCT);

                if (!colors || colors.length === 0) {
                    colorOptions.html('<p class="text-muted">Không có màu sắc</p>');
                    return;
                }

                colors.forEach((color, index) => {
                    console.log('Rendering color:', color);
                    var hasSPCT = listMauCoSPCT.includes(color.id);
                    console.log(`Color ${color.name} (${color.id}) has SPCT:`, hasSPCT);

                    const colorBtn = $(`
                        <button type="button"
                                class="color-swatch"
                                title="${color.name}"
                                data-color-id="${color.id}"
                                data-color-hex="${color.hex}"
                        ${hasSPCT ? "" : "disabled"}
                                style="background:${color.hex}; border:2.5px solid #ddd; opacity:${hasSPCT ? "1" : "0.4"};
                                       cursor:${hasSPCT ? "pointer" : "not-allowed"}; width:48px; height:48px; border-radius:50%; text-align:center; margin-bottom:20px;">
                            <span class="color-name">
                                ${color.name}
                            </span>
                        </button>
                    `);
                    colorOptions.append(colorBtn);
                });
            } catch (error) {
                console.error('Error rendering colors from API:', error);
                $('#colorOptions').html('<p class="text-danger">Lỗi hiển thị màu sắc</p>');
            }
        }

        // Helper function để lấy màu hex từ tên màu
        function getColorHex(colorName) {
            const colorMap = {
                'Đen': '#000000',
                'Trắng': '#FFFFFF',
                'Đỏ': '#FF0000',
                'Xanh': '#0000FF',
                'Xanh lá': '#00FF00',
                'Vàng': '#FFFF00',
                'Cam': '#FFA500',
                'Tím': '#800080',
                'Hồng': '#FFC0CB',
                'Nâu': '#A52A2A',
                'Xám': '#808080'
            };
            return colorMap[colorName] || '#CCCCCC';
        }

        // Render size options từ API data
        function renderSizeOptionsFromAPI(sizes, spctList) {
            try {
                const sizeOptions = $('#sizeOptions');
                sizeOptions.empty();

                console.log('Available sizes from API:', sizes);
                console.log('listSizeCoSPCT:', listSizeCoSPCT);

                if (!sizes || sizes.length === 0) {
                    sizeOptions.html('<p class="text-muted">Không có kích thước</p>');
                    return;
                }

                sizes.forEach((size, index) => {
                    console.log('Rendering size:', size);
                    var hasSPCT = listSizeCoSPCT.includes(size.id);
                    console.log(`Size ${size.name} (${size.id}) has SPCT:`, hasSPCT);

                    const sizeBtn = $(`
                        <button type="button"
                                class="size-box"
                                data-size-id="${size.id}"
                        ${hasSPCT ? "" : "disabled"}
                                style="padding:8px 18px; border:2px solid #ddd; border-radius:7px; background:#fff;
                                       font-weight:500; font-size:15px; opacity:${hasSPCT ? "1" : "0.5"}; cursor:${hasSPCT ? "pointer" : "not-allowed"};">
                            ${size.name}
                        </button>
                    `);
                    sizeOptions.append(sizeBtn);
                });
            } catch (error) {
                console.error('Error rendering sizes from API:', error);
                $('#sizeOptions').html('<p class="text-danger">Lỗi hiển thị kích thước</p>');
            }
        }

        // Hàm tìm giá nhỏ nhất từ tất cả SPCT (có tính khuyến mãi)
        function getGiaThapNhat() {
            if (!productSpctData || productSpctData.length === 0) return 0;

            let giaList = productSpctData
                .filter(x => Number(x.gia) > 0)
                .map(x => {
                    // Ưu tiên giá khuyến mãi nếu có
                    if (x.giaKhuyenMai && x.khuyenMaiPhanTram > 0 && x.giaKhuyenMai < x.giaGoc) {
                        return Number(x.giaKhuyenMai);
                    } else {
                        return Number(x.giaGoc || x.gia);
                    }
                });

            if (giaList.length === 0) return 0;
            return Math.min(...giaList);
        }

        // Hàm cập nhật UI và giá
        function updateUI() {
            console.log('updateUI được gọi');
            console.log('selectedColorId:', selectedColorId);
            console.log('selectedSizeId:', selectedSizeId);

            // Reset active + border
            $('.color-grid .color-swatch').removeClass('active').css('border-color', '#ddd');
            $('.size-grid .size-box').removeClass('active').css('border-color', '#ddd').css('background', '#fff');

            // Đánh dấu active cho màu và size đã chọn
            if (selectedColorId) {
                $('.color-grid .color-swatch[data-color-id="' + selectedColorId + '"]')
                    .addClass('active').css('border-color', '#1976d2');
            }
            if (selectedSizeId) {
                $('.size-grid .size-box[data-size-id="' + selectedSizeId + '"]')
                    .addClass('active').css('border-color', '#ffa502').css('background', '#fffbe7');
            }

            // Tìm SPCT phù hợp
            let spct = null;
            if (selectedColorId && selectedSizeId) {
                spct = productSpctData.find(x => x.mauSacId == selectedColorId && x.kichThuocId == selectedSizeId);
                console.log('SPCT tìm thấy:', spct);
            }

            // Thêm đoạn này để cập nhật thông tin Thương hiệu, Chất liệu, Đế giày
if (spct) {
    $('#thuong-hieu-text').text(spct.tenThuongHieu || 'Không có dữ liệu');
    $('#chat-lieu-text').text(spct.tenChatLieu || 'Không có dữ liệu');
    $('#de-giay-text').text(spct.tenDeGiay || 'Không có dữ liệu');
} else {
    // Khi chưa chọn đủ màu sắc và size, hiển thị thông tin của SPCT đầu tiên (nếu có)
    if (productSpctData && productSpctData.length > 0) {
        const firstSpct = productSpctData[0];
        $('#thuong-hieu-text').text(firstSpct.tenThuongHieu || 'Không có dữ liệu');
        $('#chat-lieu-text').text(firstSpct.tenChatLieu || 'Không có dữ liệu');
        $('#de-giay-text').text(firstSpct.tenDeGiay || 'Không có dữ liệu');
    } else {
        $('#thuong-hieu-text').text('Vui lòng chọn màu sắc và size');
        $('#chat-lieu-text').text('Vui lòng chọn màu sắc và size');
        $('#de-giay-text').text('Vui lòng chọn màu sắc và size');
    }
}

            // Update giá bán:
            if (spct) {
                console.log('SPCT có khuyến mãi:', spct.giaKhuyenMai, spct.khuyenMaiPhanTram, spct.giaGoc);

                // Hiển thị giá gốc nếu có KM
                if (spct.giaKhuyenMai && spct.khuyenMaiPhanTram > 0 && spct.giaKhuyenMai < spct.giaGoc) {
                    $('#GiaGoc').text(spct.giaGoc.toLocaleString('vi-VN') + ' đ').show();
                    $('#GiaApDungKhuyenMai').text(spct.giaKhuyenMai.toLocaleString('vi-VN') + ' đ').show();
                    $('#PhanTramGiamGia').text('-' + spct.khuyenMaiPhanTram + '%').show();
                } else {
                    $('#GiaGoc').hide();
                    $('#PhanTramGiamGia').hide();
                    $('#GiaApDungKhuyenMai').text(spct.giaGoc.toLocaleString('vi-VN') + ' đ').show();
                }
            } else {
                // Trường hợp chưa chọn đủ - hiện giá thấp nhất
                let giaThapNhat = getGiaThapNhat();
                console.log('Giá thấp nhất:', giaThapNhat);

                if (giaThapNhat > 0) {
                    $('#GiaGoc').hide();
                    $('#PhanTramGiamGia').hide();
                    $('#GiaApDungKhuyenMai').text(giaThapNhat.toLocaleString('vi-VN') + ' đ').show();
                } else {
                    $('#GiaGoc').hide();
                    $('#GiaApDungKhuyenMai').text('').hide();
                    $('#PhanTramGiamGia').hide();
                }
            }

            // Cập nhật form và số lượng
            if (spct) {
                $('#soLuongGroup').show();
                $('#quantityInput').attr('min', 1).attr('max', spct.soLuong || 1).val(1);
                $('#cartQuantityInput').val(1);
                $('#selectedSpctId').val(spct.id);
                $('#cartForm').show();
                $('#soLuongTon').text(`Còn: ${spct.soLuong ?? 0} sản phẩm`);
                updateQuantityUI();
            } else {
                $('#soLuongGroup').hide();
                $('#cartForm').hide();
                $('#soLuongTon').text('');
            }
        }

        // Check ngưng hoạt động thì ẩn những màu sắc và kích thước của spct đã ngưng hoạt động
        function updateStatusShowHide() {
            console.log('updateStatusShowHide được gọi');
            console.log('selectedColorId:', selectedColorId);
            console.log('selectedSizeId:', selectedSizeId);
            console.log('productSpctData:', productSpctData);

            // Reset trạng thái enable/disable
            $('.color-grid .color-swatch').removeClass('disabled').css('opacity', '1').prop('disabled', false);
            $('.size-grid .size-box').removeClass('disabled').css('opacity', '1').prop('disabled', false);

            // Nếu đã chọn size => chỉ enable màu có SPCT active
            if (selectedSizeId) {
                let mauSacCoSPCT = productSpctData
                    .filter(x => x.kichThuocId == selectedSizeId && x.trangThai && x.soLuong > 0)
                    .map(x => x.mauSacId);

                console.log('Màu sắc có SPCT cho size đã chọn:', mauSacCoSPCT);

                $('.color-grid .color-swatch').each(function() {
                    let id = $(this).data('color-id');
                    if (!mauSacCoSPCT.includes(id)) {
                        $(this).addClass('disabled').css('opacity', '0.5').prop('disabled', true);
                    }
                });
            }

            // Nếu đã chọn màu => chỉ enable size có SPCT active
            if (selectedColorId) {
                let sizeCoSPCT = productSpctData
                    .filter(x => x.mauSacId == selectedColorId && x.trangThai && x.soLuong > 0)
                    .map(x => x.kichThuocId);

                console.log('Size có SPCT cho màu đã chọn:', sizeCoSPCT);

                $('.size-grid .size-box').each(function() {
                    let id = $(this).data('size-id');
                    if (!sizeCoSPCT.includes(id)) {
                        $(this).addClass('disabled').css('opacity', '0.5').prop('disabled', true);
                    }
                });
            }
        }

        // Sự kiện chọn màu
        $(document).on('click', '.color-grid .color-swatch:not([disabled])', function () {
            var id = $(this).data('color-id');
            console.log('Chọn màu:', id);

            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedColorId === id) {
                selectedColorId = null;
            } else {
                selectedColorId = id;
            }

            console.log('selectedColorId sau khi chọn:', selectedColorId);

            // Reset size nếu chọn màu mới
            if (selectedColorId && selectedSizeId) {
                // Kiểm tra xem size hiện tại có hợp với màu mới không
                let spctExists = productSpctData.find(x => x.mauSacId == selectedColorId && x.kichThuocId == selectedSizeId);
                if (!spctExists) {
                    selectedSizeId = null;
                    console.log('Reset selectedSizeId vì không hợp với màu mới');
