        // Sự kiện chọn size
        $(document).on('click', '.size-grid .size-box:not([disabled])', function () {
            var id = $(this).data('size-id');
            console.log('Chọn size:', id);

            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedSizeId === id) {
                selectedSizeId = null;
            } else {
                selectedSizeId = id;
            }

            console.log('selectedSizeId sau khi chọn:', selectedSizeId);

            // Reset màu nếu chọn size mới
            if (selectedColorId && selectedSizeId) {
                // Kiểm tra xem màu hiện tại có hợp với size mới không
                let spctExists = productSpctData.find(x => x.mauSacId == selectedColorId && x.kichThuocId == selectedSizeId);
                if (!spctExists) {
                    selectedColorId = null;
                    console.log('Reset selectedColorId vì không hợp với size mới');
                }
