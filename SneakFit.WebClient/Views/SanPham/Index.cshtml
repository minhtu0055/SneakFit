        $(function () {
            // Khởi tạo các vòng tròn màu sắc
            $('.color-circle').each(function () {
                var color = $(this).data('color');
                $(this).css('background-color', $.Color(color));
            });

            // Chọn màu sắc
            $('.color-circle').click(function () {
                $(this).toggleClass('selected');
                updateSelectedColors();
            });

            // Chọn thương hiệu
            $('.brand-checkbox').change(function () {
                updateSelectedBrands();
            });

            // Chọn danh mục
            $('.category-checkbox').change(function () {
                updateSelectedCategories();
            });

            // Thanh trượt khoảng giá
            const minRange = $('.min-range');
            const maxRange = $('.max-range');
            const minPriceInput = $('.min-price-input');
            const maxPriceInput = $('.max-price-input');
            const minPriceDisplay = $('.min-price');
            const maxPriceDisplay = $('.max-price');

            // Validation cho input giá
            function validatePriceInput(input, isMin = true) {
                let value = parseInt(input.value) || 0;
                const min = parseInt(input.min);
                const max = parseInt(input.max);

                // Đảm bảo giá trị trong khoảng cho phép
                value = Math.max(min, Math.min(max, value));

                // Đảm bảo giá trị hợp lệ
                if (isNaN(value) || value < 0) {
                    value = 0;
                }

                input.value = value;
                return value;
            }

            // Cập nhật hiển thị giá
            function updatePriceDisplay() {
                const minPrice = parseInt($('#min-price-input').val()) || 0;
                const maxPrice = parseInt($('#max-price-input').val()) || 10000000;

                // Cập nhật slider
                $('#min-range').val(minPrice);
                $('#max-range').val(maxPrice);

                // Cập nhật hiển thị
                $('.min-price').text(minPrice.toLocaleString('vi-VN') + 'đ');
                $('.max-price').text(maxPrice.toLocaleString('vi-VN') + 'đ');
            }

            // Xử lý sự kiện thay đổi giá
            $('#min-price-input, #max-price-input').on('input', function () {
                const isMin = $(this).attr('id') === 'min-price-input';
                const value = validatePriceInput(this, isMin);

                if (isMin) {
                    // Đảm bảo giá min không vượt quá giá max
                    const maxPrice = parseInt($('#max-price-input').val()) || 10000000;
                    if (value > maxPrice) {
                        $('#max-price-input').val(value);
                    }
                } else {
                    // Đảm bảo giá max không thấp hơn giá min
                    const minPrice = parseInt($('#min-price-input').val()) || 0;
                    if (value < minPrice) {
                        $('#min-price-input').val(value);
                    }
                }

                updatePriceDisplay();
            });

            // Xử lý sự kiện blur (khi rời khỏi input)
            $('#min-price-input, #max-price-input').on('blur', function () {
                validatePriceInput(this, $(this).attr('id') === 'min-price-input');
                updatePriceDisplay();
            });

            // Xử lý sự kiện cho slider
            $('#min-range, #max-range').on('input', function () {
                const isMin = $(this).attr('id') === 'min-range';
                const value = parseInt($(this).val()) || 0;

                if (isMin) {
                    // Đảm bảo giá min không vượt quá giá max
                    const maxPrice = parseInt($('#max-range').val()) || 10000000;
                    if (value > maxPrice) {
                        $('#max-range').val(value);
                        $('#max-price-input').val(value);
                    }
                    $('#min-price-input').val(value);
                } else {
                    // Đảm bảo giá max không thấp hơn giá min
                    const minPrice = parseInt($('#min-range').val()) || 0;
                    if (value < minPrice) {
                        $('#min-range').val(value);
                        $('#min-price-input').val(value);
                    }
                    $('#max-price-input').val(value);
                }

                updatePriceDisplay();
            });

            // Cập nhật màu sắc đã chọn
            function updateSelectedColors() {
                const selectedColors = [];
                $('.color-circle.selected').each(function() {
                    selectedColors.push($(this).data('id'));
                });
                $('#selectedColorsInput').val(selectedColors.join(','));
            }

            // Cập nhật thương hiệu đã chọn
            function updateSelectedBrands() {
                const selectedBrands = [];
                $('.brand-checkbox:checked').each(function() {
                    selectedBrands.push($(this).val());
                });
                $('#selectedBrandsInput').val(selectedBrands.join(','));
            }

            // Cập nhật danh mục đã chọn
            function updateSelectedCategories() {
                const selectedCategories = [];
                $('.category-checkbox:checked').each(function() {
                    selectedCategories.push($(this).val());
                });
                $('#selectedCategoriesInput').val(selectedCategories.join(','));
                console.log('Selected categories:', selectedCategories);
                console.log('Selected categories input value:', $('#selectedCategoriesInput').val());
            }

            // Áp dụng bộ lọc
            $('.apply-filters-btn').click(function() {
                updateSelectedColors();
                updateSelectedBrands();
                updateSelectedCategories();
                loadFilteredProducts();
            });

            // Xóa tất cả bộ lọc
            $('.clear-filters-btn, .clear-all-filters-btn').click(function() {
                // Đặt lại tất cả input form
                $('input[name="tuKhoa"]').val('');
                $('.category-checkbox').prop('checked', false);
                $('.color-circle').removeClass('selected');
                $('.brand-checkbox').prop('checked', false);
                $('.min-range').val(0);
                $('.max-range').val(10000000);
                $('#min-price-input').val(0);
                $('#max-price-input').val(10000000);
                updatePriceDisplay();
                updateSelectedColors();
                updateSelectedBrands();
                updateSelectedCategories();
                loadFilteredProducts();
                updateSliderBackground();
            });

            // Xóa từng tag bộ lọc riêng lẻ
            $('.filter-remove').click(function() {
                const type = $(this).data('type');
                const id = $(this).data('id');

                switch(type) {
                    case 'keyword':
                        $('input[name="tuKhoa"]').val('');
                        break;
                    case 'category':
                        if (id) {
                            $(`input[value="${id}"]`).prop('checked', false);
                        } else {
                            // Xóa tất cả checkbox danh mục
                            $('.category-checkbox').prop('checked', false);
                        }
                        break;
                    case 'price':
                        $('.min-range').val(0);
                        $('.max-range').val(10000000);
                        $('#min-price-input').val(0);
                        $('#max-price-input').val(10000000);
                        updatePriceDisplay();
                        break;
                    case 'brand':
                        $(`input[value="${id}"]`).prop('checked', false);
                        break;
                    case 'color':
                        $(`.color-circle[data-id="${id}"]`).removeClass('selected');
                        break;
                }

                updateSelectedColors();
                updateSelectedBrands();
                updateSelectedCategories();
                // Đảm bảo cập nhật hiển thị giá trước khi gọi AJAX
                updatePriceDisplay();

                // Cập nhật lại tag bộ lọc trước khi gọi AJAX
                updateActiveFilters();

                loadFilteredProducts();           // gọi lại AJAX
                updateSliderBackground();
            });

            // Chuyển đổi chế độ xem
            $('.view-btn').click(function () {
                $('.view-btn').removeClass('active');
                $(this).addClass('active');

                const view = $(this).data('view');
                const productGrid = $('#product-grid');

                if (view === 'list') {
                    productGrid.addClass('list-view');
                    // Lưu trạng thái vào localStorage
                    localStorage.setItem('productViewMode', 'list');
                } else {
                    productGrid.removeClass('list-view');
                    // Lưu trạng thái vào localStorage
                    localStorage.setItem('productViewMode', 'grid');
                }
            });

            // Khôi phục trạng thái view khi tải trang
            function restoreViewMode() {
                const savedViewMode = localStorage.getItem('productViewMode');
                if (savedViewMode === 'list') {
                    $('#product-grid').addClass('list-view');
                    $('.view-btn[data-view="list"]').addClass('active');
                    $('.view-btn[data-view="grid"]').removeClass('active');
                } else {
                    $('#product-grid').removeClass('list-view');
                    $('.view-btn[data-view="grid"]').addClass('active');
                    $('.view-btn[data-view="list"]').removeClass('active');
                }
            }

            // Gọi hàm khôi phục khi trang được tải
            restoreViewMode();

            // Tải sản phẩm đã lọc qua AJAX
            function loadFilteredProducts(pageIndex = 1) {
                const minPrice = parseInt($('#min-price-input').val()) || 0;
                const maxPrice = parseInt($('#max-price-input').val()) || 10000000;

                const formData = {
                    tuKhoa: $('input[name="tuKhoa"]').val(),
                    selectedCategories: $('#selectedCategoriesInput').val(),
                    selectedBrands: $('#selectedBrandsInput').val(),
                    selectedColors: $('#selectedColorsInput').val(),
                    giaThapNhat: minPrice > 0 ? minPrice : null,
                    giaCaoNhat: maxPrice < 10000000 ? maxPrice : null,
                    sortBy: $('#sortBy').val(),
                    pageIndex: pageIndex
                };

                // Hiển thị chỉ báo đang tải
                $('#product-list-container').html('<div class="text-center py-5"><i class="bi bi-arrow-clockwise spin display-4"></i><p class="mt-3">Đang tải sản phẩm...</p></div>');

                // Ghi log debug
                console.log('Sending filter data:', formData);
                console.log('Selected categories:', formData.selectedCategories);
                console.log('Selected brands:', formData.selectedBrands);
                console.log('Selected colors:', formData.selectedColors);

                $.ajax({
                    url: '@Url.Action("GetFilteredProducts", "SanPham")',
                    type: 'GET',
                    data: formData,
                    success: function(response) {
                        console.log('Filter response received');
                        $('#product-list-container').html(response);
                        updateActiveFilters();
                        reinitializeEventHandlers();
                    },
                    error: function(xhr, status, error) {
                        console.error('Filter error:', error);
                        console.error('Response text:', xhr.responseText);
                        $('#product-list-container').html('<div class="text-center py-5"><i class="bi bi-exclamation-triangle display-4 text-danger"></i><p class="mt-3 text-danger">Có lỗi xảy ra khi tải sản phẩm</p><p class="text-muted">Chi tiết: ' + error + '</p></div>');
                    }
                });
            }

            // Cập nhật hiển thị bộ lọc đang áp dụng
            function updateActiveFilters() {
                const keyword = $('input[name="tuKhoa"]').val();
                const selectedCategories = $('#selectedCategoriesInput').val().split(',');
                const selectedBrands = $('#selectedBrandsInput').val().split(',');
                const selectedColors = $('#selectedColorsInput').val().split(',');
                const minPrice = $('#min-price-input').val();
                const maxPrice = $('#max-price-input').val();

                let hasActiveFilters = false;
                let filterHtml = '';

                if (keyword) {
                    hasActiveFilters = true;
                    filterHtml += `<span class="filter-tag">
                        <i class="bi bi-search me-1"></i>"${keyword}"
                        <button class="filter-remove" data-type="keyword">
                            <i class="bi bi-x"></i>
                        </button>
                    </span>`;
                }

                if (selectedCategories[0]) {
                    hasActiveFilters = true;
                    selectedCategories.forEach(id => {
                        if (id) {
                            var category = @Html.Raw(Json.Serialize(Model.DanhMucs));
                            var categoryName = category.find(c => c.id == id).tenDanhMuc;
                            filterHtml += `<span class="filter-tag">
                                <i class="bi bi-tag me-1"></i>${categoryName}
                                <button class="filter-remove" data-type="category" data-id="${id}">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                        }
                    });
                }

                if (selectedBrands[0]) {
                    hasActiveFilters = true;
                    selectedBrands.forEach(id => {
                        if (id) {
                            var brand = @Html.Raw(Json.Serialize(Model.ThuongHieus));
                            var brandName = brand.find(b => b.id == id).tenThuongHieu;
                            filterHtml += `<span class="filter-tag">
                                <i class="bi bi-shop me-1"></i>${brandName}
                                <button class="filter-remove" data-type="brand" data-id="${id}">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                        }
                    });
                }

                if (selectedColors[0]) {
                    hasActiveFilters = true;
                    selectedColors.forEach(id => {
                        if (id) {
                            const colorName = $(`.color-circle[data-id="${id}"]`).attr('title');
                            filterHtml += `<span class="filter-tag">
                                <i class="bi bi-palette me-1"></i>${colorName}
                                <button class="filter-remove" data-type="color" data-id="${id}">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                        }
                    });
                }

                if (parseInt(minPrice) > 0 || parseInt(maxPrice) < 10000000) {
                    hasActiveFilters = true;
                    const minPriceFormatted = parseInt(minPrice).toLocaleString();
                    const maxPriceFormatted = parseInt(maxPrice).toLocaleString();
                    filterHtml += `<span class="filter-tag">
                                <i class="bi bi-currency-dollar me-1"></i>${minPriceFormatted}đ - ${maxPriceFormatted}đ
                                <button class="filter-remove" data-type="price" data-id="">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                }

                if (hasActiveFilters) {
                    if ($('#active-filters').length === 0) {
                        const activeFiltersHtml = `
                            <section id="active-filters" class="active-filters-section mb-4" data-aos="fade-up" data-aos-delay="100">
                                <div class="active-filters-container">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h6 class="active-filter-label mb-0">
                                            <i class="bi bi-funnel-fill me-2"></i>Bộ lọc đang áp dụng:
                                        </h6>
                                        <button type="button" class="btn btn-sm btn-outline-danger clear-all-filters-btn">
                                            <i class="bi bi-x-circle me-1"></i>Xóa tất cả
                                        </button>
                                    </div>
                                    <div class="filter-tags mt-2">
                                        ${filterHtml}
                                    </div>
                                </div>
                            </section>`;
                        $('#search-section').after(activeFiltersHtml);
                    } else {
                        $('#active-filters .filter-tags').html(filterHtml);
                    }
                } else {
                    $('#active-filters').remove();
                }
            }

            // Khởi tạo lại các event handlers sau khi tải AJAX
            function reinitializeEventHandlers() {
                // Khởi tạo lại chuyển đổi chế độ xem
                $('.view-btn').click(function() {
                    $('.view-btn').removeClass('active');
                    $(this).addClass('active');

                    const view = $(this).data('view');
                    if (view === 'list') {
                        $('.product-box').addClass('list-view');
                    } else {
                        $('.product-box').removeClass('list-view');
                    }
                });

                // Khởi tạo lại phân trang
                $('.page-link').click(function(e) {
                    e.preventDefault();
                    const page = $(this).data('page');
                    if (page) {
                        loadFilteredProducts(page);
                    }
                });

                // Khởi tạo lại các nút xóa bộ lọc
                $('.filter-remove').click(function() {
                    const type = $(this).data('type');
                    const id = $(this).data('id');

                    switch(type) {
                        case 'keyword':
                            $('input[name="tuKhoa"]').val('');
                            break;
                        case 'category':
                            if (id) {
                                $(`input[id="category${id}"]`).prop('checked', false);
                            } else {
                                // Xóa tất cả checkbox danh mục
                                $('.category-checkbox').prop('checked', false);
                            }
                            break;
                        case 'price':
                            $('.min-range').val(0);
                            $('.max-range').val(10000000);
                            $('#min-price-input').val(0);
                            $('#max-price-input').val(10000000);
                            updatePriceDisplay();
                            break;
                        case 'brand':
                            $(`input[value="${id}"]`).prop('checked', false);
                            break;
                        case 'color':
                            $(`.color-circle[data-id="${id}"]`).removeClass('selected');
                            break;
                    }

                    updateSelectedColors();
                    updateSelectedBrands();
                    updateSelectedCategories();

                    // Đảm bảo cập nhật hiển thị giá trước khi gọi AJAX
                    updatePriceDisplay();

                    // Cập nhật lại tag bộ lọc trước khi gọi AJAX
                    updateActiveFilters();
                    loadFilteredProducts();
                    updateSliderBackground();
                });

                // Khởi tạo lại xóa tất cả bộ lọc
                $('.clear-all-filters-btn').click(function() {
                    $('input[name="tuKhoa"]').val('');
                    $('.category-checkbox').prop('checked', false);
                    $('.color-circle').removeClass('selected');
                    $('.brand-checkbox').prop('checked', false);
                    $('.min-range').val(0);
                    $('.max-range').val(10000000);
                    $('#min-price-input').val(0);
                    $('#max-price-input').val(10000000);
                    updatePriceDisplay();
                    updateSelectedColors();
                    updateSelectedBrands();
                    updateSelectedCategories();
                    loadFilteredProducts();
                    updateSliderBackground();
                });
            }

            // Khởi tạo hiển thị giá
            updatePriceDisplay();

            // Cập nhật nền của thanh trượt
            function updateSliderBackground() {
                const min = parseInt($('.min-range').attr('min'));
                const max = parseInt($('.max-range').attr('max'));

                const minVal = parseInt($('.min-range').val());
                const maxVal = parseInt($('.max-range').val());

                const range = max - min;
                const minPercent = ((minVal - min) / range) * 100;
                const maxPercent = ((maxVal - min) / range) * 100;

                const gradient = `linear-gradient(to right,
                            #ddd ${minPercent}%,
                            #007bff ${minPercent}%,
                            #007bff ${maxPercent}%,
                            #ddd ${maxPercent}%)`;

                $('.range-slider input[type="range"]').css('background', gradient);
            }

            // Gọi hàm mỗi khi giá thay đổi
            $('.min-range, .max-range').on('input change', function () {
                updateSliderBackground();
            });

            // Gọi khi trang load
            $(document).ready(function () {
                updateSliderBackground();
            });
        });
    </script>
}

