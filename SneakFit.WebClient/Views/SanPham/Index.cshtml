@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.DanhMucSPCTViewModel
@using System.Linq
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentKeyword = ViewBag.Keyword ?? "";
    var currentCategoryId = ViewBag.CategoryId ?? "";
    var currentMinPrice = ViewBag.MinPrice ?? 0;
    var currentMaxPrice = ViewBag.MaxPrice ?? 10000000;
    var currentBrands = new List<Guid>();
    var currentColors = new List<Guid>();
    var currentCategories = new List<Guid>();

    if (ViewBag.SelectedBrands is List<Guid> brands)
    {
        currentBrands = brands;
    }

    if (ViewBag.SelectedColors is List<Guid> colors)
    {
        currentColors = colors;
    }

    if (ViewBag.SelectedCategories is List<Guid> categories)
    {
        currentCategories = categories;
    }
}
<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Sản Phẩm</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Sản Phẩm</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <div class="container">
        <div class="row">

            <div class="col-lg-4 sidebar">

                <div class="widgets-container" style="border-radius: 8px">

                    <!-- Product Categories Widget -->
                    <div class="category-filter-widget widget-item">
                        <h3 class="widget-title">Danh Mục</h3>
                        <div class="category-list">
                            @foreach (var cat in Model.DanhMucs)
                            {
                                <div class="category-item">
                                    <div class="form-check">
                                        <input class="form-check-input category-checkbox" type="checkbox"
                                               id="category@cat.Id" value="@cat.Id"
                                        @(currentCategories.Contains(cat.Id) ? "checked" : "")>
                                        <label class="form-check-label" for="category@cat.Id">
                                            @cat.TenDanhMuc
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!--/Product Categories Widget -->
                    <!-- Pricing Range Widget -->
                    <div class="pricing-range-widget widget-item">
                        <h3 class="widget-title">Khoảng Giá</h3>
                        <div class="price-range-container">
                            <div class="current-range mb-3">
                                <span class="min-price">@currentMinPrice.ToString("N0")đ</span>
                                <span class="max-price float-end">@currentMaxPrice.ToString("N0")đ</span>
                            </div>

                            <div class="range-slider position-relative" style="height: 40px;">
                                <input type="range" id="min-range" class="position-absolute start-0 w-100 min-range"
                                       min="0" max="10000000" step="10000" value="@currentMinPrice" style="z-index: 2;">
                                <input type="range" id="max-range" class="position-absolute start-0 w-100 max-range"
                                       min="0" max="10000000" step="10000" value="@currentMaxPrice" style="z-index: 1;">
                            </div>

                            <div class="price-inputs mt-3">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">đ</span>
                                            <input type="number" id="min-price-input" class="form-control min-price-input"
                                                   min="0" max="10000000" step="10000" value="@currentMinPrice"
                                                   title="Giá thấp nhất">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">đ</span>
                                            <input type="number" id="max-price-input" class="form-control max-price-input"
                                                   min="0" max="10000000" step="10000" value="@currentMaxPrice"
                                                   title="Giá cao nhất">
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Nhập giá từ 0đ đến 10.000.000đ
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--/Pricing Range Widget -->
                    <!-- Color Filter Widget -->
                    <div class="color-filter-widget widget-item">
                        <h3 class="widget-title">Màu Sắc</h3>
                        <div class="color-options">
                            @foreach (var color in Model.MauSacs)
                            {
                                <span class="color-circle @(currentColors.Contains(color.Id) ? "selected" : "")"
                                      title="@color.TenMauSac"
                                      data-color="@color.MaMauSac"
                                      data-id="@color.Id"
                                      style="background:@color.MaMauSac"></span>
                            }
                        </div>
                    </div>
                    <!--/Color Filter Widget -->
                    <!-- Brand Filter Widget -->
                    <div class="brand-filter-widget widget-item">
                        <h3 class="widget-title">Thương Hiệu</h3>
                        <div class="brand-list">
                            @foreach (var brand in Model.ThuongHieus)
                            {
                                <div class="brand-item">
                                    <div class="form-check">
                                        <input class="form-check-input brand-checkbox" type="checkbox"
                                               id="brand@brand.Id" value="@brand.Id"
                                        @(currentBrands.Contains(brand.Id) ? "checked" : "")>
                                        <label class="form-check-label" for="brand@brand.Id">
                                            @brand.TenThuongHieu
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!--/Brand Filter Widget -->
                    <!-- Apply Filters Button -->
                    <div class="filter-actions mt-4">
                        <button type="button" class="btn btn-primary w-100 apply-filters-btn">
                            <i class="bi bi-funnel me-2"></i>Áp Dụng Bộ Lọc
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100 mt-2 clear-filters-btn" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
                            <i class="bi bi-x-circle me-2"></i>Xóa Tất Cả
                        </button>
                    </div>

                </div>

            </div>

            <div class="col-lg-8">

                <!-- Enhanced Search Section -->
                <section id="search-section" class="search-section mb-4">
                    <div class="search-container" data-aos="fade-up">
                        <form id="searchForm" asp-action="Index" method="get" class="search-form">
                            <div class="row g-3">
                                @* <div class="col-12 col-md-8"> *@
                                <div class="col-12">
                                    <div class="search-input-group">
                                        <div class="input-group">
                                            <span class="input-group-text search-icon">
                                                <i class="bi bi-search"></i>
                                            </span>
                                            <input type="text" name="tuKhoa" value="@currentKeyword"
                                                   class="form-control search-input"
                                                   placeholder="Tìm sản phẩm theo tên, thương hiệu, danh mục...">
                                            <button class="btn btn-primary search-btn" type="submit">
                                                <i class="bi bi-search me-1"></i>Tìm Kiếm
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                @* <div class="col-12 col-md-4">
                                    <div class="search-options">
                                        <select class="form-select" name="sortBy" id="sortBy">
                                            <option value="">Sắp xếp theo</option>
                                            <option value="name_asc">Tên A-Z</option>
                                            <option value="name_desc">Tên Z-A</option>
                                            <option value="price_asc">Giá tăng dần</option>
                                            <option value="price_desc">Giá giảm dần</option>
                                            <option value="newest">Mới nhất</option>
                                            <option value="popular">Phổ biến</option>
                                        </select>
                                    </div>
                                </div> *@
                            </div>

                            <!-- Hidden inputs for filters -->
                            <input type="hidden" name="categoryId" id="categoryIdInput" value="@currentCategoryId">
                            <input type="hidden" name="minPrice" id="minPriceInput" value="@currentMinPrice">
                            <input type="hidden" name="maxPrice" id="maxPriceInput" value="@currentMaxPrice">
                            <input type="hidden" name="selectedCategories" id="selectedCategoriesInput" value="@string.Join(",", currentCategories)">
                            <input type="hidden" name="selectedBrands" id="selectedBrandsInput" value="@string.Join(",", currentBrands)">
                            <input type="hidden" name="selectedColors" id="selectedColorsInput" value="@string.Join(",", currentColors)">
                        </form>
                    </div>
                </section>

                <!-- Active Filters Display -->
                @if (!string.IsNullOrEmpty(currentKeyword) || currentCategories.Count > 0 || currentBrands.Count > 0 || currentColors.Count > 0 || (currentMinPrice > 0 || currentMaxPrice < 10000000))
                {
                    <section id="active-filters" class="active-filters-section mb-4" data-aos="fade-up" data-aos-delay="100">
                        <div class="active-filters-container">
                            <div class="d-flex align-items-center justify-content-between">
                                <h6 class="active-filter-label mb-0">
                                    <i class="bi bi-funnel-fill me-2"></i>Bộ lọc đang áp dụng:
                                </h6>
                                <button type="button" class="btn btn-sm btn-outline-danger clear-all-filters-btn" style="font-size: 0.875rem; padding: 0.375rem 0.75rem;">
                                    <i class="bi bi-x-circle me-1"></i>Xóa tất cả
                                </button>
                            </div>
                            <div class="filter-tags mt-2">
                                @if (!string.IsNullOrEmpty(currentKeyword))
                                {
                                    <span class="filter-tag">
                                        <i class="bi bi-search me-1"></i>"@currentKeyword"
                                        <button class="filter-remove" data-type="keyword">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                                @if (currentCategoryId != "")
                                {
                                    var category = Model.DanhMucs.FirstOrDefault(c => c.Id.ToString() == currentCategoryId);
                                    if (category != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-tag me-1"></i>@category.TenDanhMuc
                                            <button class="filter-remove" data-type="category" data-id="@category.Id">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                                @foreach (var categoryId in currentCategories)
                                {
                                    var category = Model.DanhMucs.FirstOrDefault(c => c.Id == categoryId);
                                    if (category != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-tag me-1"></i>@category.TenDanhMuc
                                            <button class="filter-remove" data-type="category" data-id="@categoryId">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                                @if ((currentMinPrice > 0 && currentMinPrice != 0) || (currentMaxPrice < 10000000 && currentMaxPrice != 10000000))
                                {
                                    <span class="filter-tag">
                                        <i class="bi bi-currency-dollar me-1"></i>@currentMinPrice.ToString("N0")đ - @currentMaxPrice.ToString("N0")đ
                                        <button class="filter-remove" data-type="price" data-id="">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                                @foreach (var brandId in currentBrands)
                                {
                                    var brand = Model.ThuongHieus.FirstOrDefault(b => b.Id == brandId);
                                    if (brand != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-shop me-1"></i>@brand.TenThuongHieu
                                            <button class="filter-remove" data-type="brand" data-id="@brandId">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                                @foreach (var colorId in currentColors)
                                {
                                    var color = Model.MauSacs.FirstOrDefault(c => c.Id == colorId);
                                    if (color != null)
                                    {
                                        <span class="filter-tag">
                                            <i class="bi bi-palette me-1"></i>@color.TenMauSac
                                            <button class="filter-remove" data-type="color" data-id="@colorId">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </section>
                }

                <!-- Product List Container -->
                <div id="product-list-container">
                    @await Html.PartialAsync("_ProductList", Model)
                </div>
            </div>

        </div>
    </div>

</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-color/2.1.2/jquery.color.min.js"></script>
    <link rel="stylesheet" href="~/assets/css/Products.css" />

    <script>
        $(function () {
            // Khởi tạo các vòng tròn màu sắc
            $('.color-circle').each(function () {
                var color = $(this).data('color');
                $(this).css('background-color', $.Color(color));
            });

            // Chọn màu sắc
            $('.color-circle').click(function () {
                $(this).toggleClass('selected');
                updateSelectedColors();
            });

            // Chọn thương hiệu
            $('.brand-checkbox').change(function () {
                updateSelectedBrands();
            });

            // Chọn danh mục
            $('.category-checkbox').change(function () {
                updateSelectedCategories();
            });

            // Thanh trượt khoảng giá
            const minRange = $('.min-range');
            const maxRange = $('.max-range');
            const minPriceInput = $('.min-price-input');
            const maxPriceInput = $('.max-price-input');
            const minPriceDisplay = $('.min-price');
            const maxPriceDisplay = $('.max-price');

            // Validation cho input giá
            function validatePriceInput(input, isMin = true) {
                let value = parseInt(input.value) || 0;
                const min = parseInt(input.min);
                const max = parseInt(input.max);

                // Đảm bảo giá trị trong khoảng cho phép
                value = Math.max(min, Math.min(max, value));

                // Đảm bảo giá trị hợp lệ
                if (isNaN(value) || value < 0) {
                    value = 0;
                }

                input.value = value;
                return value;
            }

            // Cập nhật hiển thị giá
            function updatePriceDisplay() {
                const minPrice = parseInt($('#min-price-input').val()) || 0;
                const maxPrice = parseInt($('#max-price-input').val()) || 10000000;

                // Cập nhật slider
                $('#min-range').val(minPrice);
                $('#max-range').val(maxPrice);

                // Cập nhật hiển thị
                $('.min-price').text(minPrice.toLocaleString('vi-VN') + 'đ');
                $('.max-price').text(maxPrice.toLocaleString('vi-VN') + 'đ');
            }

            // Xử lý sự kiện thay đổi giá
            $('#min-price-input, #max-price-input').on('input', function () {
                const isMin = $(this).attr('id') === 'min-price-input';
                const value = validatePriceInput(this, isMin);

                if (isMin) {
                    // Đảm bảo giá min không vượt quá giá max
                    const maxPrice = parseInt($('#max-price-input').val()) || 10000000;
                    if (value > maxPrice) {
                        $('#max-price-input').val(value);
                    }
                } else {
                    // Đảm bảo giá max không thấp hơn giá min
                    const minPrice = parseInt($('#min-price-input').val()) || 0;
                    if (value < minPrice) {
                        $('#min-price-input').val(value);
                    }
                }

                updatePriceDisplay();
            });

            // Xử lý sự kiện blur (khi rời khỏi input)
            $('#min-price-input, #max-price-input').on('blur', function () {
                validatePriceInput(this, $(this).attr('id') === 'min-price-input');
                updatePriceDisplay();
            });

            // Xử lý sự kiện cho slider
            $('#min-range, #max-range').on('input', function () {
                const isMin = $(this).attr('id') === 'min-range';
                const value = parseInt($(this).val()) || 0;

                if (isMin) {
                    // Đảm bảo giá min không vượt quá giá max
                    const maxPrice = parseInt($('#max-range').val()) || 10000000;
                    if (value > maxPrice) {
                        $('#max-range').val(value);
                        $('#max-price-input').val(value);
                    }
                    $('#min-price-input').val(value);
                } else {
                    // Đảm bảo giá max không thấp hơn giá min
                    const minPrice = parseInt($('#min-range').val()) || 0;
                    if (value < minPrice) {
                        $('#min-range').val(value);
                        $('#min-price-input').val(value);
                    }
                    $('#max-price-input').val(value);
                }

                updatePriceDisplay();
            });

            // Cập nhật màu sắc đã chọn
            function updateSelectedColors() {
                const selectedColors = [];
                $('.color-circle.selected').each(function() {
                    selectedColors.push($(this).data('id'));
                });
                $('#selectedColorsInput').val(selectedColors.join(','));
            }

            // Cập nhật thương hiệu đã chọn
            function updateSelectedBrands() {
                const selectedBrands = [];
                $('.brand-checkbox:checked').each(function() {
                    selectedBrands.push($(this).val());
                });
                $('#selectedBrandsInput').val(selectedBrands.join(','));
            }

            // Cập nhật danh mục đã chọn
            function updateSelectedCategories() {
                const selectedCategories = [];
                $('.category-checkbox:checked').each(function() {
                    selectedCategories.push($(this).val());
                });
                $('#selectedCategoriesInput').val(selectedCategories.join(','));
                console.log('Selected categories:', selectedCategories);
                console.log('Selected categories input value:', $('#selectedCategoriesInput').val());
            }

            // Áp dụng bộ lọc
            $('.apply-filters-btn').click(function() {
                updateSelectedColors();
                updateSelectedBrands();
                updateSelectedCategories();
                loadFilteredProducts();
            });

            // Xóa tất cả bộ lọc
            $('.clear-filters-btn, .clear-all-filters-btn').click(function() {
                // Đặt lại tất cả input form
                $('input[name="tuKhoa"]').val('');
                $('.category-checkbox').prop('checked', false);
                $('.color-circle').removeClass('selected');
                $('.brand-checkbox').prop('checked', false);
                $('.min-range').val(0);
                $('.max-range').val(10000000);
                updatePriceDisplay();
                updateSelectedColors();
                updateSelectedBrands();
                updateSelectedCategories();
                loadFilteredProducts();
            });

            // Xóa từng tag bộ lọc riêng lẻ
            $('.filter-remove').click(function() {
                const type = $(this).data('type');
                const id = $(this).data('id');

                switch(type) {
                    case 'keyword':
                        $('input[name="tuKhoa"]').val('');
                        break;
                    case 'category':
                        if (id) {
                            $(`input[value="${id}"]`).prop('checked', false);
                        } else {
                            // Xóa tất cả checkbox danh mục
                            $('.category-checkbox').prop('checked', false);
                        }
                        break;
                    case 'price':
                        $('.min-range').val(0);
                        $('.max-range').val(10000000);
                        $('#min-price-input').val(0);
                        $('#max-price-input').val(10000000);
                        updatePriceDisplay();
                        break;
                    case 'brand':
                        $(`input[value="${id}"]`).prop('checked', false);
                        break;
                    case 'color':
                        $(`.color-circle[data-id="${id}"]`).removeClass('selected');
                        break;
                }

                updateSelectedColors();
                updateSelectedBrands();
                updateSelectedCategories();
                loadFilteredProducts();
            });

            // Chuyển đổi chế độ xem
            $('.view-btn').click(function () {
                $('.view-btn').removeClass('active');
                $(this).addClass('active');

                const view = $(this).data('view');
                const productGrid = $('#product-grid');

                if (view === 'list') {
                    productGrid.addClass('list-view');
                    // Lưu trạng thái vào localStorage
                    localStorage.setItem('productViewMode', 'list');
                } else {
                    productGrid.removeClass('list-view');
                    // Lưu trạng thái vào localStorage
                    localStorage.setItem('productViewMode', 'grid');
                }
            });

            // Khôi phục trạng thái view khi tải trang
            function restoreViewMode() {
                const savedViewMode = localStorage.getItem('productViewMode');
                if (savedViewMode === 'list') {
                    $('#product-grid').addClass('list-view');
                    $('.view-btn[data-view="list"]').addClass('active');
                    $('.view-btn[data-view="grid"]').removeClass('active');
                } else {
                    $('#product-grid').removeClass('list-view');
                    $('.view-btn[data-view="grid"]').addClass('active');
                    $('.view-btn[data-view="list"]').removeClass('active');
                }
            }

            // Gọi hàm khôi phục khi trang được tải
            restoreViewMode();

            // Tải sản phẩm đã lọc qua AJAX
            function loadFilteredProducts(pageIndex = 1) {
                const minPrice = parseInt($('#min-price-input').val()) || 0;
                const maxPrice = parseInt($('#max-price-input').val()) || 10000000;

                const formData = {
                    tuKhoa: $('input[name="tuKhoa"]').val(),
                    selectedCategories: $('#selectedCategoriesInput').val(),
                    selectedBrands: $('#selectedBrandsInput').val(),
                    selectedColors: $('#selectedColorsInput').val(),
                    giaThapNhat: minPrice > 0 ? minPrice : null,
                    giaCaoNhat: maxPrice < 10000000 ? maxPrice : null,
                    sortBy: $('#sortBy').val(),
                    pageIndex: pageIndex
                };

                // Hiển thị chỉ báo đang tải
                $('#product-list-container').html('<div class="text-center py-5"><i class="bi bi-arrow-clockwise spin display-4"></i><p class="mt-3">Đang tải sản phẩm...</p></div>');

                // Ghi log debug
                console.log('Sending filter data:', formData);
                console.log('Selected categories:', formData.selectedCategories);
                console.log('Selected brands:', formData.selectedBrands);
                console.log('Selected colors:', formData.selectedColors);

                $.ajax({
                    url: '@Url.Action("GetFilteredProducts", "SanPham")',
                    type: 'GET',
                    data: formData,
                    success: function(response) {
                        console.log('Filter response received');
                        $('#product-list-container').html(response);
                        updateActiveFilters();
                        reinitializeEventHandlers();
                    },
                    error: function(xhr, status, error) {
                        console.error('Filter error:', error);
                        console.error('Response text:', xhr.responseText);
                        $('#product-list-container').html('<div class="text-center py-5"><i class="bi bi-exclamation-triangle display-4 text-danger"></i><p class="mt-3 text-danger">Có lỗi xảy ra khi tải sản phẩm</p><p class="text-muted">Chi tiết: ' + error + '</p></div>');
                    }
                });
            }

            // Cập nhật hiển thị bộ lọc đang áp dụng
            function updateActiveFilters() {
                const keyword = $('input[name="tuKhoa"]').val();
                const selectedCategories = $('#selectedCategoriesInput').val().split(',');
                const selectedBrands = $('#selectedBrandsInput').val().split(',');
                const selectedColors = $('#selectedColorsInput').val().split(',');
                const minPrice = $('#min-price-input').val();
                const maxPrice = $('#max-price-input').val();

                let hasActiveFilters = false;
                let filterHtml = '';

                if (keyword) {
                    hasActiveFilters = true;
                    filterHtml += `<span class="filter-tag">
                        <i class="bi bi-search me-1"></i>"${keyword}"
                        <button class="filter-remove" data-type="keyword">
                            <i class="bi bi-x"></i>
                        </button>
                    </span>`;
                }

                if (selectedCategories[0]) {
                    hasActiveFilters = true;
                    selectedCategories.forEach(id => {
                        if (id) {
                            var category = @Html.Raw(Json.Serialize(Model.DanhMucs));
                            var categoryName = category.find(c => c.id == id).tenDanhMuc;
                            filterHtml += `<span class="filter-tag">
                                <i class="bi bi-tag me-1"></i>${categoryName}
                                <button class="filter-remove" data-type="category" data-id="${id}">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                        }
                    });
                }

                if (selectedBrands[0]) {
                    hasActiveFilters = true;
                    selectedBrands.forEach(id => {
                        if (id) {
                            var brand = @Html.Raw(Json.Serialize(Model.ThuongHieus));
                            var brandName = brand.find(b => b.id == id).tenThuongHieu;
                            filterHtml += `<span class="filter-tag">
                                <i class="bi bi-shop me-1"></i>${brandName}
                                <button class="filter-remove" data-type="brand" data-id="${id}">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                        }
                    });
                }

                if (selectedColors[0]) {
                    hasActiveFilters = true;
                    selectedColors.forEach(id => {
                        if (id) {
                            const colorName = $(`.color-circle[data-id="${id}"]`).attr('title');
                            filterHtml += `<span class="filter-tag">
                                <i class="bi bi-palette me-1"></i>${colorName}
                                <button class="filter-remove" data-type="color" data-id="${id}">
                                    <i class="bi bi-x"></i>
                                </button>
                            </span>`;
                        }
                    });
                }

                if (minPrice > 0 || maxPrice < 10000000) {
                    hasActiveFilters = true;
                    const minPriceFormatted = parseInt(minPrice).toLocaleString();
                    const maxPriceFormatted = parseInt(maxPrice).toLocaleString();
                    filterHtml += `<span class="filter-tag">
                        <i class="bi bi-currency-dollar me-1"></i>${minPriceFormatted}đ - ${maxPriceFormatted}đ
                        <button class="filter-remove" data-type="price">
                            <i class="bi bi-x"></i>
                        </button>
                    </span>`;
                }

                if (hasActiveFilters) {
                    if ($('#active-filters').length === 0) {
                        const activeFiltersHtml = `
                            <section id="active-filters" class="active-filters-section mb-4" data-aos="fade-up" data-aos-delay="100">
                                <div class="active-filters-container">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h6 class="active-filter-label mb-0">
                                            <i class="bi bi-funnel-fill me-2"></i>Bộ lọc đang áp dụng:
                                        </h6>
                                        <button type="button" class="btn btn-sm btn-outline-danger clear-all-filters-btn">
                                            <i class="bi bi-x-circle me-1"></i>Xóa tất cả
                                        </button>
                                    </div>
                                    <div class="filter-tags mt-2">
                                        ${filterHtml}
                                    </div>
                                </div>
                            </section>`;
                        $('#search-section').after(activeFiltersHtml);
                    } else {
                        $('#active-filters .filter-tags').html(filterHtml);
                    }
                } else {
                    $('#active-filters').remove();
                }
            }

            // Khởi tạo lại các event handlers sau khi tải AJAX
            function reinitializeEventHandlers() {
                // Khởi tạo lại chuyển đổi chế độ xem
                $('.view-btn').click(function() {
                    $('.view-btn').removeClass('active');
                    $(this).addClass('active');

                    const view = $(this).data('view');
                    if (view === 'list') {
                        $('.product-box').addClass('list-view');
                    } else {
                        $('.product-box').removeClass('list-view');
                    }
                });

                // Khởi tạo lại phân trang
                $('.page-link').click(function(e) {
                    e.preventDefault();
                    const page = $(this).data('page');
                    if (page) {
                        loadFilteredProducts(page);
                    }
                });

                // Khởi tạo lại các nút xóa bộ lọc
                $('.filter-remove').click(function() {
                    const type = $(this).data('type');
                    const id = $(this).data('id');

                    switch(type) {
                        case 'keyword':
                            $('input[name="tuKhoa"]').val('');
                            break;
                        case 'category':
                            if (id) {
                                $(`input[id="category${id}"]`).prop('checked', false);
                            } else {
                                // Xóa tất cả checkbox danh mục
                                $('.category-checkbox').prop('checked', false);
                            }
                            break;
                        case 'price':
                            $('.min-range').val(0);
                            $('.max-range').val(10000000);
                            updatePriceDisplay();
                            break;
                        case 'brand':
                            $(`input[value="${id}"]`).prop('checked', false);
                            break;
                        case 'color':
                            $(`.color-circle[data-id="${id}"]`).removeClass('selected');
                            break;
                    }

                    updateSelectedColors();
                    updateSelectedBrands();
                    updateSelectedCategories();
                    loadFilteredProducts();
                });

                // Khởi tạo lại xóa tất cả bộ lọc
                $('.clear-all-filters-btn').click(function() {
                    $('input[name="tuKhoa"]').val('');
                    $('.category-checkbox').prop('checked', false);
                    $('.color-circle').removeClass('selected');
                    $('.brand-checkbox').prop('checked', false);
                    $('.min-range').val(0);
                    $('.max-range').val(10000000);
                    updatePriceDisplay();
                    updateSelectedColors();
                    updateSelectedBrands();
                    updateSelectedCategories();
                    loadFilteredProducts();
                });
            }

            // Khởi tạo hiển thị giá
            updatePriceDisplay();
        });
    </script>
}

