@model SneakFit.WebClient.Models.SanPhamDetailViewModel
@using System.Linq
@inject IConfiguration Configuration

@{
    var baseUrl = Configuration["BaseAddress"];
    var allImages = Model.SanPhamChiTiets.SelectMany(x => x.Images ?? new List<string>()).Distinct().ToList();
    // Chuẩn hóa để fill tất cả màu/kích thước
    var listMauCoSPCT = Model.SanPhamChiTiets.Select(x => x.MauSacId).Distinct().ToList();
    var listSizeCoSPCT = Model.SanPhamChiTiets.Select(x => x.KichThuocId).Distinct().ToList();
}

<div class="container py-4">
    <div class="row">
        <!-- Slide ảnh như hiện tại, giữ nguyên -->
        <div class="col-lg-5 col-md-6">
            <div class="product-slide mb-4">
                @if (allImages != null && allImages.Any())
                {
                    if (allImages.Count == 1)
                    {
                        <img src="@(baseUrl + allImages.First())" alt="Ảnh sản phẩm" class="rounded" style="object-fit:cover; width:100%;max-height:400px;" onerror="this.src='/images/Default_Logo.png'" />
                    }
                    else
                    {
                        <div id="carouselMainImg" class="carousel slide" data-bs-ride="carousel" data-bs-interval="1750" style="max-width:420px">
                            <div class="carousel-inner">
                                @for (int i = 0; i < allImages.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@(baseUrl + allImages[i])" alt="Ảnh sản phẩm" class="d-block w-100 rounded" style="object-fit:cover; max-height:400px;" onerror="this.src='/images/Default_Logo.png'" />
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselMainImg" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselMainImg" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <img src="@($"{baseUrl}/images/Default_Logo.png")" alt="No Image" class="rounded" style="object-fit:cover; width:100%;max-height:400px;" />
                }
            </div>
        </div>
        <!-- Thông tin sản phẩm -->
        <div class="col-lg-7 col-md-6">
            <h2 class="fw-bold mb-2">@Model.SanPham.TenSanPham</h2>
            <!-- Giá sản phẩm -->
            <div class="mb-3" id="giaSPBox" style="min-height: 38px;">
                <span id="GiaApDungKhuyenMai" class="gia-km"></span>
                <span id="GiaGoc" class="gia-goc"></span>
                <span id="PhanTramGiamGia" class="giam-tag"></span>
            </div>
            <!-- Màu sắc -->
            <div class="mb-2">
                <b>Màu sắc:</b>
                <div class="color-grid flex-wrap" style="display: flex; gap: 10px;">
                    @foreach (var mau in Model.MauSacs)
                    {
                        var hasSPCT = listMauCoSPCT.Contains(mau.Id);
                        <button type="button"
                                class="color-swatch"
                                title="@mau.TenMauSac"
                                data-color-id="@mau.Id"
                                data-color-hex="@mau.MaMauSac"
                        @(hasSPCT ? "" : "disabled")
                                style="background:@mau.MaMauSac; border:2.5px solid #ddd; opacity:@(hasSPCT ? "1" : "0.4");
                                       cursor:@(hasSPCT ? "pointer" : "not-allowed"); width:48px; height:48px; border-radius:50%; text-align:center; margin-bottom:20px;">
                            <span class="color-name">
                                @mau.TenMauSac
                            </span>
                        </button>
                    }
                </div>
            </div>
            <!-- Kích thước -->
            <div class="mb-2">
                <b>Size:</b>
                <div class="size-grid flex-wrap" style="display: flex; gap: 10px;">
                    @foreach (var size in Model.KichThuocs)
                    {
                        var hasSPCT = listSizeCoSPCT.Contains(size.Id);
                        <button type="button"
                                class="size-box"
                                data-size-id="@size.Id"
                        @(hasSPCT ? "" : "disabled")
                                style="padding:8px 18px; border:2px solid #ddd; border-radius:7px; background:#fff;
                                       font-weight:500; font-size:15px; opacity:@(hasSPCT ? "1" : "0.5"); cursor:@(hasSPCT ? "pointer" : "not-allowed");">
                            @size.MaKichThuoc
                        </button>
                    }
                </div>
            </div>
            <!-- Số lượng và thêm giỏ -->
            <div class="mb-2 d-flex align-items-center" id="soLuongGroup" style="display: none">
                <b style="padding-right: 5px;">Số lượng:</b>
                <button type="button" id="btnMinus" class="btn-qty mx-2">-</button>
                <input id="quantityInput" name="quantity" value="1" min="1" max="1"
                       style="width: 55px; text-align: center;" class="form-control form-control-sm d-inline mx-2" />
                <button type="button" id="btnPlus" class="btn-qty mx-2">+</button>
                <span class="ms-2 text-muted" id="soLuongTon" style="font-weight: 500; min-width: 65px;"></span>
            </div>
            <div class="d-flex gap-2">
                <form class="d-inline" id="cartForm" style="display: none;">
                    <input type="hidden" name="id" id="selectedSpctId" value="" />
                    <input type="hidden" name="quantity" id="cartQuantityInput" value="1" />
                    <button type="button" id="btnAddToCart" class="btn btn-custom btn-checkout">
                        <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng
                    </button>
                </form>
                <a href="@Url.Action("Index", "SanPham")" class="btn btn-custom btn-return">
                    <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-color/2.1.2/jquery.color.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

    <script>
        let spctData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SanPhamChiTiets));
        let selectedColorId = null, selectedSizeId = null;

        // Khởi tạo khi trang load
        $(document).ready(function () {
            updateStatusShowHide();
            updateUI();
        });

        // Hàm tìm giá nhỏ nhất từ tất cả SPCT
        function getGiaThapNhat() {
            if (!spctData || spctData.length === 0) return 0;
            let giaList = spctData
                .filter(x => Number(x.Gia) > 0)
                .map(x => Number(x.Gia));
            if (giaList.length === 0) return 0;
            return Math.min(...giaList);
        }

        // Hàm cập nhật UI và giá
        function updateUI() {
            // Reset active + border
            $('.color-grid .color-swatch').removeClass('active').css('border-color', '#ddd');
            $('.size-grid .size-box').removeClass('active').css('border-color', '#ddd').css('background', '#fff');

            // Đánh dấu active cho màu và size đã chọn
            if (selectedColorId) {
                $('.color-grid .color-swatch[data-color-id="' + selectedColorId + '"]')
                    .addClass('active').css('border-color', '#1976d2');
            }
            if (selectedSizeId) {
                $('.size-grid .size-box[data-size-id="' + selectedSizeId + '"]')
                    .addClass('active').css('border-color', '#ffa502').css('background', '#fffbe7');
            }

            // Tìm SPCT phù hợp
            let spct = null;
            if (selectedColorId && selectedSizeId) {
                spct = spctData.find(x => x.MauSacId == selectedColorId && x.KichThuocId == selectedSizeId);
            }

            // Update giá bán:
            if (spct) {
                // Hiển thị giá gốc nếu có KM
                if (spct.GiaKhuyenMai && spct.KhuyenMaiPhanTram > 0 && spct.GiaKhuyenMai < spct.GiaGoc) {
                    $('#GiaGoc').text(spct.GiaGoc.toLocaleString('vi-VN') + ' đ').show();
                    $('#GiaApDungKhuyenMai').text(spct.GiaKhuyenMai.toLocaleString('vi-VN') + ' đ').show();
                    $('#PhanTramGiamGia').text('-' + spct.KhuyenMaiPhanTram + '%').show();
                } else {
                    $('#GiaGoc').hide();
                    $('#PhanTramGiamGia').hide();
                    $('#GiaApDungKhuyenMai').text(spct.GiaGoc.toLocaleString('vi-VN') + ' đ').show();
                }
            } else {
                // Trường hợp chưa chọn đủ
                // Hiện giá KM thấp nhất và % giảm lớn nhất
                let spctMinGia = null;
                let minGiaKhuyenMai = Number.MAX_SAFE_INTEGER;
                let maxPhanTramGiam = 0;
                let minGiaGoc = 0;

                spctData.forEach(x => {
                    // Ưu tiên SPCT còn active, giá > 0
                    if (x.TrangThai && Number(x.GiaGoc) > 0) {
                        let giaKM = (x.KhuyenMaiPhanTram > 0 && x.GiaKhuyenMai < x.GiaGoc) ? x.GiaKhuyenMai : x.GiaGoc;
                        if (giaKM < minGiaKhuyenMai) {
                            minGiaKhuyenMai = giaKM;
                            spctMinGia = x;
                        }
                        if (x.KhuyenMaiPhanTram > maxPhanTramGiam) {
                            maxPhanTramGiam = x.KhuyenMaiPhanTram;
                        }
                    }
                });

                // Nếu tìm được SPCT hợp lệ
                if (spctMinGia) {
                    // Có KM
                    if (spctMinGia.KhuyenMaiPhanTram > 0 && spctMinGia.GiaKhuyenMai < spctMinGia.GiaGoc) {
                        $('#GiaGoc').text(spctMinGia.GiaGoc.toLocaleString('vi-VN') + ' đ').show();
                        $('#GiaApDungKhuyenMai').text(spctMinGia.GiaKhuyenMai.toLocaleString('vi-VN') + ' đ').show();
                        $('#PhanTramGiamGia').text('-' + spctMinGia.KhuyenMaiPhanTram + '%').show();
                    } else {
                        $('#GiaGoc').hide();
                        $('#PhanTramGiamGia').hide();
                        $('#GiaApDungKhuyenMai').text(spctMinGia.GiaGoc.toLocaleString('vi-VN') + ' đ').show();
                    }
                } else {
                    // Không có SPCT nào active/giá > 0
                    $('#GiaGoc').hide();
                    $('#GiaApDungKhuyenMai').text('').hide();
                    $('#PhanTramGiamGia').hide();
                }
            }

            // Cập nhật form và số lượng
            if (spct) {
                $('#soLuongGroup').show();
                $('#quantityInput').attr('min', 1).attr('max', spct.SoLuong || 1).val(1);
                $('#cartQuantityInput').val(1);
                $('#selectedSpctId').val(spct.Id);
                $('#cartForm').show();
                $('#soLuongTon').text(`Còn: ${spct.SoLuong ?? 0} sản phẩm`);
                updateQuantityUI();
            } else {
                $('#soLuongGroup').hide();
                $('#cartForm').hide();
                $('#soLuongTon').text('');
            }
        }

        // Check ngưng hoạt động thì ẩn những màu sắc và kích thước của spct đã ngưng hoạt động
        function updateStatusShowHide() {
            // Đầu tiên, enable lại tất cả
            $('.color-grid .color-swatch').removeAttr('disabled').css('opacity', 1);
            $('.size-grid .size-box').removeAttr('disabled').css('opacity', 1);

            // Nếu đã chọn size => disable màu không còn spct active
            if (selectedSizeId) {
                let mauSacCoSPCT = spctData
                    .filter(x => x.KichThuocId == selectedSizeId && x.TrangThai)
                    .map(x => x.MauSacId);
                $('.color-grid .color-swatch').each(function () {
                    let id = $(this).data('color-id');
                    if (mauSacCoSPCT.indexOf(id) === -1) {
                        $(this).attr('disabled', true);
                    }
                });
            }

            // Nếu đã chọn màu => disable size không còn spct active
            if (selectedColorId) {
                let sizeCoSPCT = spctData
                    .filter(x => x.MauSacId == selectedColorId && x.TrangThai)
                    .map(x => x.KichThuocId);
                $('.size-grid .size-box').each(function () {
                    let id = $(this).data('size-id');
                    if (sizeCoSPCT.indexOf(id) === -1) {
                        $(this).attr('disabled', true);
                    }
                });
            }
        }

        // Sự kiện chọn màu
        $(document).on('click', '.color-grid .color-swatch:not([disabled])', function () {
            var id = $(this).data('color-id');
            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedColorId === id) {
                selectedColorId = null;
            } else {
                selectedColorId = id;
            }
            updateStatusShowHide();
            updateUI();
        });

        // Sự kiện chọn size
        $(document).on('click', '.size-grid .size-box:not([disabled])', function () {
            var id = $(this).data('size-id');
            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedSizeId === id) {
                selectedSizeId = null;
            } else {
                selectedSizeId = id;
            }
            updateStatusShowHide();
            updateUI();
        });

        // Số lượng input cộng/trừ với kiểm tra max/min
        function updateQuantityUI() {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let min = parseInt(inp.attr('min')) || 1;
            let max = parseInt(inp.attr('max')) || 1;

            // Fix giá trị nếu ngoài range
            if (val < min) val = min;
            if (val > max) val = max;
            inp.val(val);
            $('#cartQuantityInput').val(val);

            // Enable/disable nút
            $('#btnMinus').prop('disabled', val <= min);
            $('#btnPlus').prop('disabled', val >= max);
        }

        $('#btnMinus').click(function () {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let min = parseInt(inp.attr('min')) || 1;
            if (val > min) {
                inp.val(val - 1);
                updateQuantityUI();
            }
        });

        $('#btnPlus').click(function () {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let max = parseInt(inp.attr('max')) || 1;
            if (val < max) {
                inp.val(val + 1);
                updateQuantityUI();
            }
        });

        $('#quantityInput').on('input', function () {
            updateQuantityUI();
        });

        $('#btnAddToCart').click(function () {
            var spctId = $('#selectedSpctId').val();
            var soLuong = parseInt($('#quantityInput').val()) || 1;
            var max = parseInt($('#quantityInput').attr('max')) || 1;

            if (soLuong > max) {
                alert("Bạn đã đạt số lượng tối đa trong kho cho sản phẩm này!");
                return;
            }

            $.ajax({
                url: '@Url.Action("AddToCart", "SanPham")',
                type: 'POST',
                data: {
                    sanPhamChiTietId: spctId,
                    soLuong: soLuong
                },
                success: function (res) {
                    if (res.requireLogin) {
                        window.location.href = '/Login/Index';
                        return;
                    }
                    if (res.success) {
                        alert(res.message || 'Đã thêm vào giỏ hàng thành công!');
                    } else {
                        alert(res.message || 'Có lỗi xảy ra!');
                    }
                },
                error: function () {
                    alert('Lỗi hệ thống, vui lòng thử lại!');
                }
            });
        });
    </script>
}

<style>
    .color-swatch {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        cursor: pointer;
        position: relative;
        justify-content: center;
        font-size: 13px;
        transition: border 0.2s, box-shadow 0.2s;
        margin-bottom: 20px;
        box-shadow: 0 1px 6px 0 rgba(100,100,100,0.07);
        overflow: visible;
        text-decoration: none;
    }

        .color-swatch:hover, .color-swatch.active {
            border: 2.5px solid #1976d2 !important;
            box-shadow: 0 2px 8px 0 rgba(25,118,210,0.13);
        }

    .color-name {
        position: absolute;
        bottom: -25px;
        left: 50%;
        transform: translateX(-50%);
        color: #444;
        background: #fff;
        padding: 1px 6px;
        border-radius: 5px;
        font-size: 13px;
        box-shadow: 0 1px 4px 0 rgba(0,0,0,0.04);
        min-width: 48px;
        text-align: center;
        white-space: nowrap;
        font-weight: 500;
    }

    .size-box {
        display: inline-block;
        padding: 8px 18px;
        border: 2px solid #ddd;
        border-radius: 7px;
        background: #fff;
        font-weight: 500;
        font-size: 15px;
        margin: 0 6px 8px 0;
        cursor: pointer;
        transition: border 0.16s, background 0.16s;
    }

        .size-box.active, .size-box:hover {
            border: 2.5px solid #ffa502;
            background: #fffbe7;
        }

    .slick-slider {
        margin-bottom: 0px;
    }

    .slick-slide img {
        width: 100%;
    }

    .slick-nav button {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-qty {
        width: 36px;
        height: 36px;
        background: #f6f8fa;
        color: #1976d2;
        border: none;
        border-radius: 50%;
        font-size: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .18s, color .18s, box-shadow .18s;
        box-shadow: 0 1px 5px 0 rgba(25,118,210,0.06);
        font-weight: bold;
        outline: none;
    }

        .btn-qty:hover:not(:disabled) {
            background: #1976d2;
            color: #fff;
            box-shadow: 0 2px 8px 0 rgba(25,118,210,0.15);
        }

        .btn-qty:disabled {
            background: #eee;
            color: #ccc;
            cursor: not-allowed;
        }

    .color-swatch[disabled], .size-box[disabled] {
        opacity: 0.45 !important;
        pointer-events: none !important;
        filter: grayscale(0.2);
        border-color: #eee !important;
    }

    .product-price-row {
        display: flex;
        align-items: center; /* Canh giữa theo chiều dọc */
        gap: 12px; /* Khoảng cách giữa các phần tử */
    }

    #giaSPBox {
        display: flex;
        align-items: center; /* Căn giữa theo chiều dọc */
        gap: 12px; /* Khoảng cách giữa các phần tử */
        min-height: 38px; /* Giữ chiều cao nhất quán nếu có/không có khuyến mãi */
    }

    .gia-goc {
        text-decoration: line-through;
        color: #888;
        font-size: 1.2rem;
    }

    .gia-km {
        color: #e53935;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .giam-tag {
        background: #ffeaea;
        color: #d7263d;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 2px 10px;
        margin-left: 4px;
        display: flex;
        align-items: center; /* Đảm bảo % cũng giữa hàng nếu có icon */
        height: 28px; /* Giữ khung ổn định */
    }

    #soLuongTon {
        margin-left: 10px;
        color: #1976d2;
        font-size: 15px;
        font-weight: 600;
        min-width: 65px;
        display: inline-block;
        text-align: left;
    }

    /* Button thêm vào giỏ hàng và quay về danh sách */
    .btn-custom {
        padding: 12px 20px;
        font-size: 1.2rem;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: none;
        min-width: 200px;
        height: 48px; /* Đặt chiều cao cố định */
    }

    .btn-checkout {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        color: #FFFFFF;
    }

        .btn-checkout:hover {
            background: linear-gradient(90deg, #60A5FA, #1E3A8A);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
            color: #FFFFFF;
        }

    .btn-return {
        background: linear-gradient(90deg, #60A5FA, #1E3A8A);
        color: #FFFFFF;
    }

        .btn-return:hover {
            background: linear-gradient(90deg, #1E3A8A, #60A5FA);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
            color: #FFFFFF;
        }

        .btn-return i,
        .btn-checkout i {
            margin-right: 8px;
        }
</style>