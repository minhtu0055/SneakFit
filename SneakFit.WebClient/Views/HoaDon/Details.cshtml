@model OrderConfirmationViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Chi Tiết Đơn Hàng - SneakFit";
}

<main class="main py-4 bg-light">
    <div class="container">
        @* @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        else if (Model.HoaDonClient == null)
        {
            <div class="section-box text-center p-4">
                <p class="text-muted">Không tìm thấy đơn hàng.</p>
                <a href="@Url.Action("Index", "HoaDon")" class="btn btn-primary mt-3">Quay về danh sách</a>
            </div>
        } *@
        @if (Model.HoaDonClient == null)
        {
            <div class="section-box text-center p-4">
                <p class="text-muted">Không tìm thấy đơn hàng.</p>
                <a href="@Url.Action("Index", "HoaDon")" class="btn btn-primary mt-3">Quay về danh sách</a>
            </div>
        }
        else
        {
            <!-- Thông báo xác nhận -->
            <div class="section-box confirmation-message mb-4 text-center">
                <h5><i class="bi bi-info-circle-fill text-info"></i> Chi Tiết Đơn Hàng</h5>
                <p>Mã đơn hàng: <strong>@Model.HoaDonClient.MaHoaDon</strong></p>
            </div>

            <!-- Thông tin hóa đơn -->
            <div class="section-box order-info mb-4">
                <h5>Thông tin đơn hàng</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Người nhận:</strong> @Model.HoaDonClient.HoTen</p>
                        <p><strong>Số điện thoại:</strong> @Model.HoaDonClient.SoDienThoai</p>
                        <p><strong>Email:</strong> @Model.HoaDonClient.Email</p>
                        <p><strong>Địa chỉ giao hàng:</strong> @(string.IsNullOrEmpty(Model.HoaDonClient.DiaChi) ? "" : Model.HoaDonClient.DiaChi)</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày đặt hàng:</strong> @Model.HoaDonClient.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Phương thức thanh toán:</strong> @Model.HoaDonClient.PhuongThucThanhToan</p>
                        <p>
                            <strong>Trạng thái:</strong>
                            @{
                                var trangThai = Model.HoaDonClient.TrangThai;
                                string trangThaiTexts = trangThai switch
                                {
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoXacNhan => "Chờ xác nhận",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaXacNhan => "Đã xác nhận",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoVanChuyen => "Chờ vận chuyển",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DangVanChuyen => "Đang vận chuyển",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaThanhToan => "Đã thanh toán",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ThanhCong => "Thành công",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy => "Đã hủy",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.TraHang => "Trả hàng",
                                    _ => "Không xác định"
                                };
                                string trangThaiClasss = trangThai switch
                                {
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoXacNhan => "badge bg-warning",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaXacNhan => "badge bg-primary",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoVanChuyen => "badge bg-info",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DangVanChuyen => "badge bg-secondary",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaThanhToan => "badge bg-success",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ThanhCong => "badge bg-success",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy => "badge bg-danger",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.TraHang => "badge bg-dark",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@trangThaiClasss">@trangThaiTexts</span>
                        </p>

                        <p>
                            <strong>Trạng thái thanh toán:</strong>

                            @{
                                var trangThaiThanhToan = Model.HoaDonClient.TrangThaiThanhToan;
                                var trangThaiText = trangThaiThanhToan switch
                                {
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ChuaThanhToan => "Chưa thanh toán",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.DaThanhToan => "Đã thanh toán",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ThanhToanLoi => "Thanh toán lỗi",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.HoanTien => "Đã hoàn tiền",
                                    _ => "Chưa xác định"
                                };
                                var trangThaiClass = trangThaiThanhToan switch
                                {
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ChuaThanhToan => "badge bg-warning",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.DaThanhToan => "badge bg-success",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ThanhToanLoi => "badge bg-danger",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.HoanTien => "badge bg-info",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@trangThaiClass">@trangThaiText</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="section-box product-list mb-4">
                <h5>Sản phẩm trong đơn hàng</h5>
                @if (Model.ChiTietHoaDonClient != null && Model.ChiTietHoaDonClient.Any())
                {
                    @foreach (var item in Model.ChiTietHoaDonClient)
                    {
                        <div class="product-item d-flex align-items-center mb-3" style="border-radius: 10px;">
                            @{
                                var defaultImage = $"{baseUrl}/images/Default_Logo.png";
                                string imageUrl = defaultImage;
                                if (!string.IsNullOrEmpty(item.AnhSanPham) && item.AnhSanPham != "/images/Default_Logo.png")
                                {
                                    imageUrl = $"{baseUrl}{item.AnhSanPham}";
                                }
                            }
                            <img src="@imageUrl" class="product-img" style="margin-left: 10px;" onerror="this.src='@defaultImage'" />
                            <div class="product-info" style="align-items: center;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <p class="mb-0 fw-semibold">
                                        <span style="font-weight: bold; color: #1E3A8A;">@(string.IsNullOrEmpty(item.TenSanPham) ? "Tên sản phẩm không xác định" : item.TenSanPham)</span> ( @item.TenMauSac, @item.MaKichThuoc )
                                    </p>
                                    @if (item.KhuyenMaiId != null && item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0 && item.GiaKhuyenMai.Value < item.GiaBan)
                                    {
                                        <span class="discount" style="font-size: 0.85rem; margin-bottom: 1.5px;">Giảm @item.KhuyenMaiPhanTram%</span>
                                    }
                                </div>
                                <small class="text-muted" style="font-weight: bold; font-size: 15px">Số lượng: @item.SoLuong</small>
                            </div>
                            <div class="product-price ms-auto" style="margin-right: 10px;">
                                @if (item.KhuyenMaiId != null && item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0 && item.GiaKhuyenMai.Value < item.GiaGoc)
                                {
                                    <span class="text-danger">@item.GiaKhuyenMai.Value.ToString("N0") ₫</span>
                                    <br />
                                    <span class="text-muted text-decoration-line-through">@item.GiaGoc.Value.ToString("N0") ₫</span>
                                }
                                else
                                {
                                    <span>@item.GiaGoc?.ToString("N0") ₫</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Không có sản phẩm trong đơn hàng này.</p>
                }
            </div>

            <!-- Voucher đã sử dụng (section-box style) -->
            @if (Model.UsedVoucher != null)
            {
                <div class="section-box order-info mb-4">
                    <h5 class="voucher-info-title">
                        <i class="bi bi-ticket-perforated voucher-icon me-2"></i>Voucher đã sử dụng
                    </h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p>
                                <strong>Mã voucher:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.MaVoucher</span>
                            </p>
                            <p>
                                <strong>Loại giảm giá:</strong>
                                <span class="order-info-value">@(Model.UsedVoucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ? "Phần trăm" : "Số tiền")</span>
                            </p>
                            <p>
                                <strong>Giá trị giảm:</strong>
                                <span class="order-info-value">
                                    @(Model.UsedVoucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ?
                                        ($"{Model.UsedVoucher.GiaTriGiamGia}%") : ($"{Model.UsedVoucher.GiaTriGiamGia:N0} ₫"))
                                </span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p>
                                <strong>Điều kiện áp dụng:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.DieuKienApDung.ToString("N0") ₫</span>
                            </p>
                            <p>
                                <strong>Giá trị tối đa:</strong>
                                <span class="order-info-value">@(Model.UsedVoucher.GiaTriToiDa > 0 ? Model.UsedVoucher.GiaTriToiDa.ToString("N0") + " ₫" : "Không giới hạn")</span>
                            </p>
                            <p>
                                <strong>Hiệu lực:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.ThoiGianBatDau.ToString("dd/MM/yyyy") - @Model.UsedVoucher.ThoiGianKetThuc.ToString("dd/MM/yyyy")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Tóm tắt thanh toán (giống Checkout) -->
            <div class="section-box order-summary mb-4">
                <h5 style="color: #1E3A8A; border-bottom: 2px solid #60A5FA; padding-bottom: 10px;">Tóm tắt thanh toán</h5>
                <div class="summary-item">
                    <span>Tổng tiền hàng</span>
                    <span id="summary-products">@Model.HoaDonClient.TongTienSanPham.ToString("N0") ₫</span>
                </div>
                @if (Model.HoaDonClient.VoucherDiscount.HasValue && Model.HoaDonClient.VoucherDiscount.Value > 0)
                {
                    <div class="summary-item" id="summary-voucher">
                        <span>Áp dụng voucher</span>
                        <span class="text-danger" id="summary-voucher-amount">-@((Model.HoaDonClient.VoucherDiscount ?? 0).ToString("N0")) ₫</span>
                    </div>
                }
                <div class="summary-item">
                    <span>Phí vận chuyển</span>
                    <span id="summary-shipping">@(Model.HoaDonClient.PhiVanChuyen.ToString("N0")) ₫</span>
                </div>
                <hr />
                <div class="summary-item fw-bold fs-5">
                    <span>Tổng thanh toán</span>
                    <span id="summary-total" style="color: #1E3A8A;">@(Model.HoaDonClient.TongTien.ToString("N0")) ₫</span>
                </div>
            </div>

            <!-- Hành động -->
            <div class="section-box actions text-center">
                <a href="@Url.Action("Index", "HoaDon")" class="btn btn-primary">Quay về danh sách</a>

                @if ((int)Model.HoaDonClient.TrangThai == 0 && Model.HoaDonClient.PhuongThucThanhToan == SneakFit.Data.Enums.PhuongThucThanhToan.COD) // ChoXacNhan và COD
                {
                    <form method="post" action="@Url.Action("CancelOrder", "ThanhToan", new { id = Model.HoaDonClient.Id })" style="display:inline-block;" id="cancelOrderForm">
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#cancelModal">Hủy hóa đơn</button>
                    </form>
                }
                @if ((int)Model.HoaDonClient.TrangThai == 5) // ThanhCong
                {
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#returnModal">
                        Yêu cầu trả hàng/hoàn tiền
                    </button>
                }
            </div>
        }
    </div>

    <!-- Modal for Cancel Confirmation -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center">
                    <span class="check-icon"><i class="bi bi-question-circle-fill text-info"></i></span>
                    <h5 class="mt-3">Xác nhận hủy hóa đơn</h5>
                    <p>Bạn có chắc chắn muốn hủy hóa đơn này không?</p>
                    <div class="mt-3">
                        <button type="button" class="btn btn-primary confirm-cancel-btn" onclick="submitCancelForm()">OK</button>
                        <button type="button" class="btn btn-secondary cancel-modal-btn" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Yêu cầu trả hàng -->
    <div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="TraHang" asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title" id="returnModalLabel" style="color: white">Yêu cầu trả hàng/hoàn tiền</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="OrderId" value="@Model.HoaDonClient.Id" />
                        <div class="mb-2">
                            <label class="form-label">Lý do</label>
                            <textarea name="Reason" class="form-control" required></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Hình thức hoàn</label>
                            <div class="form-control-plaintext">Admin sẽ hoàn lại qua tài khoản cá nhân</div>
                            <input type="hidden" name="Method" value="2" />
                        </div>


                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        </div>
                </form>
            </div>
        </div>
    </div>

</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/assets/css/TraHang.css">
    <script>
        function submitCancelForm() {
            document.getElementById('cancelOrderForm').submit();
        }
    </script>
}

<style>
    .main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-box {
        background-color: #FFFFFF;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

        .section-box:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .section-box h5 {
            font-weight: 600;
            margin-bottom: 15px;
            color: #1E3A8A;
            font-size: 1.4rem;
            border-bottom: 2px solid #60A5FA;
            padding-bottom: 10px;
        }

            .section-box h5 i {
                margin-right: 10px;
                font-size: 1.5rem;
            }

    .confirmation-message {
        background-color: #E6F3FA;
        padding: 30px;
        border-radius: 10px;
    }

        .confirmation-message h5 {
            font-size: 1.6rem;
            color: #1E3A8A;
        }

        .confirmation-message p {
            font-size: 1.1rem;
            color: #4B5563;
            margin: 10px 0;
        }

    .order-info p {
        font-size: 1rem;
        color: #4B5563;
        margin-bottom: 10px;
    }

        .order-info p strong {
            color: #1E3A8A;
        }

    .product-list .product-item {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        padding: 15px 0;
        border-bottom: 1px solid #E5E7EB;
        transition: background 0.3s ease;
    }

        .product-list .product-item:hover {
            background-color: #F1F5F9;
        }

    .product-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #E5E7EB;
        flex-shrink: 0;
    }

    .product-info {
        flex: 1;
        margin-left: 20px;
        min-width: 0;
    }

        .product-info p {
            margin: 0 0 5px 0;
            font-weight: 600;
            font-size: 1.1rem;
            color: #1E3A8A;
        }

    .product-price {
        font-weight: 700;
        color: #1E3A8A;
        font-size: 1.1rem;
        margin-left: auto;
        flex-shrink: 0;
    }

    .order-summary {
        padding: 20px;
        background-color: #FFFFFF;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .summary-item {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 1.1rem;
        color: #4B5563;
    }

        .summary-item span:last-child {
            font-weight: 600;
            color: #1E3A8A;
        }

        .summary-item.fw-bold {
            font-size: 1.3rem;
            color: #1E3A8A;
        }

    .actions .btn {
        padding: 10px 20px;
        font-size: 1.1rem;
        border-radius: 6px;
    }

    .btn-primary {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        border: none;
        color: #FFFFFF;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #3B82F6, #163172);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
        }

    .btn-warning {
        background: linear-gradient(90deg, #60A5FA, #1E3A8A);
        border: none;
        color: #FFFFFF;
    }

        .btn-warning:hover {
            background: linear-gradient(90deg, #163172, #3B82F6);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
            color: #FFFFFF;
        }

    .discount {
        display: inline-block;
        background: #ffe4e0;
        color: #ef5854;
        font-weight: bold;
        border-radius: 6px;
        padding: 2px 8px;
        margin-left: 8px;
        vertical-align: middle;
    }

    .text-danger {
        color: #e11d48 !important;
        font-weight: bold;
    }

    .text-muted.text-decoration-line-through {
        color: #9ca3af !important;
    }

    /* Voucher Used Section Custom Style */
    .voucher-used-box {
        border: 1.5px solid #60A5FA;
        background: #f7fbff;
        box-shadow: 0 2px 8px rgba(96, 165, 250, 0.08);
    }

    .voucher-title {
        font-weight: 700;
        color: #1E3A8A;
        font-size: 1.4rem;
        border-bottom: 2px solid #60A5FA;
        padding-bottom: 10px;
        width: 100%;
        margin-bottom: 0;
    }

    .voucher-used-box .row {
        margin-top: 10px;
    }

    .voucher-label {
        font-size: 1.08rem;
        color: #1E3A8A;
        font-weight: 500;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

        .voucher-label span:first-child {
            min-width: 130px;
            color: #2563eb;
            font-weight: 600;
            margin-right: 8px;
        }

    .voucher-badge {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        color: #fff;
        font-weight: 700;
        border-radius: 8px;
        padding: 3px 16px;
        font-size: 1.08rem;
        letter-spacing: 1px;
        box-shadow: 0 2px 8px rgba(30, 58, 138, 0.08);
        margin-left: 2px;
        display: inline-block;
    }

    .voucher-value {
        color: #2563eb;
        font-weight: 600;
        font-size: 1.08rem;
    }

    .voucher-discount {
        color: #e11d48;
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: 1px;
    }

    .voucher-info-box {
        background: #fff;
        border: 1.5px solid #60A5FA;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 2px 8px rgba(96, 165, 250, 0.08);
    }

    .voucher-info-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1E3A8A;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        border-bottom: 2px solid #60A5FA;
        padding-bottom: 10px;
        margin-bottom: 18px;
    }

    .voucher-icon {
        font-size: 2rem;
        color: #22c55e;
        display: inline-block;
        vertical-align: middle;
    }

    .voucher-info-row {
        margin-bottom: 10px;
        font-size: 1.08rem;
    }

    .voucher-info-label {
        font-weight: 600;
        color: #1E3A8A;
        min-width: 140px;
        display: inline-block;
