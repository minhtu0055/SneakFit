@using SneakFit.ViewModels.Catalog.HoaDonClient
@model List<HoaDonClientViewModel>
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Danh Sách Đơn Hàng - SneakFit";
}

<main class="main py-4 bg-light">
    <div class="container">
        <h2 class="text-center mb-4" style="color: #1E3A8A; font-weight: 600;">Danh Sách Đơn Hàng Của Bạn</h2>

        @if (Model == null || !Model.Any())
        {
            <div class="section-box text-center p-4">
                <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Quay về trang chủ</a>
            </div>
        }
        else
        {
            <div class="section-box">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="border-right: none; ">Mã Đơn Hàng</th>
                                <th style="border-right: none; ">Ngày Đặt Hàng</th>
                                <th style="border-right: none; ">Tổng Thanh Toán</th>
                                <th style="border-right: none; ">Trạng Thái</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="border-right: none; ">@item.MaHoaDon</td>
                                    <td style="border-right: none; ">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="border-right: none; ">@item.TongTien.ToString("N0") ₫</td>
                                    <td style="border-right: none; ">@item.TrangThai</td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-outline-primary btn-sm">Xem Chi Tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (ViewBag.TotalRecords > ViewBag.PageSize)
        {
            var totalPages = (int)Math.Ceiling((double)ViewBag.TotalRecords / ViewBag.PageSize);
            <nav aria-label="Page navigation example" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.PageIndex == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageIndex = ViewBag.PageIndex - 1 })">&laquo;</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.PageIndex ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageIndex = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.PageIndex == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageIndex = ViewBag.PageIndex + 1 })">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
}

<style>
    .main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-box {
        position: relative;
        background-color: #FFFFFF;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

    .table {
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 0; /* Loại bỏ margin bottom mặc định */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            padding: 12px;
            text-align: center;
            background-color: #1E3A8A;
            color: #FFFFFF;
            border: 1px solid #60A5FA;
        }

            .table thead th:first-child {
                border-top-left-radius: 8px;
            }

            .table thead th:last-child {
                border-top-right-radius: 8px;
            }

            .table thead th:hover {
                text-decoration: none;
                background-color: #1E3A8A;
            }

        .table tbody {
            /* border: 1px solid #60A5FA; */
            border-top: none;
        }

            .table tbody td {
                padding: 12px;
                text-align: center;
                vertical-align: middle;
                color: #4B5563;
                border: 1px solid #60A5FA;
                border-top: none;
            }

            .table tbody tr {
                background-color: #FFFFFF;
            }

                .table tbody tr:hover {
                    background-color: #F8FAFC;
                }

                /* Áp dụng border-radius cho dòng cuối cùng */
                .table tbody tr:last-child td:first-child {
                    border-bottom-left-radius: 8px;
                }

                .table tbody tr:last-child td:last-child {
                    border-bottom-right-radius: 8px;
                }

    /* Loại bỏ hiệu ứng sọc của table-striped */
    .table-striped tbody tr:nth-child(odd) {
        background-color: #FFFFFF;
    }

    .table-striped tbody tr:nth-child(even) {
        background-color: #FFFFFF;
    }

    .btn-outline-primary {
        border-color: #60A5FA;
        color: #60A5FA;
        padding: 6px 12px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-outline-primary:hover {
            background-color: #60A5FA;
            color: #FFFFFF;
            transform: scale(1.05);
        }

    .btn-primary {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        border: none;
        color: #FFFFFF;
        padding: 10px 20px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #3B82F6, #163172);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
        }

    /* PHÂN TRANG TÙY CHỈNH */
    .pagination {
        margin-top: 24px;
        margin-bottom: 0;
    }
    .pagination .page-item {
        margin: 0 2px;
    }
    .pagination .page-link {
        color: #1E3A8A;
        border: 1.5px solid #60A5FA;
        border-radius: 6px;
        font-weight: 500;
        background: #fff;
        transition: all 0.2s;
        min-width: 38px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(30,58,138,0.04);
    }
    .pagination .page-link:hover {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        color: #fff;
        border-color: #1E3A8A;
        transform: translateY(-2px) scale(1.07);
    }
    .pagination .active .page-link {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        color: #fff;
        border-color: #1E3A8A;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(30,58,138,0.10);
        pointer-events: none;
    }
    .pagination .disabled .page-link {
        color: #A0AEC0;
        background: #F1F5F9;
        border-color: #E2E8F0;
        pointer-events: none;
        box-shadow: none;
    }
</style>