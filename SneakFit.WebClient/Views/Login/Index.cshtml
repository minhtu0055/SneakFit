@using SneakFit.ViewModels.System.User
@using SneakFit.ViewModels.System.DiaChi
@model SneakFit.WebClient.Models.LoginRegisterViewModel
<main class="main">

    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Đăng nhập</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/">Trang chủ</a></li>
                    <li class="current">Đăng nhập</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Login Register Section -->
    <section id="login-register" class="login-register section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="login-register-wraper">

                        <!-- Tab Navigation -->
                        <ul class="nav nav-tabs nav-tabs-bordered justify-content-center mb-4" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(ViewBag.ActiveTab == "register" ? "" : "active")" data-bs-toggle="tab" data-bs-target="#login-register-login-form" type="button" role="tab" aria-selected="@(ViewBag.ActiveTab == "register" ? "false" : "true")">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(ViewBag.ActiveTab == "register" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#login-register-registration-form" type="button" role="tab" aria-selected="@(ViewBag.ActiveTab == "register" ? "true" : "false")">
                                    <i class="bi bi-person-plus me-1"></i>Đăng ký
                                </button>
                            </li>
                        </ul>

                        <!-- Tab Content -->
                        <div class="tab-content">

                            <!-- Login Form -->
                            <div class="tab-pane fade @(ViewBag.ActiveTab == "register" ? "" : "show active")" id="login-register-login-form" role="tabpanel">
                                @*                                 @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger">
                                        @TempData["ErrorMessage"]
                                    </div>
                                } *@
                                <form asp-action="Index" asp-controller="Login" method="post">

                                    <div class="mb-4">
                                        <label for="login-register-login-email" class="form-label">Tên Đăng Nhập</label>
                                        <input asp-for="Login.UserName" type="text" class="form-control" id="login-register-login-email" required />
                                        <span asp-validation-for="Login.UserName" class="text-danger"></span>
                                    </div>

                                    <div class="mb-4">
                                        <label for="login-register-login-password" class="form-label">Mật Khẩu</label>
                                        <div class="input-group">
                                            <input asp-for="Login.Password" type="password" class="form-control" id="login-register-login-password" required />
                                            <span class="input-group-text" id="togglePassword" style="cursor:pointer;">
                                                <i class="bi bi-eye-slash" id="togglePasswordIcon"></i>
                                            </span>
                                        </div>
                                        <span asp-validation-for="Login.Password" class="text-danger"></span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <div class="form-check">
                                            <input asp-for="Login.RememberMe" type="checkbox" class="form-check-input" id="login-register-remember-me" />
                                            <label class="form-check-label" for="login-register-remember-me">Remember me</label>
                                        </div>
                                        <a asp-action="QuenMatKhau" asp-controller="Login" class="forgot-password">Quên mật khẩu?</a>
                                    </div>

                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg" name="submitType" value="login">Login</button>

                                    </div>
                                </form>
                            </div>

                            <!-- Registration Form -->
                            <div class="tab-pane fade @(ViewBag.ActiveTab == "register" ? "show active" : "")" id="login-register-registration-form" role="tabpanel">
                                @if (ViewBag.ActiveTab == "register" && !ViewData.ModelState.IsValid)
                                {
                                    <div class="alert alert-danger">
                                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <div>@error.ErrorMessage</div>
                                        }
                                    </div>
                                }
                                <form asp-action="Register" asp-controller="Login" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()

                                    <!-- Profile Picture Section -->
                                    <div class="row mb-4">
                                        <div class="col-12 text-center">
                                            <label for="registerFileInput">
                                                <div class="profile-upload-container">
                                                    <img id="registerPreviewImage" src="~/assets/img/avatars/hinhanhnew.png" alt="Ảnh" class="profile-preview" />
                                                    <div id="registerCameraIcon" class="camera-icon">
                                                        <i class="bi bi-camera"></i>
                                                    </div>
                                                </div>
                                            </label>
                                            <input asp-for="Register.HinhAnh" id="registerFileInput" type="file" accept="image/*" class="form-control d-none" onchange="registerPreviewFile(this)" />
                                        </div>
                                    </div>

                                    <!-- Form Fields Section -->
                                    <div class="row g-4">
                                        <!-- First Row -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Register.HoVaTen" class="form-label fw-bold">
                                                    Họ và tên <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="Register.HoVaTen" class="form-control form-control-lg" placeholder="Vui lòng nhập họ tên..." required />
                                                <span asp-validation-for="Register.HoVaTen" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Register.UserName" class="form-label fw-bold">
                                                    Tài khoản <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="Register.UserName" class="form-control form-control-lg" placeholder="Nhập tài khoản..." required />
                                                <span asp-validation-for="Register.UserName" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <!-- Second Row -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Register.Email" class="form-label fw-bold">
                                                    Email <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="Register.Email" type="email" class="form-control form-control-lg" placeholder="Nhập email..." required />
                                                <span asp-validation-for="Register.Email" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Register.SoDienThoai" class="form-label fw-bold">
                                                    Số điện thoại <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="Register.SoDienThoai" class="form-control form-control-lg" placeholder="Nhập số điện thoại..." required pattern="[0-9]{10}" />
                                                <span asp-validation-for="Register.SoDienThoai" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <!-- Third Row -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Register.NgaySinh" class="form-label fw-bold">
                                                    Ngày sinh <span class="text-danger">*</span>
                                                </label>
                                                <div class="input-group input-group-lg">
                                                    <span class="input-group-text">
                                                        <i class="bi bi-calendar-event"></i>
                                                    </span>
                                                    <input asp-for="Register.NgaySinh" type="date" class="form-control" required />
                                                </div>
                                                <span asp-validation-for="Register.NgaySinh" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Register.GioiTinh" class="form-label fw-bold">
                                                    Giới tính <span class="text-danger">*</span>
                                                </label>
                                                <div class="gender-options">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" asp-for="Register.GioiTinh" id="nam" value="true" checked>
                                                        <label class="form-check-label" for="nam">Nam</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" asp-for="Register.GioiTinh" id="nu" value="false">
                                                        <label class="form-check-label" for="nu">Nữ</label>
                                                    </div>
                                                </div>
                                                <span asp-validation-for="Register.GioiTinh" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <!-- Fourth Row - Address -->
                                        @* <div class="col-12">
                                            <div class="form-group">
                                                <label asp-for="Register.DiaChi.TenDiaChi" class="form-label fw-bold">
                                                    Địa chỉ cụ thể <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="Register.DiaChi.TenDiaChi" class="form-control form-control-lg" placeholder="Nhập địa chỉ chi tiết..." required />
                                                <span asp-validation-for="Register.DiaChi.TenDiaChi" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <!-- Fifth Row - Location Dropdowns -->
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Register.DiaChi.TenThanhPho" class="form-label fw-bold">
                                                    Thành phố/Tỉnh <span class="text-danger">*</span>
                                                </label>
                                                <select id="province" class="form-select form-select-lg" required>
                                                    <option value="">Chọn Tỉnh/Thành phố</option>
                                                </select>
                                                <input type="hidden" asp-for="Register.DiaChi.TenThanhPho" id="provinceName" />
                                                <input type="hidden" asp-for="Register.DiaChi.MaTinh" id="provinceCode" />
                                                <span asp-validation-for="Register.DiaChi.TenThanhPho" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Register.DiaChi.TenHuyen" class="form-label fw-bold">
                                                    Quận/Huyện <span class="text-danger">*</span>
                                                </label>
                                                <select id="district" class="form-select form-select-lg" required disabled>
                                                    <option value="">Chọn Quận/Huyện</option>
                                                </select>
                                                <input type="hidden" asp-for="Register.DiaChi.TenHuyen" id="districtName" />
                                                <input type="hidden" asp-for="Register.DiaChi.MaHuyen" id="districtCode" />
                                                <span asp-validation-for="Register.DiaChi.TenHuyen" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Register.DiaChi.TenXa" class="form-label fw-bold">
                                                    Thôn/Xã <span class="text-danger">*</span>
                                                </label>
                                                <select id="ward" class="form-select form-select-lg" required disabled>
                                                    <option value="">Chọn Phường/Xã</option>
                                                </select>
                                                <input type="hidden" asp-for="Register.DiaChi.TenXa" id="wardName" />
                                                <input type="hidden" asp-for="Register.DiaChi.MaXa" id="wardCode" />
                                                <span asp-validation-for="Register.DiaChi.TenXa" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div> *@

                                        <!-- Submit Button -->
                                        <div class="row mt-5">
                                            <div class="col-12 text-center">
                                                <button type="submit" class="btn btn-primary btn-lg px-5 py-3">
                                                    <i class="bi bi-person-plus me-2"></i>Đăng ký
                                                </button>
                                            </div>
                                        </div>
                                </form>

                                <style>
                                    .profile-upload-container {
                                        position: relative;
                                        display: inline-block;
                                        width: 150px;
                                        height: 150px;
                                        background: #f8f9fa;
                                        border: 3px dashed #dee2e6;
                                        border-radius: 50%;
                                        cursor: pointer;
                                        transition: all 0.3s ease;
                                        overflow: hidden;
                                    }

                                        .profile-upload-container:hover {
                                            border-color: #007bff;
                                            background: #e3f2fd;
                                        }

                                    .profile-preview {
                                        width: 100%;
                                        height: 100%;
                                        object-fit: cover;
                                        border-radius: 50%;
                                        display: none;
                                    }

                                    .camera-icon {
                                        position: absolute;
                                        top: 50%;
                                        left: 50%;
                                        transform: translate(-50%, -50%);
                                        font-size: 48px;
                                        color: #6c757d;
                                    }

                                    .form-group {
                                        margin-bottom: 1.5rem;
                                    }

                                    .form-label {
                                        margin-bottom: 0.5rem;
                                        color: #495057;
                                    }

                                    .form-control-lg, .form-select-lg {
                                        padding: 0.75rem 1rem;
                                        font-size: 1rem;
                                        border-radius: 0.5rem;
                                        border: 2px solid #e9ecef;
                                        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
                                    }

                                        .form-control-lg:focus, .form-select-lg:focus {
                                            border-color: #007bff;
                                            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
                                        }

                                    .input-group-lg .input-group-text {
                                        padding: 0.75rem 1rem;
                                        font-size: 1rem;
                                        border-radius: 0.5rem 0 0 0.5rem;
                                    }

                                    .gender-options {
                                        padding: 0.75rem 1rem;
                                       /*  background: #f8f9fa;
                                        border: 2px solid #e9ecef; */
                                        border-radius: 0.5rem;
                                        min-height: 60px;
                                        display: flex;
                                        align-items: center;
                                    }

                                    .form-check-inline {
                                        margin-right: 1.5rem;
                                    }

                                    .form-check-input {
                                        margin-right: 0.5rem;
                                    }

                                    .btn-lg {
                                        font-size: 1.1rem;
                                        font-weight: 600;
                                        border-radius: 0.5rem;
                                        transition: all 0.3s ease;
                                    }

                                        .btn-lg:hover {
                                            transform: translateY(-2px);
                                            box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);
                                        }

                                    .text-danger {
                                        font-weight: bold;
                                    }
                                </style>

                                @* /* hiển thị ảnh */ *@
                                <script>
                                    function registerPreviewFile(input) {
                                        const file = input.files[0];
                                        if (file) {
                                            const reader = new FileReader();
                                            reader.onload = function (e) {
                                                document.getElementById('registerPreviewImage').src = e.target.result;
                                                document.getElementById('registerPreviewImage').style.display = 'block';
                                                document.getElementById('registerCameraIcon').style.display = 'none';
                                            }
                                            reader.readAsDataURL(file);
                                        }
                                    }
                                </script>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </div>

    </section><!-- /Login Register Section -->

</main>
@section Scripts {
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {

            // THÔNG BÁO LỖI
            // Hiển thị Toastr từ TempData
            var loginSuccess = '@TempData["LoginSuccess"]';
            var successMessage = '@TempData["SuccessMessage"]';
            var errorMessage = '@TempData["ErrorMessage"]';

            if (loginSuccess) {
                toastr.success(loginSuccess);
            }
            if (successMessage) {
                toastr.success(successMessage);
            }
            if (errorMessage) {
                toastr.error(errorMessage);
            }

            // Hiển thị lỗi đăng ký từ ModelState
            var registerErrors = [];
            @if (ViewBag.ActiveTab == "register" && !ViewData.ModelState.IsValid)
            {
                foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <text>registerErrors.push('@error.ErrorMessage'); </text>
                }
            }
            if (registerErrors.length > 0) {
                registerErrors.forEach(function (msg) {
                    toastr.error(msg);
                });
            }

            // Giữ tab đang active
            var activeTab = '@ViewBag.ActiveTab';
            if (activeTab === 'register') {
                var tab = new bootstrap.Tab(document.querySelector('button[data-bs-target="#login-register-registration-form"]'));
                tab.show();
            }

            //SUBMIT LOGIN
            $("#loginForm").submit(function (e) {
                e.preventDefault();

                if (!$(this).valid()) {
                    return false;
                }

                var formData = {
                    "Login.UserName": $("#Login_UserName").val(),
                    "Login.Password": $("#Login_Password").val(),
                    submitType: "login"
                };

                $.ajax({
                    url: '@Url.Action("Index", "Login")',
                    type: 'POST',
                    data: formData,
                    success: function (result) {
                        if (result.success) {
                            toastr.success("Đăng nhập thành công!");
                            setTimeout(function () {
                                window.location.href = result.redirectUrl;
                            }, 1000);
                        } else {
                            toastr.error(result.message || "Sai tài khoản hoặc mật khẩu");
                        }
                    },
                    error: function () {
                        toastr.error("Đã xảy ra lỗi khi đăng nhập");
                    }
                });
            });


            //SUNMIT ĐĂNG KÍ
            $("#registerForm").submit(function (e) {
                e.preventDefault();

                var formData = new FormData(this);

                $.ajax({
                    url: '@Url.Action("Register", "Login")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            setTimeout(() => {
                                window.location.href = '@Url.Action("Index", "Login")';
                            }, 1500);
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("Đăng kí thất bại. Vui lòng thử lại.");
                    }
                });
            });

            // API ĐỊA CHỈ
            // Khi chọn tỉnh/thành phố
            $('#province').change(function () {
                const provinceId = $(this).val();
                const provinceName = $(this).find('option:selected').data('name');
                $('#provinceName').val(provinceName);
                $('#provinceCode').val(provinceId);

                // Reset quận/huyện và phường/xã
                $('#district').html('<option value="">Chọn Quận/Huyện</option>');
                $('#ward').html('<option value="">Chọn Phường/Xã</option>');
                $('#districtName').val('');
                $('#districtCode').val('');
                $('#wardName').val('');
                $('#wardCode').val('');

                if (provinceId) {
                    $('#district').prop('disabled', false);
                    // Load quận/huyện
                    $.ajax({
                        url: 'https://localhost:7277/api/Ghn/districts',  // Thêm BaseAddress vào
                        type: 'GET',
                        success: function (response) {
                            const districts = response.data.filter(d => d.ProvinceID == provinceId);
                            let options = '<option value="">Chọn Quận/Huyện</option>';
                            districts.forEach(function (district) {
                                options += `<option value="${district.DistrictID}" data-name="${district.DistrictName}">${district.DistrictName}</option>`;
                            });
                            $('#district').html(options);
                        },
                        error: function (error) {
                            console.error('Lỗi khi tải danh sách quận/huyện:', error);
                            toastr.error('Không thể tải danh sách quận/huyện');
                        }
                    });
                } else {
                    $('#district').prop('disabled', true);
                    $('#ward').prop('disabled', true);
                }
            });

            // Khi chọn quận/huyện
            $('#district').change(function () {
                const districtId = $(this).val();
                const districtName = $(this).find('option:selected').data('name');
                $('#districtName').val(districtName);
                $('#districtCode').val(districtId);

                // Reset phường/xã
                $('#ward').html('<option value="">Chọn Phường/Xã</option>');
                $('#wardName').val('');
                $('#wardCode').val('');

                if (districtId) {
                    $('#ward').prop('disabled', false);
                    // Load phường/xã
                    $.ajax({
                        url: `https://localhost:7277/api/Ghn/wards/${districtId}`,  // Thêm BaseAddress vào
                        type: 'GET',
                        success: function (response) {
                            const wards = response.data;
                            let options = '<option value="">Chọn Phường/Xã</option>';
                            wards.forEach(function (ward) {
                                options += `<option value="${ward.WardCode}" data-name="${ward.WardName}">${ward.WardName}</option>`;
                            });
                            $('#ward').html(options);
                        },
                        error: function (error) {
                            console.error('Lỗi khi tải danh sách phường/xã:', error);
                            toastr.error('Không thể tải danh sách phường/xã');
                        }
                    });
                } else {
                    $('#ward').prop('disabled', true);
                }
            });

            // Khi chọn phường/xã
            $('#ward').change(function () {
                const wardName = $(this).find('option:selected').data('name');
                $('#wardName').val(wardName);
                $('#wardCode').val(wardName.split('/')[0]);
            });

            $.ajax({
                url: 'https://localhost:7277/api/Ghn/provinces', // Đúng với backend (Ghn viết hoa)
                type: 'GET',
                success: function (response) {
                    console.log("API provinces response:", response); // Thêm dòng này
                    const provinces = response.data;
                    let options = '<option value="">Chọn Tỉnh/Thành phố</option>';
                    provinces.forEach(function (province) {
                        options += `<option value="${province.ProvinceID}" data-name="${province.ProvinceName}">${province.ProvinceName}</option>`;
                    });
                    $('#province').html(options);
                },
                error: function (error) {
                    console.error('Lỗi khi tải danh sách tỉnh/thành phố:', error);
                    toastr.error('Không thể tải danh sách tỉnh/thành phố');
                }
            });

            // Toggle password visibility
            $('#togglePassword').on('click', function () {
                var passwordInput = $('#login-register-login-password');
                var icon = $('#togglePasswordIcon');
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
        });


    </script>
}

