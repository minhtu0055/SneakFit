@model List<SneakFit.WebClient.Models.GioHangItemViewModel>
@inject IConfiguration Configuration

@{
    var baseUrl = Configuration["BaseAddress"];
}

<main class="main">
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Cart</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li class="current">Cart</li>
                </ol>
            </nav>
        </div>
    </div>
    <section id="cartDetails" class="cart section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
            <div class="row g-4">
                <div class="col-lg-8" data-aos="fade-up" data-aos-delay="200">
                    <div class="cart-items">
                        <div class="cart-header d-none d-lg-block">
                            <div class="row align-items-center gy-4">
                                <div class="col-lg-1 text-center">
                                    <input type="checkbox" id="select-all" title="Chọn tất cả" style="margin-left: 38.5px; " />
                                </div>
                                <div class="col-lg-5"><h5 style="margin-left: 25px; ">Product</h5></div>
                                <div class="col-lg-2 text-center"><h5>Price</h5></div>
                                <div class="col-lg-2 text-center"><h5>Quantity</h5></div>
                                <div class="col-lg-2 text-center"><h5 style="margin-right: 38.5px; ">Total</h5></div>
                            </div>
                        </div>

                        @if (Model.Count == 0)
                        {
                            <div class="alert alert-info mt-3">Giỏ hàng của bạn đang trống.</div>
                        }
                        else
                        {
                            int idx = 0;
                            foreach (var item in Model)
                            {
                                <div class="cart-item" data-aos="fade-up" data-aos-delay="@(100 + idx * 100)">
                                    <div class="row align-items-center gy-4">
                                        <div class="col-lg-1 col-12 text-center mb-3 mb-lg-0">
                                            <input type="checkbox" class="item-checkbox" data-id="@item.SanPhamChiTietId" data-price="@item.ThanhTien" />
                                        </div>
                                        <div class="col-lg-5 col-12 mb-3 mb-lg-0">
                                            <div class="product-info d-flex align-items-center">
                                                <div class="product-image">
                                                    <img src="@($"{Configuration["BaseAddress"]}{(string.IsNullOrEmpty(item.AnhSanPham) ? "/images/Default_Logo.png" : item.AnhSanPham)}")"
                                                         alt="@item.TenSanPham"
                                                         class="img-fluid" loading="lazy" style="max-width:75px; max-height:75px; border-radius: 12px" />
                                                </div>
                                                <div class="product-details ms-3">
                                                    <h6 class="product-title">@item.TenSanPham</h6>
                                                    <div class="product-meta">
                                                        <span class="product-color">Color: @item.MauSac</span>
                                                        <span class="product-size">Size: @item.KichThuoc</span>
                                                    </div>
                                                    <button class="remove-item btn btn-link text-danger p-0" type="button"
                                                            data-id="@item.SanPhamChiTietId">
                                                        <i class="bi bi-trash"></i> Remove
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-2 text-center">
                                            <div class="price-tag">
                                                @if (item.GiaKhuyenMai > 0 && item.GiaKhuyenMai < item.GiaGoc)
                                                {
                                                    <span class="current-price">@item.GiaKhuyenMai.ToString("N0")</span>
                                                    <span class="original-price text-muted" style="text-decoration:line-through">@item.GiaGoc.ToString("N0")</span>
                                                }
                                                else
                                                {
                                                    <span class="current-price">@item.GiaGoc.ToString("N0")</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-2 text-center">
                                            <div class="quantity-selector">
                                                <button class="quantity-btn decrease" type="button" data-id="@item.SanPhamChiTietId" style="font-weight: bold">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="number" class="quantity-input" value="@item.SoLuong" min="1" data-max="99"
                                                       data-id="@item.SanPhamChiTietId">
                                                @* <button class="quantity-btn increase" type="button" data-id="@item.SanPhamChiTietId">
                                                    <i class="bi bi-plus"></i>
                                                </button> *@
                                                <button class="quantity-btn increase" type="button" data-id="@item.SanPhamChiTietId"
                                                @(item.SoLuong >= item.SoLuongTon ? "disabled title='Đã đạt số lượng tồn kho tối đa!'" : "")>
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-12 col-lg-2 text-center mt-3 mt-lg-0">
                                            <div class="item-total">
                                                <span>@item.ThanhTien.ToString("N0")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                idx++;
                            }
                        }

                        <!-- Coupon/Action Bar -->
                        <div class="cart-actions mt-3">
                            <div class="row g-3">
                                <div class="col-lg-6 col-md-6">
                                    <div class="coupon-form">
                                        <div class="input-group">
                                            <input type="text" class="form-control" placeholder="Coupon code" id="couponCode">
                                            <button class="btn btn-accent" type="button">Apply</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 text-md-end">
                                    <button class="btn btn-outline-accent me-2" type="button" onclick="location.reload();">
                                        <i class="bi bi-arrow-clockwise"></i> Update
                                    </button>
                                    <button class="btn btn-outline-danger me-2" type="button" id="delete-selected">
                                        <i class="bi bi-trash"></i> Delete Selected
                                    </button>
                                    <button class="btn btn-outline-danger" type="button" id="clear-cart">
                                        <i class="bi bi-trash"></i> Clear All
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="cart-summary">
                        <h4 class="summary-title">Order Summary</h4>
                        <div class="summary-item">
                            <span class="summary-label">Subtotal</span>
                            <span class="summary-value" id="subtotal">0 VNĐ</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Shipping</span>
                            <span class="summary-value">35,000 VNĐ</span>
                        </div>
                        <div class="summary-total">
                            <span class="summary-label">Total</span>
                            <span class="summary-value" id="total">35,000 VNĐ</span>
                        </div>
                        <div class="checkout-button">
                            <a href="@Url.Action("Checkout", "GioHang")" class="btn btn-accent w-100">
                                Proceed to Checkout <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                        <div class="continue-shopping">
                            <a href="@Url.Action("Index", "SanPham")" class="btn btn-link w-100">
                                <i class="bi bi-arrow-left"></i> Continue Shopping
                            </a>
                        </div>
                        <div class="payment-methods">
                            <p class="payment-title">We Accept</p>
                            <div class="payment-icons">
                                <i class="bi bi-credit-card-2-front"></i>
                                <i class="bi bi-paypal"></i>
                                <i class="bi bi-wallet2"></i>
                                <i class="bi bi-apple"></i>
                                <i class="bi bi-google"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let isProcessing = false;
        let cartQuantities = {};

        // Hàm tính tổng tiền dựa trên các sản phẩm được chọn
        function calculateTotals() {
            let subtotal = 0;
            $('.item-checkbox:checked').each(function () {
                subtotal += parseFloat($(this).data('price')) || 0;
            });
            const shipping = 35000; // Giá vận chuyển cố định 35,000 VNĐ
            const total = subtotal + shipping;
            $('#subtotal').text(subtotal.toLocaleString() + ' VNĐ');
            $('#total').text(total.toLocaleString() + ' VNĐ');
        }

        // Hàm enable/disable nút + -
        function buttonState($input, maxQuantity) {
            let qty = parseInt($input.val()) || 1;
            let $decrease = $input.siblings('.decrease');
            let $increase = $input.siblings('.increase');

            if (qty <= 1) {
                $decrease.prop('disabled', true).addClass('opacity-50').attr('title', 'Số lượng tối thiểu là 1!');
            } else {
                $decrease.prop('disabled', false).removeClass('opacity-50').attr('title', '');
            }

            if (qty >= maxQuantity) {
                $increase.prop('disabled', true).addClass('opacity-50').attr('title', 'Đã đạt số lượng tồn kho tối đa!');
            } else {
                $increase.prop('disabled', false).removeClass('opacity-50').attr('title', '');
            }
        }

        // Hàm cập nhật số lượng (AJAX)
        function updateQuantity(productId, quantity, $input) {
            if (isProcessing) return;
            isProcessing = true;
            $('.quantity-btn, .quantity-input').prop('disabled', true);
            $.ajax({
                url: '/GioHang/CapNhatSoLuong',
                type: 'POST',
                data: {
                    sanPhamChiTietId: productId,
                    soLuong: quantity
                },
                success: function(response) {
                    if (response.success) {
                        $input.val(response.soLuong);
                        cartQuantities[productId] = response.soLuong;
                        // let maxQuantity = response.maxQuantity || 99;
                        // $input.data('max', maxQuantity);
                        // buttonState($input, maxQuantity);
                        const maxQuantity = response.maxQuantity || 99;
        $input.data('max', maxQuantity);

        // GỌI LẠI SAU KHI CẬP NHẬT max
        buttonState($input, maxQuantity);
                        $input.closest('.cart-item').find('.item-total span').text(response.thanhTien.toLocaleString());
                        // Cập nhật giá mới cho checkbox
                        $input.closest('.cart-item').find('.item-checkbox').data('price', response.thanhTien);
                        calculateTotals(); // Tính lại tổng khi số lượng thay đổi
                    } else {
                        Swal.fire('Lỗi', response.message || 'Có lỗi!', 'error');
                        $input.val($input.data('old') || 1);
                        cartQuantities[productId] = $input.data('old') || 1;
                        buttonState($input, $input.data('max') || 99);
                    }
                },
                error: function() {
                    Swal.fire('Lỗi', 'Có lỗi khi cập nhật số lượng!', 'error');
                    $input.val($input.data('old') || 1);
                    cartQuantities[productId] = $input.data('old') || 1;
                    buttonState($input, $input.data('max') || 99);
                },
                complete: function() {
                    isProcessing = false;
                    $('.quantity-btn, .quantity-input').prop('disabled', false);
                }
            });
        }

        $(function() {
            // Khởi tạo số lượng & maxQuantity
            $('.quantity-input').each(function() {
                let $input = $(this);
                let id = $input.data('id');
                let val = parseInt($input.val()) || 1;
                let maxQuantity = parseInt($input.data('max')) || 99;
                cartQuantities[id] = val;
                buttonState($input, maxQuantity);
            });

            // Sự kiện click +/-
            $(document).on('click', '.increase, .decrease', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (isProcessing) return;
                let $input = $(this).siblings('.quantity-input');
                let id = $input.data('id');
                let maxQuantity = parseInt($input.data('max')) || 99;
                let val = cartQuantities[id] !== undefined ? cartQuantities[id] : (parseInt($input.val()) || 1);
                $input.data('old', val);

                let newVal = $(this).hasClass('increase') ? val + 1 : val - 1;
                if (newVal < 1) newVal = 1;
                if (newVal > maxQuantity) newVal = maxQuantity;

                if (newVal !== val) {
                    cartQuantities[id] = newVal;
                    updateQuantity(id, newVal, $input);
                }
                setTimeout(function() {
                    buttonState($input, maxQuantity);
                }, 100);
            });

            // Sự kiện nhập input số lượng
            $(document).on('focus', '.quantity-input', function () {
                $(this).data('old', parseInt($(this).val()) || 1);
            });

            $(document).on('blur', '.quantity-input', function () {
                if (isProcessing) return;
                let $input = $(this);
                let oldVal = $input.data('old') || 1;
                let newVal = parseInt($input.val()) || 1;
                let maxQuantity = parseInt($input.data('max')) || 99;
                if (newVal < 1) newVal = 1;
                if (newVal > maxQuantity) newVal = maxQuantity;
                if (newVal !== oldVal) {
                    updateQuantity($input.data('id'), newVal, $input);
                } else {
                    $input.val(newVal);
                    buttonState($input, maxQuantity);
                }
                buttonState($input, maxQuantity);
            });

            $(document).on('keydown', '.quantity-input', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $(this).blur();
                }
            });

            // Xóa sản phẩm
            $(document).on('click', '.remove-item', function (e) {
                e.preventDefault();
                if (isProcessing) return;
                var spctId = $(this).data('id');
                Swal.fire({
                    title: 'Xác nhận',
                    text: 'Bạn có chắc muốn xóa sản phẩm này?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        isProcessing = true;
                        $.ajax({
                            url: '/GioHang/XoaSanPham',
                            type: 'POST',
                            data: { sanPhamChiTietId: spctId },
                            success: function (res) {
                                isProcessing = false;
                                if (res.success) {
                                    Swal.fire('Thành công', res.message, 'success').then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                    Swal.fire('Lỗi', res.message, 'error');
                                }
                            },
                            error: function (xhr) {
                                isProcessing = false;
                                var errorMsg = xhr.responseJSON?.message || 'Có lỗi khi xóa sản phẩm!';
                                Swal.fire('Lỗi', errorMsg, 'error');
                            }
                        });
                    }
                });
            });

            // Xóa toàn bộ giỏ hàng
            $(document).on('click', '#clear-cart', function (e) {
                e.preventDefault();
                if (isProcessing) return;
                Swal.fire({
                    title: 'Xác nhận',
                    text: 'Bạn có chắc muốn xóa toàn bộ giỏ hàng?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa hết',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        isProcessing = true;
                        $.ajax({
                            url: '/GioHang/XoaTatCa',
                            type: 'POST',
                            success: function (res) {
                                isProcessing = false;
                                if (res.success) {
                                    Swal.fire('Thành công', res.message, 'success').then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                    Swal.fire('Lỗi', res.message, 'error');
                                }
                            },
                            error: function (xhr) {
                                isProcessing = false;
                                var errorMsg = xhr.responseJSON?.message || 'Có lỗi khi xóa giỏ hàng!';
                                Swal.fire('Lỗi', errorMsg, 'error');
                            }
                        });
                    }
                });
            });

            // Checkbox: Chọn tất cả
            $(document).on('change', '#select-all', function () {
                var isChecked = $(this).is(':checked');
                $('.item-checkbox').prop('checked', isChecked).trigger('change'); // Trigger change để tính tổng
            });

            // Checkbox: Cập nhật trạng thái "Chọn tất cả" và tính tổng khi thay đổi
            $(document).on('change', '.item-checkbox', function () {
                var allChecked = $('.item-checkbox').length === $('.item-checkbox:checked').length;
                $('#select-all').prop('checked', allChecked);
                calculateTotals(); // Tính lại tổng khi checkbox thay đổi
            });

            // Xóa các sản phẩm đã chọn
            $(document).on('click', '#delete-selected', function (e) {
                e.preventDefault();
                if (isProcessing) return;

                var selectedIds = [];
                $('.item-checkbox:checked').each(function () {
                    selectedIds.push($(this).data('id'));
                });

                if (selectedIds.length === 0) {
                    Swal.fire('Thông báo', 'Vui lòng chọn ít nhất một sản phẩm để xóa!', 'info');
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận',
                    text: `Bạn có chắc muốn xóa ${selectedIds.length} sản phẩm đã chọn?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        isProcessing = true;
                        $.ajax({
                            url: '/GioHang/XoaNhieuSanPham',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(selectedIds),
                            success: function (res) {
                                isProcessing = false;
                                if (res.success) {
                                    Swal.fire('Thành công', res.message, 'success').then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                    Swal.fire('Lỗi', res.message, 'error');
                                }
                            },
                            error: function (xhr) {
                                isProcessing = false;
                                var errorMsg = xhr.responseJSON?.message || 'Có lỗi khi xóa các sản phẩm!';
                                Swal.fire('Lỗi', errorMsg, 'error');
                            }
                        });
                    }
                });
            });

            // Khởi tạo tổng tiền khi trang tải
            calculateTotals();
        });
    </script>
}