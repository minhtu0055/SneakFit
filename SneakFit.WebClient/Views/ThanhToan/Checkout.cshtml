            // Lưu địa chỉ mới
            function saveNewAddress() {
                const receiverName = $('#modal-receiver-name').val();
                const phoneNumber = $('#modal-phone-number').val();
                const province = $('#modal-province option:selected').data('name');
                const provinceId = $('#modal-province').val();
                const district = $('#modal-district option:selected').data('name');
                const districtId = $('#modal-district').val();
                const ward = $('#modal-ward option:selected').data('name');
                const wardCode = $('#modal-ward').val();
                const detailAddress = $('#modal-detail-address').val();
                const isDefault = $('#modal-set-default').is(':checked');

                if (!receiverName || !phoneNumber || !province || !district || !ward || !detailAddress) {
                    alert('Vui lòng điền đầy đủ thông tin địa chỉ.');
                    return;
                }

                const newAddress = {
                    tenNguoiNhan: receiverName,
                    soDienThoai: phoneNumber,
                    tenDiaChi: detailAddress,
                    tenThanhPho: province,
                    tenHuyen: district,
                    tenXa: ward,
                    maTinh: provinceId,
                    maHuyen: districtId,
                    maXa: wardCode,
                    macDinh: isDefault
                };

                fetch('/DiaChi/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(newAddress)
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(response => {
                    loadUserAddresses();
                    $('#addNewAddressModal').modal('hide');
                    $('#changeAddressModal').modal('show');
                    
                    // Nếu địa chỉ mới được đặt làm mặc định, cập nhật preview
                    if (isDefault) {
                        // Lấy địa chỉ vừa tạo để cập nhật preview
                        setTimeout(function() {
                            loadUserAddresses(function() {
                                // Tìm địa chỉ mới nhất (địa chỉ mặc định)
                                const newDefaultAddress = $('.address-item.selected').data('address-id');
                                if (newDefaultAddress) {
                                    fetch(`/DiaChi/GetById?id=${newDefaultAddress}`)
                                        .then(response => {
                                            if (!response.ok) {
                                                throw new Error(`HTTP error! status: ${response.status}`);
                                            }
                                            return response.json();
                                        })
                                        .then(data => {
                                            const address = data.resultObj || data;
                                            if (address && address.maHuyen && address.maXa) {
                                                updateAddressPreview(address); // Chỉ cập nhật preview
                                            }
                                        })
                                        .catch(error => {
                                            console.error('Lỗi khi cập nhật preview sau khi thêm địa chỉ mới:', error);
                                        });
                                }
                            });
                        }, 500); // Delay để đảm bảo địa chỉ đã được tạo
                    }
                })
                .catch(error => {
                    console.error('Lỗi khi thêm địa chỉ:', error);
                    alert('Lỗi khi thêm địa chỉ.');
                });
            }

