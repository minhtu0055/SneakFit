@using SneakFit.WebClient.Models
@model CheckoutViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Thanh Toán";
}

<main class="main py-4 bg-light">
    <div class="container">

        <!-- Địa chỉ nhận hàng -->
        <div class="section-box address-box mb-4">
            <div class="address-details">
                <h5><i class="bi bi-geo-alt-fill"></i> Địa chỉ nhận hàng</h5>
                <div class="address-info">
                    <div class="address-text">
                        <p class="mb-1"><strong>@Model.HoTen</strong> <span class="text-muted">(@Model.SoDienThoai)</span></p>
                        <p class="mb-0">@Model.DiaChi</p>
                    </div>
                    <div class="address-actions">
                        <a href="#" id="btnChangeAddress" class="btn btn-change">Thay đổi</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="section-box product-list mb-4" style="border-radius: 10px;">
            <h5>Sản phẩm</h5>
            @foreach (var item in Model.GioHangItems)
            {
                <div class="product-item d-flex align-items-center mb-3" style="border-radius: 10px;">
                    @{
                        var defaultImage = $"{baseUrl}/images/Default_Logo.png";
                        string imageUrl = defaultImage;

                        if (!string.IsNullOrEmpty(item.AnhSanPham))
                        {
                            imageUrl = $"{baseUrl}{item.AnhSanPham}";
                        }
                    }
                    <img src="@imageUrl" class="product-img" style="margin-left: 10px;" onerror="this.src='@defaultImage'" />
                    <div class="product-info" style="align-items: center;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <p class="mb-0 fw-semibold">
                                @item.TenSanPham (Màu: @item.MauSac,Kích cỡ: @item.KichThuoc)
                            </p>
                            @if (item.PhanTramGiamGia > 0)
                            {
                                <span class="discount " style="font-size: 0.85rem; margin-bottom: 1.5px;">
                                    Giảm @item.PhanTramGiamGia%
                                </span>
                            }
                        </div>
                        <small class="text-muted" style="font-weight: bold; font-size: 15px">Số lượng: @item.SoLuong</small>
                    </div>
                    <div class="product-price ms-auto" style="margin-right: 10px;">
                        @if (item.GiaKhuyenMai < item.GiaGoc)
                        {
                            <span class="text-danger">@item.GiaKhuyenMai.ToString("N0") ₫</span>
                            <br />
                            <span class="text-muted text-decoration-line-through">@item.GiaGoc.ToString("N0") ₫</span>
                        }
                        else
                        {
                            <span>@item.GiaGoc.ToString("N0") ₫</span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Phương thức vận chuyển -->
        <div class="section-box shipping-method mb-4">
            <h5>Phương thức vận chuyển</h5>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <select id="province" class="form-select">
                        <option selected>Chọn tỉnh / thành</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select id="district" class="form-select">
                        <option selected>Chọn quận / huyện</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select id="ward" class="form-select">
                        <option selected>Chọn phường / xã</option>
                    </select>
                </div>
            </div>
            <div class="shipping-info">Phí vận chuyển mặc định: <strong>35,000 ₫</strong></div>
        </div>

        <!-- Hình thức thanh toán -->
        <div class="section-box payment-method mb-4">
            <h5>Hình thức thanh toán</h5>
            <div class="payment-options" style="align-items: center;">
                <label class="payment-btn">
                    <input type="radio" name="HinhThucThanhToan" id="cod" value="COD">
                    <span>Thanh toán khi nhận hàng (COD)</span>
                </label>
                <label class="payment-btn">
                    <input type="radio" name="HinhThucThanhToan" id="online" value="Online">
                    <span>Thanh toán online</span>
                </label>
                <span id="paymentError" class="text-danger" style="display:none;">Vui lòng chọn một hình thức thanh toán.</span>
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div class="section-box order-summary">
            <h5>Tóm tắt đơn hàng</h5>
            <div class="summary-item">
                <span>Tổng tiền hàng</span>
                <span>@(Model.TongTienSanPham.ToString("N0")) ₫</span>
            </div>
            <div class="summary-item">
                <span>Phí vận chuyển</span>
                <span>35,000 ₫</span>
            </div>
            <hr />
            <div class="summary-item fw-bold fs-5">
                <span>Tổng thanh toán</span>
                <span>@((Model.TongTienSanPham + 35000).ToString("N0")) ₫</span>
            </div>

            <!-- Hiển thị validation errors -->
            @if (ViewData.ModelState.Count > 0 && !ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <form method="post" asp-action="Checkout" asp-controller="ThanhToan" id="checkoutForm">
                <input type="hidden" asp-for="HoTen" id="HoTenInput" value="@Model.HoTen" />
                <input type="hidden" asp-for="SoDienThoai" id="SoDienThoaiInput" value="@Model.SoDienThoai" />
                @* <input type="hidden" asp-for="Email" value="@Model.Email" /> *@
                <input type="hidden" asp-for="DiaChi" id="DiaChiInput" value="@Model.DiaChi" />
                <input type="hidden" asp-for="GhiChu" value="@Model.GhiChu ?? string.Empty" />
                <input type="hidden" asp-for="PhiVanChuyen" value="@Model.PhiVanChuyen" />
                <input type="hidden" asp-for="TongTienSanPham" value="@Model.TongTienSanPham" />
                <input type="hidden" asp-for="DiaChiMoi" id="HiddenAddressInput" value="@Model.DiaChiMoi ?? string.Empty" />
                <input type="hidden" asp-for="PhuongThucThanhToan" id="selectedPayment" value="@(Model.PhuongThucThanhToan?.ToString())" />
                <button type="submit" class="btn btn-danger btn-checkout mt-3" id="submitBtn">Đặt hàng</button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        const baseUrl = '@baseUrl';
        const userId = '@User.FindFirst("UserId")?.Value' || '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
        let selectedAddressId = null; // Biến để theo dõi địa chỉ được chọn

        $(document).ready(function () {
            // Hàm chung để load dữ liệu cho dropdown
            function loadDropdown(url, selector, defaultOption, valueField, textField, callback) {
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        console.log('Response from API:', response);
                        const items = response.data || response;

                        if (!Array.isArray(items) || items.length === 0) {
                            console.warn(`Dữ liệu không hợp lệ từ ${url}:`, items);
                            $(selector).html(`<option value="">Lỗi: Không có dữ liệu</option>`);
                            return;
                        }

                        let options = `<option value="">${defaultOption}</option>`;
                        items.forEach(item => {
                            options += `<option value="${item[valueField]}" data-name="${item[textField]}">${item[textField]}</option>`;
                        });
                        $(selector).html(options);

                        if (callback) callback();
                    },
                    error: function (xhr) {
                        console.error(`Lỗi khi tải dữ liệu từ ${url}: ${xhr.status} - ${xhr.responseText}`);
                        $(selector).html(`<option value="">Lỗi: ${xhr.status}</option>`);
                    }
                });
            }

            // Load tỉnh/thành
            function loadProvinces(selector) {
                loadDropdown(`${baseUrl}/api/ghn/provinces`, selector, 'Chọn tỉnh / thành', 'ProvinceID', 'ProvinceName');
            }

            // Load quận/huyện theo tỉnh
            function loadDistricts(provinceId, districtSelector, wardSelector) {
                if (!provinceId) {
                    $(districtSelector).html('<option value="">Chọn quận / huyện</option>').prop('disabled', true);
                    $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                    return;
                }

                $(districtSelector).prop('disabled', false);
                $.ajax({
                    url: `${baseUrl}/api/ghn/districts`,
                    type: 'GET',
                    success: function (response) {
                        console.log('Districts response:', response);
                        const allDistricts = response.data || response;

                        if (!Array.isArray(allDistricts)) {
                            console.warn('Dữ liệu districts không hợp lệ:', allDistricts);
                            $(districtSelector).html('<option value="">Lỗi: Không có dữ liệu</option>');
                            return;
                        }

                        const filteredDistricts = allDistricts.filter(district =>
                            district.ProvinceID == provinceId
                        );

                        console.log('Filtered districts:', filteredDistricts);
                        if (filteredDistricts.length === 0) {
                            $(districtSelector).html('<option value="">Không có quận/huyện</option>');
                            return;
                        }

                        let options = '<option value="">Chọn quận / huyện</option>';
                        filteredDistricts.forEach(district => {
                            options += `<option value="${district.DistrictID}" data-name="${district.DistrictName}">${district.DistrictName}</option>`;
                        });
                        $(districtSelector).html(options);
                    },
                    error: function (xhr) {
                        console.error('Lỗi khi tải districts:', xhr.status, xhr.responseText);
                        $(districtSelector).html('<option value="">Lỗi: Không thể tải dữ liệu</option>');
                    }
                });

                $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
            }

            // Load phường/xã theo quận/huyện
            function loadWards(districtId, wardSelector) {
                if (!districtId) {
                    $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                    return;
                }

                $(wardSelector).prop('disabled', false);
                loadDropdown(`${baseUrl}/api/ghn/wards/${districtId}`, wardSelector, 'Chọn phường / xã', 'WardCode', 'WardName');
            }

            // Load danh sách địa chỉ của người dùng
            function loadUserAddresses() {
                $.ajax({
                    url: '/DiaChi/GetAll',
                    type: 'GET',
                    success: function (addresses) {
                        let addressHtml = '';
                        let defaultAddress = null;
                        if (!addresses || addresses.length === 0) {
                            addressHtml = '<p>Chưa có địa chỉ nào. Vui lòng thêm địa chỉ mới.</p>';
                        } else {
                            addresses.forEach(address => {
                                if (address.mac_Dinh) defaultAddress = address;
                                addressHtml += `
                                    <div class="address-item mb-3 p-3 border rounded d-flex align-items-center justify-content-between" data-address-id="${address.id}" style="cursor: pointer;">
                                        <div>
                                            <p class="mb-1"><strong>${address.tenNguoiNhan}</strong> <span class="text-muted">(${address.soDienThoai})</span></p>
                                            <p class="mb-1">${address.tenDiaChi}, ${address.tenXa}, ${address.tenHuyen}, ${address.tenThanhPho}</p>
                                            <span class="set-default text-danger" style="cursor: pointer; text-decoration: none;" data-address-id="${address.id}">Đặt làm địa chỉ mặc định</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center" style="min-width: 100px;">
                                            <input type="radio" name="addressRadio" class="address-radio" value="${address.id}" ${address.mac_Dinh ? 'checked' : ''} style="margin-bottom: 8px; width: 20px; height: 20px;">
                                            ${address.mac_Dinh ? '<span class="badge bg-success align-middle" style="font-size:1rem;min-width:80px;text-align:center;">Mặc định</span>' : ''}
                                        </div>
                                    </div>`;
                            });
                        }
                        $('#addressItems').html(addressHtml);
                        // Nếu có địa chỉ mặc định, cập nhật luôn vào phần địa chỉ nhận hàng
                        if (defaultAddress) {
                            setCheckoutAddress(defaultAddress);
                            selectedAddressId = defaultAddress.id; // Cập nhật selectedAddressId
                        }
                    },
                    error: function (xhr) {
                        $('#addressItems').html('<p>Lỗi khi tải danh sách địa chỉ.</p>');
                    }
                });
            }

            // Hàm cập nhật địa chỉ nhận hàng trên giao diện Checkout
            function setCheckoutAddress(address) {
                const fullAddress = `${address.tenDiaChi}, ${address.tenXa}, ${address.tenHuyen}, ${address.tenThanhPho}`;
                $('.address-box p:last').text(fullAddress);
                $('.address-box p:first strong').text(address.tenNguoiNhan);
                $('.address-box p:first span').text(`(${address.soDienThoai})`);
                $('#HoTenInput').val(address.tenNguoiNhan);
                $('#SoDienThoaiInput').val(address.soDienThoai);
                $('#DiaChiInput').val(fullAddress);
                $('#HiddenAddressInput').val(fullAddress);
            }

            // Đặt địa chỉ mặc định
            function setDefaultAddress(addressId) {
                $.ajax({
                    url: `/DiaChi/SetDefault?id=${addressId}`,
                    type: 'PUT',
                    success: function (response) {
                        selectedAddressId = addressId;
                        loadUserAddresses(); // Tải lại danh sách địa chỉ để cập nhật giao diện
                    },
                    error: function (xhr) {
                        alert('Lỗi khi đặt địa chỉ mặc định.');
                    }
                });
            }

            // Cập nhật địa chỉ trên form thanh toán
            function updateCheckoutAddress(addressId) {
                if (!addressId) {
                    alert('Vui lòng chọn một địa chỉ.');
                    return;
                }
                $.ajax({
                    url: `/DiaChi/GetById?id=${addressId}`,
                    type: 'GET',
                    success: function (response) {
                        const address = response.resultObj || response;
                        setCheckoutAddress(address);
                        $('#changeAddressModal').modal('hide');
                    },
                    error: function (xhr) {
                        alert('Lỗi khi cập nhật địa chỉ.');
                    }
                });
            }

            // Khởi tạo
            loadProvinces('#province');

            // Load provinces cho modal thêm địa chỉ mới khi modal được mở
            $('#addNewAddressModal').on('show.bs.modal', function () {
                loadProvinces('#modal-province');
                // Reset form
                $('#modal-receiver-name').val('');
                $('#modal-phone-number').val('');
                $('#modal-detail-address').val('');
                $('#modal-province').val('');
                $('#modal-district').html('<option value="">Chọn quận / huyện</option>').prop('disabled', true);
                $('#modal-ward').html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                // Đảm bảo changeAddressModal vẫn mở
                $('#changeAddressModal').modal('show');
            });

            // Xử lý khi chọn tỉnh/thành
            $('#province, #modal-province').on('change', function () {
                const provinceId = $(this).val();
                const districtSelector = $(this).attr('id') === 'province' ? '#district' : '#modal-district';
                const wardSelector = $(this).attr('id') === 'province' ? '#ward' : '#modal-ward';
                loadDistricts(provinceId, districtSelector, wardSelector);
            });

            // Xử lý khi chọn quận/huyện
            $('#district, #modal-district').on('change', function () {
                const districtId = $(this).val();
                const wardSelector = $(this).attr('id') === 'district' ? '#ward' : '#modal-ward';
                loadWards(districtId, wardSelector);
            });

            // Click "Thay đổi" địa chỉ
            $('#btnChangeAddress').click(function (e) {
                e.preventDefault();
                selectedAddressId = null; // Reset địa chỉ được chọn
                loadUserAddresses();
                $('#changeAddressModal').modal('show');
            });

            // Click vào địa chỉ để chọn
            $(document).on('click', '.address-item', function () {
                $('.address-item').removeClass('selected');
                $(this).addClass('selected');
                selectedAddressId = $(this).data('address-id');
                $(this).find('.address-radio').prop('checked', true); // Chọn radio button tương ứng
            });

            // Xử lý khi click radio button
            $(document).on('change', '.address-radio', function () {
                const addressId = $(this).val();
                selectedAddressId = addressId;
                $('.address-item').removeClass('selected');
                $(this).closest('.address-item').addClass('selected');
                setDefaultAddress(addressId); // Đặt địa chỉ này làm mặc định
            });

            // Click "Đặt làm mặc định"
            $(document).on('click', '.set-default', function (e) {
                e.stopPropagation(); // Ngăn sự kiện click trên address-item
                const addressId = $(this).data('address-id');
                selectedAddressId = addressId;
                $(this).closest('.address-item').find('.address-radio').prop('checked', true); // Chọn radio button tương ứng
                $('.address-item').removeClass('selected');
                $(this).closest('.address-item').addClass('selected');
                setDefaultAddress(addressId); // Đặt địa chỉ này làm mặc định
            });

            // Click "Xác nhận" trong changeAddressModal
            $('#confirm-address').click(function () {
                var selectedRadio = $('.address-radio:checked');
                if (selectedRadio.length > 0) {
                    var addressId = selectedRadio.val();
                    $.ajax({
                        url: `/DiaChi/GetById?id=${addressId}`,
                        type: 'GET',
                        success: function (response) {
                            var address = response.resultObj || response;
                            setCheckoutAddress(address);
                            $('#changeAddressModal').modal('hide');
                        }
                    });
                } else {
                    // Nếu không chọn gì, lấy lại địa chỉ mặc định mới nhất
                    $.ajax({
                        url: '/DiaChi/GetAll',
                        type: 'GET',
                        success: function (addresses) {
                            var defaultAddress = null;
                            if (addresses && addresses.length > 0) {
                                defaultAddress = addresses.find(a => a.mac_Dinh);
                            }
                            if (defaultAddress) {
                                setCheckoutAddress(defaultAddress);
                            }
                            $('#changeAddressModal').modal('hide');
                        }
                    });
                }
            });

            // Click "Hủy" hoặc "X" trong addNewAddressModal
            $('#cancel-new-address, #close-new-address').click(function () {
                $('#addNewAddressModal').modal('hide');
                $('#changeAddressModal').modal('show');
            });

            // Click "Lưu địa chỉ mới"
            $('#save-new-address').click(function () {
                const receiverName = $('#modal-receiver-name').val();
                const phoneNumber = $('#modal-phone-number').val();
                const province = $('#modal-province option:selected').data('name');
                const provinceId = $('#modal-province').val();
                const district = $('#modal-district option:selected').data('name');
                const districtId = $('#modal-district').val();
                const ward = $('#modal-ward option:selected').data('name');
                const wardCode = $('#modal-ward').val();
                const detailAddress = $('#modal-detail-address').val();

                if (!receiverName || !phoneNumber || !province || !district || !ward || !detailAddress) {
                    alert('Vui lòng điền đầy đủ thông tin địa chỉ.');
                    return;
                }

                const newAddress = {
                    tenNguoiNhan: receiverName,
                    soDienThoai: phoneNumber,
                    tenDiaChi: detailAddress,
                    tenThanhPho: province,
                    tenHuyen: district,
                    tenXa: ward,
                    maTinh: provinceId,
                    maHuyen: districtId,
                    maXa: wardCode,
                    mac_Dinh: false
                };

                $.ajax({
                    url: '/DiaChi/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(newAddress),
                    success: function (response) {
                        loadUserAddresses();
                        $('#addNewAddressModal').modal('hide');
                        $('#changeAddressModal').modal('show');
                    },
                    error: function (xhr) {
                        alert('Lỗi khi thêm địa chỉ.');
                    }
                });
            });

            // Xử lý radio thanh toán
            let lastSelectedRadio = null;
            $('.payment-btn input[type="radio"]').on('click', function () {
                const $radio = $(this);
                if ($radio.is(':checked') && lastSelectedRadio === $radio[0]) {
                    $radio.prop('checked', false);
                    $('#selectedPayment').val('');
                    lastSelectedRadio = null;
                } else {
                    $('#selectedPayment').val($radio.val());
                    lastSelectedRadio = $radio[0];
                    $('#paymentError').hide();
                }
            });

            // Kiểm tra khi submit
            $('#checkoutForm').on('submit', function (e) {
                if (!$('.payment-btn input[type="radio"]:checked').length) {
                    e.preventDefault();
                    $('#paymentError').show();
                    return false;
                }
            });
        });
    </script>
}

<!-- Modal chọn địa chỉ -->
<div class="modal fade" id="changeAddressModal" tabindex="-1" aria-labelledby="changeAddressLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chọn địa chỉ giao hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <!-- Danh sách địa chỉ -->
                <div id="addressList" class="mb-4">
                    <h6>Danh sách địa chỉ của tôi</h6>
                    <div id="addressItems"></div>
                </div>
                <!-- Nút thêm địa chỉ mới -->
                <button id="btnAddNewAddress" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#addNewAddressModal">Thêm địa chỉ mới</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="confirm-address" class="btn btn-primary">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm địa chỉ mới -->
<div class="modal fade" id="addNewAddressModal" tabindex="-1" aria-labelledby="addNewAddressLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNewAddressLabel">Thêm địa chỉ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng" id="close-new-address"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
