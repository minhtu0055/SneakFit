@using SneakFit.WebClient.Models
@model CheckoutViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Thanh Toán";
}

<main class="main py-4 bg-light">
    <div class="container">

        <!-- Địa chỉ nhận hàng -->
        <div class="section-box address-box mb-4">
            <div class="address-details">
                <h5><i class="bi bi-geo-alt-fill"></i> Địa chỉ nhận hàng</h5>
                <div class="address-info">
                    <div class="address-text">
                        <p class="mb-1"><strong>@Model.HoTen</strong> <span class="text-muted">(@Model.SoDienThoai)</span></p>
                        <p class="mb-0">@Model.DiaChi</p>
                    </div>
                    <div class="address-actions">
                        <a href="#" id="btnChangeAddress" class="btn btn-change">Thay đổi</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="section-box product-list mb-4" style="border-radius: 10px;">
            <h5>Sản phẩm</h5>
            @foreach (var item in Model.GioHangItems)
            {
                <div class="product-item d-flex align-items-center mb-3" style="border-radius: 10px;">
                    @{
                        var defaultImage = $"{baseUrl}/images/Default_Logo.png";
                        string imageUrl = defaultImage;

                        if (!string.IsNullOrEmpty(item.AnhSanPham))
                        {
                            imageUrl = $"{baseUrl}{item.AnhSanPham}";
                        }
                    }
                    <img src="@imageUrl" class="product-img" style="margin-left: 10px;" onerror="this.src='@defaultImage'" />
                    <div class="product-info" style="align-items: center;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <p class="mb-0 fw-semibold">
                                @item.TenSanPham (Màu: @item.MauSac,Kích cỡ: @item.KichThuoc)
                            </p>
                            @if (item.PhanTramGiamGia > 0)
                            {
                                <span class="discount " style="font-size: 0.85rem; margin-bottom: 1.5px;">
                                    Giảm @item.PhanTramGiamGia%
                                </span>
                            }
                        </div>
                        <small class="text-muted" style="font-weight: bold; font-size: 15px">Số lượng: @item.SoLuong</small>
                    </div>
                    <div class="product-price ms-auto" style="margin-right: 10px;">
                        @if (item.GiaKhuyenMai < item.GiaGoc)
                        {
                            <span class="text-danger">@item.GiaKhuyenMai.ToString("N0") ₫</span>
                            <br />
                            <span class="text-muted text-decoration-line-through">@item.GiaGoc.ToString("N0") ₫</span>
                        }
                        else
                        {
                            <span>@item.GiaGoc.ToString("N0") ₫</span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Phương thức vận chuyển -->
        <div class="section-box shipping-method mb-4">
            <h5>Phương thức vận chuyển</h5>

            <div class="shipping-info">
                Phí vận chuyển: <strong id="shipping-fee">@Model.PhiVanChuyen.ToString("N0") ₫</strong>
            </div>
        </div>

        <!-- Chọn voucher -->
        <div class="section-box voucher-section mb-4">
            <h5>Chọn voucher</h5>
            <div class="d-flex justify-content-between align-items-center">
                <div class="voucher-list flex-grow-1" id="selectedVoucherContainer">
                    <span id="selectedVoucherText">Chưa chọn voucher</span>
                </div>
                <div class="voucher-action ms-3">
                    <button type="button" class="btn btn-outline-primary" id="btnSelectVoucher" data-bs-toggle="modal" data-bs-target="#voucherModal">Chọn voucher</button>
                </div>
            </div>
        </div>

        <!-- Hình thức thanh toán -->
        <div class="section-box payment-method mb-4">
            <h5>Hình thức thanh toán</h5>
            <div class="payment-options" style="align-items: center;">
                <label class="payment-btn">
                    <input type="radio" name="HinhThucThanhToan" id="cod" value="COD">
                    <span>Thanh toán khi nhận hàng (COD)</span>
                </label>
                <label class="payment-btn">
                    <input type="radio" name="HinhThucThanhToan" id="VnPay" value="VnPay">
                    <span>Thanh toán VnPay</span>
                </label>
                <label class="payment-btn">
                    <input type="radio" name="HinhThucThanhToan" id="MoMo" value="MoMo">
                    <span>Thanh toán MoMo</span>
                </label>
                <span id="paymentError" class="text-danger" style="display:none;">Vui lòng chọn một hình thức thanh toán.</span>
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div class="section-box order-summary">
            <h5>Tóm tắt đơn hàng</h5>
            <div class="summary-item">
                <span>Tổng tiền hàng</span>
                <span id="summary-products">@Model.TongTienSanPham.ToString("N0") ₫</span>
            </div>
            <div class="summary-item" id="summary-voucher" style="display:@((Model.VoucherId != null && Model.DiscountAmount > 0) ? "flex" : "none")">
                <span>Áp dụng voucher</span>
                <span class="text-danger" id="summary-voucher-amount">-@((Model.DiscountAmount ?? 0).ToString("N0")) ₫</span>
            </div>
            <div class="summary-item">
                <span>Phí vận chuyển</span>
                <span id="summary-shipping">@Model.PhiVanChuyen.ToString("N0") ₫</span>
            </div>
            <div class="summary-item fw-bold fs-5">
                <span>Tổng thanh toán</span>
                <span id="summary-total">@((Model.TongTienSanPham + Model.PhiVanChuyen - (Model.DiscountAmount ?? 0)).ToString("N0")) ₫</span>
            </div>

            <!-- Hiển thị validation errors -->
            @if (ViewData.ModelState.Count > 0 && !ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <form method="post" asp-action="Checkout" asp-controller="ThanhToan" id="checkoutForm">
                <input type="hidden" asp-for="HoTen" id="HoTenInput" value="@Model.HoTen" />
                <input type="hidden" asp-for="SoDienThoai" id="SoDienThoaiInput" value="@Model.SoDienThoai" />
                @* <input type="hidden" asp-for="Email" value="@Model.Email" /> *@
                <input type="hidden" asp-for="DiaChi" id="DiaChiInput" value="@Model.DiaChi" />
                <input type="hidden" asp-for="GhiChu" value="@Model.GhiChu ?? string.Empty" />
                <input type="hidden" asp-for="PhiVanChuyen" value="@Model.PhiVanChuyen" />
                <input type="hidden" asp-for="TongTienSanPham" value="@Model.TongTienSanPham" />
                <input type="hidden" asp-for="DiaChiMoi" id="HiddenAddressInput" value="@Model.DiaChiMoi ?? string.Empty" />
                <input type="hidden" asp-for="PhuongThucThanhToan" id="selectedPayment" value="" />
                <!-- Hidden voucher fields -->
                <input type="hidden" asp-for="VoucherId" id="VoucherId" />
                <input type="hidden" asp-for="DiscountAmount" id="DiscountAmount" />
                <input type="hidden" name="VoucherCode" id="VoucherCode" />
                <input type="hidden" name="VoucherType" id="VoucherType" />
                <input type="hidden" name="VoucherValue" id="VoucherValue" />
                <input type="hidden" name="VoucherMax" id="VoucherMax" />
                <input type="hidden" name="VoucherDiscountAmount" id="VoucherDiscountAmount" />
                <button type="submit" class="btn btn-danger btn-checkout mt-3" id="submitBtn">Đặt hàng</button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        const baseUrl = '@baseUrl';
        const userId = '@User.FindFirst("UserId")?.Value' || '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
        const defaultAddressId = '@Model.DefaultAddressId'; // Thêm biến từ model
        let selectedAddressId = null; // Biến để theo dõi địa chỉ được chọn tạm thời trong checkout
        let selectedVoucher = null;
        let tempSelectedAddress = null; // Biến để lưu địa chỉ tạm thời khi chọn trong modal
        let currentAddress = null; // Biến để lưu địa chỉ hiện tại đang dùng

        $(document).ready(function () {
            // Xóa dữ liệu cũ trong sessionStorage khi load trang để đảm bảo chọn địa chỉ mới
            sessionStorage.removeItem('selectedAddressId');
            selectedAddressId = null;

            // Hàm chung để load dữ liệu cho dropdown
            function loadDropdown(url, selector, defaultOption, valueField, textField, callback) {
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        console.log('Response from API:', response);
                        const items = response.data || response;

                        if (!Array.isArray(items) || items.length === 0) {
                            console.warn(`Dữ liệu không hợp lệ từ ${url}:`, items);
                            $(selector).html(`<option value="">Lỗi: Không có dữ liệu</option>`);
                            return;
                        }

                        let options = `<option value="">${defaultOption}</option>`;
                        items.forEach(item => {
                            options += `<option value="${item[valueField]}" data-name="${item[textField]}">${item[textField]}</option>`;
                        });
                        $(selector).html(options);

                        if (callback) callback();
                    },
                    error: function (xhr) {
                        console.error(`Lỗi khi tải dữ liệu từ ${url}: ${xhr.status} - ${xhr.responseText}`);
                        $(selector).html(`<option value="">Lỗi: ${xhr.status}</option>`);
                    }
                });
            }

            // Load tỉnh/thành
            function loadProvinces(selector, callback) {
                loadDropdown(`${baseUrl}/api/ghn/provinces`, selector, 'Chọn tỉnh / thành', 'ProvinceID', 'ProvinceName', callback);
            }

            // Load quận/huyện theo tỉnh
            function loadDistricts(provinceId, districtSelector, wardSelector, callback) {
                if (!provinceId) {
                    $(districtSelector).html('<option value="">Chọn quận / huyện</option>').prop('disabled', true);
                    $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                    if (callback) callback();
                    return;
                }

                $(districtSelector).prop('disabled', false);
                $.ajax({
                    url: `${baseUrl}/api/ghn/districts`,
                    type: 'GET',
                    success: function (response) {
                        console.log('Districts response:', response);
                        const allDistricts = response.data || response;

                        if (!Array.isArray(allDistricts)) {
                            console.warn('Dữ liệu districts không hợp lệ:', allDistricts);
                            $(districtSelector).html('<option value="">Lỗi: Không có dữ liệu</option>');
                            if (callback) callback();
                            return;
                        }

                        const filteredDistricts = allDistricts.filter(district =>
                            district.ProvinceID == provinceId
                        );

                        console.log('Filtered districts:', filteredDistricts);
                        if (filteredDistricts.length === 0) {
                            $(districtSelector).html('<option value="">Không có quận/huyện</option>');
                            if (callback) callback();
                            return;
                        }

                        let options = '<option value="">Chọn quận / huyện</option>';
                        filteredDistricts.forEach(district => {
                            options += `<option value="${district.DistrictID}" data-name="${district.DistrictName}">${district.DistrictName}</option>`;
                        });
                        $(districtSelector).html(options);
                        if (callback) callback();
                    },
                    error: function (xhr) {
                        console.error('Lỗi khi tải districts:', xhr.status, xhr.responseText);
                        $(districtSelector).html('<option value="">Lỗi: Không thể tải dữ liệu</option>');
                        if (callback) callback();
                    }
                });

                $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
            }

            // Load phường/xã theo quận/huyện
            function loadWards(districtId, wardSelector, callback) {
                if (!districtId) {
                    $(wardSelector).html('<option value="">Chọn phường / xã</option>').prop('disabled', true);
                    if (callback) callback();
                    return;
                }

                $(wardSelector).prop('disabled', false);
                loadDropdown(`${baseUrl}/api/ghn/wards/${districtId}`, wardSelector, 'Chọn phường / xã', 'WardCode', 'WardName', callback);
            }

            // Load danh sách địa chỉ của người dùng
            function loadUserAddresses(callback) {
                $.ajax({
                    url: '/DiaChi/GetAll',
                    type: 'GET',
                    success: function (addresses) {
                        let addressHtml = '';
                        let defaultAddress = null;
                        if (!addresses || addresses.length === 0) {
                            addressHtml = '<p>Chưa có địa chỉ nào. Vui lòng thêm địa chỉ mới.</p>';
                        } else {
                            // Sắp xếp để địa chỉ mặc định lên đầu
                            let defaultAddr = addresses.find(a => a.macDinh);
                            let otherAddrs = addresses.filter(a => !a.macDinh);
                            let sortedAddresses = defaultAddr ? [defaultAddr, ...otherAddrs] : otherAddrs;

                            sortedAddresses.forEach(address => {
                                if (address.macDinh) {
                                    defaultAddress = address;
                                }
                                addressHtml += `
                                    <div class="address-item mb-3 p-3 border rounded d-flex align-items-center justify-content-between ${address.macDinh ? 'selected' : ''}" data-address-id="${address.id}" style="cursor: pointer;">
                                        <div class="address-content">
                                            <div class="address-radio">
                                                <input type="radio" name="addressRadio" class="address-radio-default" value="${address.id}" ${selectedAddressId === address.id ? 'checked' : ''} style="margin-right: 10px; width: 20px; height: 20px;">
                                            </div>
                                            <div class="address-text">
                                                <p class="mb-1"><strong>${address.tenNguoiNhan}</strong> <span class="text-muted">(${address.soDienThoai})</span></p>
                                                <p class="mb-1">${address.tenDiaChi}, ${address.tenXa}, ${address.tenHuyen}, ${address.tenThanhPho}</p>
                                                ${address.macDinh ? '<span class="badge align-middle" style="min-width:80px; text-align:center;">Mặc Định</span>' : ''}
                                            </div>
                                        </div>
                                        <div class="address-actions">
                                            <button class="btn btn-edit btn-sm" data-address-id="${address.id}">Sửa đổi</button>
                                        </div>
                                    </div>`;
                            });
                        }
                        $('#addressItems').html(addressHtml);
                        if (defaultAddress && !selectedAddressId) {
                            selectedAddressId = defaultAddress.id; // Gán mặc định nếu chưa có lựa chọn
                            $('.address-item[data-address-id="' + selectedAddressId + '"] .address-radio-default').prop('checked', true);
                            $('.address-item[data-address-id="' + selectedAddressId + '"]').addClass('selected');
                        }
                        if (callback) callback(); // Gọi callback sau khi tải xong
                    },
                    error: function (xhr) {
                        $('#addressItems').html('<p>Lỗi khi tải danh sách địa chỉ.</p>');
                        if (callback) callback(); // Gọi callback ngay cả khi có lỗi
                    }
                });
            }

            // Hàm cập nhật phí vận chuyển theo địa chỉ mới
            function updateShippingFee(address) {
                if (!address.maHuyen || !address.maXa) {
                    alert('Địa chỉ không đầy đủ để tính phí vận chuyển.');
                    return;
                }
                
                // Hiển thị loading
                $('#shipping-fee').html('<div class="spinner-border spinner-border-sm text-primary" role="status"></div> Đang tính...');
                
                $.ajax({
                    url: baseUrl + '/api/ghn/shipping-fee',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        FromDistrictId: 0, // Server sẽ tự động set địa chỉ shop
                        ToDistrictId: parseInt(address.maHuyen),
                        ToWardCode: address.maXa,
                        Weight: 700,
                        Length: 33,
                        Width: 20,
                        Height: 12,
                        ServiceId: 53321
                    }),
                    success: function(response) {
                        var json = typeof response === 'string' ? JSON.parse(response) : response;
                        var newFee = 0;
                        
                        if (json && json.data && (json.data.total || json.data.service_fee)) {
                            newFee = json.data.total || json.data.service_fee;
                            $('#shipping-fee').text(newFee.toLocaleString('vi-VN') + ' ₫');
                            $('#summary-shipping').text(newFee.toLocaleString('vi-VN') + ' ₫');
                            $('input[asp-for="PhiVanChuyen"]').val(newFee); // Update lại hidden input
                            
                            // Cập nhật lại summary sau khi thay đổi phí vận chuyển
                            updateOrderSummary(selectedVoucher);
                        } else {
                            $('#shipping-fee').text('Không tính được');
                            $('input[asp-for="PhiVanChuyen"]').val(0);
                            alert('Không thể tính phí vận chuyển cho địa chỉ này.');
                        }
                    },
                    error: function(xhr) {
                        $('#shipping-fee').text('Lỗi tính phí');
                        $('input[asp-for="PhiVanChuyen"]').val(0);
                        console.error('Lỗi khi tính phí vận chuyển:', xhr.responseJSON || xhr.statusText);
                        alert('Lỗi khi tính phí vận chuyển.');
                    }
                });
            }

            // Hàm khi chọn "Xác nhận" địa chỉ mặc định trong modal
            $('#confirm-address').click(function () {
                if (!selectedAddressId) {
                    alert('Vui lòng chọn một địa chỉ.');
                    return;
                }
                
                // Thực sự cập nhật địa chỉ khi bấm xác nhận
                fetch(`/DiaChi/GetById?id=${selectedAddressId}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        const address = data.resultObj || data;
                        if (address && address.maHuyen && address.maXa) {
                            currentAddress = address; // Lưu địa chỉ hiện tại
                            setCheckoutAddress(address, true); // Thực sự cập nhật địa chỉ và tính phí ship
                            $('#changeAddressModal').modal('hide');
                            $('#addressPreview').hide(); // Ẩn preview
                        } else {
                            console.warn('Địa chỉ không đầy đủ thông tin:', address);
                            alert('Địa chỉ không đầy đủ thông tin để tính phí vận chuyển.');
                        }
                    })
                    .catch(error => {
                        console.error('Lỗi khi cập nhật địa chỉ:', error);
                        alert('Lỗi khi cập nhật địa chỉ.');
                    });
            });

            // Hàm cập nhật địa chỉ nhận hàng trên giao diện Checkout
            function setCheckoutAddress(address, shouldUpdateShippingFee = true) {
                const fullAddress = `${address.tenDiaChi}, ${address.tenXa}, ${address.tenHuyen}, ${address.tenThanhPho}`;
                $('.address-box p:last').text(fullAddress);
                $('.address-box p:first strong').text(address.tenNguoiNhan);
                $('.address-box p:first span').text(`(${address.soDienThoai})`);
                $('#HoTenInput').val(address.tenNguoiNhan);
                $('#SoDienThoaiInput').val(address.soDienThoai);
                $('#DiaChiInput').val(fullAddress);
                $('#HiddenAddressInput').val(fullAddress);
                $('#HiddenAddressInput').data('address-id', address.id); // Lưu id vào data attribute
                if (shouldUpdateShippingFee) {
                    updateShippingFee(address);
                }
            }

            // Đặt địa chỉ mặc định
            function setDefaultAddress(addressId) {
                fetch(`/DiaChi/SetDefault?id=${addressId}`, {
                    method: 'PUT'
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(response => {
                    selectedAddressId = addressId; // Cập nhật selectedAddressId sau khi set default
                    loadUserAddresses(); // Tải lại danh sách để phản ánh trạng thái mới
                    sessionStorage.setItem('selectedAddressId', addressId); // Lưu vào sessionStorage
                    
                    // Cập nhật preview sau khi đặt địa chỉ mặc định
                    setTimeout(function() {
                        fetch(`/DiaChi/GetById?id=${addressId}`)
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error(`HTTP error! status: ${response.status}`);
                                }
                                return response.json();
                            })
                            .then(data => {
                                const address = data.resultObj || data;
                                if (address && address.maHuyen && address.maXa) {
                                    updateAddressPreview(address); // Chỉ cập nhật preview
                                } else {
                                    console.warn('Địa chỉ mặc định không đầy đủ thông tin:', address);
                                    $('#addressPreview').hide();
                                }
                            })
                            .catch(error => {
                                console.error('Lỗi khi cập nhật preview sau khi đặt mặc định:', error);
                            });
                    }, 500); // Delay 500ms để đảm bảo địa chỉ đã được cập nhật
                })
                .catch(error => {
                    console.error('Lỗi khi đặt địa chỉ mặc định:', error);
                });
            }

            // Cập nhật địa chỉ trên form thanh toán (tạm thời trong phiên checkout)
            function updateCheckoutAddress(addressId) {
                if (!addressId) {
                    alert('Vui lòng chọn một địa chỉ.');
                    return;
                }
                $.ajax({
                    url: `/DiaChi/GetById?id=${addressId}`,
                    type: 'GET',
                    success: function (response) {
                        const address = response.resultObj || response;
                        setCheckoutAddress(address, true);
                        $('#changeAddressModal').modal('hide');
                        selectedAddressId = addressId; // Lưu tạm thời cho lần checkout này
                    },
                    error: function (xhr) {
                        alert('Lỗi khi cập nhật địa chỉ.');
                    }
                });
            }

            // Load dữ liệu địa chỉ vào modal sửa đổi
            function loadAddressToEditModal(addressId) {
                $.ajax({
                    url: `/DiaChi/GetById?id=${addressId}`,
                    type: 'GET',
                    success: function (response) {
                        const address = response.resultObj || response;
                        $('#edit-receiver-name').val(address.tenNguoiNhan);
                        $('#edit-phone-number').val(address.soDienThoai);
                        $('#edit-detail-address').val(address.tenDiaChi);
                        loadProvinces('#edit-province', function () {
                            $('#edit-province').val(address.maTinh);
