                `;
                $('#selectedVoucherText').html(html);
                $('#voucherModal').modal('hide');

                // Cập nhật summary
                updateOrderSummary(selectedVoucher);

                // Xóa voucher
                $('.btn-remove-voucher').on('click', function () {
                    selectedVoucher = null;
                    $('#selectedVoucherText').html('<span>Chưa chọn voucher</span>');
                    setVoucherHiddenFields(null, 0);
                    updateOrderSummary(null);
