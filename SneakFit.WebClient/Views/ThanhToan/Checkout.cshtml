            // Function tính toán và cập nhật order summary
            function updateOrderSummary(voucher) {
                // var tongSanPham = parseFloat($('#summary-products').text().replaceAll('.', '').replace(' ₫', '').replace(',', '')) || 0;
                var tongSanPham = parseFloat($('#summary-products').text().replace(/\./g, '').replace(/,/g, '').replace(' ₫', '')) || 0;
                var phiVanChuyen = parseFloat($('#summary-shipping').text().replaceAll('.', '').replace(' ₫', '').replace(',', '')) || 0;
                var discountAmount = 0;

                if (voucher) {
                    var value = parseFloat(voucher.value) || 0;
                    var max = voucher.max ? parseFloat(voucher.max) : null;
                    var condition = parseFloat(voucher.condition) || 0;

                    if (tongSanPham < condition) {
                        alert('Đơn hàng chưa đủ điều kiện áp dụng voucher.');
                        setVoucherHiddenFields(null, 0);
                        $('#summary-voucher').hide();
                        $('#summary-total').text((tongSanPham + phiVanChuyen).toLocaleString('vi-VN') + ' ₫');
                        return;
                    }

                    if (voucher.type == 0) { // %
                        discountAmount = (tongSanPham * value) / 100;
                        if (max && discountAmount > max) {
                            discountAmount = max;
                        }
                    } else { // Tiền cố định
                        discountAmount = value;
                        if (discountAmount > tongSanPham) {
                            discountAmount = tongSanPham;
                        }
                    }

                    setVoucherHiddenFields(voucher, discountAmount);
                } else {
                    setVoucherHiddenFields(null, 0);
                }

                if (discountAmount > 0) {
                    $('#summary-voucher-amount').text('-' + discountAmount.toLocaleString('vi-VN') + ' ₫');
                    $('#summary-voucher').show();
                } else {
                    $('#summary-voucher').hide();
                }

                var tongThanhToan = tongSanPham - discountAmount + phiVanChuyen;
                if (tongThanhToan < 0) tongThanhToan = 0;
                $('#summary-total').text(tongThanhToan.toLocaleString('vi-VN') + ' ₫');

                $('#VoucherId').val(voucher ? voucher.id : '');
                $('#DiscountAmount').val(discountAmount);
            }

            // Function set hidden fields (đã có sẵn, giữ nguyên)
            function setVoucherHiddenFields(voucher, discountAmount) {
                if (voucher) {
                    $('#VoucherId').val(voucher.id);
                    $('#VoucherCode').val(voucher.maVoucher);
                    $('#VoucherType').val(voucher.type);
                    $('#VoucherValue').val(voucher.value);
                    $('#VoucherMax').val(voucher.max || '');
                    $('#VoucherDiscountAmount').val(discountAmount || 0);
                } else {
                    $('#VoucherId').val('');
                    $('#VoucherCode').val('');
                    $('#VoucherType').val('');
                    $('#VoucherValue').val('');
                    $('#VoucherMax').val('');
                    $('#VoucherDiscountAmount').val('');
                }
            }

            // Sự kiện khi mở modal voucher: kiểm tra điều kiện và sắp xếp
            $('#voucherModal').on('show.bs.modal', function () {
                var tongSanPham = parseFloat($('#summary-products').text().replace(/\./g, '').replace(/,/g, '').replace(' ₫', '')) || 0;
                var voucherCards = [];
                $('#voucherList .voucher-card').each(function () {
                    var $card = $(this);
                    var $btn = $card.find('.btn-apply-voucher');
                    var condition = parseFloat($btn.data('voucher-condition')) || 0;
                    var type = parseInt($btn.data('voucher-type'));
                    var value = parseFloat($btn.data('voucher-value')) || 0;
                    var max = parseFloat($btn.data('voucher-max')) || 0;
                    var discount = 0;

                    // Kiểm tra điều kiện
                    if (tongSanPham < condition) {
                        $btn.prop('disabled', true);
                        $card.addClass('disabled');
                        $card.css('opacity', 0.5);
                        discount = 0;
                    } else {
                        $btn.prop('disabled', false);
                        $card.removeClass('disabled');
                        $card.css('opacity', 1);
                        // Tính số tiền giảm thực tế
                        if (type === 0) { // %
                            discount = tongSanPham * value / 100;
                            if (max > 0 && discount > max) discount = max;
                        } else { // Tiền cố định
                            discount = value;
                            if (discount > tongSanPham) discount = tongSanPham;
                        }
                    }
                    voucherCards.push({ card: $card, discount: discount });
                });

                // Sắp xếp voucher đủ điều kiện theo discount giảm dần
                voucherCards.sort(function (a, b) {
                    return b.discount - a.discount;
                });

                // Đưa các voucher đủ điều kiện lên đầu
                var $voucherList = $('#voucherList');
                var colWrappers = [];
                voucherCards.forEach(function (item) {
                    // .voucher-card nằm trong .col-md-6
                    colWrappers.push(item.card.closest('.col-md-6'));
                });
                $voucherList.empty();
                colWrappers.forEach(function ($col) {
                    $voucherList.append($col);
                });
            });

            // Hàm cập nhật preview địa chỉ trong modal (không thực sự thay đổi)
            function updateAddressPreview(address) {
                tempSelectedAddress = address; // Lưu địa chỉ tạm thời
                
                // Cập nhật preview trong modal
                const fullAddress = `${address.tenDiaChi}, ${address.tenXa}, ${address.tenHuyen}, ${address.tenThanhPho}`;
                
                // Hiển thị preview ở đâu đó trong modal (có thể thêm div preview)
                if ($('#addressPreview').length === 0) {
                    // Tạo div preview nếu chưa có
                    $('#changeAddressModal .modal-body').prepend(`
                        <div id="addressPreview" class="alert alert-info mb-3" style="display: none;">
                            <h6><i class="bi bi-info-circle"></i> Xem trước địa chỉ:</h6>
                            <p class="mb-1"><strong>${address.tenNguoiNhan}</strong> <span class="text-muted">(${address.soDienThoai})</span></p>
                            <p class="mb-0">${fullAddress}</p>
                        </div>
                    `);
                } else {
                    // Cập nhật nội dung preview
                    $('#addressPreview').html(`
                        <h6><i class="bi bi-info-circle"></i> Xem trước địa chỉ:</h6>
                        <p class="mb-1"><strong>${address.tenNguoiNhan}</strong> <span class="text-muted">(${address.soDienThoai})</span></p>
                        <p class="mb-0">${fullAddress}</p>
                    `);
                }
                
                $('#addressPreview').show();
                
                // Tính phí ship preview
                if (address.maHuyen && address.maXa) {
                    updateShippingFeePreview(address);
                }
            }

            // Hàm tính phí ship preview (chỉ hiển thị, không lưu)
            function updateShippingFeePreview(address) {
                if (!address.maHuyen || !address.maXa) {
                    return;
                }
                
                fetch(baseUrl + '/api/ghn/shipping-fee', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        FromDistrictId: 0,
                        ToDistrictId: parseInt(address.maHuyen),
                        ToWardCode: address.maXa,
                        Weight: 700,
                        Length: 33,
                        Width: 20,
                        Height: 12,
                        ServiceId: 53321
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    try {
                        var newFee = 0;
                        
                        if (data && data.data && (data.data.total || data.data.service_fee)) {
                            newFee = data.data.total || data.data.service_fee;
                            // Hiển thị phí ship preview trong modal
                            if ($('#shippingFeePreview').length === 0) {
                                $('#addressPreview').append(`
                                    <div id="shippingFeePreview" class="mt-2">
                                        <small class="text-muted">Phí vận chuyển dự kiến: <strong>${newFee.toLocaleString('vi-VN')} ₫</strong></small>
                                    </div>
                                `);
                            } else {
                                $('#shippingFeePreview').html(`
                                    <small class="text-muted">Phí vận chuyển dự kiến: <strong>${newFee.toLocaleString('vi-VN')} ₫</strong></small>
                                `);
                            }
                            console.log('Preview - Tính phí vận chuyển:', newFee);
                        }
                    } catch (e) {
                        console.error('Preview - Lỗi khi parse response:', e);
                    }
                })
                .catch(error => {
                    console.error('Preview - Lỗi khi tính phí vận chuyển:', error);
                });
            }

            // Sự kiện khi modal địa chỉ được đóng
            $('#changeAddressModal').on('hidden.bs.modal', function () {
                // Ẩn preview khi đóng modal
                $('#addressPreview').hide();
                tempSelectedAddress = null; // Reset địa chỉ tạm thời
            });
        });
    </script>
}

