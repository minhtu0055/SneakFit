<div class="modal fade" id="voucherModal" tabindex="-1" aria-labelledby="voucherModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="voucherModalLabel">Chọn voucher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div id="voucherList" class="row g-3 voucher-grid">
                    @if ((Model.PrivateVouchers != null && Model.PrivateVouchers.Any()) || (Model.PublicVouchers != null && Model.PublicVouchers.Any()))
                    {
                        // --------- VOUCHER CÁ NHÂN ----------
                        if (Model.PrivateVouchers != null && Model.PrivateVouchers.Any())
                        {
                            <div class="col-12 mb-2">
                                <h6 class="fw-bold text-primary">
                                    <i class="bi bi-person-badge"></i> Voucher cá nhân
                                </h6>
                            </div>
                            @foreach (var voucher in Model.PrivateVouchers.Where(v => v.SoLuong > 0 && v.TrangThai == SneakFit.Data.Enums.TrangThaiGiamGia.HoatDong))
                            {
                                var giaTriGiamGiaFormatted = voucher.GiaTriGiamGia.ToString("#,##0").Replace(",", ".");
                                var giaTriToiDaFormatted = voucher.GiaTriToiDa > 0 ? voucher.GiaTriToiDa.ToString("#,##0").Replace(",", ".") : null;
                                <div class="col-md-6">
                                    <div class="voucher-card mb-3" data-voucher-id="@voucher.Id">
                                        <div class="card-body d-flex flex-column justify-content-between h-100">
                                            <div>
                                                <span class="badge badge-voucher badge-private mb-2">Cá nhân</span>
                                                <h6 class="card-title mb-2 voucher-code">@voucher.MaVoucher</h6>
                                                <p class="mb-2 voucher-value">
                                                    Giảm: <strong>@giaTriGiamGiaFormatted @(voucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ? "%" : "₫")</strong>
                                                </p>
                                                @if (voucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram && giaTriToiDaFormatted != null)
                                                {
                                                    <p class="mb-2 voucher-max">Giá trị tối đa: @giaTriToiDaFormatted ₫</p>
                                                }
                                                <p class="mb-2 voucher-condition">Điều kiện: Đơn từ @voucher.DieuKienApDung.ToString("#,##0").Replace(",", ".") ₫</p>
                                                <p class="mb-2 voucher-expiry">HSD: @voucher.ThoiGianKetThuc.ToString("dd/MM/yyyy")</p>
                                            </div>
                                            <div class="text-end">
                                                <button type="button" class="btn btn-primary btn-apply-voucher"
                                                        data-voucher-id="@voucher.Id"
                                                        data-voucher-name="@voucher.MaVoucher"
                                                        data-voucher-value="@voucher.GiaTriGiamGia"
                                                        data-voucher-type="@((int)voucher.LoaiGiamGia)"
                                                        data-voucher-max="@voucher.GiaTriToiDa"
                                                        data-voucher-condition="@voucher.DieuKienApDung">
                                                    Chọn
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        // --------- VOUCHER CÔNG KHAI ----------
                        if (Model.PublicVouchers != null && Model.PublicVouchers.Any())
                        {
                            <div class="col-12 mb-2 mt-3">
                                <h6 class="fw-bold text-primary">
                                    <i class="bi bi-globe"></i> Voucher công khai
                                </h6>
                            </div>
                            @foreach (var voucher in Model.PublicVouchers.Where(v => v.SoLuong > 0 && v.TrangThai == SneakFit.Data.Enums.TrangThaiGiamGia.HoatDong))
                            {
                                var giaTriGiamGiaFormatted = voucher.GiaTriGiamGia.ToString("#,##0").Replace(",", ".");
                                var giaTriToiDaFormatted = voucher.GiaTriToiDa > 0 ? voucher.GiaTriToiDa.ToString("#,##0").Replace(",", ".") : null;
                                <div class="col-md-6">
                                    <div class="voucher-card mb-3" data-voucher-id="@voucher.Id">
                                        <div class="card-body d-flex flex-column justify-content-between h-100">
                                            <div>
                                                <span class="badge badge-voucher badge-public mb-2">Công khai</span>
                                                <h6 class="card-title mb-2 voucher-code">@voucher.MaVoucher</h6>
                                                <p class="mb-2 voucher-value">
                                                    Giảm: <strong>@giaTriGiamGiaFormatted @(voucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ? "%" : "₫")</strong>
                                                </p>
                                                @if (voucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram && giaTriToiDaFormatted != null)
                                                {
                                                    <p class="mb-2 voucher-max">Giá trị tối đa: @giaTriToiDaFormatted ₫</p>
                                                }
                                                <p class="mb-2 voucher-condition">Điều kiện: Đơn từ @voucher.DieuKienApDung.ToString("#,##0").Replace(",", ".") ₫</p>
                                                <p class="mb-2 voucher-expiry">HSD: @voucher.ThoiGianKetThuc.ToString("dd/MM/yyyy")</p>
                                            </div>
                                            <div class="text-end">
                                                <button type="button" class="btn btn-primary btn-apply-voucher"
                                                        data-voucher-id="@voucher.Id"
                                                        data-voucher-name="@voucher.MaVoucher"
                                                        data-voucher-value="@voucher.GiaTriGiamGia"
                                                        data-voucher-type="@((int)voucher.LoaiGiamGia)"
                                                        data-voucher-max="@voucher.GiaTriToiDa"
                                                        data-voucher-condition="@voucher.DieuKienApDung">
                                                    Chọn
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="col-12"><p>Không có voucher nào khả dụng.</p></div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

