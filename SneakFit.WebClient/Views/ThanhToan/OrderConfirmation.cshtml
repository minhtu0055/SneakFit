﻿@using SneakFit.WebClient.Models
@model OrderConfirmationViewModel
@inject IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
    ViewData["Title"] = "Xác Nhận Đơn Hàng - SneakFit";
}

<main class="main py-4 bg-light">
    <div class="container">
        @* @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        else if (Model.HoaDonClient.TrangThai == SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy)
        {
            <!-- Thông báo đơn hàng đã hủy -->
            <div class="section-box confirmation-message mb-4 text-center">
                <h5><i class="bi bi-x-circle-fill text-danger"></i> Đơn hàng đã bị hủy!</h5>
                <p>Đơn hàng của bạn đã bị hủy do thanh toán thất bại.</p>
                <p>Mã đơn hàng: <strong>@Model.HoaDonClient.MaHoaDon</strong></p>
                <p class="text-muted">Bạn có thể đặt hàng lại nếu muốn.</p>
            </div>
        } *@
        @if (Model.HoaDonClient.TrangThai == SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy)
        {
            <!-- Thông báo đơn hàng đã hủy -->
            <div class="section-box confirmation-message mb-4 text-center">
                <h5><i class="bi bi-x-circle-fill text-danger"></i> Đơn hàng đã bị hủy!</h5>
                <p>Đơn hàng của bạn đã bị hủy do thanh toán thất bại.</p>
                <p>Mã đơn hàng: <strong>@Model.HoaDonClient.MaHoaDon</strong></p>
                <p class="text-muted">Bạn có thể đặt hàng lại nếu muốn.</p>
            </div>
        }
        else
        {
            <!-- Thông báo xác nhận thành công -->
            <div class="section-box confirmation-message mb-4 text-center">
                <h5><i class="bi bi-check-circle-fill text-success"></i> Đặt hàng thành công!</h5>
                <p>Cảm ơn bạn đã mua sắm tại SneakFit. Đơn hàng của bạn đã được ghi nhận.</p>
                <p>Mã đơn hàng: <strong>@Model.HoaDonClient.MaHoaDon</strong></p>
            </div>

            <!-- Thông tin hóa đơn -->
            <div class="section-box order-info mb-4">
                <h5>Thông tin đơn hàng</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Người nhận:</strong> @Model.HoaDonClient.HoTen</p>
                        <p><strong>Số điện thoại:</strong> @Model.HoaDonClient.SoDienThoai</p>
                        <p><strong>Email:</strong> @Model.HoaDonClient.Email</p>
                        <p><strong>Địa chỉ giao hàng:</strong> @Model.HoaDonClient.DiaChi</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày đặt hàng:</strong> @Model.HoaDonClient.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Phương thức thanh toán:</strong> @Model.HoaDonClient.PhuongThucThanhToan</p>
                        @* <p><strong>Trạng thái:</strong> 
                            @if (Model.HoaDonClient.TrangThai == SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy)
                            {
                                <span class="badge bg-danger">@Model.HoaDonClient.TrangThai</span>
                            }
                            else if (Model.HoaDonClient.TrangThai == SneakFit.Data.Enums.TrangThaiHoaDon.ChoVanChuyen)
                            {
                                <span class="badge bg-success">@Model.HoaDonClient.TrangThai</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@Model.HoaDonClient.TrangThai</span>
                            }
                        </p> *@
                        <p>
                            <strong>Trạng thái:</strong>
                            @{
                                var trangThai = Model.HoaDonClient.TrangThai;
                                string trangThaiTexts = trangThai switch
                                {
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoXacNhan => "Chờ xác nhận",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaXacNhan => "Đã xác nhận",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoVanChuyen => "Chờ vận chuyển",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DangVanChuyen => "Đang vận chuyển",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaThanhToan => "Đã thanh toán",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ThanhCong => "Thành công",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy => "Đã hủy",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.TraHang => "Trả hàng",
                                    _ => "Không xác định"
                                };
                                string trangThaiClasss = trangThai switch
                                {
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoXacNhan => "badge bg-warning",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaXacNhan => "badge bg-primary",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ChoVanChuyen => "badge bg-info",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DangVanChuyen => "badge bg-secondary",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaThanhToan => "badge bg-success",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.ThanhCong => "badge bg-success",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.DaHuy => "badge bg-danger",
                                    SneakFit.Data.Enums.TrangThaiHoaDon.TraHang => "badge bg-dark",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@trangThaiClasss">@trangThaiTexts</span>
                        </p>

                        <p><strong>Trạng thái thanh toán:</strong> 
                            @{
                                var trangThaiThanhToan = Model.HoaDonClient.TrangThaiThanhToan;
                                var trangThaiText = trangThaiThanhToan switch
                                {
                                    SneakFit.Data.Enums.TrangThaiThanhToan.DaThanhToan => "Đã thanh toán",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ChuaThanhToan => "Chưa thanh toán",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ThanhToanLoi => "Thanh toán lỗi",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.HoanTien => "Đã hoàn tiền",
                                    _ => trangThaiThanhToan.ToString()
                                };
                                var badgeClass = trangThaiThanhToan switch
                                {
                                    SneakFit.Data.Enums.TrangThaiThanhToan.DaThanhToan => "bg-success",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ChuaThanhToan => "bg-warning",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.ThanhToanLoi => "bg-danger",
                                    SneakFit.Data.Enums.TrangThaiThanhToan.HoanTien => "bg-info",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@trangThaiText</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="section-box product-list mb-4">
                <h5>Sản phẩm trong đơn hàng</h5>
                @if (Model.ChiTietHoaDonClient != null && Model.ChiTietHoaDonClient.Any())
                {
                    @foreach (var item in Model.ChiTietHoaDonClient)
                    {
                        <div class="product-item d-flex align-items-center mb-3">
                            @* <img src="@($"{baseUrl}/images/Default_Logo.png")" class="product-img" style="margin-left: 10px;" /> <!-- Ảnh mặc định nếu không có --> *@
                            @{
                                var defaultImage = $"{baseUrl}/images/Default_Logo.png";
                                string imageUrl = defaultImage;

                                if (!string.IsNullOrEmpty(item.AnhSanPham) && item.AnhSanPham != "/images/Default_Logo.png")
                                {
                                    imageUrl = $"{baseUrl}{item.AnhSanPham}";
                                }
                            }
                            <img src="@imageUrl" class="product-img" style="margin-left: 10px;" onerror="this.src='@defaultImage'" />
                            <div class="product-info">
                                <p class="mb-1">@item.TenSanPham ( @item.TenMauSac, @item.MaKichThuoc )</p>
                                <small class="text-muted">Số lượng: @item.SoLuong</small>
                            </div>
                            <div class="product-price ms-auto" style="margin-right: 10px;">@((item.GiaBan * item.SoLuong).ToString("N0")) ₫</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Không có sản phẩm trong đơn hàng này.</p>
                }
            </div>

            @if (Model.UsedVoucher != null)
            {
                <div class="section-box order-info mb-4">
                    <h5 class="voucher-info-title">
                        <i class="bi bi-ticket-perforated voucher-icon me-2"></i>Voucher đã sử dụng
                    </h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p>
                                <strong>Mã voucher:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.MaVoucher</span>
                            </p>
                            <p>
                                <strong>Loại giảm giá:</strong>
                                <span class="order-info-value">@(Model.UsedVoucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ? "Phần trăm" : "Số tiền")</span>
                            </p>
                            <p>
                                <strong>Giá trị giảm:</strong>
                                <span class="order-info-value">
                                    @(Model.UsedVoucher.LoaiGiamGia == SneakFit.Data.Enums.LoaiGiamGia.PhamTram ?
                                        ($"{Model.UsedVoucher.GiaTriGiamGia}%") : ($"{Model.UsedVoucher.GiaTriGiamGia:N0} ₫"))
                                </span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p>
                                <strong>Điều kiện áp dụng:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.DieuKienApDung.ToString("N0") ₫</span>
                            </p>
                            <p>
                                <strong>Giá trị tối đa:</strong>
                                <span class="order-info-value">@(Model.UsedVoucher.GiaTriToiDa > 0 ? Model.UsedVoucher.GiaTriToiDa.ToString("N0") + " ₫" : "Không giới hạn")</span>
                            </p>
                            <p>
                                <strong>Hiệu lực:</strong>
                                <span class="order-info-value">@Model.UsedVoucher.ThoiGianBatDau.ToString("dd/MM/yyyy") - @Model.UsedVoucher.ThoiGianKetThuc.ToString("dd/MM/yyyy")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Tóm tắt thanh toán -->
            <div class="section-box order-summary mb-4">
                <h5>Tóm tắt thanh toán</h5>
                <div class="summary-item">
                    <span>Tổng tiền hàng</span>
                    <span>@(Model.HoaDonClient.TongTienSanPham.ToString("N0") ?? "0") ₫</span>
                </div>
                @if (Model.HoaDonClient.VoucherDiscount.HasValue && Model.HoaDonClient.VoucherDiscount.Value > 0)
                {
                    <div class="summary-item" id="summary-voucher">
                        <span>Áp dụng voucher</span>
                        <span class="text-danger" id="summary-voucher-amount">-@((Model.HoaDonClient.VoucherDiscount ?? 0).ToString("N0")) ₫</span>
                    </div>
                }
                <div class="summary-item">
                    <span>Phí vận chuyển</span>
                    <span>@Model.HoaDonClient.PhiVanChuyen.ToString("N0") ₫</span>
                </div>
                <hr />
                <div class="summary-item fw-bold fs-5">
                    <span>Tổng thanh toán</span>
                    <span>@Model.HoaDonClient.TongTien.ToString("N0") ₫</span>
                </div>
            </div>

            <!-- Hành động -->
            <div class="section-box actions text-center">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Quay về trang chủ</a>
                <a href="@Url.Action("Details", "HoaDon", new { id = Model.HoaDonClient.Id })" class="btn btn-outline-primary ms-2">Xem chi tiết đơn hàng</a>
            </div>
        }
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
}

<style>
    main.main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-box {
        background-color: #FFFFFF;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

        .section-box:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .section-box h5 {
            font-weight: 600;
            margin-bottom: 15px;
            color: #1E3A8A;
            font-size: 1.4rem;
            border-bottom: 2px solid #60A5FA;
            padding-bottom: 10px;
        }

            .section-box h5 i {
                margin-right: 10px;
                font-size: 1.5rem;
            }

    .confirmation-message {
        background-color: #E6F3FA;
        padding: 30px;
        border-radius: 10px;
    }

        .confirmation-message h5 {
            font-size: 1.6rem;
            color: #1E3A8A;
        }

        .confirmation-message p {
            font-size: 1.1rem;
            color: #4B5563;
            margin: 10px 0;
        }

    .order-info p {
        font-size: 1rem;
        color: #4B5563;
        margin-bottom: 10px;
    }

        .order-info p strong {
            color: #1E3A8A;
        }

    .product-list .product-item {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        padding: 15px 0;
        border-bottom: 1px solid #E5E7EB;
        transition: background 0.3s ease;
    }

        .product-list .product-item:hover {
            background-color: #F1F5F9;
        }

    .product-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #E5E7EB;
        flex-shrink: 0;
    }

    .product-info {
        flex: 1;
        margin-left: 20px;
        min-width: 0;
    }

        .product-info p {
            margin: 0 0 5px 0;
            font-weight: 600;
            font-size: 1.1rem;
            color: #1E3A8A;
        }

    .product-price {
        font-weight: 700;
        color: #1E3A8A;
        font-size: 1.1rem;
        margin-left: auto;
        flex-shrink: 0;
    }

    .order-summary {
        padding: 20px;
        background-color: #FFFFFF;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .summary-item {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 1.1rem;
        color: #4B5563;
    }

        .summary-item span:last-child {
            font-weight: 600;
            color: #1E3A8A;
        }

        .summary-item.fw-bold {
            font-size: 1.3rem;
            color: #1E3A8A;
        }

    .actions .btn {
        padding: 10px 20px;
        font-size: 1.1rem;
        border-radius: 6px;
    }

    .btn-primary {
        background: linear-gradient(90deg, #1E3A8A, #60A5FA);
        border: none;
        color: #FFFFFF;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #3B82F6, #163172);
            box-shadow: 0 4px 15px rgba(30, 58, 138, 0.3);
            transform: translateY(-2px);
        }

    .btn-outline-primary {
        border-color: #60A5FA;
        color: #60A5FA;
    }

            .btn-outline-primary:hover {
        background-color: #60A5FA;
        color: #FFFFFF;
    }

    /* Styles cho thông báo đơn hàng đã hủy */
    .confirmation-message h5 .bi-x-circle-fill {
        color: #DC3545;
        font-size: 1.5rem;
    }

    .confirmation-message .text-danger {
        color: #DC3545 !important;
    }

    .badge {
        font-size: 0.9rem;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
    }

    .badge.bg-danger {
        background-color: #DC3545 !important;
        color: #FFFFFF;
    }

    .badge.bg-success {
        background-color: #198754 !important;
        color: #FFFFFF;
    }

    .badge.bg-warning {
        background-color: #FFC107 !important;
        color: #000000;
    }
</style>