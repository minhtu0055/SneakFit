@model SneakFit.ViewModels.Catalog.TraHang.ReturnViewModel
@using SneakFit.Data.Enums

@{
    ViewData["Title"] = "Chi tiết yêu cầu trả hàng";

    string ToText(ReturnStatus s) => s switch
    {
        ReturnStatus.ChapNhanDuyetHangHoan => "Chờ phê duyệt",
        ReturnStatus.LayHangHoan => "Đang vận chuyển về",
        ReturnStatus.HoanHang => "Đã nhận hoàn hàng",
        ReturnStatus.ThanhCong => "Hoàn hàng thành công",
        ReturnStatus.TuChoi => "Từ chối",
        _ => "Không xác định"
    };

    string ToBadge(ReturnStatus s) => s switch
    {
        ReturnStatus.ChapNhanDuyetHangHoan => "badge bg-warning",
        ReturnStatus.LayHangHoan => "badge bg-info",
        ReturnStatus.HoanHang => "badge bg-primary",
        ReturnStatus.ThanhCong => "badge bg-success",
        ReturnStatus.TuChoi => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    var isRejected = Model.Status == ReturnStatus.TuChoi;
}

<main class="main py-4 bg-light" style="border-radius: 8px;">
    <div class="container">
        @* @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger section-box">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success section-box">@TempData["SuccessMessage"]</div>
        } *@

        <!-- Header / Confirmation-like box -->
        <div class="section-box text-center">
            <span class="check-icon"><i class="bi bi-info-circle-fill text-info"></i></span>
            <h5 class="mt-2">Chi tiết yêu cầu trả hàng</h5>
            <p>Mã yêu cầu: <strong>@Model.Code</strong></p>
            <p>Trạng thái: <span class="@ToBadge(Model.Status)">@ToText(Model.Status)</span></p>
        </div>

        <!-- Info -->
        <div class="section-box">
            <h5>Thông tin yêu cầu</h5>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Ngày tạo:</strong> <span class="order-info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></p>
                    <p><strong>Lý do:</strong> <span class="order-info-value">@Model.Reason</span></p>
                    <p><strong>Hình thức hoàn:</strong> <span class="order-info-value">Hoàn tiền qua tài khoản cá nhân</span></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Lý do:</strong> <span class="order-info-value">@Model.Reason</span></p>
                    @if (!string.IsNullOrEmpty(Model.ShippingCarrier))
                    {
                        <p><strong>Đơn vị vận chuyển:</strong> <span class="order-info-value">@Model.ShippingCarrier</span></p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingCode))
                    {
                        <p><strong>Mã vận đơn:</strong> <span class="order-info-value">@Model.ShippingCode</span></p>
                    }
                    <p>
                        <strong>Hóa đơn liên quan:</strong>
                        <a class="btn btn-sm btn-outline-primary ms-1" asp-controller="HoaDon" asp-action="Details" asp-route-id="@Model.OrderId">
                            Xem hóa đơn
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Status steps (timeline) -->
        <div class="section-box">
            <h5>Tiến trình xử lý</h5>

            <ul class="status-steps">
                <li class="@( !isRejected && Model.Status >= ReturnStatus.ChapNhanDuyetHangHoan ? "active" : "" )">
                    <span class="dot"></span><span>Chờ phê duyệt</span>
                </li>
                <li class="@( !isRejected && Model.Status >= ReturnStatus.LayHangHoan ? "active" : "" )">
                    <span class="dot"></span><span>Đang vận chuyển về</span>
                </li>
                <li class="@( !isRejected && Model.Status >= ReturnStatus.HoanHang ? "active" : "" )">
                    <span class="dot"></span><span>Đã nhận hoàn hàng</span>
                </li>
                <li class="@( !isRejected && Model.Status >= ReturnStatus.ThanhCong ? "active" : "" )">
                    <span class="dot"></span><span>Hoàn hàng thành công</span>
                </li>

                @if (isRejected)
                {
                    <li class="rejected">
                        <span class="dot"></span><span>Đã từ chối</span>
                    </li>
                }
            </ul>
        </div>

        <!-- Actions -->
        <div class="section-box text-center">
            <a class="btn btn-primary" asp-action="Index">Danh sách yêu cầu</a>

            @if (Model.Status == ReturnStatus.ChapNhanDuyetHangHoan)
            {
                <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Xác nhận hủy yêu cầu?');">
                    <input type="hidden" name="id" value="@Model.ReturnId" />
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">Hủy yêu cầu</button>
                </form>
            }
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/assets/css/TraHang.css">
}

<style>
    .main {
        padding: 20px 10px;
        background-color: #F1F5F9;
        font-family: 'Poppins',sans-serif
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%
    }

    .section-box {
        background: #fff;
        padding: 20px;
        border: 1px solid #60A5FA;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        margin-bottom: 25px;
        transition: all .3s ease
    }

        .section-box:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,.1);
            transform: translateY(-2px)
        }

        .section-box h5 {
            font-weight: 600;
            margin-bottom: 15px;
            color: #1E3A8A;
            font-size: 1.4rem;
            border-bottom: 2px solid #60A5FA;
            padding-bottom: 10px
        }

    .check-icon {
        display: inline-block;
        font-size: 2.2rem
    }

    .order-info-value {
        color: #4B5563;
        font-weight: 500;
        margin-left: 4px
    }

    .btn-primary {
        background: linear-gradient(90deg,#1E3A8A,#60A5FA);
        border: none;
        color: #fff;
        padding: 10px 20px;
        border-radius: 6px;
        transition: all .3s
    }

        .btn-primary:hover {
            background: linear-gradient(90deg,#3B82F6,#163172);
            box-shadow: 0 4px 15px rgba(30,58,138,.3);
            transform: translateY(-2px)
        }

    .btn-warning {
        background: linear-gradient(90deg,#60A5FA,#1E3A8A);
        border: none;
        color: #fff
    }

        .btn-warning:hover {
            background: linear-gradient(90deg,#163172,#3B82F6);
            box-shadow: 0 4px 15px rgba(30,58,138,.3);
            transform: translateY(-2px);
            color: #fff
        }

    /* Status steps */
    .status-steps {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px
    }

        .status-steps li {
            position: relative;
            padding: 16px 12px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
            color: #64748B;
            font-weight: 600
        }

            .status-steps li .dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #cbd5e1;
                display: inline-block
            }

            .status-steps li.active {
                background: #E6F3FA;
                border-color: #60A5FA;
                color: #1E3A8A;
                box-shadow: 0 2px 10px rgba(96,165,250,.15)
            }

                .status-steps li.active .dot {
                    background: #1E3A8A
                }

            .status-steps li.rejected {
                background: #fff1f2;
                border-color: #fecdd3;
                color: #e11d48
            }

                .status-steps li.rejected .dot {
                    background: #e11d48
                }

</style>
