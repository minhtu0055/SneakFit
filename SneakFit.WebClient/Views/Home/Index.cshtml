<!-- Product List Section -->
<section id="product-list" class="product-list section">

    <div class="container isotope-layout" data-aos="fade-up" data-aos-delay="100" data-default-filter="*" data-layout="masonry" data-sort="original-order">

        <div class="row">
            <div class="col-12">
                <div class="product-filters isotope-filters mb-5 d-flex justify-content-center" data-aos="fade-up">
                    <ul class="d-flex flex-wrap gap-2 list-unstyled">
                        <li class="filter-active" data-filter="*">All</li>
                        <li data-filter=".filter-clothing">Clothing</li>
                        <li data-filter=".filter-accessories">Accessories</li>
                        <li data-filter=".filter-electronics">Electronics</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row product-container isotope-container" data-aos="fade-up" data-aos-delay="200">
            @if (Model.SanPhams != null && Model.SanPhams.Items.Any())
            {
                @foreach (var item in Model.SanPhams.Items.Where(x => x.TrangThai))
                {
                    var priceInfo = ViewBag.ProductPrices?[item.Id] as Tuple<decimal?, decimal?, string>; // GiaCu, GiaKM, NhanKM
                    var giaCu = priceInfo?.Item1;
                    var giaKM = priceInfo?.Item2;
                    var nhanKM = priceInfo?.Item3;

                    var listGia = Model.AllSpct
                    .Where(x => x.SanPhamId == item.Id && x.Gia > 0)
                    .Select(x => x.Gia)
                    .ToList();

                    <div class="col-md-6 col-lg-3 product-item isotope-item filter-@item.TenDanhMuc?.ToLower().Replace(" ", "-")">
                        <div class="product-card">
                            <div class="product-image position-relative">
                                @if (!string.IsNullOrEmpty(item.ImageDaiDien))
                                {
                                    <img src="@(ViewBag.BaseAddress + item.ImageDaiDien)" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy">
                                    <img src="@(ViewBag.BaseAddress + item.ImageDaiDien)" alt="@item.TenSanPham Hover" class="img-fluid hover-img" loading="lazy">
                                }
                                else
                                {
                                    <img src="~/assets/img/product/no-image.png" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy">
                                    <img src="~/assets/img/product/no-image.png" alt="@item.TenSanPham Hover" class="img-fluid hover-img" loading="lazy">
                                }

                                @if (!string.IsNullOrEmpty(nhanKM))
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">Sale</span>
                                }

                                <div class="product-overlay">
                                    @* <a href="/gio-hang/them/@item.Id" class="btn-cart"><i class="bi bi-cart-plus"></i> Add to Cart</a> *@
                                    <form action="@Url.Action("AddToCart", "Cart")" method="post" class="d-inline" id="cartForm" style="display: none;">
                                        <input type="hidden" name="id" id="selectedSpctId" value="" />
                                        <input type="hidden" name="quantity" id="cartQuantityInput" value="1" />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                                        </button>
                                    </form>
                                    <div class="product-actions">
                                        <div class="product-quick-actions">
                                            <button type="button" class="quick-action-btn"><i class="bi bi-heart"></i></button>
                                            <button type="button" class="quick-action-btn"><i class="bi bi-arrow-repeat"></i></button>
                                            <button type="button" class="quick-action-btn"
                                                    onclick="window.location.href='@Url.Action("Details", "SanPham", new { id = item.Id })'">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="product-info">
                                <div class="product-content">
                                    <div class="product-details d-flex justify-content-between">
                                        <h2 class="product-title mb-0" style="font-weight: bold">@item.TenSanPham</h2>
                                        <h4 class="product-category mb-0 ms-2" style="font-size:1rem; font-weight:600; color:#1766b3;">
                                            @item.TenDanhMuc
                                        </h4>
                                    </div>
                                    <div class="product-price mt-2" style="font-size:1.13rem; font-weight:600; color:#e53935;">
                                        @if (listGia.Any())
                                        {
                                            <span>@listGia.Min().ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span>Liên hệ</span>
                                        }
                                    </div>
                                </div>

                                <div class="product-stock mt-1">
                                    <span class="stock-amount">@item.TongSoSanPham sản phẩm</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>Không có sản phẩm nào để hiển thị 😢</p>
                </div>
            }
        </div>

        <div class="text-center mt-5" data-aos="fade-up">
            <a href="#" class="view-all-btn">View All Products <i class="bi bi-arrow-right"></i></a>
        </div>

    </div>

</section><!-- /Product List Section -->
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-color/2.1.2/jquery.color.min.js"></script>

    <script>
        $(function () {
            // Dùng jQuery-color để chuẩn hóa và animate nếu muốn
            $('.color-circle').each(function () {
                var color = $(this).data('color');
                // Nếu màu chưa đúng định dạng hex, convert ở backend trước khi truyền ra
                $(this).css('background-color', $.Color(color));
            });

            // Chọn màu khi click
            $('.color-circle').click(function () {
                $('.color-circle').removeClass('selected');
                $(this).addClass('selected');
                // Gửi filter nếu muốn hoặc lấy $(this).data('id') để lọc
            });


        });

    </script>
}

