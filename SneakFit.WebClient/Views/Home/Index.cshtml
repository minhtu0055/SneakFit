<!-- Best Sellers Section -->
<section id="best-sellers" class="best-sellers section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="section-title">
            <h2>Bán chạy nhất</h2>
            <p>Những sản phẩm bán chạy nhất trong tháng</p>
        </div>
        <div class="best-seller-slider swiper init-swiper">
            <script type="application/json" class="swiper-config">
                {
                  "loop": true,
                  "autoplay": {
                    "delay": 5000,
                    "disableOnInteraction": false
                  },
                  "grabCursor": true,
                  "speed": 600,
                  "slidesPerView": "auto",
                  "spaceBetween": 20,
                  "navigation": {
                    "nextEl": ".swiper-button-next",
                    "prevEl": ".swiper-button-prev"
                  },
                  "breakpoints": {
                    "320": { "slidesPerView": 1, "spaceBetween": 10 },
                    "576": { "slidesPerView": 2, "spaceBetween": 15 },
                    "768": { "slidesPerView": 3, "spaceBetween": 20 },

                    "992": { "slidesPerView": 4, "spaceBetween": 20 },
                    "1200": { "slidesPerView": 5, "spaceBetween": 20 }
                  }
                }
            </script>
            <div class="swiper-wrapper">
                @if (Model.BestSellerSpct != null && Model.BestSellerSpct.Any())
                {
                    foreach (var item in Model.BestSellerSpct)
                    {
                        <div class="swiper-slide">
                            <div class="product-card" data-aos="fade-up">
                                <div class="product-image position-relative">
                                    <img src="@item.Anh" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy" style="height:220px;object-fit:cover;">
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">Best Seller</span>
                                </div>
                                <div class="product-info">
                                    <div class="product-content">
                                        <div class="product-details d-flex justify-content-between">
                                            <h2 class="product-title mb-0" style="font-weight: bold">@item.TenSanPham</h2>
                                            <h4 class="product-category mb-0 ms-2" style="font-size:1rem; font-weight:600; color:#1766b3;">
                                                @item.MauSac - @item.KichThuoc
                                            </h4>
                                        </div>
                                        <div class="product-price mt-2" style="font-size:1.13rem; font-weight:600; color:#e53935;">
                                            <span>@item.Gia.ToString("N0") đ</span>
                                        </div>
                                    </div>
                                    <div class="product-stock mt-1">
                                        <span class="stock-amount">Đã bán: @item.SoLuongDaBan</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="swiper-slide">
                        <div class="product-card text-center">
                            <p>Không có sản phẩm bán chạy nào.</p>
                        </div>
                    </div>
                }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </div>
</section><!-- /Best Sellers Section -->
<!-- Product List Section -->
<section id="product-list" class="product-list section">

    <div class="container isotope-layout" data-aos="fade-up" data-aos-delay="100" data-default-filter="*" data-layout="masonry" data-sort="original-order">

        <div class="row">
            <div class="col-12">
                <div class="product-filters isotope-filters mb-5 d-flex justify-content-center" data-aos="fade-up">
                    <ul class="d-flex flex-wrap gap-2 list-unstyled">
                        <li class="filter-active" data-filter="*">Tất cả</li>
                        @foreach (var dm in Model.DanhMucs)
                        {
                            <li data-filter=".filter-@dm.TenDanhMuc.ToLower().Replace(" ", "-")">@dm.TenDanhMuc</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="row product-container isotope-container" data-aos="fade-up" data-aos-delay="200">
            @if (Model.SanPhams != null && Model.SanPhams.Items.Any())
            {
                @foreach (var item in Model.SanPhams.Items.Where(x => x.TrangThai))
                {
                    var priceInfo = ViewBag.ProductPrices?[item.Id] as Tuple<decimal?, decimal?, string>; // GiaCu, GiaKM, NhanKM
                    var giaCu = priceInfo?.Item1;
                    var giaKM = priceInfo?.Item2;
                    var nhanKM = priceInfo?.Item3;

                    var listGia = Model.AllSpct
                    .Where(x => x.SanPhamId == item.Id && x.Gia > 0)
                    .ToList();
                    
                    var minGiaGoc = listGia.Any() ? listGia.Min(x => x.GiaGoc) : 0M;
                    var minGiaKm = listGia.Any() ? listGia.Min(x => x.GiaKhuyenMai) : 0M;
                    var maxPhanTramGiam = listGia.Any() ? listGia.Max(x => x.KhuyenMaiPhanTram) : 0M;
                    var spctsCoKM = listGia.Where(x => x.KhuyenMaiPhanTram > 0 && x.GiaKhuyenMai < x.GiaGoc).ToList();

                    // Nếu có khuyến mãi
                    var minGiaGocCoKM = spctsCoKM.Any() ? spctsCoKM.Min(x => x.GiaGoc) : minGiaGoc;
                    var minGiaKMCoKM = spctsCoKM.Any() ? spctsCoKM.Min(x => x.GiaKhuyenMai) : minGiaKm;
                    var maxGiamCoKM = spctsCoKM.Any() ? spctsCoKM.Max(x => x.KhuyenMaiPhanTram) : 0M;

                    <div class="col-md-6 col-lg-3 product-item isotope-item filter-@item.TenDanhMuc?.ToLower().Replace(" ", "-")">
                        <div class="product-card">
                            <div class="product-image position-relative">
                                @if (!string.IsNullOrEmpty(item.ImageDaiDien))
                                {
                                    <img src="@(ViewBag.BaseAddress + item.ImageDaiDien)" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy" onerror="this.src='/assets/img/SneakFit_Logo.png'">
                                    <img src="@(ViewBag.BaseAddress + item.ImageDaiDien)" alt="@item.TenSanPham Hover" class="img-fluid hover-img" loading="lazy" onerror="this.src='/assets/img/SneakFit_Logo.png'">
                                }
                                else
                                {
                                    <img src="~/assets/img/SneakFit_Logo.png" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy">
                                    <img src="~/assets/img/SneakFit_Logo.png" alt="@item.TenSanPham Hover" class="img-fluid hover-img" loading="lazy">
                                }

                                @if (!string.IsNullOrEmpty(nhanKM))
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">Sale</span>
                                }

                                <div class="product-overlay">
                                    <button type="button" class="btn btn-cart" onclick="openProductModal('@item.Id', '@item.TenSanPham')">
                                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                                    </button>
                                    <div class="product-actions">
                                        <div class="product-quick-actions">
                                            <button type="button" class="quick-action-btn"><i class="bi bi-heart"></i></button>
                                            <button type="button" class="quick-action-btn"><i class="bi bi-arrow-repeat"></i></button>
                                            <button type="button" class="quick-action-btn"
                                                    onclick="window.location.href='@Url.Action("Details", "SanPham", new { id = item.Id })'">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="product-info">
                                <div class="product-content">
                                    <div class="product-details d-flex justify-content-between">
                                        <h2 class="product-title mb-0" style="font-weight: bold">@item.TenSanPham</h2>
                                        <h4 class="product-category mb-0 ms-2" style="font-size:1rem; font-weight:600; color:#1766b3;">
                                            @item.TenDanhMuc
                                        </h4>
                                    </div>
                                    <div class="product-price mt-2" style="font-size:1.13rem; font-weight:600; color:#e53935;">
                                        @if (listGia.Any())
                                        {
                                            if (spctsCoKM.Any())
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    @* <span class="gia-goc" style="text-decoration:line-through; color:gray">@minGiaGocCoKM.ToString("N0") đ</span> *@
                                                    <span class="gia-km">@minGiaKMCoKM.ToString("N0") đ</span>
                                                    <span class="giam-tag ms-2 text-danger">-@maxGiamCoKM%</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>@minGiaGoc.ToString("N0") đ</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>Liên hệ</span>
                                        }
                                    </div>
                                </div>

                                <div class="product-stock mt-1">
                                    <span class="stock-amount">@item.TongSoSanPham sản phẩm</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>Không có sản phẩm nào để hiển thị 😢</p>
                </div>
            }
        </div>
    </div>

</section><!-- /Product List Section -->
<!-- Modal thông báo trung tâm -->
