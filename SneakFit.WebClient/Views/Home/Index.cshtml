            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="product-image-container">
                            <img id="modalProductImage" src="" alt="Product" class="img-fluid rounded" style="object-fit:cover; width:100%;max-height:400px;" onerror="this.src='/assets/img/SneakFit_Logo.png'">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h4 id="modalProductName" class="fw-bold mb-2"></h4>

                        <!-- Giá sản phẩm -->
                        <div class="mb-3" id="giaSPBox" style="min-height: 38px;">
                            <span id="GiaApDungKhuyenMai" class="gia-km"></span>
