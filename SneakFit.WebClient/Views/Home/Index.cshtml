                <button type="button" class="btn btn-primary mt-4 px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-color/2.1.2/jquery.color.min.js"></script>
    <link rel="stylesheet" href="~/assets/css/Home.css">

    <script>
        $(function () {
            // Dùng jQuery-color để chuẩn hóa và animate nếu muốn
            $('.color-circle').each(function () {
                var color = $(this).data('color');
                // Nếu màu chưa đúng định dạng hex, convert ở backend trước khi truyền ra
                $(this).css('background-color', $.Color(color));
            });

            // Chọn màu khi click
            $('.color-circle').click(function () {
                $('.color-circle').removeClass('selected');
                $(this).addClass('selected');
                // Gửi filter nếu muốn hoặc lấy $(this).data('id') để lọc
            });

            // ===== HIỆU ỨNG NÂNG CAO CHO HERO SECTION =====

            // 1. Parallax Effect - Ảnh giày di chuyển khi cuộn
            $(window).scroll(function() {
                const scrolled = $(window).scrollY;
                const heroSection = $('#hero');
                const heroHeight = heroSection.height();

                if (scrolled < heroHeight) {
                    // Main product parallax
                    $('.main-product').css({
                        'transform': `translateY(${scrolled * 0.15}px) scale(${1 + scrolled * 0.0001})`
                    });

                    // Floating products parallax
                    $('.product-1').css({
                        'transform': `translateY(${scrolled * 0.1}px) rotate(${scrolled * 0.02}deg)`
                    });

                    $('.product-2').css({
                        'transform': `translateY(${scrolled * 0.08}px) rotate(${-scrolled * 0.015}deg)`
                    });

                    $('.product-3').css({
                        'transform': `translateY(${scrolled * 0.06}px) rotate(${scrolled * 0.01}deg)`
                    });

                    // Discount badge parallax
                    $('.discount-badge').css({
                        'transform': `translateY(${scrolled * 0.05}px) scale(${1 + scrolled * 0.0002})`
                    });
                }
            });

            // 2. 3D Hover Effect cho ảnh giày - Cải tiến cho ảnh đã xóa nền
            $('.main-product, .floating-product img').on('mousemove', function(e) {
                const $this = $(this);
                const rect = this.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = (y - centerY) / 15;
                const rotateY = (centerX - x) / 15;

                $this.css({
                    'transform': `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.1)`,
                    'transition': 'transform 0.1s ease-out',
                    'filter': 'drop-shadow(0 15px 35px rgba(23,102,179,0.3))'
                });
            }).on('mouseleave', function() {
                $(this).css({
                    'transform': 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)',
                    'transition': 'transform 0.5s ease-out',
                    'filter': 'drop-shadow(0 8px 32px rgba(23,102,179,0.15))'
                });
            });

            // 3. Particle Effect cho background
            createParticles();

            // 4. Text Animation cho tiêu đề - TẠM TẮT để fix lỗi
            // animateHeroText();

            // 5. CTA Button Pulse Effect
            $('.btn-shop').addClass('pulse-animation');

            // 6. Modal event listeners
            $('#productModal').on('shown.bs.modal', function () {
                console.log('Modal shown event triggered');
                // Enable backdrop click và keyboard - Sử dụng cách an toàn hơn
                try {
                    const modalInstance = bootstrap.Modal.getInstance(this);
                    if (modalInstance) {
                        modalInstance._config.backdrop = true;
                        modalInstance._config.keyboard = true;
                    }
                } catch (error) {
                    console.log('Modal config update skipped:', error);
                }
            });

            $('#productModal').on('hidden.bs.modal', function () {
                console.log('Modal hidden event triggered');
                // Reset form khi đóng modal
                $('#quantityInput').val(1);
                selectedColorId = null;
                selectedSizeId = null;
                // Clear modal content
                $('#colorOptions').empty();
                $('#sizeOptions').empty();
                $('#modalProductPrice').text('');
            });

            // Force close modal khi click backdrop
            $(document).on('click', '.modal-backdrop', function() {
                $('#productModal').modal('hide');
            });

            // Force close modal khi press ESC
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && $('#productModal').hasClass('show')) {
                    $('#productModal').modal('hide');
                }
            });
        });

        // Tạo particle effect
        function createParticles() {
            const heroSection = document.getElementById('hero');
            if (!heroSection) return;

            // Tạo container cho particles
            const particleContainer = document.createElement('div');
            particleContainer.className = 'particle-container';
            particleContainer.style.cssText = `
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                overflow: hidden;
                pointer-events: none;
                z-index: 1;
            `;
            heroSection.appendChild(particleContainer);

            // Tạo particles
            for (let i = 0; i < 15; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.cssText = `
                    position: absolute;
                    width: 4px;
                    height: 4px;
                    background: rgba(23, 102, 179, 0.1);
                    border-radius: 50%;
                    animation: float-particle ${3 + Math.random() * 4}s infinite linear;
                    left: ${Math.random() * 100}%;
                    top: ${Math.random() * 100}%;
                `;
                particleContainer.appendChild(particle);
            }
        }

        // Animation cho text
        function animateHeroText() {
            const title = $('.ecommerce-hero-1 h1');
            const text = title.text();
            title.empty();

            text.split('').forEach((char, index) => {
                const span = $('<span>').text(char === ' ' ? '\u00A0' : char);
                span.css({
                    'opacity': '0',
                    'animation': `fadeInChar 0.5s ease forwards ${index * 0.05}s`
                });
                title.append(span);
            });
        }

        // ===== MODAL FUNCTIONS =====
        let currentProductId = null;
        let selectedColorId = null;
        let selectedSizeId = null;
        let productSpctData = [];
        let listMauCoSPCT = [];
        let listSizeCoSPCT = [];

        // Mở modal chọn sản phẩm
        function openProductModal(productId, productName) {
            console.log('Opening modal for product:', productId, productName);

            // Reset modal state
            selectedColorId = null;
            selectedSizeId = null;
            $('#quantityInput').val(1);

            currentProductId = productId;
            $('#modalProductName').text(productName);

            // Lấy ảnh sản phẩm
            const productCard = $(`[onclick*="${productId}"]`).closest('.product-card');
            const productImage = productCard.find('.main-img').attr('src');
            $('#modalProductImage').attr('src', productImage);

            // Hiển thị modal trước
            try {
                const modal = new bootstrap.Modal(document.getElementById('productModal'), {
                    backdrop: true,
                    keyboard: true,
                    focus: true
                });
                modal.show();
                console.log('Modal opened successfully');
            } catch (error) {
                console.error('Error opening modal:', error);
                // Fallback cho jQuery
                $('#productModal').modal({
                    backdrop: true,
                    keyboard: true,
                    show: true
                });
            }

            // Load SPCT data từ API
            loadProductSpctDataFromAPI(productId);
        }

        // Load dữ liệu SPCT cho sản phẩm từ API
        function loadProductSpctDataFromAPI(productId) {
            // Hiển thị loading
            $('#colorOptions').html('<p class="text-muted">Đang tải...</p>');
            $('#sizeOptions').html('<p class="text-muted">Đang tải...</p>');

            $.ajax({
                url: '@Url.Action("GetProductModalData", "Home")',
                type: 'GET',
                data: { productId: productId },
                success: function(response) {
                    console.log('API Response:', response);

                    if (response.success) {
                        // Lưu dữ liệu
                        productSpctData = response.spctList;
                        console.log('productSpctData saved:', productSpctData);

                        // Chuẩn hóa để fill tất cả màu/kích thước
                        listMauCoSPCT = productSpctData.map(x => x.mauSacId);
                        listSizeCoSPCT = productSpctData.map(x => x.kichThuocId);

                        console.log('listMauCoSPCT:', listMauCoSPCT);
                        console.log('listSizeCoSPCT:', listSizeCoSPCT);

                        // Render color options
                        renderColorOptionsFromAPI(response.colors, response.spctList);

                        // Render size options
                        renderSizeOptionsFromAPI(response.sizes, response.spctList);

                        // Khởi tạo UI
                        updateStatusShowHide();
                        updateUI();

                        console.log('Modal data loaded successfully');
                    } else {
                        console.error('API Error:', response.message);
                        $('#colorOptions').html('<p class="text-danger">Lỗi: ' + response.message + '</p>');
                        $('#sizeOptions').html('<p class="text-danger">Lỗi: ' + response.message + '</p>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', error);
                    $('#colorOptions').html('<p class="text-danger">Lỗi kết nối</p>');
                    $('#sizeOptions').html('<p class="text-danger">Lỗi kết nối</p>');
                }
            });
        }

        // Render color options từ API data
        function renderColorOptionsFromAPI(colors, spctList) {
            try {
                const colorOptions = $('#colorOptions');
                colorOptions.empty();

                console.log('Available colors from API:', colors);
                console.log('listMauCoSPCT:', listMauCoSPCT);

                if (!colors || colors.length === 0) {
                    colorOptions.html('<p class="text-muted">Không có màu sắc</p>');
                    return;
                }

                colors.forEach((color, index) => {
                    console.log('Rendering color:', color);
                    var hasSPCT = listMauCoSPCT.includes(color.id);
                    console.log(`Color ${color.name} (${color.id}) has SPCT:`, hasSPCT);

                    const colorBtn = $(`
                        <button type="button"
                                class="color-swatch"
                                title="${color.name}"
                                data-color-id="${color.id}"
                                data-color-hex="${color.hex}"
                        ${hasSPCT ? "" : "disabled"}
                                style="background:${color.hex}; border:2.5px solid #ddd; opacity:${hasSPCT ? "1" : "0.4"};
                                       cursor:${hasSPCT ? "pointer" : "not-allowed"}; width:48px; height:48px; border-radius:50%; text-align:center; margin-bottom:20px;">
                            <span class="color-name">
                                ${color.name}
                            </span>
                        </button>
                    `);
                    colorOptions.append(colorBtn);
                });
            } catch (error) {
                console.error('Error rendering colors from API:', error);
                $('#colorOptions').html('<p class="text-danger">Lỗi hiển thị màu sắc</p>');
            }
        }

        // Helper function để lấy màu hex từ tên màu
        function getColorHex(colorName) {
            const colorMap = {
                'Đen': '#000000',
                'Trắng': '#FFFFFF',
                'Đỏ': '#FF0000',
                'Xanh': '#0000FF',
                'Xanh lá': '#00FF00',
                'Vàng': '#FFFF00',
                'Cam': '#FFA500',
                'Tím': '#800080',
                'Hồng': '#FFC0CB',
                'Nâu': '#A52A2A',
                'Xám': '#808080'
            };
            return colorMap[colorName] || '#CCCCCC';
        }

        // Render size options từ API data
        function renderSizeOptionsFromAPI(sizes, spctList) {
            try {
                const sizeOptions = $('#sizeOptions');
                sizeOptions.empty();

                console.log('Available sizes from API:', sizes);
                console.log('listSizeCoSPCT:', listSizeCoSPCT);

                if (!sizes || sizes.length === 0) {
                    sizeOptions.html('<p class="text-muted">Không có kích thước</p>');
                    return;
                }

                sizes.forEach((size, index) => {
                    console.log('Rendering size:', size);
                    var hasSPCT = listSizeCoSPCT.includes(size.id);
                    console.log(`Size ${size.name} (${size.id}) has SPCT:`, hasSPCT);

                    const sizeBtn = $(`
                        <button type="button"
                                class="size-box"
                                data-size-id="${size.id}"
                        ${hasSPCT ? "" : "disabled"}
                                style="padding:8px 18px; border:2px solid #ddd; border-radius:7px; background:#fff;
                                       font-weight:500; font-size:15px; opacity:${hasSPCT ? "1" : "0.5"}; cursor:${hasSPCT ? "pointer" : "not-allowed"};">
                            ${size.name}
                        </button>
                    `);
                    sizeOptions.append(sizeBtn);
                });
            } catch (error) {
                console.error('Error rendering sizes from API:', error);
                $('#sizeOptions').html('<p class="text-danger">Lỗi hiển thị kích thước</p>');
            }
        }

        // Hàm tìm giá nhỏ nhất từ tất cả SPCT (có tính khuyến mãi)
        function getGiaThapNhat() {
            if (!productSpctData || productSpctData.length === 0) return 0;

            let giaList = productSpctData
                .filter(x => Number(x.gia) > 0)
                .map(x => {
                    // Ưu tiên giá khuyến mãi nếu có
                    if (x.giaKhuyenMai && x.khuyenMaiPhanTram > 0 && x.giaKhuyenMai < x.giaGoc) {
                        return Number(x.giaKhuyenMai);
                    } else {
                        return Number(x.giaGoc || x.gia);
                    }
                });

            if (giaList.length === 0) return 0;
            return Math.min(...giaList);
        }

        // Hàm cập nhật UI và giá
        function updateUI() {
            console.log('updateUI được gọi');
            console.log('selectedColorId:', selectedColorId);
            console.log('selectedSizeId:', selectedSizeId);

            // Reset active + border
            $('.color-grid .color-swatch').removeClass('active').css('border-color', '#ddd');
            $('.size-grid .size-box').removeClass('active').css('border-color', '#ddd').css('background', '#fff');

            // Đánh dấu active cho màu và size đã chọn
            if (selectedColorId) {
                $('.color-grid .color-swatch[data-color-id="' + selectedColorId + '"]')
                    .addClass('active').css('border-color', '#1976d2');
            }
            if (selectedSizeId) {
                $('.size-grid .size-box[data-size-id="' + selectedSizeId + '"]')
                    .addClass('active').css('border-color', '#ffa502').css('background', '#fffbe7');
            }

            // Tìm SPCT phù hợp
            let spct = null;
            if (selectedColorId && selectedSizeId) {
                spct = productSpctData.find(x => x.mauSacId == selectedColorId && x.kichThuocId == selectedSizeId);
                console.log('SPCT tìm thấy:', spct);
            }

            // Update giá bán:
            if (spct) {
                console.log('SPCT có khuyến mãi:', spct.giaKhuyenMai, spct.khuyenMaiPhanTram, spct.giaGoc);

                // Hiển thị giá gốc nếu có KM
                if (spct.giaKhuyenMai && spct.khuyenMaiPhanTram > 0 && spct.giaKhuyenMai < spct.giaGoc) {
                    $('#GiaGoc').text(spct.giaGoc.toLocaleString('vi-VN') + ' đ').show();
                    $('#GiaApDungKhuyenMai').text(spct.giaKhuyenMai.toLocaleString('vi-VN') + ' đ').show();
                    $('#PhanTramGiamGia').text('-' + spct.khuyenMaiPhanTram + '%').show();
                } else {
                    $('#GiaGoc').hide();
                    $('#PhanTramGiamGia').hide();
                    $('#GiaApDungKhuyenMai').text(spct.giaGoc.toLocaleString('vi-VN') + ' đ').show();
                }
            } else {
                // Trường hợp chưa chọn đủ - hiện giá thấp nhất
                let giaThapNhat = getGiaThapNhat();
                console.log('Giá thấp nhất:', giaThapNhat);

                if (giaThapNhat > 0) {
                    $('#GiaGoc').hide();
                    $('#PhanTramGiamGia').hide();
                    $('#GiaApDungKhuyenMai').text(giaThapNhat.toLocaleString('vi-VN') + ' đ').show();
                } else {
                    $('#GiaGoc').hide();
                    $('#GiaApDungKhuyenMai').text('').hide();
                    $('#PhanTramGiamGia').hide();
                }
            }

            // Cập nhật form và số lượng
            if (spct) {
                $('#soLuongGroup').show();
                $('#quantityInput').attr('min', 1).attr('max', spct.soLuong || 1).val(1);
                $('#cartQuantityInput').val(1);
                $('#selectedSpctId').val(spct.id);
                $('#cartForm').show();
                $('#soLuongTon').text(`Còn: ${spct.soLuong ?? 0} sản phẩm`);
                updateQuantityUI();
            } else {
                $('#soLuongGroup').hide();
                $('#cartForm').hide();
                $('#soLuongTon').text('');
            }
        }

        // Check ngưng hoạt động thì ẩn những màu sắc và kích thước của spct đã ngưng hoạt động
        function updateStatusShowHide() {
            console.log('updateStatusShowHide được gọi');
            console.log('selectedColorId:', selectedColorId);
            console.log('selectedSizeId:', selectedSizeId);
            console.log('productSpctData:', productSpctData);

            // Reset trạng thái enable/disable
            $('.color-grid .color-swatch').removeClass('disabled').css('opacity', '1').prop('disabled', false);
            $('.size-grid .size-box').removeClass('disabled').css('opacity', '1').prop('disabled', false);

            // Nếu đã chọn size => chỉ enable màu có SPCT active
            if (selectedSizeId) {
                let mauSacCoSPCT = productSpctData
                    .filter(x => x.kichThuocId == selectedSizeId && x.trangThai && x.soLuong > 0)
                    .map(x => x.mauSacId);

                console.log('Màu sắc có SPCT cho size đã chọn:', mauSacCoSPCT);

                $('.color-grid .color-swatch').each(function() {
                    let id = $(this).data('color-id');
                    if (!mauSacCoSPCT.includes(id)) {
                        $(this).addClass('disabled').css('opacity', '0.5').prop('disabled', true);
                    }
                });
            }

            // Nếu đã chọn màu => chỉ enable size có SPCT active
            if (selectedColorId) {
                let sizeCoSPCT = productSpctData
                    .filter(x => x.mauSacId == selectedColorId && x.trangThai && x.soLuong > 0)
                    .map(x => x.kichThuocId);

                console.log('Size có SPCT cho màu đã chọn:', sizeCoSPCT);

                $('.size-grid .size-box').each(function() {
                    let id = $(this).data('size-id');
                    if (!sizeCoSPCT.includes(id)) {
                        $(this).addClass('disabled').css('opacity', '0.5').prop('disabled', true);
                    }
                });
            }
        }

        // Sự kiện chọn màu
        $(document).on('click', '.color-grid .color-swatch:not([disabled])', function () {
            var id = $(this).data('color-id');
            console.log('Chọn màu:', id);

            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedColorId === id) {
                selectedColorId = null;
            } else {
                selectedColorId = id;
            }

            console.log('selectedColorId sau khi chọn:', selectedColorId);

            // Reset size nếu chọn màu mới
            if (selectedColorId && selectedSizeId) {
                // Kiểm tra xem size hiện tại có hợp với màu mới không
                let spctExists = productSpctData.find(x => x.mauSacId == selectedColorId && x.kichThuocId == selectedSizeId);
                if (!spctExists) {
                    selectedSizeId = null;
                    console.log('Reset selectedSizeId vì không hợp với màu mới');
                }
            }

            updateStatusShowHide();
            updateUI();
        });

        // Sự kiện chọn size
        $(document).on('click', '.size-grid .size-box:not([disabled])', function () {
            var id = $(this).data('size-id');
            console.log('Chọn size:', id);

            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedSizeId === id) {
                selectedSizeId = null;
            } else {
                selectedSizeId = id;
            }

            console.log('selectedSizeId sau khi chọn:', selectedSizeId);

            // Reset màu nếu chọn size mới
            if (selectedColorId && selectedSizeId) {
                // Kiểm tra xem màu hiện tại có hợp với size mới không
                let spctExists = productSpctData.find(x => x.mauSacId == selectedColorId && x.kichThuocId == selectedSizeId);
                if (!spctExists) {
                    selectedColorId = null;
                    console.log('Reset selectedColorId vì không hợp với size mới');
                }
            }

            updateStatusShowHide();
            updateUI();
        });

        // Số lượng input cộng/trừ với kiểm tra max/min
        function updateQuantityUI() {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let min = parseInt(inp.attr('min')) || 1;
            let max = parseInt(inp.attr('max')) || 1;

            // Fix giá trị nếu ngoài range
            if (val < min) val = min;
            if (val > max) val = max;
            inp.val(val);
            $('#cartQuantityInput').val(val);

            // Enable/disable nút
            $('#btnMinus').prop('disabled', val <= min);
            $('#btnPlus').prop('disabled', val >= max);
        }

        $('#btnMinus').click(function () {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let min = parseInt(inp.attr('min')) || 1;
            if (val > min) {
                inp.val(val - 1);
                updateQuantityUI();
            }
        });

        $('#btnPlus').click(function () {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let max = parseInt(inp.attr('max')) || 1;
            if (val < max) {
                inp.val(val + 1);
                updateQuantityUI();
            }
        });

        $('#quantityInput').on('input', function () {
            updateQuantityUI();
        });

                 $('#btnAddToCart').click(function () {
            var spctId = $('#selectedSpctId').val();
            var soLuong = parseInt($('#quantityInput').val()) || 1;
            var max = parseInt($('#quantityInput').attr('max')) || 1;

            if (soLuong > max) {
                alert("Bạn đã đạt số lượng tối đa trong kho cho sản phẩm này!");
                return;
            }

            $.ajax({
                url: '@Url.Action("AddToCart", "SanPham")',
                type: 'POST',
                data: {
                    sanPhamChiTietId: spctId,
                    soLuong: soLuong
                },
                success: function (res) {
                    if (res.requireLogin) {
                        window.location.href = '/Login/Index';
                        return;
                    }
                    if (res.success) {
                        $('#centerToastMessage').text(res.message || 'Đã thêm vào giỏ hàng thành công!');
                        var toastModal = new bootstrap.Modal(document.getElementById('centerToastModal'));
                        toastModal.show();
                        setTimeout(function () {
                            toastModal.hide();
                        }, 3000); // Tự động ẩn sau 3 giây
                    } else {
                        $('#centerToastMessage').text(res.message || 'Có lỗi xảy ra!');
                        var toastModal = new bootstrap.Modal(document.getElementById('centerToastModal'));
                        toastModal.show();
                        setTimeout(function () {
                            toastModal.hide();
                        }, 3000); // Tự động ẩn sau 3 giây
                    }
                },
                error: function () {
                    $('#centerToastMessage').text('Lỗi hệ thống, vui lòng thử lại!');
                    var toastModal = new bootstrap.Modal(document.getElementById('centerToastModal'));
                    toastModal.show();
                    setTimeout(function () {
                        toastModal.hide();
                    }, 3000); // Tự động ẩn sau 3 giây
                }
            });
        });


    </script>
}

<!-- Product Selection Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
