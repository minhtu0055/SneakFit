<!-- Product List Section -->
<section id="product-list" class="product-list section">

    <div class="container isotope-layout" data-aos="fade-up" data-aos-delay="100" data-default-filter="*" data-layout="masonry" data-sort="original-order">

        <div class="row">
            <div class="col-12">
                <div class="product-filters isotope-filters mb-5 d-flex justify-content-center" data-aos="fade-up">
                    <ul class="d-flex flex-wrap gap-2 list-unstyled">
                        <li class="filter-active" data-filter="*">All</li>
                        <li data-filter=".filter-clothing">Clothing</li>
                        <li data-filter=".filter-accessories">Accessories</li>
                        <li data-filter=".filter-electronics">Electronics</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row product-container isotope-container" data-aos="fade-up" data-aos-delay="200">
            @if (Model.SanPhams != null && Model.SanPhams.Items.Any())
            {
                @foreach (var item in Model.SanPhams.Items.Where(x => x.TrangThai))
                {
                    var priceInfo = ViewBag.ProductPrices?[item.Id] as Tuple<decimal?, decimal?, string>; // GiaCu, GiaKM, NhanKM
                    var giaCu = priceInfo?.Item1;
                    var giaKM = priceInfo?.Item2;
                    var nhanKM = priceInfo?.Item3;

                    var listGia = Model.AllSpct
                    .Where(x => x.SanPhamId == item.Id && x.Gia > 0)
                    .Select(x => x.Gia)
                    .ToList();

                    <div class="col-md-6 col-lg-3 product-item isotope-item filter-@item.TenDanhMuc?.ToLower().Replace(" ", "-")">
                        <div class="product-card">
                            <div class="product-image position-relative">
                                @if (!string.IsNullOrEmpty(item.ImageDaiDien))
                                {
                                    <img src="@(ViewBag.BaseAddress + item.ImageDaiDien)" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy">
                                    <img src="@(ViewBag.BaseAddress + item.ImageDaiDien)" alt="@item.TenSanPham Hover" class="img-fluid hover-img" loading="lazy">
                                }
                                else
                                {
                                    <img src="~/assets/img/product/no-image.png" alt="@item.TenSanPham" class="img-fluid main-img" loading="lazy">
                                    <img src="~/assets/img/product/no-image.png" alt="@item.TenSanPham Hover" class="img-fluid hover-img" loading="lazy">
                                }

                                @if (!string.IsNullOrEmpty(nhanKM))
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">Sale</span>
                                }

                                <div class="product-overlay">
                                    @foreach (var spct in Model.AllSpct.Where(x => x.SanPhamId == item.Id))
                                    {
                                        <a href="javascript:void(0)"
                                           class="btn-cart"
                                           data-bs-toggle="modal"
                                           data-bs-target="#productModal-@spct.Id">
                                            <i class="bi bi-cart-plus"></i> MUA NGAY
                                        </a>
                                    }
                                    <div class="product-actions">
                                        <div class="product-quick-actions">
                                            <button type="button" class="quick-action-btn"><i class="bi bi-heart"></i></button>
                                            <button type="button" class="quick-action-btn"><i class="bi bi-arrow-repeat"></i></button>
                                            <button type="button" class="quick-action-btn"
                                                    onclick="window.location.href='@Url.Action("Details", "SanPham", new { id = item.Id })'">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="product-info">
                                <div class="product-content">
                                    <div class="product-details d-flex justify-content-between">
                                        <h2 class="product-title mb-0" style="font-weight: bold">@item.TenSanPham</h2>
                                        <h4 class="product-category mb-0 ms-2" style="font-size:1rem; font-weight:600; color:#1766b3;">
                                            @item.TenDanhMuc
                                        </h4>
                                    </div>
                                    <div class="product-price mt-2" style="font-size:1.13rem; font-weight:600; color:#e53935;">
                                        @if (listGia.Any())
                                        {
                                            <span>@listGia.Min().ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span>Liên hệ</span>
                                        }
                                    </div>
                                </div>

                                <div class="product-stock mt-1">
                                    <span class="stock-amount">@item.TongSoSanPham sản phẩm</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>Không có sản phẩm nào để hiển thị 😢</p>
                </div>
            }
        </div>

        @foreach (var spct in Model.AllSpct)
        {
            <div class="modal fade" id="productModal-@spct.Id" tabindex="-1" aria-labelledby="modalLabel-@spct.Id" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content p-4">
                        <div class="modal-header border-0 pb-2">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body row g-4 align-items-start">
                            <!-- Hình ảnh sản phẩm -->
                            <div class="col-md-6 text-center">
                                @* <img src="@(baseUrl + spct.Images.First())"
                                     alt="@spct.TenSanPham"
                                     class="img-fluid shadow-image"
                                     style="max-height: 400px; object-fit: contain; border-radius: 8px"
                                     onerror="this.src='/images/no-image.png'" /> *@

                                @if (allImages != null && allImages.Any())
                                {
                                    if (allImages.Count == 1)
                                    {
                                        <img src="@(baseUrl + allImages.First())" alt="Ảnh sản phẩm" class="rounded" style="object-fit:cover; width:100%;max-height:400px;" onerror="this.src='/images/no-image.png'" />
                                    }
                                    else
                                    {
                                        <div id="carouselMainImg" class="carousel slide" data-bs-ride="carousel" data-bs-interval="1750" style="max-width:420px">
                                            <div class="carousel-inner">
                                                @for (int i = 0; i < allImages.Count; i++)
                                                {
                                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                                        <img src="@(baseUrl + allImages[i])" alt="Ảnh sản phẩm" class="d-block w-100 rounded" style="object-fit:cover; max-height:400px;" onerror="this.src='/images/no-image.png'" />
                                                    </div>
                                                }
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselMainImg" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon"></span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#carouselMainImg" data-bs-slide="next">
                                                <span class="carousel-control-next-icon"></span>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <img src="/images/no-image.png" alt="No Image" class="rounded" style="object-fit:cover; width:100%;max-height:400px;" />
                                }
                            </div>

                            <!-- Thông tin sản phẩm -->
                            <div class="col-md-6">
                                <h4 class="fw-bold">@spct.TenSanPham</h4>
                                <p>----------------------------------------------------------------------------------------------------------</p>
                                <div class="text-danger fw-bold fs-5 mb-3">@spct.Gia.ToString("N0") VND</div>

                                <!-- Màu sắc -->
                                <div class="mb-4">
                                    <label class="fw-semibold mb-2 d-block">Màu sắc:</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var color in Model.MauSacs)
                                        {
                                            var hasSPCT = listMauCoSPCT.Contains(color.Id);
                                            <button type="button"
                                                    class="color-swatch"
                                                    title="@color.TenMauSac"
                                                    data-color-id="@color.Id"
                                                    data-color-hex="@color.MaMauSac"
                                            @(hasSPCT ? "" : "disabled")
                                                    style="background:@color.MaMauSac; border:2.5px solid #ddd; opacity:@(hasSPCT ? "1" : "0.4");
                                               cursor:@(hasSPCT ? "pointer" : "not-allowed"); width:48px; height:48px; border-radius:50%; text-align:center; margin-bottom:20px;">
                                            </button>
                                        }
                                    </div>
                                </div>
                                <p>----------------------------------------------------------------------------------------------------------</p>
                                <!-- Size -->
                                <div class="mb-4">
                                    <b>Size:</b>
                                    <div class="size-grid flex-wrap" style="display: flex; gap: 10px;">
                                        @if (Model.KichThuocs != null)
                                        {
                                            @foreach (var size in Model.KichThuocs)
                                            {
                                                var hasSPCT = listSizeCoSPCT.Contains(size.Id);
                                                <button type="button"
                                                        class="size-box"
                                                        data-size-id="@size.Id"
                                                @(hasSPCT ? "" : "disabled")
                                                        style="padding:8px 18px; border:2px solid #ddd; border-radius:7px; background:#fff; font-weight:500; font-size:15px; opacity:@(hasSPCT ? "1" : "0.5"); cursor:@(hasSPCT ? "pointer" : "not-allowed");">
                                                    @size.MaKichThuoc
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                                <p>----------------------------------------------------------------------------------------------------------</p>
                                <!-- Số lượng -->
                                <div class="mb-4">
                                    <label class="fw-semibold mb-2 d-block">Số lượng tồn:</label>
                                    <span class="text-danger fw-bold">@spct.SoLuong sản phẩm</span>
                                </div>

                                <div class="d-flex align-items-center gap-2 mt-3">
                                    <input type="number" min="1" max="@spct.SoLuong" value="1" class="form-control" style="width: 80px;" id="modalQuantity-@spct.Id" />
                                    <form action="@Url.Action("AddToCart", "Cart")" method="post" class="d-inline" id="cartForm" style="display: none;">
                                        <input type="hidden" name="id" id="selectedSpctId" value="" />
                                        <input type="hidden" name="quantity" id="cartQuantityInput" value="1" />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="text-center mt-5" data-aos="fade-up">
            <a href="#" class="view-all-btn">View All Products <i class="bi bi-arrow-right"></i></a>
        </div>

    </div>

</section><!-- /Product List Section -->

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-color/2.1.2/jquery.color.min.js"></script>

    <script>
        let spctData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SanPhamChiTiets));
        let selectedColorId = null, selectedSizeId = null;

        // Hàm tìm giá nhỏ nhất từ tất cả SPCT
        function getGiaThapNhat() {
            if (!spctData || spctData.length === 0) return 0;
            let giaList = spctData
                .filter(x => Number(x.Gia) > 0)
                .map(x => Number(x.Gia));
            if (giaList.length === 0) return 0;
            return Math.min(...giaList);
        }

        // Hàm cập nhật UI và giá
        function updateUI() {
            // Reset active + border
            $('.color-grid .color-swatch').removeClass('active').css('border-color', '#ddd');
            $('.size-grid .size-box').removeClass('active').css('border-color', '#ddd').css('background', '#fff');

            // Đánh dấu active cho màu và size đã chọn
            if (selectedColorId) {
                $('.color-grid .color-swatch[data-color-id="' + selectedColorId + '"]')
                    .addClass('active').css('border-color', '#1976d2');
            }
            if (selectedSizeId) {
                $('.size-grid .size-box[data-size-id="' + selectedSizeId + '"]')
                    .addClass('active').css('border-color', '#ffa502').css('background', '#fffbe7');
            }

            // Tìm SPCT phù hợp
            let spct = null;
            if (selectedColorId && selectedSizeId) {
                spct = spctData.find(x => x.MauSacId == selectedColorId && x.KichThuocId == selectedSizeId);
            }

            // Cập nhật giá
            if (spct && spct.Gia) {
                // Có SPCT cụ thể - hiển thị giá của SPCT đó
                $('#giaSP').text(Number(spct.Gia).toLocaleString('vi-VN') + " đ");
            } else {
                // Chưa chọn đủ hoặc không có SPCT - hiển thị giá thấp nhất
                let giaMin = getGiaThapNhat();
                if (giaMin && giaMin > 0) {
                    $('#giaSP').text(giaMin.toLocaleString('vi-VN') + " đ");
                } else {
                    $('#giaSP').text("");
                }
            }

            // Cập nhật form và số lượng
            if (spct) {
                $('#soLuongGroup').show();
                $('#quantityInput').attr('min', 1).attr('max', spct.SoLuong || 1).val(1);
                $('#cartQuantityInput').val(1);
                $('#selectedSpctId').val(spct.Id);
                $('#cartForm').show();
                $('#soLuongTon').text(`Còn: ${spct.SoLuong ?? 0} sản phẩm`);
                updateQuantityUI();
            } else {
                $('#soLuongGroup').hide();
                $('#cartForm').hide();
                $('#soLuongTon').text('');
            }
        }

        // Check ngưng hoạt động thì ẩn những màu sắc và kích thước của spct đã ngưng hoạt động
        function updateStatusShowHide() {
            // Đầu tiên, enable lại tất cả
            $('.color-grid .color-swatch').removeAttr('disabled').css('opacity', 1);
            $('.size-grid .size-box').removeAttr('disabled').css('opacity', 1);

            // Nếu đã chọn size => disable màu không còn spct active
            if (selectedSizeId) {
                let mauSacCoSPCT = spctData
                    .filter(x => x.KichThuocId == selectedSizeId && x.TrangThai)
                    .map(x => x.MauSacId);
                $('.color-grid .color-swatch').each(function () {
                    let id = $(this).data('color-id');
                    if (mauSacCoSPCT.indexOf(id) === -1) {
                        $(this).attr('disabled', true);
                    }
                });
            }

            // Nếu đã chọn màu => disable size không còn spct active
            if (selectedColorId) {
                let sizeCoSPCT = spctData
                    .filter(x => x.MauSacId == selectedColorId && x.TrangThai)
                    .map(x => x.KichThuocId);
                $('.size-grid .size-box').each(function () {
                    let id = $(this).data('size-id');
                    if (sizeCoSPCT.indexOf(id) === -1) {
                        $(this).attr('disabled', true);
                    }
                });
            }
        }

        // Sự kiện chọn màu
        $(document).on('click', '.color-grid .color-swatch:not([disabled])', function () {
            var id = $(this).data('color-id');
            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedColorId === id) {
                selectedColorId = null;
            } else {
                selectedColorId = id;
            }
            updateStatusShowHide();
            updateUI();
        });

        // Sự kiện chọn size
        $(document).on('click', '.size-grid .size-box:not([disabled])', function () {
            var id = $(this).data('size-id');
            // Toggle: nếu đã chọn thì bỏ chọn, chưa chọn thì chọn
            if (selectedSizeId === id) {
                selectedSizeId = null;
            } else {
                selectedSizeId = id;
            }
            updateStatusShowHide();
            updateUI();
        });

        // Số lượng input cộng/trừ với kiểm tra max/min
        function updateQuantityUI() {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let min = parseInt(inp.attr('min')) || 1;
            let max = parseInt(inp.attr('max')) || 1;

            // Fix giá trị nếu ngoài range
            if (val < min) val = min;
            if (val > max) val = max;
            inp.val(val);
            $('#cartQuantityInput').val(val);

            // Enable/disable nút
            $('#btnMinus').prop('disabled', val <= min);
            $('#btnPlus').prop('disabled', val >= max);
        }

        $('#btnMinus').click(function () {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let min = parseInt(inp.attr('min')) || 1;
            if (val > min) {
                inp.val(val - 1);
                updateQuantityUI();
            }
        });

        $('#btnPlus').click(function () {
            let inp = $('#quantityInput');
            let val = parseInt(inp.val()) || 1;
            let max = parseInt(inp.attr('max')) || 1;
            if (val < max) {
                inp.val(val + 1);
                updateQuantityUI();
            }
        });

        $('#quantityInput').on('input', function () {
            updateQuantityUI();
        });

        // Khởi tạo khi trang load
        $(document).ready(function () {
            updateStatusShowHide();
            updateUI();
        });
    </script>
}

