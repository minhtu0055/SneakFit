@using SneakFit.Data.Enums
@using SneakFit.ViewModels.Common
@using SneakFit.ViewModels.System.User
@model SneakFit.ViewModels.Catalog.Voucher.CreateVoucher

@{
    var khachHangs = ViewBag.KhachHangs as PagedResult<UserViewModels>;
    ViewData["Title"] = "Tạo Voucher";
}

<div class="container-fluid">
    <h3 class="mt-4">Tạo mới voucher</h3>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách voucher</a></li>
        <li class="breadcrumb-item active">Tạo mới</li>
    </ol>
    <div class="card mb-4">
        <div class="card-body">
            <div class="col-md-8 mx-auto">
                <form asp-action="Create" method="post" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3 row">
                        <label asp-for="MaVoucher" class="col-sm-3 col-form-label">
                            Mã voucher <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <input asp-for="MaVoucher" class="form-control"
                                   value="@Model.MaVoucher"
                                   placeholder="Mã sẽ là @Model.MaVoucher"
                                   readonly />
                            <span asp-validation-for="MaVoucher" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="LoaiGiamGia" class="col-sm-3 col-form-label">Loại Giảm giá <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiGiamGia" asp-items="@ViewBag.LoaiGiamGia" class="form-select">
                                <option value="">-- Chọn loại giảm giá --</option>
                            </select>
                            <span asp-validation-for="LoaiGiamGia" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="GiaTriGiamGia" class="col-sm-3 col-form-label">
                            Giá trị giảm giá <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input asp-for="GiaTriGiamGia" class="form-control" type="number" step="0.01" />
                                <span class="input-group-text">
                                    @(Model?.LoaiGiamGia == LoaiGiamGia.PhamTram ? "%" : "VNĐ")
                                </span>
                            </div>
                            <span asp-validation-for="GiaTriGiamGia" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="DieuKienApDung" class="col-sm-3 col-form-label">Điều kiện áp dụng <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input asp-for="DieuKienApDung" class="form-control" type="number" step="1000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="DieuKienApDung" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="SoLuong" class="col-sm-3 col-form-label">Số Lượng <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="SoLuong" class="form-control" type="number" min="1" />
                            <span asp-validation-for="SoLuong" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="ThoiGianBatDau" class="col-sm-3 col-form-label">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="ThoiGianKetThuc" class="col-sm-3 col-form-label">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="LoaiVoucher" class="col-sm-3 col-form-label">Loại voucher <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiVoucher" asp-items="@ViewBag.LoaiVoucher" class="form-select">
                                <option value="">-- Chọn loại voucher --</option>
                            </select>
                            <span asp-validation-for="LoaiVoucher" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="section-block mb-4" id="userSelectionSection" style=" background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <div class="card-header">
                            Danh sách khách hàng
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <input type="text" id="searchCustomer" class="form-control" placeholder="Tìm kiếm theo tên, email hoặc số điện thoại...">
                                        <button class="btn btn-primary" type="button" id="btnSearchCustomer">
                                            <i class="bx bx-search"></i> Tìm
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive" style=" border-radius: 8px">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr style="background-color: mediumpurple; color: white;">
                                            <th>
                                                @* <input type="checkbox" id="selectAll" /> *@
                                            </th>
                                            <th>Họ và tên</th>
                                            <th>Email</th>
                                            <th>Số điện thoại</th>
                                        </tr>
                                    </thead>
                                    <tbody style="background-colo: white;">
                                        @if (khachHangs != null)
                                        {
                                            foreach (var item in khachHangs.Items)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" name="SelectedUserIds" value="@item.Id" class="user-checkbox" />
                                                    </td>
                                                    <td>@item.HoVaTen</td>
                                                    <td>@item.Email</td>
                                                    <td>@item.SoDienThoai</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            
                            <div id="customerPagination" class="mt-2 d-flex justify-content-center"></div>
                        </div>
                    </div>

                    <div class="mb-3 row ">
                        <div class="col-sm-12 text-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bx bx-save me-1"></i> Tạo mới
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bx bx-arrow-back me-1"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function toggleUserSelection() {
                var loaiVoucher = $("#LoaiVoucher").val();
                if (loaiVoucher == "@((int)LoaiVoucher.RiengTu)") {
                    $("#userSelectionSection").show();
                    // Load lại danh sách khách hàng trang đầu tiên khi chuyển sang riêng tư
                    searchCustomers(1);
                } else {
                    $("#userSelectionSection").hide();
                    // Xóa bảng và phân trang khi không phải riêng tư
                    $("table tbody").empty();
                    $("#customerPagination").empty();
                }
            }

            // Call on page load
            toggleUserSelection();

            // Call on change of voucher type
            $("#LoaiVoucher").change(toggleUserSelection);

            // Handle select all checkbox
            $("#selectAll").change(function () {
                $(".user-checkbox").prop("checked", $(this).prop("checked"));
            });

            // Handle customer search
            $("#btnSearchCustomer").click(function() {
                searchCustomers();
            });

            $("#searchCustomer").keypress(function(e) {
                if(e.which == 13) {
                    searchCustomers();
                }
            });

            function searchCustomers(pageIndex = 1) {
                var keyword = $("#searchCustomer").val();
                $.ajax({
                    url: '/Voucher/GetUsersForVoucherPaging',
                    type: 'GET',
                    data: {
                        keyword: keyword,
                        pageIndex: pageIndex,
                        pageSize: 10
                    },
                    success: function(response) {
                        if(response.isSuccessed) {
                            var customers = response.resultObj.items;
                            var tbody = $("table tbody");
                            tbody.empty();
                            customers.forEach(function(customer) {
                                var row = `
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="SelectedUserIds" value="${customer.id}" class="user-checkbox" />
                                        </td>
                                        <td>${customer.hoVaTen}</td>
                                        <td>${customer.email}</td>
                                        <td>${customer.soDienThoai}</td>
                                    </tr>
                                `;
                                tbody.append(row);
                            });
                            renderCustomerPagination(response.resultObj.pageIndex, response.resultObj.pageCount);
                        }
                    },
                    error: function(error) {
                        console.error('Error searching customers:', error);
                        toastr.error("Có lỗi xảy ra khi tìm kiếm khách hàng");
                    }
                });
            }

            function renderCustomerPagination(currentPage, pageCount) {
                var pagination = $("#customerPagination");
                pagination.empty();
                if (pageCount <= 1) return;
                var html = '<ul class="pagination">';
                for (let i = 1; i <= pageCount; i++) {
                    html += `<li class="page-item ${i === currentPage ? 'active' : ''}">` +
                        `<a href="javascript:void(0)" class="page-link" onclick="searchCustomers(${i})">${i}</a>` +
                        `</li>`;
                }
                html += '</ul>';
                pagination.html(html);
            }

            // Đảm bảo các hàm có thể gọi từ HTML onclick
            window.searchCustomers = searchCustomers;
            window.renderCustomerPagination = renderCustomerPagination;

            // Khi load trang, render luôn phân trang nếu có dữ liệu
            $(function() {
                var khachHangs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.KhachHangs));
                if (khachHangs && khachHangs.pageCount > 1) {
                    renderCustomerPagination(khachHangs.pageIndex, khachHangs.pageCount);
                }
            });

            // Real-time validation functions
            function validateRequiredField(fieldId, fieldName) {
                var value = $("#" + fieldId).val();
                if (!value || value.trim() === "") {
                    toastr.error(`Vui lòng nhập ${fieldName}`);
                    return false;
                }
                return true;
            }

            function validateSoLuong() {
                var soLuong = parseInt($("#SoLuong").val());
                if (isNaN(soLuong) || soLuong <= 0) {
                    toastr.error("Số lượng voucher phải lớn hơn 0");
                    return false;
                }
                return true;
            }

            function validateGiaTriGiamGia() {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                var giaTriGiamGia = parseFloat($("#GiaTriGiamGia").val());
                var errorMsg = "";

                if (!validateRequiredField("GiaTriGiamGia", "giá trị giảm giá")) {
                    return false;
                }

                if (loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)") {
                    if (giaTriGiamGia < 0 || giaTriGiamGia > 100) {
                        errorMsg = "Giá trị giảm giá phải từ 0% đến 100% đối với loại phần trăm";
                    }
                } else if (loaiGiamGia == "@((int)LoaiGiamGia.SoTien)") {
                    if (giaTriGiamGia <= 0) {
                        errorMsg = "Giá trị giảm giá phải lớn hơn 0 VNĐ đối với loại số tiền";
                    }
                }

                if (errorMsg) {
                    toastr.error(errorMsg);
                    return false;
                }
                return true;
            }

            function validateThoiGianBatDau() {
                if (!validateRequiredField("ThoiGianBatDau", "thời gian bắt đầu")) {
                    return false;
                }

                var thoiGianBatDau = new Date($("#ThoiGianBatDau").val());
                if (thoiGianBatDau <= new Date()) {
                    toastr.error("Thời gian bắt đầu phải sau thời điểm hiện tại");
                    return false;
                }
                return true;
            }

            function validateThoiGianKetThuc() {
                if (!validateRequiredField("ThoiGianKetThuc", "thời gian kết thúc")) {
                    return false;
                }

                var thoiGianBatDau = new Date($("#ThoiGianBatDau").val());
                var thoiGianKetThuc = new Date($("#ThoiGianKetThuc").val());
                if (thoiGianKetThuc <= thoiGianBatDau) {
                    toastr.error("Thời gian kết thúc phải sau thời gian bắt đầu");
                    return false;
                }
                return true;
            }

            function validateKhachHang() {
                var loaiVoucher = $("#LoaiVoucher").val();
                if (loaiVoucher == "@((int)LoaiVoucher.RiengTu)") {
                    var selectedUsers = $(".user-checkbox:checked").length;
                    if (selectedUsers === 0) {
                        toastr.error("Vui lòng chọn ít nhất một khách hàng cho voucher riêng tư");
                        return false;
                    }
                }
                return true;
            }

            function validateDieuKienApDung() {
                var dieuKienApDung = parseFloat($("#DieuKienApDung").val());
                if (isNaN(dieuKienApDung) || dieuKienApDung <= 0) {
                    toastr.error("Điều kiện áp dụng phải lớn hơn 0");
                    return false;
                }
                return true;
            }

            // Add event listeners for real-time validation
            $("#SoLuong").on('input', validateSoLuong);
            $("#GiaTriGiamGia").on('input', validateGiaTriGiamGia);
            $("#LoaiGiamGia").change(validateGiaTriGiamGia);
            $("#ThoiGianBatDau").change(validateThoiGianBatDau);
            $("#ThoiGianKetThuc").change(validateThoiGianKetThuc);
            $(".user-checkbox").change(validateKhachHang);
            $("#DieuKienApDung").on('input', validateDieuKienApDung);

            // Handle form submission
            $("form").submit(function(e) {
                e.preventDefault();
                
                // Validate all fields before submission
                if (!validateSoLuong() ||
                    !validateGiaTriGiamGia() || 
                    !validateThoiGianBatDau() || 
                    !validateThoiGianKetThuc() || 
                    !validateKhachHang() ||
                    !validateDieuKienApDung()) {
                    return false;
                }

                var formData = $(this).serialize();
                $.ajax({
                    url: '@Url.Action("Create", "Voucher")',
                    type: 'POST',
                    data: formData,
                    success: function(result) {
                        if (result.success) {
                            toastr.success("Tạo voucher thành công!");
                            setTimeout(function() {
                                window.location.href = '@Url.Action("Index", "Voucher")';
                            }, 1500);
                        } else {
                            toastr.error(result.message || "Không thể tạo voucher. Vui lòng thử lại!");
                        }
                    },
                    error: function() {
                        toastr.error("Đã xảy ra lỗi khi tạo voucher. Vui lòng thử lại sau!");
                    }
                });
            });
        });
    </script>
}