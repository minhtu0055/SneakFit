@using SneakFit.Data.Enums
@using SneakFit.ViewModels.Common
@model PagedResult<SneakFit.ViewModels.Catalog.Voucher.VoucherViewModels>

@{
    ViewData["Title"] = "Danh sách Voucher";
}

<div class="text-end mb-4">
    <a asp-action="Create" asp-controller="Voucher" class="btn btn-primary">
        <i class="bx bx-plus me-1"></i> Tạo voucher mới
    </a>
</div>
<div class="card">
    <div class="card-header">
        <div class="row">
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Mã voucher</label>
                        <input type="text" value="@ViewBag.Keyword" name="keyword" class="form-control" placeholder="Nhập mã voucher..." />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Trạng thái</label>
                        <select name="status" class="form-select" asp-items="ViewBag.DanhSachTrangThai"></select>
                    </div>
                    <div class="col-md-2 mb-2 d-flex align-items-end">
                        <div class="btn-group w-100">
                            <button type="submit" class="btn btn-primary">
                                <i class="bx bx-search"></i> Tìm
                            </button>
                            <a asp-action="Index" class="btn btn-dark">
                                <i class="bx bx-reset"></i> Reset
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMsg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMsg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>MÃ VOUCHER</th>
                    <th>LOẠI GIẢM GIÁ</th>
                    <th>GIÁ TRỊ GIẢM</th>
                    <th>loại Voucher</th>
                    <th>ĐIỀU KIỆN</th>
                    <th>GIÁ TRỊ TỐI ĐA</th>
                    <th>SỐ LƯỢNG</th>
                    <th>THỜI GIAN</th>
                    <th>TRẠNG THÁI</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model?.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.MaVoucher)
                            </td>
                            <td>
                                @(item.LoaiGiamGia == LoaiGiamGia.PhamTram ? "Phần trăm" : "Số tiền")
                            </td>
                            <td>
                                @(item.LoaiGiamGia == LoaiGiamGia.PhamTram ? item.GiaTriGiamGia + "%" : item.GiaTriGiamGia.ToString("N0") + " đ")
                            </td>
                            <td>
                                @(item.loaiVoucher == LoaiVoucher.CongKhai ? "Công Khai" : "Riêng Tư")
                            </td>
                            <td>
                                @item.DieuKienApDung.ToString("N0") đ
                            </td>
                            <td>
                                @item.GiaTriToiDa.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                <span class="badge bg-label-dark">@item.SoLuong</span>
                            </td>
                            <td>
                                <div><i class="bx bx-calendar me-1"></i>Từ: @item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</div>
                                <div><i class="bx bx-calendar me-1"></i>Đến: @item.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <span class="badge bg-label-@GetStatusColor(item.TrangThai)">
                                    @GetStatusName(item.TrangThai)
                                </span>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="@Url.Action("Edit", new { id = item.Id })">
                                            <i class="bx bx-edit-alt me-1"></i> Chỉnh sửa
                                        </a>
                                        <a class="dropdown-item" href="@Url.Action("Details", new { id = item.Id })">
                                            <i class="bx bx-detail me-1"></i> Chi tiết
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">Không có dữ liệu voucher.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Component.InvokeAsync("Pager", Model)
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto-hide alerts after 4 seconds
            setTimeout(function () {
                $(".alert").fadeOut("slow");
            }, 4000);

            // Check for success/error messages in URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const successMsg = urlParams.get('successMsg');
            const errorMsg = urlParams.get('errorMsg');

            if (successMsg) {
                toastr.success(successMsg);
            }
            if (errorMsg) {
                toastr.error(errorMsg);
            }
        });
    </script>

    @functions {
    string GetStatusName(TrangThaiGiamGia status)
    {
        switch (status)
        {
            case TrangThaiGiamGia.HoatDong:
                return "Đang hoạt động";
            case TrangThaiGiamGia.KhongHoatDong:
                return "Chưa hoạt động";
            case TrangThaiGiamGia.HetHan:
                return "Đã hết hạn";
            default:
                return status.ToString();
        }
    }
    string GetStatusColor(TrangThaiGiamGia status)
    {
        switch (status)
        {
            case TrangThaiGiamGia.HoatDong:
                return "success";
            case TrangThaiGiamGia.KhongHoatDong:
                return "warning";
            case TrangThaiGiamGia.HetHan:
                return "danger";
            default:
                return "danger";
        }
    }
    }
}
