﻿@using SneakFit.ViewModels.Catalog.Voucher
@using SneakFit.Data.Enums
@using SneakFit.ViewModels.Common
@using SneakFit.ViewModels.System.User
@model UpdateVoucher
@{
    var khachHangs = ViewBag.KhachHangs as PagedResult<UserViewModels>;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cập nhật Voucher";
}

<div class="container-fluid">
    <h3 class="mt-4">Cập nhật voucher</h3>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách voucher</a></li>
        <li class="breadcrumb-item active">Cập nhật</li>
    </ol>
    <div class="card mb-4">
        <div class="card-body">
            <div class="col-md-8 mx-auto">
                <form asp-action="Edit" method="post" id="edit-form" class="needs-validation">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3 row">
                        <label asp-for="MaVoucher" class="col-sm-3 col-form-label">Mã voucher <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="MaVoucher" class="form-control"
                                   value="@Model.MaVoucher"
                                   placeholder="Mã sẽ là @Model.MaVoucher"
                                   readonly />
                            <span asp-validation-for="MaVoucher" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="LoaiGiamGia" class="col-sm-3 col-form-label">Loại Giảm giá <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiGiamGia" asp-items="@ViewBag.LoaiGiamGia" class="form-select">
                            </select>
                            <div class="invalid-feedback">
                                Vui lòng chọn loại giảm giá
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="GiaTriGiamGia" class="col-sm-3 col-form-label">Giá trị giảm giá <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <div class="input-group has-validation">
                                <input asp-for="GiaTriGiamGia" class="form-control" type="number" />
                                <span class="input-group-text discount-unit"></span>
                            </div>
                            <small class="form-text text-muted discount-hint"></small>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="DieuKienApDung" class="col-sm-3 col-form-label">
                            Điều kiện áp dụng <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <div class="input-group has-validation">
                                <input type="text"
                                       id="DieuKienApDungFormatted"
                                       class="form-control"
                                       value="@Model.DieuKienApDung.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))"
                                       oninput="formatAndSyncInput(this)" />
                                <span class="input-group-text">VNĐ</span>

                                <!-- Input thật để binding model, không hiển thị -->
                                <input asp-for="DieuKienApDung" type="hidden" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row" id="giatritoidaRow">
                        <label asp-for="GiaTriToiDa" class="col-sm-3 col-form-label">
                            Gia Trị Tối Đa <span class="text-danger">*</span>
                        </label>
                        <div class="col-sm-9">
                            <div class="input-group has-validation">
                                <div class="input-group">
                                <input asp-for="GiaTriToiDa" class="form-control" type="number" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="GiaTriToiDa" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row" id="soLuongRow">
                        <label asp-for="SoLuong" class="col-sm-3 col-form-label">Số Lượng <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <div class="input-group has-validation">
                                <input asp-for="SoLuong" class="form-control" type="number" min="1" />
                                <div class="invalid-feedback">
                                    Vui lòng nhập số lượng voucher (phải lớn hơn 0)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="ThoiGianBatDau" class="col-sm-3 col-form-label">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <div class="input-group has-validation">
                                <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
                                <div class="invalid-feedback">
                                    Vui lòng chọn thời gian bắt đầu
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="ThoiGianKetThuc" class="col-sm-3 col-form-label">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
                            <div class="invalid-feedback">
                                Vui lòng chọn thời gian kết thúc
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="LoaiVoucher" class="col-sm-3 col-form-label">Loại voucher <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiVoucher" class="form-select" onchange="toggleUserSelection()">
                                @if (Model.LoaiVoucher == LoaiVoucher.RiengTu)
                                {
                                    <option value="@((int)LoaiVoucher.RiengTu)" selected>Riêng tư</option>
                                    <option value="@((int)LoaiVoucher.CongKhai)" disabled>Công khai</option>
                                }
                                else
                                {
                                    <option value="@((int)LoaiVoucher.CongKhai)" selected>Công khai</option>
                                    <option value="@((int)LoaiVoucher.RiengTu)">Riêng tư</option>
                                }
                            </select>
                            <span asp-validation-for="LoaiVoucher" class="text-danger"></span>
                            @if (Model.LoaiVoucher == LoaiVoucher.RiengTu)
                            {
                                <small class="text-muted">Không thể chuyển voucher riêng tư sang công khai</small>
                            }
                        </div>
                    </div>

                    <div id="userSelection" class="section-block mb-4" style="display: none; background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <div class="card-header">
                            Danh sách khách hàng
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6 d-flex">
                                    <input type="text" id="searchCustomer" class="form-control" placeholder="Tìm kiếm theo tên, email hoặc số điện thoại...">
                                    <button class="btn btn-primary" type="button" id="btnSearchCustomer">
                                        <i class="bx bx-search"></i> Tìm
                                    </button>
                                    @* Hidden SelectedUserIds to keep checked users after search *@
                                    @foreach (var id in Model.SelectedUserIds ?? new List<Guid>())
                                    {
                                        <input type="hidden" name="SelectedUserIds" value="@id" />
                                    }
                                </div>
                            </div>
                            <div class="table-responsive" style=" border-radius: 8px">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr style="background-color: mediumpurple; color: white;">
                                            <th style="width: 50px;">
                                                @* <input type="checkbox" id="selectAll" /> *@
                                            </th>
                                            <th>HỌ VÀ TÊN</th>
                                            <th>EMAIL</th>
                                            <th>SỐ ĐIỆN THOẠI</th>
                                        </tr>
                                    </thead>
                                    <tbody style="background-colo: white;">
                                        @if (khachHangs != null && khachHangs.Items.Any())
                                        {
                                            foreach (var user in khachHangs.Items)
                                            {
                                                if (user.TrangThai)
                                                {
                                                    var isExistingUser = Model.SelectedUserIds != null && Model.SelectedUserIds.Contains(user.Id);
                                                    <tr class="@(isExistingUser ? "table-primary" : "")">
                                                        <td>
                                                            <input type="checkbox"
                                                                   class="user-checkbox"
                                                                   name="SelectedUserIds"
                                                                   value="@user.Id"
                                                            @(isExistingUser ? "checked" : "")
                                                            @(isExistingUser ? "disabled" : "") />
                                                        </td>
                                                        <td class="@(isExistingUser ? "fw-bold" : "")">@user.HoVaTen</td>
                                                        <td class="@(isExistingUser ? "fw-bold" : "")">@user.Email</td>
                                                        <td class="@(isExistingUser ? "fw-bold" : "")">@user.SoDienThoai</td>
                                                    </tr>
                                                }

                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (khachHangs != null && khachHangs.PageCount > 1)
                            {
                                <div class="mt-2 d-flex justify-content-center">
                                    <ul class="pagination">
                                        @for (var i = 1; i <= khachHangs.PageCount; i++)
                                        {
                                            <li class="page-item @(i == khachHangs.PageIndex ? "active" : "")">
                                                <a href="javascript:void(0)" class="page-link" onclick="searchCustomers(@i)">@i</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                    <small class="text-muted">* Khách hàng đã có trong voucher này sẽ được hiển thị bôi đậm và không thể bỏ chọn</small>
                    <input type="hidden" id="SelectedUserIdsHidden" name="SelectedUserIdsHidden" />
                    <div class="mb-3 row ">
                        <div class="col-sm-12 text-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bx bx-save me-1"></i> Cập Nhật
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bx bx-arrow-back me-1"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @*  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} *@
    <script>


        function toggleSoLuongRow() {
            var loaiVoucher = $("#LoaiVoucher").val();
            if (loaiVoucher == "@((int)LoaiVoucher.RiengTu)") {
                $("#soLuongRow").hide();
            } else {
                $("#soLuongRow").show();
            }
        }

        function toggleGiaTriToiDaRow() {
            var loaiGiamGia = $("#LoaiGiamGia").val();
            if (loaiGiamGia == "@((int)LoaiGiamGia.SoTien)") {
                $("#giatritoidaRow").hide();
            } else {
                $("#giatritoidaRow").show();
            }
        }

        // Gọi khi trang load
        toggleSoLuongRow();
        toggleGiaTriToiDaRow();

        // Gọi khi thay đổi select
        $("#LoaiVoucher").change(toggleSoLuongRow);
        $("#LoaiGiamGia").change(toggleGiaTriToiDaRow);


        function formatCurrencyInput(input) {
            // Xóa ký tự không phải số, kể cả dấu chấm
            let value = input.value.replace(/\D/g, '');
            if (value) {
                input.value = Number(value).toLocaleString('vi-VN');
            } else {
                input.value = '';
            }
        }

        // Trước khi submit form: bỏ dấu chấm để server nhận đúng số
        function formatAndSyncInput(input) {
            // Xóa ký tự không phải số
            const raw = input.value.replace(/\D/g, '');

            // Cập nhật lại input hiển thị với định dạng tiền VNĐ
            input.value = new Intl.NumberFormat('vi-VN').format(raw);

            // Đồng bộ giá trị sạch về input hidden asp-for
            document.querySelector('input[name="DieuKienApDung"]').value = raw;
        }
        // Trước khi submit form: bỏ dấu chấm để server nhận đúng số
        function formatAndSyncInput(input) {
            // Xóa ký tự không phải số
            const raw = input.value.replace(/\D/g, '');

            // Cập nhật lại input hiển thị với định dạng tiền VNĐ
            input.value = new Intl.NumberFormat('vi-VN').format(raw);

            // Đồng bộ giá trị sạch về input hidden asp-for
            document.querySelector('input[name="GiaTriToiDa"]').value = raw;
        }


        var existingUserIds = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingUserIds ?? new List<Guid>()));
        var selectedUserIds = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SelectedUserIds ?? new List<Guid>()));
        $(document).ready(function () {

            // Hàm cập nhật đơn vị giảm giá và các thuộc tính của input giá trị giảm
            function capNhatLoaiGiamGia() {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                var unit = loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)" ? "%" : "VNĐ";
                $(".discount-unit").text(unit);

                // Cập nhật hint text
                var hint = loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)"
                    ? "Giá trị giảm giá phải từ 0% đến 100%"
                    : "Giá trị giảm giá phải lớn hơn 0 VNĐ";
                $(".discount-hint").text(hint);

                if (loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)") {
                    $("#GiaTriGiamGia").attr({
                        "step": "0.01",
                        "max": "100",
                        "min": "0"
                    });
                } else {
                    $("#GiaTriGiamGia").attr({
                        "step": "1000",
                        "min": "0"
                    }).removeAttr("max");
                }
            }

            $("#LoaiGiamGia").change(capNhatLoaiGiamGia);
            capNhatLoaiGiamGia();


            //tìm kiếm và load danh sách


            // Handle customer search
            $("#btnSearchCustomer").click(function () {
                searchCustomers();
            });

            $("#searchCustomer").keypress(function (e) {
                if (e.which == 13) {
                    searchCustomers();
                }
            });
            // Tự động tìm kiếm khi người dùng thay đổi từ khóa
            $("#searchCustomer").on('input', function () {
                var keyword = $(this).val();
                if (keyword.length === 0) {
                    // Nếu xóa hết từ khóa, tải lại trang để hiển thị danh sách ban đầu
                    window.location.reload();
                }
            });

            // Hàm render lại bảng khách hàng và phân trang
            function searchCustomers(pageIndex = 1) {
                var keyword = $("#searchCustomer").val();
                $.ajax({
                    url: '/Voucher/GetUsersForVoucherPaging',
                    type: 'GET',
                    data: {
                        keyword: keyword,
                        pageIndex: pageIndex,
                        pageSize: 10
                    },
                    success: function (response) {
                        if (response.isSuccessed) {
                            var customers = response.resultObj.items;
                            var tbody = $("table tbody");
                            tbody.empty();
                            customers.forEach(function (customer) {
                                var isExisting = existingUserIds.includes(customer.id);
                                var isSelected = selectedUserIds.includes(customer.id);
                                var rowClass = (isExisting || isSelected) ? 'table-primary' : '';
                                var boldClass = (isExisting || isSelected) ? 'fw-bold' : '';
                                var checkboxAttr = '';

                                if (isExisting) {
                                    checkboxAttr = 'checked disabled';
                                } else if (isSelected) {
                                    checkboxAttr = 'checked';
                                }

                                var row = `
                                                    <tr class="${rowClass}">
                                                        <td><input type="checkbox" class="user-checkbox" name="SelectedUserIds" value="${customer.id}" ${checkboxAttr} /></td>
                                                        <td class="${boldClass}">${customer.hoVaTen}</td>
                                                        <td class="${boldClass}">${customer.email}</td>
                                                        <td class="${boldClass}">${customer.soDienThoai}</td>
                                                    </tr>
                                                `;
                                tbody.append(row);
                            });
                            renderCustomerPagination(response.resultObj.pageIndex, response.resultObj.pageCount);
                        }
                    },
                    error: function (error) {
                        toastr.error("Có lỗi xảy ra khi tìm kiếm khách hàng");
                    }
                });
            }
            function renderCustomerPagination(currentPage, pageCount) {
                var pagination = $("#customerPagination");
                pagination.empty();
                if (pageCount <= 1) return;
                var html = '<ul class="pagination">';
                for (let i = 1; i <= pageCount; i++) {
                    html += `<li class="page-item ${i === Number(currentPage) ? 'active' : ''}">` +
                        `<a href="javascript:void(0)" class="page-link" onclick="searchCustomers(${i})">${i}</a>` +
                        `</li>`;
                }
                html += '</ul>';
                pagination.html(html);
            }
            window.searchCustomers = searchCustomers;
            window.renderCustomerPagination = renderCustomerPagination;
            // Khi load trang, render luôn phân trang nếu có dữ liệu
            $(function () {
                var khachHangs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.KhachHangs));
                if (khachHangs && khachHangs.pageCount > 1) {
                    renderCustomerPagination(khachHangs.pageIndex, khachHangs.pageCount);
                }
            });

            // Kiểm tra loại voucher khi trang được tải
            toggleUserSelection();

            // Hàm kiểm tra và hiển thị/ẩn phần chọn khách hàng
            function toggleUserSelection() {
                var loaiVoucher = $("#LoaiVoucher").val();
                if (loaiVoucher == "@((int)LoaiVoucher.RiengTu)") {
                    $("#userSelection").show();
                } else {
                    $("#userSelection").hide();
                }
            }

            // Thêm sự kiện change cho select loại voucher
            $("#LoaiVoucher").change(toggleUserSelection);

            function validateRequiredField(fieldId, fieldName) {
                var value = $("#" + fieldId).val();
                if (!value || value.trim() === "") {
                    toastr.error(`Vui lòng nhập ${fieldName}`);
                    return false;
                }
                return true;
            }

            //validate dữ liệu

            function validateSoLuong() {
                var loaiVoucher = $("#LoaiVoucher").val();
                if (loaiVoucher == "@((int)LoaiVoucher.RiengTu)") {
                    // Nếu là riêng tư thì không cần validate số lượng
                    return true;
                }
                var soLuong = parseInt($("#SoLuong").val());
                if (isNaN(soLuong) || soLuong <= 0) {
                    toastr.error("Số lượng voucher phải lớn hơn 0");
                    return false;
                }
                return true;
            }

            function validateGiaTriGiamGia() {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                var giaTriGiamGia = parseFloat($("#GiaTriGiamGia").val());
                var errorMsg = "";

                if (!validateRequiredField("GiaTriGiamGia", "giá trị giảm giá")) {
                    return false;
                }

                if (loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)") {
                    if (giaTriGiamGia < 1 || giaTriGiamGia > 100) {
                        errorMsg = "Giá trị giảm giá phải từ 1% đến 100% đối với loại phần trăm";
                    }
                } else if (loaiGiamGia == "@((int)LoaiGiamGia.SoTien)") {
                    if (giaTriGiamGia <= 1000) {
                        errorMsg = "Giá trị giảm giá phải lớn hơn 1000 VNĐ đối với loại số tiền";
                    }
                }

                if (errorMsg) {
                    toastr.error(errorMsg);
                    return false;
                }
                return true;
            }

            function validateThoiGianBatDau() {
                if (!validateRequiredField("ThoiGianBatDau", "thời gian bắt đầu")) {
                    return false;
                }

                var thoiGianBatDau = new Date($("#ThoiGianBatDau").val());
                if (thoiGianBatDau <= new Date()) {
                    toastr.error("Thời gian bắt đầu phải sau thời điểm hiện tại");
                    return false;
                }
                return true;
            }

            function validateThoiGianKetThuc() {
                if (!validateRequiredField("ThoiGianKetThuc", "thời gian kết thúc")) {
                    return false;
                }

                var thoiGianBatDau = new Date($("#ThoiGianBatDau").val());
                var thoiGianKetThuc = new Date($("#ThoiGianKetThuc").val());
                if (thoiGianKetThuc <= thoiGianBatDau) {
                    toastr.error("Thời gian kết thúc phải sau thời gian bắt đầu");
                    return false;
                }
                return true;
            }

            function validateDieuKienApDung() {
                var dieuKien = parseFloat($("#DieuKienApDung").val());
                if (isNaN(dieuKien) || dieuKien <= 0) {
                    toastr.error("Điều kiện áp dụng phải lớn hơn 0");
                    return false;
                }
                return true;
            }
            function validateGiatritoida() {
                var giatritoida = parseFloat($("#GiaTriToiDa").val());
                if (isNaN(giatritoida) || giatritoida <= 0) {
                    toastr.error("Gia Trị Tối Đa phải lớn hơn 0");
                    return false;
                }
                return true;
            }

            // function validateKhachHang() {
            //     var loaiVoucher = "@Model.LoaiVoucher";
            //     if (loaiVoucher == "@((int)LoaiVoucher.RiengTu)") {
            //         var selectedUsers = $(".user-checkbox:checked").length;
            //     }
            //     return true;
            // }

            function validateLoaiVoucher() {
                var loaiVoucher = parseInt($("#LoaiVoucher").val()); // Lấy giá trị loại voucher (int)
                var isRiengTu = loaiVoucher === @((int)LoaiVoucher.RiengTu);

                if (isRiengTu) {
                    var selectedUsers = $("input[name='SelectedUserIds']:checked");
                }

                return true;
            }

            // Add event listeners for real-time validation
            $("#SoLuong").on('input', validateSoLuong);
            $("#GiaTriGiamGia").on('input', validateGiaTriGiamGia);
            $("#LoaiGiamGia").change(validateGiaTriGiamGia);
            $("#ThoiGianBatDau").change(validateThoiGianBatDau);
            $("#ThoiGianKetThuc").change(validateThoiGianKetThuc);
            $("#DieuKienApDung").on('input', validateDieuKienApDung);
            $("#GiaTriToiDa").on('input', validateGiatritoida);
            $(".user-checkbox").change(validateLoaiVoucher);

            // Handle form submission
            $("#edit-form").submit(function (e) {
                e.preventDefault();
                // Gán lại selectedUserIds vào input ẩn
                const selectedUserValues = $("input[name='SelectedUserIds']:checked").map(function () {
                    return $(this).val();
                }).get();
                $("#SelectedUserIdsHidden").val(selectedUserValues.join(','));

                // Validate all fields before submission
                if (!validateSoLuong() ||
                    !validateGiaTriGiamGia() ||
                    !validateThoiGianBatDau() ||
                    !validateThoiGianKetThuc() ||
                    !validateDieuKienApDung() ||
                    !validateGiatritoida() ||
                    !validateLoaiVoucher()) {
                    return false;
                }

                var formData = $(this).serialize();
                $.ajax({
                    url: '@Url.Action("Edit", "Voucher")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            toastr.success("Cập nhật voucher thành công!");
                            setTimeout(function () {
                                window.location.href = '@Url.Action("Index", "Voucher")';
                            }, 1500);
                        } else {
                            toastr.error(response.message || "Không thể cập nhật voucher. Vui lòng thử lại!");
                        }
                    },
                    error: function (xhr) {
                        var errorMessage = "Đã xảy ra lỗi khi cập nhật voucher. Vui lòng thử lại sau!";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        toastr.error(errorMessage);
                    }
                });
            });


            // Cập nhật selectedUserIds khi check/uncheck khách hàng mới
            $(document).on('change', '.user-checkbox:not(:disabled)', function () {
                var userId = $(this).val();
                if ($(this).is(':checked')) {
                    if (!selectedUserIds.includes(userId)) selectedUserIds.push(userId);
                } else {
                    selectedUserIds = selectedUserIds.filter(id => id != userId);
                }
                $("#SelectedUserIdsHidden").val(selectedUserIds.join(','));
            });
            $("#edit-form").submit(function () {
                $("#SelectedUserIdsHidden").val(selectedUserIds.join(','));
            });
        });
    </script>
} 