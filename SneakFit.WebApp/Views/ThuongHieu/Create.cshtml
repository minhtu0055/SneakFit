@model SneakFit.ViewModels.Catalog.ThuongHieu.ThemThuongHieu
<form asp-controller="ThuongHieu" asp-action="Create" id="createThuongHieuForm" method="post">
    <div class="mb-3">
        <label asp-for="TenThuongHieu" class="form-label">Tên Thương Hiệu</label>
        <input asp-for="TenThuongHieu" class="form-control" placeholder="Nhập tên thương hiệu"
               pattern="^[a-zA-ZÀ-ỹ\s]+$"
               oninput="validateInput(this)"
               maxlength="50"
               title="Vui lòng chỉ nhập chữ cái" />
        <span asp-validation-for="TenThuongHieu" class="text-danger"></span>
        <span id="customError" class="text-danger" style="display: none;">Vui lòng chỉ nhập chữ cái</span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">Thêm</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
    </div>
</form>
<script>
function validateInput(input) {
    const pattern = /^[a-zA-ZÀ-ỹ\s]+$/;
    const errorSpan = document.getElementById('customError');
    if (!pattern.test(input.value) && input.value !== '') {
        errorSpan.style.display = 'block';
        input.setCustomValidity('Vui lòng chỉ nhập chữ cái');
    } else {
        errorSpan.style.display = 'none';
        input.setCustomValidity('');
    }
}
</script> 