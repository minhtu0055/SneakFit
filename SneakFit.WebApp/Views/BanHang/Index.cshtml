            function loadPrivateVouchers(userId, tongTienHoaDon) {
                $.ajax({
                    url: '/Voucher/PrivateVouchers',
                    type: 'GET',
                    data: { userId: userId, tongTienHoaDon: tongTienHoaDon },
                    success: function (res) {
                        if (res && res.isSuccessed && res.resultObj && res.resultObj.length > 0) {
                            let html = '';
