                                         data-dieukienapdung="${voucher.dieuKienApDung}"
                                         data-giatri="${voucher.giaTriGiamGia}"
                                         data-loaigiamgia="${voucher.loaiGiamGia}"
                                         data-giatritoida="${voucher.giaTriToiDa}"
