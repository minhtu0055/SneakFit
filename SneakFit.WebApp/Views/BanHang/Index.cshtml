@using SneakFit.Data.Enums
@model List<SneakFit.ViewModels.Catalog.HoaDonChiTiet.HoaDonChiTietViewModel>

@{
    ViewData["Title"] = "Bán hàng tại quầy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .custom-table-no-vertical thead th {
        border-bottom: 2px solid #696cff !important;
        background: #696cff;
        color: #fff;
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
    }

    .custom-table-no-vertical td {
        text-align: center;
        vertical-align: middle;
    }

    .gia-khuyen-mai {
        color: #e53935;
        font-weight: bold;
    }

    .gia-goc {
        color: #888;
        text-decoration: line-through;
        font-size: 0.95em;
    }

    .badge.bg-success {
        background-color: #4fd1c5 !important;
        color: #fff !important;
    }

    .voucher-box {
        display: flex;
        align-items: center;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        min-height: 40px;
        position: relative;
    }

    .voucher-icon {
        font-size: 1.2em;
        color: #222;
        margin-right: 10px;
        display: flex;
        align-items: center;
    }

    .voucher-label {
        font-weight: 600;
        color: #222;
        margin-right: auto;
    }

    .voucher-action {
        color: #888;
        font-weight: 500;
        margin-left: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }
    /* Bootstrap modal overlay */
    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.4);
    }

    .modal-content {
        background: white;
        border-radius: 8px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        overflow: hidden;
        border: none;
    }

    .modal-header {
        padding: 6px 20px 6px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-title {
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 18px;
        color: #999;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
    }

        .close-btn:hover {
            color: #666;
        }

    .modal-body {
        padding: 20px;
    }

    .search-container {
        margin-bottom: 24px;
    }

    .search-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
        color: #999;
        background: #fafafa;
    }

        .search-input:focus {
            border-color: #d0d0d0;
            background: white;
        }

    .section-title {
        font-size: 14px;
        font-weight: 500;
        color: #333;
        margin-bottom: 16px;
    }

    .empty-state {
        text-align: center;
        padding: 32px 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        background: #f5f5f5;
        border-radius: 50%;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .empty-icon::before {
            content: '';
            width: 32px;
            height: 24px;
            background: #ddd;
            border-radius: 4px;
            position: relative;
        }

        .empty-icon::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 20px;
            height: 16px;
            background: white;
            border-radius: 2px;
        }

    .empty-text {
        font-size: 14px;
        color: #999;
    }

    .voucher-section {
        background: #f8f9fa;
        margin: 0 -20px;
        padding: 16px 20px;
    }

    .voucher-section-title {
        font-size: 14px;
        font-weight: 500;
        color: #333;
        margin-bottom: 12px;
    }

    .voucher-item {
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 6px;
        padding: 16px;
        display: flex;
        align-items: flex-start;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }

        .voucher-item:hover {
            border-color: #007bff;
            box-shadow: 0 2px 8px rgba(0, 123, 255, 0.1);
        }

    .voucher-badge {
        background: #ffc107;
        color: #333;
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        position: absolute;
        top: -6px;
        right: -6px;
        z-index: 1;
    }

    .voucher-code {
        background: #f8f9fa;
        color: #333;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        margin-right: 12px;
        min-width: 70px;
        text-align: center;
        flex-shrink: 0;
    }

    .voucher-info {
        flex: 1;
    }

    .voucher-name {
        font-size: 14px;
        font-weight: 500;
        color: #333;
        margin-bottom: 4px;
    }

    .voucher-details {
        font-size: 12px;
        color: #666;
        line-height: 1.4;
    }

    .voucher-discount {
        font-size: 16px;
        font-weight: 600;
        color: #ff6b35;
        margin-left: 8px;
        flex-shrink: 0;
    }

    .radio-container {
        margin-left: 8px;
        flex-shrink: 0;
    }

    .radio-btn {
        width: 18px;
        height: 18px;
        border: 2px solid #ddd;
        border-radius: 50%;
        position: relative;
        cursor: pointer;
    }

    .voucher-item.selected .radio-btn {
        border-color: #007bff;
    }

        .voucher-item.selected .radio-btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 8px;
            height: 8px;
            background: #007bff;
            border-radius: 50%;
        }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="hoa-don-tabs">
            <ul class="nav nav-pills" id="hoaDonTabs"></ul>
        </div>
        <div>
            <button id="btnTaoHoaDon" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Tạo hóa đơn
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin hóa đơn</h5>
                    <div class="d-flex gap-2">
                        <button id="qrScanBtn" class="btn btn-primary">
                            <i class="bx bx-qr me-1"></i></i> QR Code
                        </button>
                        <button id="btnThemSanPham" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> Thêm sản phẩm
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <thead>
                            <tr style="text-align: center">
                                <th style="width: 50px;">STT</th>
                                <th>Ảnh</th>
                                <th>Sản phẩm</th>
                                <th style="width: 240px;">Số lượng</th>
                                <th style="width: 180px;">Đơn giá</th>
                                <th style="width: 180px;">Thành tiền</th>
                                <th style="width: 110px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="hoaDonChiTietTable">
                            <tr class="no-data">
                                <td colspan="7" class="text-center">Không có sản phẩm nào trong giỏ</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Tổng tiền:</strong></td>
                                <td colspan="2"><span id="tongTien">0 VNĐ</span></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Phân trang cho hóa đơn chờ -->
                    <div id="paginationContainer" class="d-none">
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="pagination-info">
                                Hiển thị <span id="startItem">0</span> - <span id="endItem">0</span> của <span id="totalItems">0</span> sản phẩm
                            </div>
                            <nav aria-label="Phân trang hóa đơn chờ">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item" id="prevPage">
                                        <a class="page-link" href="#" aria-label="Trang trước">
                                            <i class="bx bx-chevron-left"></i>
                                        </a>
                                    </li>
                                    <li class="page-item" id="nextPage">
                                        <a class="page-link" href="#" aria-label="Trang sau">
                                            <i class="bx bx-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin khách hàng</h5>
                    <div class="d-flex align-items-center gap-3">
                        <span id="selectedCustomerTag" class="badge bg-danger d-none">
                            <span id="selectedCustomerName"></span>
                            <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.6em;" id="removeCustomer"></button>
                        </span>
                        <div class="position-relative">
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm" id="searchKhachHang" placeholder="Tìm kiếm theo tên hoặc số điện thoại..." style="width: 250px;" />
                                <button class="btn btn-outline-primary btn-sm" type="button" id="btnTimKiemKH">
                                    <i class="bx bx-search"></i>
                                </button>
                            </div>
                            <div id="ketQuaTimKiemKH" class="position-absolute w-100 bg-white shadow-sm rounded mt-1 d-none" style="z-index: 1000; max-height: 200px; overflow-y: auto;"></div>
                        </div>
                        <button id="btnThemMoiKH" class="btn btn-primary btn-sm">
                            <i class="bx bx-plus me-1"></i> Thêm mới KH
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <form id="formKhachHang">
                        <input type="hidden" id="khachHangId" name="khachHangId" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex align-items-center">
                                    <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Tên khách hàng:</label>
                                    <div id="customerName" class="form-control-plaintext">Khách hàng lẻ</div>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="customerEmailRow">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex align-items-center">
                                    <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Email:</label>
                                    <div id="customerEmail" class="form-control-plaintext">-</div>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="customerPhoneRow">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex align-items-center">
                                    <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Số điện thoại:</label>
                                    <div id="customerPhone" class="form-control-plaintext">-</div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin thanh toán</h5>
                    <a href="#" id="btnChonDiaChi" class="d-flex align-items-center d-none" style="font-weight: 500;">
                        <i class="bx bx-map-pin me-1" style="font-size: 1.2em;"></i> Chọn địa chỉ
                    </a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div id="giaoHangDiaChiSection">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Họ Và Tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="hoVaTen" placeholder="Họ Và Tên" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="soDienThoai" placeholder="Số điện thoại" readonly>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label fw-bold">Thành phố/Tỉnh <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="provinceName" readonly />
                                        <input type="hidden" id="provinceCode" />
                                        <span class="invalid-feedback">Vui lòng chọn tỉnh/thành phố</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label fw-bold">Quận/Huyện <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="districtName" readonly />
                                        <input type="hidden" id="districtCode" />
                                        <span class="invalid-feedback">Vui lòng chọn quận/huyện</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label fw-bold">Phường/Xã <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="wardName" readonly />
                                        <input type="hidden" id="wardCode" />
                                        <span class="invalid-feedback">Vui lòng chọn phường/xã</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Thôn/Xóm</label>
                                    <input type="text" class="form-control" id="diaChiCuThe" readonly placeholder="Địa chỉ cụ thể">
                                </div>
                                <div class="d-flex align-items-center justify-content-end">
                                    <img src="~/assets/img/GHN.webp" alt="GHN" class="me-2" style="width: 160px; object-fit: contain; border-radius: 6px;">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-2" id="giaoHangToggleRow">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="toggleGiaoHang">
                                    <label class="form-check-label fw-bold" for="toggleGiaoHang">Giao hàng</label>
                                </div>
                            </div>
                            <div class="voucher-box mb-4">
                                <span class="voucher-icon"><i class="bx bx-discount"></i></span>
                                <span class="voucher-label">Phiếu giảm giá</span>
                                <span class="voucher-action">Chọn hoặc nhập mã <i class="bx bx-chevron-right"></i></span>
                            </div>
                            <div class="border-0 mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tạm tính:</span>
                                    <span class="fw-bold tam-tinh-value">0 VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 d-none" id="phiVanChuyenRow">
                                    <span>Phí vận chuyển (tạm tính):</span>
                                    <span class="fw-bold">0 VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Giảm giá:</span>
                                    <span id="giamGiaValue" class="fw-bold">0 VNĐ</span>
                                </div>

                                <!-- Thông báo voucher đã áp dụng -->
                                <div id="voucherAppliedNotification" class="d-none mb-3">
                                    <div class="alert alert-success d-flex align-items-center justify-content-between" style="background-color: #d4edda; border-color: #c3e6cb; color: #155724;">
                                        <div>
                                            <div class="fw-bold" id="voucherAppliedText">Áp dụng thành công phiếu giảm giá <span id="voucherName" class="fw-bold"></span></div>
                                            <div class="small" id="voucherDetails">Giảm <span id="voucherDiscountValue" class="text-danger fw-bold"></span> đơn tối thiểu <span id="voucherMinOrder" class="text-danger fw-bold"></span></div>
                                        </div>
                                        <button type="button" class="btn-close" onclick="removeVoucher()"></button>
                                    </div>
                                </div>

                                <hr>
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="fw-bold" title="Tổng tiền = Tạm tính + Phí vận chuyển (nếu có) - Giảm giá (nếu có)">Tổng tiền:</span>
                                    <span class="fw-bold text-danger fs-5" id="tongTienThanhToan">0 VNĐ</span>
                                </div>
                                <div class="mb-3 tien-mat-fields">
                                    <label class="form-label fw-bold">Tiền khách đưa:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="tienKhachDua" placeholder="VND" inputmode="numeric">
                                    </div>
                                    <small class="text-muted">Vui lòng nhập đủ tiền khách đưa!</small>
                                </div>
                                <div class="d-flex justify-content-between mb-3 tien-mat-fields">
                                    <span class="fw-bold">Tiền thừa:</span>
                                    <span class="fw-bold" id="tienThua">0 VNĐ</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Chọn phương thức thanh toán:</label>
                                <div class="border rounded p-3 mb-2" style="border-color: #ffc107 !important; background-color: #fff9e6;">
                                    <div class="d-flex align-items-center">
                                        <input class="form-check-input me-3" type="radio" name="paymentMethod" id="tienMat" checked>
                                        <div class="bg-warning rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bx bx-money text-white"></i>
                                        </div>
                                        <label class="form-check-label fw-bold" for="tienMat">Tiền mặt</label>
                                    </div>
                                </div>
                                <div class="border rounded p-3 mb-2">
                                    <div class="d-flex align-items-center">
                                        <input class="form-check-input me-3" type="radio" name="paymentMethod" id="chuyenKhoan">
                                        <div class="bg-primary rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bx bx-credit-card text-white"></i>
                                        </div>
                                        <label class="form-check-label fw-bold" for="chuyenKhoan">Chuyển khoản</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <textarea class="form-control" id="ghiChu" rows="3" placeholder="Nhập ghi chú..."></textarea>
                            </div>
                            <button class="btn btn-warning w-100 fw-bold py-2">Thanh toán</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalThemSanPham" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm sản phẩm vào hóa đơn</h5>
                    <button class="close-btn" data-bs-dismiss="modal" aria-label="Close">×</button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="searchSanPham" placeholder="Tìm kiếm sản phẩm..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" id="filterKichThuoc">
                                    <option value="">Tất cả kích cỡ</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" id="filterMauSac">
                                    <option value="">Tất cả màu sắc</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive product-table-scroll" style="overflow-y: auto;">
                        <table class="table table-hover custom-table-no-vertical">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Giá bán</th>
                                    <th>Số lượng tồn</th>
                                    <th>Kích thước</th>
                                    <th>Màu sắc</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="danhSachSanPham"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="text-muted">
                            Hiển thị <span id="currentPageInfo">0-0</span> của <span id="totalRecords">0</span> sản phẩm
                        </div>
                        <nav aria-label="Phân trang sản phẩm">
                            <ul class="pagination pagination-sm mb-0" id="paginationSanPham"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalChonVoucher" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title">Chọn phiếu giảm giá</h3>
                    <button class="close-btn" data-bs-dismiss="modal" aria-label="Close">×</button>
                </div>

                <div class="modal-body">
                    <div class="search-container">
                        <input type="text" class="search-input" placeholder="Tìm kiếm phiếu giảm giá theo mã, tên" id="searchInput">
                    </div>

                    <div class="section-title">Phiếu giảm giá dành riêng cho bạn</div>

                    <div id="private-voucher-list"></div>

                    <div class="voucher-section">
                        <div class="voucher-section-title">Các phiếu giảm giá khác</div>
                        <div id="public-voucher-list"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalDanhSachDiaChi" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Chọn địa chỉ giao hàng</h5>
                    <button type="button" class="btn btn-primary btn-sm ms-2" id="btnTaoDiaChiMoi">
                        <i class="bx bx-plus"></i> Thêm địa chỉ mới
                    </button>
                    <button type="button" class="close-btn" data-bs-dismiss="modal" aria-label="Close">×</button>
                </div>
                <div class="modal-body">
                    <div id="danhSachDiaChiContent">
                        <!-- Danh sách địa chỉ sẽ được load ở đây -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Quét QR -->
<div class="modal fade" id="qrScanModal" tabindex="-1" aria-labelledby="qrScanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="qrScanModalLabel">Quét mã QR sản phẩm</h5>
                <button type="button" class="close-btn" data-bs-dismiss="modal" aria-label="Close">×</button>
            </div>
            <div class="modal-body text-center">
                <div id="qr-video-container" style="position:relative;">
                    <video id="qr-video" width="100%" height="240" autoplay></video>
                    <canvas id="qr-canvas" style="display:none;"></canvas>
                </div>
                <div id="qr-result" class="mt-2 text-success fw-bold"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
            let danhSachHoaDon = [];
            let hoaDonHienTai = null;
            const MAX_HOA_DON = 5;
            let currentPage = 1;
            let pageSize = 5;
            let totalRecords = 0;
            let pageCount = 0;
            let currentKeyword = "";

            // Biến phân trang cho hóa đơn chờ
            let currentInvoicePage = 1;
            let itemsPerInvoicePage = 5; // Số sản phẩm hiển thị trên mỗi trang
            let totalInvoicePages = 1;
            let video = document.getElementById('qr-video');
            let canvas = document.getElementById('qr-canvas');
            let ctx = canvas ? canvas.getContext('2d') : null;
            let scanning = false;
            let stream = null;
            let scanInterval = null;
            let lastResult = null;
            let modal = null;

            $(document).ready(function () {
                // Initialize events
                $("#btnTaoHoaDon").click(taoHoaDonMoi);
                $("#btnThemSanPham").click(function () {
                    if (!hoaDonHienTai) {
                        toastr.warning("Vui lòng tạo hóa đơn trước khi thêm sản phẩm");
                        return;
                    }
                    currentPage = 1;
                    loadDanhSachSanPham();
                    loadFilterOptions();
                    $("#modalThemSanPham").modal("show");
                });

                // Tạo hàm chung để tìm kiếm sản phẩm
                function performSanPhamSearch() {
                    currentKeyword = $("#searchSanPham").val().trim();
                    currentPage = 1;
                    loadDanhSachSanPham();
                }

                // Auto search with debounce
                let searchSanPhamTimeout;
                $("#searchSanPham").on("input", function () {
                    clearTimeout(searchSanPhamTimeout);
                    searchSanPhamTimeout = setTimeout(performSanPhamSearch, 500);
                });



                // Tìm kiếm khi nhấn Enter
                $("#searchSanPham").keypress(function (e) {
                    if (e.which === 13) {
                        clearTimeout(searchSanPhamTimeout);
                        performSanPhamSearch();
                    }
                });

                $("#modalThemSanPham").on("hidden.bs.modal", function () {
                    currentPage = 1;
                    currentKeyword = "";
                    $("#searchSanPham").val("");
                });

                $("#filterMauSac, #filterKichThuoc").on("change", function() {
                debugger
                currentPage = 1; // reset về trang đầu khi lọc
                loadDanhSachSanPham();
                });

                // Payment method toggle
                $('input[name="paymentMethod"]').change(function () {
                    if ($('#chuyenKhoan').is(':checked')) {
                        $('.tien-mat-fields').hide();
                    } else {
                        $('.tien-mat-fields').show();
                    }
                });
                // Initialize visibility on page load
                if ($('#chuyenKhoan').is(':checked')) {
                    $('.tien-mat-fields').hide();
                } else {
                    $('.tien-mat-fields').show();
                }

                // Ẩn/hiện địa chỉ giao hàng theo trạng thái checkbox
                function toggleGiaoHangDiaChi() {
                    if ($('#toggleGiaoHang').is(':checked')) {
                        $('#giaoHangDiaChiSection').show();
                        $('#phiVanChuyenRow').removeClass('d-none');
                        $('#btnChonDiaChi').removeClass('d-none');
                        if (hoaDonHienTai && hoaDonHienTai.khachHang && hoaDonHienTai.khachHang.id) {
                            $.ajax({
                                url: '/BanHang/GetDiaChiByUser',
                                type: 'GET',
                                data: { userId: hoaDonHienTai.khachHang.id },
                                success: function(response) {
                                    if (response && response.isSuccessed && response.resultObj && response.resultObj.length > 0) {
                                        // Tìm địa chỉ mặc định
                                        var diaChiMacDinh = response.resultObj.find(dc => dc.isDefault === true || dc.macDinh === true);
                                        if (diaChiMacDinh) {
                                            // Fill thông tin vào form
                                            $('#hoVaTen').val(diaChiMacDinh.tenNguoiNhan || '');
                                            $('#soDienThoai').val(diaChiMacDinh.soDienThoai || '');
                                            $('#diaChiCuThe').val(diaChiMacDinh.tenDiaChi || '');
                                            $('#provinceName').val(diaChiMacDinh.tenThanhPho || '');
                                            $('#provinceCode').val(diaChiMacDinh.maTinh || '');
                                            $('#districtName').val(diaChiMacDinh.tenHuyen || '');
                                            $('#districtCode').val(diaChiMacDinh.maHuyen || '');
                                            $('#wardName').val(diaChiMacDinh.tenXa || '');
                                            $('#wardCode').val(diaChiMacDinh.maXa || '');
                                            // Tính phí vận chuyển nếu có đủ thông tin
                                            if ($('#toggleGiaoHang').is(':checked') && $('#districtCode').val() && $('#wardCode').val()) {
                                                tinhPhiVanChuyen();
                                            }
                                        }
                                    }
                                }
                            });
                        }
                    } else {
                        $('#giaoHangDiaChiSection').hide();
                        $('#phiVanChuyenRow').addClass('d-none');
                        $('#btnChonDiaChi').addClass('d-none');
                        if (hoaDonHienTai) {
                            hoaDonHienTai.phiVanChuyen = 0; // Reset phí ship
                            capNhatHoaDonHienTai();         // Cập nhật lại tổng tiền
                        }
                    }
                }
                // Khi bật/tắt giao hàng
                $('#toggleGiaoHang').change(function() {
                if (hoaDonHienTai) {
                    hoaDonHienTai.isGiaoHang = $(this).is(':checked');
                    // Gọi API cập nhật trường GiaoHang cho hóa đơn chờ
                    $.ajax({
                        url: '/HoaDon/UpdateHoaDonCho',
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                        Id: hoaDonHienTai.id,
                        HoTen: hoaDonHienTai.khachHang.hoTen || "",
                        SoDienThoai: hoaDonHienTai.khachHang.soDienThoai || "",
                        Email: hoaDonHienTai.khachHang.email || "",
                        UserId: hoaDonHienTai.khachHang.id || null,
                        TongTien: Math.max(hoaDonHienTai.tongTien - (hoaDonHienTai.giamGia || 0), 0),
                        TrangThai: hoaDonHienTai.trangThai || 0,
                        DiaChi: hoaDonHienTai.diaChi || "",
                        GhiChu: hoaDonHienTai.ghiChu || "",
                        PhuongThucThanhToan: hoaDonHienTai.phuongThucThanhToan || 1,
                        LoaiHoaDon: hoaDonHienTai.loaiHoaDon || 2,
                        NgayThanhToan: hoaDonHienTai.ngayThanhToan || null,
                        MaHoaDon: hoaDonHienTai.tenHoaDon || "",
                        PhiVanChuyen: hoaDonHienTai.phiVanChuyen || 0,
                        TrangThaiThanhToan: hoaDonHienTai.trangThaiThanhToan || 1,
                        VoucherId: hoaDonHienTai.voucherId || null,
                        GiaoHang: hoaDonHienTai.isGiaoHang || false,
                        TienKhachDua: parseInt($("#tienKhachDua").val().replace(/[^0-9]/g, "")) || 0
                    }),
                        success: function(res) {
                            if (res && res.success) {
                                // toastr.success("Cập nhật trạng thái giao hàng thành công!");
                            } else {
                                toastr.error(res.message || "Cập nhật trạng thái giao hàng thất bại!");
                            }
                        },
                        error: function(xhr) {
                            toastr.error("Lỗi khi cập nhật trạng thái giao hàng: " + (xhr.responseJSON?.message || xhr.statusText));
                        }
                    });
                }
                toggleGiaoHangDiaChi();
            });
                // Khi nhập địa chỉ giao hàng
                $('#hoVaTen, #soDienThoai, #province, #district, #ward, #diaChiCuThe').on('change input', function() {
                    if (hoaDonHienTai) {
                        hoaDonHienTai.diaChiGiaoHang = {
                            hoVaTen: $('#hoVaTen').val() || '',
                            soDienThoai: $('#soDienThoai').val() || '',
                            provinceCode: $('#provinceCode').val() || '',
                            provinceName: $('#provinceName').val() || '',
                            districtCode: $('#districtCode').val() || '',
                            districtName: $('#districtName').val() || '',
                            wardCode: $('#wardCode').val() || '',
                            wardName: $('#wardName').val() || '',
                            diaChiCuThe: $('#diaChiCuThe').val() || ''
                        };

                        // Tính phí vận chuyển khi thay đổi địa chỉ và đang bật giao hàng
                        if (hoaDonHienTai.isGiaoHang && $('#districtCode').val() && $('#wardCode').val()) {
                            tinhPhiVanChuyen();
                        }
                    }
                });
                toggleGiaoHangDiaChi(); // Khởi tạo trạng thái ban đầu

                loadHoaDonCho();
            });

            function taoHoaDonMoi() {
                if (danhSachHoaDon.length >= MAX_HOA_DON) {
                    toastr.warning(`Bạn chỉ có thể tạo tối đa ${MAX_HOA_DON} hóa đơn chờ`);
                    return;
                }
                resetKhachHang();
                const khachHangId = $("#khachHangId").val();
                const hoTen = $("#customerName").text() || "Khách hàng lẻ";
                const soDienThoai = $("#customerPhone").text() !== "-" ? $("#customerPhone").text() : null;
                const email = $("#customerEmail").text() !== "-" ? $("#customerEmail").text() : null;
                const diaChi = $("#diaChiCuThe").val() || null;

                const hoaDonRequest = {
                    tongTien: 0,
                    trangThai: 0, // ChoXacNhan
                    userId: khachHangId || null,
                    diaChi: diaChi,
                    soDienThoai: soDienThoai,
                    email: email,
                    hoTen: hoTen,
                    ghiChu: null,
                    phuongThucThanhToan: 1, // Tiền mặt
                    loaiHoaDon: 2, // TaiQuay
                    ngayThanhToan: null,
                    phiVanChuyen: 0,
                    trangThaiThanhToan: 1, // ChuaThanhToan
                    voucherId: null
                };

                const $btn = $("#btnTaoHoaDon");
                $btn.prop("disabled", true).html('<i class="bx bx-loader-alt bx-spin"></i> Đang tạo...');

                $.ajax({
                    url: '/HoaDon/CreateHoaDonCho',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(hoaDonRequest),
                    success: function (result) {
                        $btn.prop("disabled", false).html('<i class="bx bx-plus me-1"></i> Tạo hóa đơn');

                        if (result && result.id && result.maHoaDon) {
                            const hoaDonMoi = {
                                id: result.id,
                                tenHoaDon: result.maHoaDon, // Hiển thị MaHoaDon
                                sanPham: [],
                                tongTien: result.tongTien,
                                khachHang: {
                                    id: khachHangId || null,
                                    hoTen: hoTen || '',
                                    soDienThoai: soDienThoai || '',
                                    email: email || ''
                                },
                                ghiChu: null
                            };

                            danhSachHoaDon.push(hoaDonMoi);
                            hoaDonHienTai = hoaDonMoi;
                            capNhatTabHoaDon();
                            capNhatHoaDonHienTai();

                            // RESET thông tin khách hàng trên giao diện
                            resetKhachHang();
                            toastr.success("Tạo hóa đơn chờ thành công!");

                            // Reset tiền khách đưa và tiền thừa khi tạo hóa đơn mới
                            $("#tienKhachDua").val("");
                            $("#tienThua").text("0 VNĐ");
                            $("#tienKhachDua").removeClass("is-invalid");
                            $("#tienKhachDua").closest('.mb-3').find('small.text-muted').text("Vui lòng nhập đủ tiền khách đưa!");

                            // Reset ghi chú khi tạo hóa đơn mới
                            $("#ghiChu").val("");
                        } else {
                            toastr.error("Tạo hóa đơn thất bại!");
                        }
                    },
                    error: function (xhr) {
                        $btn.prop("disabled", false).html('<i class="bx bx-plus me-1"></i> Tạo hóa đơn');
                        toastr.error("Lỗi khi tạo hóa đơn: " + (xhr.responseJSON?.message || xhr.statusText));
                    }
                });
            }

            function capNhatTabHoaDon() {
                const tabContainer = $("#hoaDonTabs").empty();
                danhSachHoaDon.forEach((hoaDon, index) => {
                    const isActive = hoaDon.id === hoaDonHienTai.id;
                    const tabItem = `
                        <li class="nav-item">
                            <a class="nav-link ${isActive ? 'active' : ''}"  data-hoadon-id="${hoaDon.id}">
                                ${hoaDon.tenHoaDon}
                                <button class="btn-close btn-close-white ms-2 btn-xoa-hoadon" data-hoadon-id="${hoaDon.id}" style="font-size: 0.5rem;"></button>
                            </a>
                        </li>
                    `;
                    tabContainer.append(tabItem);
                });

                $(".nav-link").click(function (e) {
                    if (!$(e.target).hasClass('btn-xoa-hoadon')) {
                        const hoaDonId = $(this).data("hoadon-id");
                        chuyenHoaDon(hoaDonId);
                    }
                });

                $(".btn-xoa-hoadon").click(function (e) {
                    e.stopPropagation();
                    const hoaDonId = $(this).data("hoadon-id");
                    xoaHoaDon(hoaDonId);
                });
            }

            // Switch between invoices
            function chuyenHoaDon(hoaDonId) {
                const hoaDon = danhSachHoaDon.find(hd => hd.id === hoaDonId);
                if (hoaDon) {
                    hoaDonHienTai = hoaDon;
                    // Lưu id vào localStorage
                    localStorage.setItem('hoaDonHienTaiId', hoaDonId);
                    capNhatTabHoaDon();
                    capNhatHoaDonHienTai();
                }
            }

            function loadHoaDonCho() {
                $.ajax({
                    url: '/HoaDon/GetHoaDonCho',
                    type: 'GET',
                    success: function (result) {
                        if (result && result.length > 0) {
                            // Lấy chi tiết sản phẩm cho từng hóa đơn
                            let promises = result.map(hd =>
                                $.ajax({
                                    url: '/HoaDonChiTiet/GetByHoaDonId',
                                    type: 'GET',
                                    data: { id: hd.id }

                                }).then(spList => ({
                                    id: hd.id,
                                    tenHoaDon: hd.maHoaDon,
                                    sanPham: spList,
                                    tongTien: hd.tongTien,
                                    khachHang: {
                                        id: hd.userId,
                                        hoTen: hd.hoTen || '',
                                        soDienThoai: hd.soDienThoai || '',
                                        email: hd.email || ''
                                    },
                                    isGiaoHang: hd.giaoHang,
                                    diaChiGiaoHang: {
                                        hoVaTen: hd.tenNguoiNhan || '',
                                        soDienThoai: hd.soDienThoai || '',
                                        province: hd.maTinh || '',
                                        provinceName: hd.tenTinh || '',
                                        district: hd.maHuyen || '',
                                        districtName: hd.tenHuyen || '',
                                        ward: hd.maXa || '',
                                        wardName: hd.tenXa || '',
                                        diaChiCuThe: hd.tenDiaChi || ''
                                    },
                                    voucherId: hd.voucherId || null,
                                    phiVanChuyen: hd.phiVanChuyen || 0
                                }))
                            );

                            Promise.all(promises).then(list => {
                                danhSachHoaDon = list; // Không map lại nữa!
                                let hoaDonIdDaLuu = localStorage.getItem('hoaDonHienTaiId');
                                if (hoaDonIdDaLuu) {
                                    hoaDonHienTai = danhSachHoaDon.find(hd => hd.id === hoaDonIdDaLuu) || danhSachHoaDon[0];
                                } else {
                                    hoaDonHienTai = danhSachHoaDon[0];
                                }
                                capNhatTabHoaDon();
                                capNhatHoaDonHienTai();
                                toastr.success("Đã tải " + danhSachHoaDon.length + " hóa đơn chờ");
                            });
                        } else {
                            taoHoaDonMoi();
                        }
                    },
                    error: function (xhr) {
                        console.error("Lỗi khi tải hóa đơn chờ:", xhr);
                        taoHoaDonMoi();
                    }
                });
            }

            // Delete invoice
            function xoaHoaDon(hoaDonId) {
                if (danhSachHoaDon.length <= 1) {
                    toastr.warning("Phải có ít nhất một hóa đơn");
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận xóa',
                    text: "Bạn có chắc chắn muốn xóa hóa đơn này?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Gọi API xóa hóa đơn trên server
                        $.ajax({
                            url: '/HoaDon/DeleteHoaDonCho?id=' + hoaDonId,
                            type: 'DELETE',
                            success: function (res) {
                                if (res && res.success) {
                                    danhSachHoaDon = danhSachHoaDon.filter(hd => hd.id !== hoaDonId);
                                    if (hoaDonHienTai.id === hoaDonId) {
                                        hoaDonHienTai = danhSachHoaDon[0];
                                    }
                                    capNhatTabHoaDon();
                                    capNhatHoaDonHienTai();
                                    toastr.success("Xóa hóa đơn thành công");
                                } else {
                                    toastr.error(res.message || "Xóa hóa đơn thất bại!");
                                }
                            },
                            error: function (xhr) {
                                toastr.error("Lỗi khi xóa hóa đơn: " + (xhr.responseJSON?.message || xhr.statusText));
                            }
                        });
                    }
                });
            }

            function capNhatHoaDonHienTai() {
                if (!hoaDonHienTai) return;

                $("#customerName").text(hoaDonHienTai.khachHang.hoTen || "Khách hàng lẻ");
                $("#customerPhone").text(hoaDonHienTai.khachHang.soDienThoai || "-");
                $("#customerEmail").text(hoaDonHienTai.khachHang.email || "-");
                // $("#khachHangId").val(hoaDonHienTai.khachHang.id || "");

                // Tính toán phân trang
                const totalItems = hoaDonHienTai.sanPham.length;
                totalInvoicePages = Math.ceil(totalItems / itemsPerInvoicePage);

                // Đảm bảo currentInvoicePage không vượt quá tổng số trang
                if (currentInvoicePage > totalInvoicePages) {
                    currentInvoicePage = totalInvoicePages || 1;
                }

                // Lấy sản phẩm cho trang hiện tại
                const startIndex = (currentInvoicePage - 1) * itemsPerInvoicePage;
                const endIndex = Math.min(startIndex + itemsPerInvoicePage, totalItems);
                const sanPhamTrangHienTai = hoaDonHienTai.sanPham.slice(startIndex, endIndex);

                const tableBody = $("#hoaDonChiTietTable").empty();
                if (hoaDonHienTai.sanPham.length === 0) {
                    tableBody.append('<tr class="no-data"><td colspan="7" class="text-center">Không có sản phẩm nào trong giỏ</td></tr>');
                    $("#paginationContainer").addClass("d-none");
                } else {
                    sanPhamTrangHienTai.forEach((sp, index) => {
                        const actualIndex = startIndex + index; // Index thực tế trong danh sách gốc
                        let anhSanPham = 'https://localhost:7277/images/Default_Logo.png';
                        if (sp.images && sp.images.length > 0) {
                            anhSanPham = sp.images[0].startsWith('http') ? sp.images[0] : `https://localhost:7277${sp.images[0]}`;
                        }
                        const row = `
                            <tr>
                                <td>${actualIndex + 1}</td>
                                <td style="width:70px; position:relative;">
                                    <div style="position:relative; display:inline-block;">
                                        <img src="${anhSanPham}" alt="${sp.tenSanPham}" width="80" height="80" style="object-fit:cover; border-radius:8px; border:1px solid #eee;">
                                    </div>
                                </td>
                                <td>
                                    <div>
                                         <div class="fw-bold">${sp.tenSanPham} [${sp.kichThuoc} - ${sp.mauSac}]</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <button class="btn btn-outline-secondary btn-giam-sl" data-index="${actualIndex}" data-hoa-don-chi-tiet-id="${sp.id}">-</button>
                                        <input type="number" class="form-control text-center input-so-luong" value="${sp.soLuong}" min="1" max="${sp.soLuongTon || 999}" data-index="${actualIndex}" data-hoa-don-chi-tiet-id="${sp.id}">
                                        <button class="btn btn-outline-secondary btn-tang-sl" data-index="${actualIndex}" data-hoa-don-chi-tiet-id="${sp.id}">+</button>
                                    </div>
                                    <small class="text-muted">Tồn: ${sp.soLuongTon || 0}</small>
                                </td>
                                <td style="text-align: center;">${formatCurrency(sp.giaBan)}</td>
                                <td style="text-align: center;">${formatCurrency(sp.giaBan * sp.soLuong)}</td>
                                <td style="text-align: center;">
                                    <button class="btn btn-sm btn-danger btn-xoa-sp" data-index="${actualIndex}" data-hoa-don-chi-tiet-id="${sp.id}">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                        tableBody.append(row);
                    });

                    $(".btn-giam-sl").click(function () {
                        const index = $(this).data("index");
                        const id = $(this).data("hoa-don-chi-tiet-id");
                        giamSoLuong(index, id);
                    });

                    $(".btn-tang-sl").click(function () {
                        const index = $(this).data("index");
                        const id = $(this).data("hoa-don-chi-tiet-id");
                        tangSoLuong(index, id);
                    });

                    $(".input-so-luong").change(function () {
                        const index = $(this).data("index");
                        const id = $(this).data("hoa-don-chi-tiet-id");
                        const soLuong = parseInt($(this).val());
                        capNhatSoLuong(index, soLuong, id);
                    });

                    $(".btn-xoa-sp").click(function () {
                        const index = $(this).data("index");
                        const hoaDonChiTietId = $(this).data("hoa-don-chi-tiet-id");
                        xoaSanPham(index, hoaDonChiTietId);
                    });
                }

                // Cập nhật thông tin phân trang
                if (totalItems > 0) {
                    $("#startItem").text(startIndex + 1);
                    $("#endItem").text(endIndex);
                    $("#totalItems").text(totalItems);
                    $("#paginationContainer").removeClass("d-none");

                    // Cập nhật trạng thái nút phân trang
                    $("#prevPage").toggleClass("disabled", currentInvoicePage <= 1);
                    $("#nextPage").toggleClass("disabled", currentInvoicePage >= totalInvoicePages);
                } else {
                    $("#paginationContainer").addClass("d-none");
                }

                let tongTien = 0;
                if (hoaDonHienTai.sanPham && hoaDonHienTai.sanPham.length > 0) {
                    hoaDonHienTai.sanPham.forEach(sp => {
                        tongTien += sp.giaBan * sp.soLuong;
                    });
                }
                hoaDonHienTai.tongTien = tongTien;
                $("#tongTien").text(formatCurrency(tongTien));
                $(".tam-tinh-value").text(formatCurrency(tongTien));

                if (hoaDonHienTai.khachHang.id) {
                    // Có khách hàng thực sự
                    $("#selectedCustomerName").text(hoaDonHienTai.khachHang.hoTen);
                    $("#selectedCustomerTag").removeClass("d-none");
                    $("#customerPhoneRow, #customerEmailRow").show();
                    $("#giaoHangToggleRow").removeClass("d-none");
                } else {
                    // Khách hàng lẻ
                    $("#selectedCustomerName").text("");
                    $("#selectedCustomerTag").addClass("d-none");
                    $("#customerPhoneRow, #customerEmailRow").hide();
                    $("#giaoHangToggleRow").addClass("d-none");
                    $("#giaoHangDiaChiSection").hide();
                    $("#toggleGiaoHang").prop("checked", false);
                    $("#phiVanChuyenRow").addClass("d-none");
                }

                // Lấy phí vận chuyển và giảm giá (nếu có)
                let phiVanChuyen = hoaDonHienTai.phiVanChuyen || 0;
                let giamGia = hoaDonHienTai.giamGia || 0;

                // Cập nhật hiển thị giảm giá và thông báo voucher
                $('#giamGiaValue').text(formatCurrency(giamGia));

                // Hiển thị thông báo voucher nếu có voucher được áp dụng
                if (giamGia > 0 && hoaDonHienTai.maVoucherDaChon) {
                    // Tìm voucher trong danh sách để lấy thông tin chi tiết
                    let voucherInfo = null;
                    $('.voucher-item').each(function() {
                        if ($(this).data('voucher') === hoaDonHienTai.maVoucherDaChon) {
                            voucherInfo = {
                                name: $(this).find('.voucher-code').text(),
                                loaiGiamGia: parseInt($(this).data('loaigiamgia')),
                                giaTriGiamGia: parseInt($(this).data('giatri')),
                                dieuKienApDung: parseInt($(this).data('dieukienapdung'))
                            };
                            return false; // break loop
                        }
                    });

                    if (voucherInfo) {
                        let discountText = voucherInfo.loaiGiamGia === 0 ? voucherInfo.giaTriGiamGia + '%' : formatCurrency(voucherInfo.giaTriGiamGia);
                        let minOrderText = formatCurrency(voucherInfo.dieuKienApDung);

                        $('#voucherName').text(voucherInfo.name);
                        $('#voucherDiscountValue').text(discountText);
                        $('#voucherMinOrder').text(minOrderText);
                        $('#voucherAppliedNotification').removeClass('d-none');
                    }
                } else {
                    $('#voucherAppliedNotification').addClass('d-none');
                }

                // Tổng tiền thanh toán cuối cùng
                let tongTienThanhToan = tongTien + phiVanChuyen - giamGia;
                if (tongTienThanhToan < 0) tongTienThanhToan = 0;

                $("#tongTienThanhToan").text(formatCurrency(tongTienThanhToan));

                capNhatTienThua();

                // Set lại trạng thái checkbox giao hàng trước
                $('#toggleGiaoHang').prop('checked', hoaDonHienTai.isGiaoHang || false);

                // Nếu isGiaoHang == true thì show địa chỉ giao hàng
                if (hoaDonHienTai.isGiaoHang) {
                    $('#giaoHangDiaChiSection').show();
                    $('#phiVanChuyenRow').removeClass('d-none');
                    $('#btnChonDiaChi').removeClass('d-none');
                    // Reset tất cả các trường địa chỉ trước khi load dữ liệu mới
                    $('#hoVaTen').val('');
                    $('#soDienThoai').val('');
                    resetDiaChiDropdowns();
                    $('#diaChiCuThe').val('');
                    // Nếu là hóa đơn chờ (chưa có địa chỉ cụ thể) và có khách hàng, lấy địa chỉ mặc định từ bảng địa chỉ khách hàng
                    if (!hoaDonHienTai.diaChiGiaoHang || !hoaDonHienTai.diaChiGiaoHang.districtCode || hoaDonHienTai.diaChiGiaoHang.districtCode === '') {
                        if (hoaDonHienTai.khachHang && hoaDonHienTai.khachHang.id) {
                                $.ajax({
                                    url: '/BanHang/GetDiaChiByUser',
                                    type: 'GET',
                                    data: { userId: hoaDonHienTai.khachHang.id },
                                    success: function(response) {
                                        if (response && response.isSuccessed && response.resultObj && response.resultObj.length > 0) {
                                            var diaChiMacDinh = response.resultObj.find(dc => dc.isDefault === true || dc.macDinh === true) || response.resultObj[0];
                                            if (diaChiMacDinh) {
                                                $('#hoVaTen').val(diaChiMacDinh.tenNguoiNhan || '');
                                                $('#soDienThoai').val(diaChiMacDinh.soDienThoai || '');

                                                $('#provinceName').val(diaChiMacDinh.tenThanhPho || '');
                                                $('#provinceCode').val(diaChiMacDinh.maTinh || '');
                                                $('#districtName').val(diaChiMacDinh.tenHuyen || '');
                                                $('#districtCode').val(diaChiMacDinh.maHuyen || '');
                                                $('#wardName').val(diaChiMacDinh.tenXa || '');
                                                $('#wardCode').val(diaChiMacDinh.maXa || '');
                                                $('#diaChiCuThe').val(diaChiMacDinh.tenDiaChi || '');
                                                 // Tính phí vận chuyển nếu có đủ thông tin
                                                if ($('#toggleGiaoHang').is(':checked') && $('#districtCode').val() && $('#wardCode').val()) {
                                                    tinhPhiVanChuyen();
                                                }
                                            }
                                        }
                                    }
                                });
                        }
                    } else {
                        // Nếu hóa đơn đã có địa chỉ cụ thể (ví dụ hóa đơn đã xác nhận), fill như cũ
                        if (hoaDonHienTai.diaChiGiaoHang) {
                                $('#hoVaTen').val(hoaDonHienTai.diaChiGiaoHang.hoVaTen || '');
                                $('#soDienThoai').val(hoaDonHienTai.diaChiGiaoHang.soDienThoai || '');


                                $('#provinceName').val(hoaDonHienTai.diaChiGiaoHang.provinceName || '');
                                $('#provinceCode').val(hoaDonHienTai.diaChiGiaoHang.provinceCode || '');
                                $('#districtName').val(hoaDonHienTai.diaChiGiaoHang.districtName || '');
                                $('#districtCode').val(hoaDonHienTai.diaChiGiaoHang.districtCode || '');
                                $('#wardName').val(hoaDonHienTai.diaChiGiaoHang.wardName || '');
                                $('#wardCode').val(hoaDonHienTai.diaChiGiaoHang.wardCode || '');
                                $('#diaChiCuThe').val(hoaDonHienTai.diaChiGiaoHang.diaChiCuThe || '');
                                // Tính phí vận chuyển nếu có đủ thông tin
                                if ($('#toggleGiaoHang').is(':checked') && $('#districtCode').val() && $('#wardCode').val()) {
                                    tinhPhiVanChuyen();
                                }
                        }
                    }
                } else {
                    $('#giaoHangDiaChiSection').hide();
                    $('#phiVanChuyenRow').addClass('d-none');
                    // Reset các trường địa chỉ khi không giao hàng
                    $('#hoVaTen').val('');
                    $('#soDienThoai').val('');
                    resetDiaChiDropdowns();
                    $('#diaChiCuThe').val('');
                }

                // Set lại giá trị tiền khách đưa cho đúng hóa đơn hiện tại
                let tienKhachDua = hoaDonHienTai.TienKhachDua || "";
                if (tienKhachDua) {
                    $("#tienKhachDua").val(Number(tienKhachDua).toLocaleString('vi-VN'));
                } else {
                    $("#tienKhachDua").val("");
                }
                capNhatTienThua(); // Để cập nhật lại tiền thừa

                // Set lại giá trị ghi chú cho đúng hóa đơn hiện tại
                let ghiChu = hoaDonHienTai.ghiChu || "";
                $("#ghiChu").val(ghiChu);
            }

            // Increase product quantity
            function tangSoLuong(index, hoaDonChiTietId) {
                let sp = hoaDonHienTai.sanPham[index];
                let newQuantity = sp.soLuong + 1;
                $.ajax({
                    url: '/HoaDonChiTiet/UpdateQuantity',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ hoaDonChiTietId: hoaDonChiTietId, newQuantity: newQuantity }),
                    success: function (res) {
                        if (res && res.success) {
                            loadChiTietHoaDonHienTai();
                            toastr.success("Cập nhật số lượng thành công");
                        } else {
                            toastr.error(res.message || "Cập nhật số lượng thất bại");
                        }
                    },
                    error: function (xhr) {
                        toastr.error("Lỗi khi cập nhật số lượng: " + (xhr.responseJSON?.message || xhr.statusText));
                    }
                });
            }

            // Decrease product quantity
            function giamSoLuong(index, hoaDonChiTietId) {
                let sp = hoaDonHienTai.sanPham[index];
                if (sp.soLuong <= 1) return;
                let newQuantity = sp.soLuong - 1;
                $.ajax({
                    url: '/HoaDonChiTiet/UpdateQuantity',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ hoaDonChiTietId: hoaDonChiTietId, newQuantity: newQuantity }),
                    success: function (res) {
                        if (res && res.success) {
                            loadChiTietHoaDonHienTai();
                            toastr.success("Cập nhật số lượng thành công");
                        } else {
                            toastr.error(res.message || "Cập nhật số lượng thất bại");
                        }
                    },
                    error: function (xhr) {
                        toastr.error("Lỗi khi cập nhật số lượng: " + (xhr.responseJSON?.message || xhr.statusText));
                    }
                });
            }

            // Update product quantity
            function capNhatSoLuong(index, soLuong, hoaDonChiTietId) {
                if (soLuong < 1) soLuong = 1;
                $.ajax({
                    url: '/HoaDonChiTiet/UpdateQuantity',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ hoaDonChiTietId: hoaDonChiTietId, newQuantity: soLuong }),
                    success: function (res) {
                        if (res && res.success) {
                            loadChiTietHoaDonHienTai();
                            toastr.success("Cập nhật số lượng thành công");
                        } else {
                            toastr.error(res.message || "Cập nhật số lượng thất bại");
                        }
                    },
                    error: function (xhr) {
                        toastr.error("Lỗi khi cập nhật số lượng: " + (xhr.responseJSON?.message || xhr.statusText));
                    }
                });
            }

            // Remove product
            function xoaSanPham(index, hoaDonChiTietId) {
                if (!hoaDonHienTai || !hoaDonHienTai.sanPham[index]) {
                    toastr.error("Không tìm thấy sản phẩm để xóa");
                    return;
                }

                const sanPham = hoaDonHienTai.sanPham[index];

                Swal.fire({
                    title: 'Xác nhận xóa',
                    text: `Bạn có chắc chắn muốn xóa sản phẩm "${sanPham.tenSanPham}" khỏi hóa đơn?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Gọi API xóa hóa đơn chi tiết
                        $.ajax({
                            url: '/HoaDonChiTiet/Delete',
                            type: 'DELETE',
                            data: { id: hoaDonChiTietId },
                            success: function (res) {
                                if (res && res.success) {
                                    // Xóa khỏi danh sách local
                                    hoaDonHienTai.sanPham.splice(index, 1);
                                    // Reset về trang 1 khi xóa sản phẩm
                                    currentInvoicePage = 1;
                                    tinhTongTien();
                                    capNhatHoaDonHienTai();
                                    toastr.success("Xóa sản phẩm khỏi hóa đơn thành công");
                                } else {
                                    toastr.error(res.message || "Xóa sản phẩm thất bại");
                                }
                            },
                            error: function (xhr) {
                                toastr.error("Lỗi khi xóa sản phẩm: " + (xhr.responseJSON?.message || xhr.statusText));
                            }
                        });
                    }
                });
            }

            // Calculate total amount
            function tinhTongTien() {
                hoaDonHienTai.tongTien = hoaDonHienTai.sanPham.reduce((total, sp) => total + (sp.giaBan * sp.soLuong), 0);

                // Cập nhật tổng tiền vào database nếu có hóa đơn hiện tại
                if (hoaDonHienTai && hoaDonHienTai.id) {
                    $.ajax({
                        url: '/HoaDon/UpdateHoaDonCho',
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            Id: hoaDonHienTai.id,
                            HoTen: hoaDonHienTai.khachHang.hoTen || "",
                            SoDienThoai: hoaDonHienTai.khachHang.soDienThoai || "",
                            Email: hoaDonHienTai.khachHang.email || "",
                            UserId: hoaDonHienTai.khachHang.id || null,
                            TongTien: Math.max(hoaDonHienTai.tongTien - (hoaDonHienTai.giamGia || 0), 0),
                            TrangThai: hoaDonHienTai.trangThai || 0,
                            DiaChi: hoaDonHienTai.diaChi || "",
                            GhiChu: hoaDonHienTai.ghiChu || "",
                            PhuongThucThanhToan: hoaDonHienTai.phuongThucThanhToan || 1,
                            LoaiHoaDon: hoaDonHienTai.loaiHoaDon || 2,
                            NgayThanhToan: hoaDonHienTai.ngayThanhToan || null,
                            MaHoaDon: hoaDonHienTai.tenHoaDon || "",
                            PhiVanChuyen: hoaDonHienTai.phiVanChuyen || 0,
                            TrangThaiThanhToan: hoaDonHienTai.trangThaiThanhToan || 1,
                            VoucherId: hoaDonHienTai.voucherId || null,
                            GiaoHang: hoaDonHienTai.isGiaoHang || false,
                            TienKhachDua: parseInt($("#tienKhachDua").val().replace(/[^0-9]/g, "")) || 0
                        }),
                        success: function(res) {
                            if (!res || !res.success) {
                                console.warn("Không thể cập nhật tổng tiền hóa đơn:", res?.message);
                            }
                        },
                        error: function(xhr) {
                            console.error("Lỗi khi cập nhật tổng tiền hóa đơn:", xhr.responseJSON?.message || xhr.statusText);
                        }
                    });
                }
            }
                    function loadFilterOptions() {
                        // Kích thước
                        $.ajax({
                            url: '/KichThuoc/GetAll',
                            type: 'GET',
                            success: function(response) {
                                const kichThuocSelect = $("#filterKichThuoc");
                                kichThuocSelect.find('option:not(:first)').remove();
                                (response.resultObj || response).forEach(function(kt) {
                                    kichThuocSelect.append(`<option value="${kt.id}">${kt.tenKichThuoc || kt.maKichThuoc}</option>`);
                                });
                            }
                        });

                        // Màu sắc
                        $.ajax({
                            url: '/MauSac/GetAll',
                            type: 'GET',
                            success: function(response) {
                                const mauSacSelect = $("#filterMauSac");
                                mauSacSelect.find('option:not(:first)').remove();
                                (response.resultObj || response).forEach(function(ms) {
                                    mauSacSelect.append(`<option value="${ms.id}">${ms.tenMauSac}</option>`);
                                });
                            }
                        });
                    }
            // Load product list
            function loadDanhSachSanPham() {
                const tableBody = $("#danhSachSanPham").html('<tr><td colspan="9" class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></td></tr>');

                // Thêm delay 2-3 giây trước khi gọi ajax
                setTimeout(function() {
                    $.ajax({
                        url: '/SPCT/GetSPCTForModal',
                        type: 'GET',
                        data: {
                            tuKhoa: currentKeyword,
                            pageIndex: currentPage,
                            pageSize: pageSize,
                            mauSacId: $("#filterMauSac").val() || null,
                            kichThuocId: $("#filterKichThuoc").val() || null
                        },
                        success: function (response) {
                            tableBody.empty();
                            if (!response.items || response.items.length === 0) {
                                tableBody.append('<tr><td colspan="9" class="text-center">Không tìm thấy sản phẩm nào</td></tr>');
                                updatePaginationInfo(0, 0, 0);
                                return;
                            }

                            totalRecords = response.totalRecords;
                            pageCount = response.pageCount;
                            currentPage = response.pageIndex;

                            response.items.forEach((sp, index) => {
                                let anhSanPham = 'https://localhost:7277/images/Default_Logo.png';
                                if (sp.images && sp.images.length > 0) {
                                    anhSanPham = sp.images[0].startsWith('http') ? sp.images[0] : `https://localhost:7277${sp.images[0]}`;
                                }
                                const row = `
                                    <tr>
                                        <td>${(currentPage - 1) * pageSize + index + 1}</td>
                                        <td style="width:70px; position:relative;">
                                            <div style="position:relative; display:inline-block;">
                                                <img src="${anhSanPham}" alt="${sp.tenSanPham}" width="60" height="60" style="object-fit:cover; border-radius:8px; border:1px solid #eee;">
                                            </div>
                                        </td>
                                        <td>${sp.tenSanPham}</td>
                                        <td>
                                            ${
                                                sp.giaKhuyenMai && sp.giaKhuyenMai > 0 && sp.giaKhuyenMai < sp.gia
                                                ? `<span class="gia-khuyen-mai">${formatCurrency(sp.giaKhuyenMai)}</span><br>
                                                <span class="gia-goc">${formatCurrency(sp.gia)}</span>`
                                                : `${formatCurrency(sp.gia)}`
                                            }
                                        </td>
                                        <td>${sp.soLuong}</td>
                                        <td>${sp.tenKichThuoc}</td>
                                        <td>${sp.tenMauSac}</td>
                                        <td>${sp.trangThai ? '<span class="badge bg-success">Còn hàng</span>' : '<span class="badge bg-danger">Hết hàng</span>'}</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary btn-them-vao-hoadon" data-sp-id="${sp.id}" ${sp.trangThai ? '' : 'disabled'}>
                                                Chọn
                                            </button>
                                        </td>
                                    </tr>
                                `;
                                tableBody.append(row);
                            });

                            $(".btn-them-vao-hoadon").click(function () {
                                const spId = $(this).data("sp-id");
                                const sanPham = response.items.find(sp => sp.id === spId);
                                if (sanPham) {
                                    themSanPhamVaoHoaDon(sanPham);
                                }
                            });

                            updatePaginationInfo();
                            createPagination();
                        },
                        error: function (error) {
                            tableBody.html(`<tr><td colspan="9" class="text-center text-danger">Lỗi khi tải dữ liệu: ${error.statusText}</td></tr>`);
                            console.error('Lỗi khi tải danh sách sản phẩm:', error);
                            updatePaginationInfo(0, 0, 0);
                        }
                    });
                }, Math.floor(Math.random() * 100) + 250); // Delay ngẫu nhiên từ 2-3 giây
            }

            // Update pagination info
            function updatePaginationInfo() {
                const startRecord = totalRecords > 0 ? (currentPage - 1) * pageSize + 1 : 0;
                const endRecord = Math.min(currentPage * pageSize, totalRecords);
                $("#currentPageInfo").text(`${startRecord}-${endRecord}`);
                $("#totalRecords").text(totalRecords);
            }

            // Create pagination
            function createPagination() {
                const paginationContainer = $("#paginationSanPham").empty();
                if (pageCount <= 1) return;

                const prevDisabled = currentPage === 1 ? 'disabled' : '';
                paginationContainer.append(`
                    <li class="page-item ${prevDisabled}">
                        <a class="page-link" data-page="${currentPage - 1}"><</a>
                    </li>
                `);

                const startPage = Math.max(1, currentPage - 2);
                const endPage = Math.min(pageCount, currentPage + 2);

                for (let i = startPage; i <= endPage; i++) {
                    const active = i === currentPage ? 'active' : '';
                    paginationContainer.append(`
                        <li class="page-item ${active}">
                            <a class="page-link" data-page="${i}">${i}</a>
                        </li>
                    `);
                }

                const nextDisabled = currentPage === pageCount ? 'disabled' : '';
                paginationContainer.append(`
                    <li class="page-item ${nextDisabled}">
                        <a class="page-link" data-page="${currentPage + 1}">></a>
                    </li>
                `);

                paginationContainer.find(".page-link").click(function (e) {
                    e.preventDefault();
                    const page = $(this).data("page");
                    if (page && page >= 1 && page <= pageCount && page !== currentPage) {
                        currentPage = page;
                        loadDanhSachSanPham(); // ĐÚNG, chỉ gọi hàm này!
                        // KHÔNG gọi $("#modalThemSanPham").modal("show") ở đây!
                    }
                });
            }

            // Add product to invoice
            function themSanPhamVaoHoaDon(sanPham) {
                if (!hoaDonHienTai || !hoaDonHienTai.id) {
                    toastr.error("Vui lòng tạo hóa đơn trước!");
                    return;
                }
                $.ajax({
                    url: '/HoaDonChiTiet/CreateOrUpdate',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        HoaDonId: hoaDonHienTai.id,
                        SanPhamChiTietId: sanPham.id,
                        SoLuong: 1,
                        GiaBan: (sanPham.giaKhuyenMai && sanPham.giaKhuyenMai > 0 && sanPham.giaKhuyenMai < sanPham.gia) ? sanPham.giaKhuyenMai : sanPham.gia
                    }),
                    success: function (res) {
                        // Sau khi thêm/cập nhật thành công, load lại chi tiết hóa đơn hiện tại
                        // Reset về trang 1 khi thêm sản phẩm mới
                        currentInvoicePage = 1;
                        loadChiTietHoaDonHienTai();
                        toastr.success("Thêm sản phẩm thành công vào hóa đơn chờ");
                    },
                    error: function (xhr) {
                        toastr.error("Lỗi khi thêm sản phẩm: " + (xhr.responseJSON?.message || xhr.statusText));
                    }
                });
            }

            function loadChiTietHoaDonHienTai() {
                $.ajax({
                    url: '/HoaDonChiTiet/GetByHoaDonId',
                    type: 'GET',
                    data: { id: hoaDonHienTai.id },
                    success: function (spList) {
                        hoaDonHienTai.sanPham = spList;
                        capNhatHoaDonHienTai();
                    }
                });
            }

            // Format currency
            function formatCurrency(amount) {
                // Định dạng tiền tệ kiểu Việt Nam, thay thế ký hiệu ₫ thành VNĐ
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' })
                    .format(amount)
                    .replace('₫', 'VNĐ');
            }

            // Customer search handling
            let searchTimeout;
            $("#searchKhachHang").on("input", function () {
                const keyword = $(this).val().trim();

                // Clear previous timeout
                clearTimeout(searchTimeout);

                // Validation: chỉ cho phép chữ cái, số, dấu cách và một số ký tự đặc biệt
                const validPattern = /^[a-zA-ZÀ-ỹđĐ0-9\s\-\.]+$/;
                if (keyword.length > 0 && !validPattern.test(keyword)) {
                    toastr.warning("Từ khóa chỉ được chứa chữ cái, số và dấu cách");
                    return;
                }

                if (keyword.length >= 2) {
                    // Debounce search - wait 300ms after user stops typing
                    searchTimeout = setTimeout(function() {
                        timKiemKhachHang(keyword);
                    }, 300);
                } else {
                    $("#ketQuaTimKiemKH").addClass("d-none").empty();
                }
            });

            $(document).on("click", function (e) {
                if (!$(e.target).closest("#searchKhachHang, #ketQuaTimKiemKH").length) {
                    $("#ketQuaTimKiemKH").addClass("d-none");
                }
            });

            $("#btnTimKiemKH").click(function () {
                const keyword = $("#searchKhachHang").val().trim();
                if (keyword.length >= 2) {
                    // Hiển thị loading state
                    const originalText = $(this).html();
                    $(this).html('<i class="bx bx-loader-alt bx-spin"></i>');
                    $(this).prop('disabled', true);

                    timKiemKhachHang(keyword);

                    // Khôi phục trạng thái sau 1 giây
                    setTimeout(() => {
                        $(this).html(originalText);
                        $(this).prop('disabled', false);
                    }, 1000);
                } else {
                    toastr.warning("Vui lòng nhập ít nhất 2 ký tự để tìm kiếm theo tên hoặc số điện thoại");
                }
            });

            $("#btnThemMoiKH").click(function () {
                $("#modalThemMoiKHForm").modal("show");
            });

            // Xử lý form thêm mới khách hàng
            $('#formThemMoiKH').submit(function (e) {
                e.preventDefault();
                const form = this;

                // Xóa các thông báo lỗi cũ
                $(form).find('.is-invalid').removeClass('is-invalid');

                let isValid = true;

                // Kiểm tra từng input và select required
                $(form).find('input[required], select[required]').each(function () {
                    if (!this.value.trim()) {
                        $(this).addClass('is-invalid');
                        isValid = false;
                    }
                });

                // Kiểm tra email
                const emailInput = $(form).find('input[name="Email"]')[0];
                if (emailInput && !emailInput.checkValidity()) {
                    $(emailInput).addClass('is-invalid');
                    isValid = false;
                }

                // Kiểm tra số điện thoại
                const phoneInput = $(form).find('input[name="SoDienThoai"]')[0];
                if (phoneInput && !phoneInput.checkValidity()) {
                    $(phoneInput).addClass('is-invalid');
                    isValid = false;
                }

                if (!isValid) {
                    toastr.warning("Vui lòng điền đầy đủ và đúng định dạng các thông tin bắt buộc!");
                    return false;
                }

                // Nếu hợp lệ, tiến hành gửi AJAX
                const formData = new FormData(form);

                const $submitButton = $(form).find('button[type="submit"]');
                const originalButtonText = $submitButton.html();
                $submitButton.prop('disabled', true).html('<i class="bx bx-loader-alt bx-spin"></i> Đang xử lý...');

                $.ajax({
                    url: '/KhachHang/CreateKhachHang',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response && response.success) {
                            toastr.success("Tạo khách hàng thành công!");
                            $("#modalThemMoiKHForm").modal("hide");
                            form.reset(); // Reset form sau khi thành công
                            $('#previewImage').attr('src', '/assets/img/avatars/hinhanhnew.png');

                            // Tự động chọn khách hàng vừa tạo
                            if (response.resultObj) {
                                chonKhachHang(response.resultObj);
                            }
                        } else {
                            toastr.error(response.message || "Tạo khách hàng thất bại!");
                        }
                    },
                    error: function (xhr) {
                        toastr.error("Lỗi khi tạo khách hàng: " + (xhr.responseJSON?.message || xhr.statusText));
                    },
                    complete: function() {
                            $submitButton.prop('disabled', false).html(originalButtonText);
                    }
                });
            });

            // Thêm sự kiện để xóa validation error khi người dùng nhập liệu
            $('#formThemMoiKH').on('input', 'input, select', function() {
                if (this.checkValidity()) {
                    $(this).removeClass('is-invalid');
                }
            });

            // Highlight từ khóa tìm kiếm
            function highlightKeyword(text, keyword) {
                if (!text || !keyword) return text;
                const regex = new RegExp(`(${keyword})`, 'gi');
                return text.replace(regex, '<mark class="bg-warning">$1</mark>');
            }

            // Search customers
            function timKiemKhachHang(keyword) {
                const resultContainer = $("#ketQuaTimKiemKH").empty();
                resultContainer.append('<div class="p-2 text-center"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> Đang tìm kiếm...</div>');
                resultContainer.removeClass("d-none");

                $.ajax({
                    url: '/BanHang/TimKiemKhachHang',
                    type: 'GET',
                    data: {
                        tuKhoa: keyword,
                        pageIndex: 1,
                        pageSize: 10
                    },
                    success: function (response) {
                        resultContainer.empty();

                        if (!response || !response.success) {
                            const errorMessage = response && response.message ? response.message : 'Lỗi khi tìm kiếm';
                            resultContainer.append(`
                                <div class="p-3 text-center">
                                    <div class="text-muted mb-2">
                                        <i class="bx bx-search bx-sm"></i>
                                    </div>
                                    <div class="text-muted">Không tìm thấy khách hàng nào phù hợp</div>
                                    <small class="text-muted">Thử tìm kiếm với từ khóa khác</small>
                                </div>
                            `);
                        } else {
                            // Thêm header với số lượng kết quả và từ khóa tìm kiếm
                            resultContainer.append(`
                                <div class="p-2 border-bottom bg-light">
                                    <small class="text-muted">
                                        <i class="bx bx-search me-1"></i>
                                        Tìm thấy ${response.data.items.length} khách hàng cho "${keyword}"
                                    </small>
                                </div>
                            `);

                            // SẮP XẾP KẾT QUẢ: ĐƯA KHÁCH HÀNG KHỚP TÊN LÊN ĐẦU
                            let sortedItems = response.data.items.slice();
                            const lowerKeyword = keyword.toLowerCase();
                            sortedItems.sort((a, b) => {
                                const aName = (a.hoVaTen || '').toLowerCase();
                                const bName = (b.hoVaTen || '').toLowerCase();
                                // Ưu tiên tên bắt đầu bằng keyword
                                const aStarts = aName.startsWith(lowerKeyword);
                                const bStarts = bName.startsWith(lowerKeyword);
                                if (aStarts && !bStarts) return -1;
                                if (!aStarts && bStarts) return 1;
                                // Ưu tiên tên chứa keyword
                                const aContains = aName.includes(lowerKeyword);
                                const bContains = bName.includes(lowerKeyword);
                                if (aContains && !bContains) return -1;
                                if (!aContains && bContains) return 1;
                                // Nếu không thì giữ nguyên thứ tự
                                return 0;
                            });

                            sortedItems.forEach(customer => {
                                const customerItem = `
                                    <div class="p-2 border-bottom customer-item" data-id="${customer.id}" style="cursor: pointer;">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-sm me-2 bg-light rounded-circle">
                                                <span class="avatar-initial rounded-circle ${customer.gioiTinh ? 'bg-primary' : 'bg-danger'}">
                                                    ${customer.hoVaTen ? customer.hoVaTen.charAt(0) : '?'}
                                                </span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="fw-bold">${highlightKeyword(customer.hoVaTen || '-', keyword)} ${customer.gioiTinh ? '- Nam' : '- Nữ'}</div>
                                                <div class="small text-muted">
                                                    <i class="bx bx-phone me-1"></i>${highlightKeyword(customer.soDienThoai || '-', keyword)}
                                                </div>
                                                <div class="small text-muted">
                                                    <i class="bx bx-envelope me-1"></i>${customer.email || '-'}
                                                </div>
                                            </div>
                                            <div class="text-muted">
                                                <i class="bx bx-chevron-right"></i>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                resultContainer.append(customerItem);
                            });

                            $(".customer-item").click(function () {
                                const customerId = $(this).data("id");
                                const selectedCustomer = response.data.items.find(c => c.id === customerId);
                                if (selectedCustomer) {
                                    chonKhachHang(selectedCustomer);
                                }
                            });

                            // Thêm hover effect
                            $(".customer-item").hover(
                                function() {
                                    $(this).addClass("bg-light");
                                },
                                function() {
                                    $(this).removeClass("bg-light");
                                }
                            );
                        }
                    },
                    error: function (xhr, status, error) {
                        resultContainer.empty();
                        let errorMessage = 'Lỗi khi tìm kiếm';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (error) {
                            errorMessage = `Lỗi: ${error}`;
                        }

                        resultContainer.append(`<div class="p-2 text-center text-danger">${errorMessage}</div>`);
                        console.error('Lỗi khi tìm kiếm khách hàng:', error);
                    }
                });
            }

            function chonKhachHang(customer) {
                $("#khachHangId").val(customer.id);
                $("#customerName").text(customer.hoVaTen || "Khách hàng lẻ");
                $("#customerPhoneRow, #customerEmailRow").show();
                $("#customerPhone").text(customer.soDienThoai || "-");
                $("#customerEmail").text(customer.email || "-");

                // Hiển thị tag khách hàng đã chọn
                $("#selectedCustomerName").text(customer.hoVaTen);
                $("#selectedCustomerTag").removeClass("d-none");

                // Cập nhật thông tin khách hàng vào hóa đơn hiện tại
                if (hoaDonHienTai) {
                    hoaDonHienTai.khachHang = {
                        id: customer.id,
                        hoTen: customer.hoVaTen,
                        soDienThoai: customer.soDienThoai,
                        email: customer.email
                    };
                }

                toastr.success(`Đã chọn khách hàng: ${customer.hoVaTen}`);
                $("#ketQuaTimKiemKH").addClass("d-none");
                $("#searchKhachHang").val("");

                if (hoaDonHienTai && hoaDonHienTai.id) {
                    $.ajax({
                        url: '/HoaDon/UpdateHoaDonCho',
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            Id: hoaDonHienTai.id,
                            HoTen: customer.hoVaTen,
                            SoDienThoai: customer.soDienThoai,
                            Email: customer.email,
                            UserId: customer.id,
                            TongTien: Math.max(hoaDonHienTai.tongTien - (hoaDonHienTai.giamGia || 0), 0),
                            TrangThai: hoaDonHienTai.trangThai || 0,
                            DiaChi: hoaDonHienTai.diaChi || "",
                            GhiChu: hoaDonHienTai.ghiChu || "",
                            PhuongThucThanhToan: hoaDonHienTai.phuongThucThanhToan || 1,
                            LoaiHoaDon: hoaDonHienTai.loaiHoaDon || 2,
                            NgayThanhToan: hoaDonHienTai.ngayThanhToan || null,
                            MaHoaDon: hoaDonHienTai.tenHoaDon || "",
                            PhiVanChuyen: hoaDonHienTai.phiVanChuyen || 0,
                            TrangThaiThanhToan: hoaDonHienTai.trangThaiThanhToan || 1,
                            VoucherId: hoaDonHienTai.voucherId || null,
                            GiaoHang: hoaDonHienTai.isGiaoHang || false,
                            TienKhachDua: parseInt($("#tienKhachDua").val().replace(/[^0-9]/g, "")) || 0
                        }),
                        success: function(res) {
                            if (res && res.success) {
                                toastr.success("Cập nhật khách hàng cho hóa đơn thành công!");
                            } else {
                                toastr.error(res.message || "Cập nhật thất bại!");
                            }
                        },
                        error: function(xhr) {
                            toastr.error("Lỗi khi cập nhật hóa đơn: " + (xhr.responseJSON?.message || xhr.statusText));
                        }
                    });
                }

                if (hoaDonHienTai.khachHang.id) {
                    // Có khách hàng thực sự
                    $("#selectedCustomerName").text(hoaDonHienTai.khachHang.hoTen);
                    $("#selectedCustomerTag").removeClass("d-none");
                    $("#customerPhoneRow, #customerEmailRow").show();
                    $("#giaoHangToggleRow").removeClass("d-none");
                } else {
                    // Khách hàng lẻ
                    $("#selectedCustomerName").text("");
                    $("#selectedCustomerTag").addClass("d-none");
                    $("#customerPhoneRow, #customerEmailRow").hide();
                    $("#giaoHangToggleRow").addClass("d-none");
                    $("#giaoHangDiaChiSection").hide();
                    $("#toggleGiaoHang").prop("checked", false);
                    $("#phiVanChuyenRow").addClass("d-none");
                }

                if ($('#toggleGiaoHang').is(':checked')) {
                    toggleGiaoHangDiaChi();
                }
            }

