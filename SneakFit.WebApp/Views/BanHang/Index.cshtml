        // Lắng nghe sự kiện nhập tiền khách đưa
        $("#tienKhachDua").on("input", function () {
            let raw = $(this).val().replace(/[^0-9]/g, "");
            if (raw === "") raw = "0";
            let formatted = Number(raw).toLocaleString('vi-VN');
            $(this).val(formatted);

            capNhatTienThua();
        });

        function capNhatTienThua() {
            let raw = $("#tienKhachDua").val().replace(/[^0-9]/g, "");
            if (raw === "") raw = "0";
            let tienKhachDua = parseInt(raw) || 0;

            let tongTienThanhToan = 0;
            if (hoaDonHienTai && typeof hoaDonHienTai.tongTien !== "undefined") {
                let phiVanChuyen = hoaDonHienTai.phiVanChuyen || 0;
                let giamGia = hoaDonHienTai.giamGia || 0;
                tongTienThanhToan = hoaDonHienTai.tongTien + phiVanChuyen - giamGia;
                if (tongTienThanhToan < 0) tongTienThanhToan = 0;
            } else {
                let tongTienText = $("#tongTienThanhToan").text().replace(/[^\d]/g, "");
                tongTienThanhToan = parseInt(tongTienText) || 0;
            }

            if (tienKhachDua < tongTienThanhToan) {
                $("#tienThua").text("0 VNĐ");
                $("#tienKhachDua").addClass("is-invalid");
                $("#tienKhachDua").closest('.mb-3').find('small.text-muted').text("Số tiền khách đưa phải lớn hơn hoặc bằng tổng tiền!");
            } else {
                let tienThua = tienKhachDua - tongTienThanhToan;
                $("#tienThua").text(formatCurrency(tienThua));
                $("#tienKhachDua").removeClass("is-invalid");
                $("#tienKhachDua").closest('.mb-3').find('small.text-muted').text("Vui lòng nhập đủ tiền khách đưa!");
            }
        }

