                    TenDiaChi: $('#TenDiaChi').val(),
                    TenThanhPho: $('#modalProvinceName').val(),
                    TenHuyen: $('#modalDistrictName').val(),
                    TenXa: $('#modalWardName').val(),
                    MacDinh: $('#MacDinh').is(':checked'),
