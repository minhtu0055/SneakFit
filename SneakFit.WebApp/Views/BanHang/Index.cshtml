                error: function(error) {
                    console.error('Lỗi khi tải danh sách tỉnh/thành phố:', error);
                    toastr.error('Không thể tải danh sách tỉnh/thành phố');
                }
            });

            // Khi chọn tỉnh/thành phố
            $('#province').change(function() {
                const provinceId = $(this).val();
                const provinceName = $(this).find('option:selected').data('name');
                $('#provinceName').val(provinceName);
                $('#provinceCode').val(provinceId);

                // Reset quận/huyện và phường/xã
                $('#district').html('<option value="">Chọn Quận/Huyện</option>');
                $('#ward').html('<option value="">Chọn Phường/Xã</option>');
                $('#districtName').val('');
                $('#districtCode').val('');
                $('#wardName').val('');
                $('#wardCode').val('');

                if (provinceId) {
                    $('#district').prop('disabled', false);
                    // Load quận/huyện
                    $.ajax({
                        url: 'https://localhost:7277/api/ghn/districts',
                        type: 'GET',
                        success: function(response) {
                            const districts = response.data.filter(d => d.ProvinceID == provinceId);
                            let options = '<option value="">Chọn Quận/Huyện</option>';
                            districts.forEach(function(district) {
                                options += `<option value="${district.DistrictID}" data-name="${district.DistrictName}">${district.DistrictName}</option>`;
                            });
                            $('#district').html(options);
                            $('#district').trigger('ajaxDistrictLoaded');
                        },
                        error: function(error) {
                            console.error('Lỗi khi tải danh sách quận/huyện:', error);
                            toastr.error('Không thể tải danh sách quận/huyện');
                        }
                    });
                } else {
                    $('#district').prop('disabled', true);
                    $('#ward').prop('disabled', true);
                }
            });

            // Khi chọn quận/huyện
            $('#district').change(function() {
                const districtId = $(this).val();
                const districtName = $(this).find('option:selected').data('name');
                $('#districtName').val(districtName);
                $('#districtCode').val(districtId);

                // Reset phường/xã
                $('#ward').html('<option value="">Chọn Phường/Xã</option>');
                $('#wardName').val('');
                $('#wardCode').val('');

                if (districtId) {
                    $('#ward').prop('disabled', false);
                    // Load phường/xã
                    $.ajax({
                        url: `https://localhost:7277/api/ghn/wards/${districtId}`,
                        type: 'GET',
                        success: function(response) {
                            const wards = response.data;
                            let options = '<option value="">Chọn Phường/Xã</option>';
                            wards.forEach(function(ward) {
                                options += `<option value="${ward.WardCode}" data-name="${ward.WardName}">${ward.WardName}</option>`;
                            });
                            $('#ward').html(options);
                            $('#ward').trigger('ajaxWardLoaded');
                        },
                        error: function(error) {
                            console.error('Lỗi khi tải danh sách phường/xã:', error);
                            toastr.error('Không thể tải danh sách phường/xã');
                        }
                    });
                } else {
                    $('#ward').prop('disabled', true);
                }
            });

            // Khi chọn phường/xã
            $('#ward').change(function() {
                const wardName = $(this).find('option:selected').data('name');
                const wardCode = $(this).val();
                $('#wardName').val(wardName || '');
                $('#wardCode').val(wardCode || '');
            });
        });

        // Sự kiện nút Thanh toán
        $(".btn-warning.w-100").click(function () {
            if (!hoaDonHienTai || !hoaDonHienTai.id) {
                toastr.error("Không tìm thấy hóa đơn để thanh toán!");
                return;
            }
            if (!hoaDonHienTai.sanPham || hoaDonHienTai.sanPham.length === 0) {
                toastr.warning("Vui lòng thêm sản phẩm vào hóa đơn!");
                return;
            }

            let phuongThucThanhToan = $("#tienMat").is(":checked") ? 1 : 2; // 1: Tiền mặt, 2: Chuyển khoản
            let tongTienThanhToan = hoaDonHienTai.tongTien + (hoaDonHienTai.phiVanChuyen || 0) - (hoaDonHienTai.giamGia || 0);
            if (tongTienThanhToan < 0) tongTienThanhToan = 0;

            if (phuongThucThanhToan === 1) {
                let raw = $("#tienKhachDua").val().replace(/[^0-9]/g, "");
                let tienKhachDua = parseInt(raw) || 0;
                if (tienKhachDua < tongTienThanhToan) {
                    toastr.warning("Số tiền khách đưa phải lớn hơn hoặc bằng tổng tiền!");
                    $("#tienKhachDua").addClass("is-invalid");
                    return;
                }
            }

            let ghiChu = $(".form-control[placeholder='Nhập ghi chú...']").val();
            let choThanhToan = $("#choThanhToan").is(":checked");

            // Lấy các trường cần thiết từ hoaDonHienTai
            let data = {
                Id: hoaDonHienTai.id,
                TongTien: hoaDonHienTai.tongTien,
                UserId: hoaDonHienTai.khachHang?.id || null,
                DiaChi: hoaDonHienTai.diaChi || "",
                SoDienThoai: hoaDonHienTai.khachHang?.soDienThoai || "",
                Email: hoaDonHienTai.khachHang?.email || "",
                HoTen: hoaDonHienTai.khachHang?.hoTen || "",
                GhiChu: ghiChu,
                PhuongThucThanhToan: phuongThucThanhToan,
                LoaiHoaDon: 2, // Tại quầy
                NgayThanhToan: new Date().toISOString(),
                MaHoaDon: hoaDonHienTai.tenHoaDon || "",
                PhiVanChuyen: hoaDonHienTai.phiVanChuyen || 0,
                TrangThaiThanhToan: 2, // Đã thanh toán
                VoucherId: hoaDonHienTai.voucherId || null,
                GiaoHang: hoaDonHienTai.isGiaoHang || false
            };

            Swal.fire({
                title: 'Xác nhận thanh toán',
                text: 'Bạn có chắc chắn muốn thanh toán hóa đơn này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Thanh toán',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/HoaDon/ThanhToan',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (res) {
                            if (res && res.success) {
                                toastr.success("Thanh toán thành công!");
                                loadHoaDonCho();
                            } else {
                                toastr.error(res.message || "Thanh toán thất bại!");
                            }
                        },
                        error: function (xhr) {
                            toastr.error("Lỗi khi thanh toán: " + (xhr.responseJSON?.message || xhr.statusText));
                        }
                    });
                }
            });
        });
    </script>
}