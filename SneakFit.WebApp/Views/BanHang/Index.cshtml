                let userId = hoaDonHienTai && hoaDonHienTai.khachHang ? hoaDonHienTai.khachHang.id : null;
                let tongTien = hoaDonHienTai && hoaDonHienTai.tongTien ? hoaDonHienTai.tongTien : 0;

                if (userId) {
