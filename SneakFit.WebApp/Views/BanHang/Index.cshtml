@using SneakFit.Data.Enums
@model List<SneakFit.ViewModels.Catalog.HoaDonChiTiet.HoaDonChiTietViewModel>
@{
    ViewData["Title"] = "Bán hàng tại quầy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="hoa-don-tabs">
        <ul class="nav nav-pills" id="hoaDonTabs">
            <!-- Các tab hóa đơn sẽ được thêm vào đây bằng JavaScript -->
        </ul>
    </div>
    <div>
        <button id="btnTaoHoaDon" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Tạo hóa đơn
        </button>
    </div>
</div>

<div class="row">
    <!-- Thông tin hóa đơn hiện tại -->
    <div class="col-xl-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Thông tin hóa đơn</h5>
                <button id="btnThemSanPham" class="btn btn-primary btn-sm">
                    <i class="bx bx-plus me-1"></i> Thêm sản phẩm
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="hoaDonChiTietTable">
                            <!-- Dữ liệu sản phẩm sẽ được thêm vào đây -->
                            <tr class="no-data">
                                <td colspan="6" class="text-center">Không có sản phẩm nào trong giỏ</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Tổng tiền:</strong></td>
                                <td colspan="2"><span id="tongTien">0 VNĐ</span></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin khách hàng -->
    <div class="col-xl-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Thông tin khách hàng</h5>
                <div class="d-flex align-items-center gap-3">
                    <!-- Selected Customer Tag (hidden by default) -->
                    <span id="selectedCustomerTag" class="badge bg-danger d-none">
                        <span id="selectedCustomerName">Nguyễn Anh Dũng</span>
                        <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.6em;" id="removeCustomer"></button>
                    </span>

                    <div class="position-relative">
                        <div class="input-group">
                            <input type="text" class="form-control form-control-sm" id="searchKhachHang" placeholder="Tìm kiếm khách hàng..." style="width: 250px;" />
                            <button class="btn btn-outline-primary btn-sm" type="button" id="btnTimKiemKH">
                                <i class="bx bx-search"></i>
                            </button>
                        </div>
                        <div id="ketQuaTimKiemKH" class="position-absolute w-100 bg-white shadow-sm rounded mt-1 d-none" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                            <!-- Kết quả tìm kiếm sẽ được hiển thị ở đây -->
                        </div>
                    </div>
                    <button id="btnThemMoiKH" class="btn btn-warning btn-sm">
                        <i class="bx bx-plus me-1"></i> Thêm mới KH
                    </button>
                </div>
            </div>
            <div class="card-body">

                <!-- Customer Information Form - 2 Column Layout -->
                <form id="formKhachHang">
                    <input type="hidden" id="khachHangId" name="khachHangId" />

                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <div class="mb-3 d-flex align-items-center">
                                <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Tên khách hàng:</label>
                                <div id="customerName" class="form-control-plaintext">Khách hàng lẻ</div>
                            </div>
                        </div>
                    </div>

                    <!-- Email Row (hidden by default for guest customers) -->
                    <div class="row" id="customerEmailRow">
                        <div class="col-md-6">
                            <div class="mb-3 d-flex align-items-center">
                                <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Email:</label>
                                <div id="customerEmail" class="form-control-plaintext">-</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Empty column for spacing -->
                        </div>
                    </div>

                    <!-- Phone Row (hidden by default for guest customers) -->
                    <div class="row" id="customerPhoneRow">
                        <div class="col-md-6">
                            <div class="mb-3 d-flex align-items-center">
                                <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Số điện thoại:</label>
                                <div id="customerPhone" class="form-control-plaintext">-</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <!-- Empty column for spacing -->
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Thông tin thanh toán -->
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Thông tin thanh toán</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Cột trái - Thông tin địa chỉ -->
                    <div class="col-md-6">
                        <!-- Phường -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Phường <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="phong" placeholder="Phường" value="0387880000">
                        </div>

                        <!-- Row cho 3 select -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Tỉnh/thành phố <span class="text-danger">*</span></label>
                                <select class="form-select" id="tinhThanhPho">
                                    <option selected>Hung Yên</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Quận/huyện <span class="text-danger">*</span></label>
                                <select class="form-select" id="quanHuyen">
                                    <option selected>Huyện Văn Lâm</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Xã/phường/thị trấn <span class="text-danger">*</span></label>
                                <select class="form-select" id="xaPhuongThiTran">
                                    <option selected>Xã Tân Quang</option>
                                </select>
                            </div>
                        </div>

                        <!-- Địa chỉ cụ thể -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ cụ thể</label>
                            <input type="text" class="form-control" id="diaChiCuThe" placeholder="Số 8">
                        </div>

                        <!-- Logo GHN -->
                        <div class="d-flex align-items-center mt-4">
                            <img src="https://via.placeholder.com/60x30?text=GHN" alt="GHN" class="me-2">
                            <span class="fw-bold">GIAO HÀNG NHANH TOÀN QUỐC</span>
                        </div>
                    </div>

                    <!-- Cột phải - Thông tin thanh toán -->
                    <div class="col-md-6">
                        <!-- Phiếu giảm giá -->
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <i class="bx bx-discount text-primary"></i>
                            <span class="fw-bold">Phiếu giảm giá</span>
                            <a href="#" class="text-primary text-decoration-none">Chọn hoặc nhập mã <i class="bx bx-chevron-right"></i></a>
                        </div>

                        <!-- Tóm tắt đơn hàng -->
                        <div class="border-0 mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tạm tính:</span>
                                <span class="fw-bold">200,000 đ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Phí vận chuyển (tạm tính):</span>
                                <span class="fw-bold">38,501 đ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Giảm giá:</span>
                                <span class="fw-bold">0 đ</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="fw-bold">Tổng tiền:</span>
                                <span class="fw-bold text-danger fs-5">238,501 đ</span>
                            </div>
                        </div>

                        <!-- Phương thức thanh toán -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn phương thức thanh toán:</label>

                            <!-- Tiền mặt -->
                            <div class="border rounded p-3 mb-2" style="border-color: #ffc107 !important; background-color: #fff9e6;">
                                <div class="d-flex align-items-center">
                                    <input class="form-check-input me-3" type="radio" name="paymentMethod" id="tienMat" checked>
                                    <div class="bg-warning rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bx bx-money text-white"></i>
                                    </div>
                                    <label class="form-check-label fw-bold" for="tienMat">Tiền mặt</label>
                                </div>
                            </div>

                            <!-- Chuyển khoản -->
                            <div class="border rounded p-3 mb-2">
                                <div class="d-flex align-items-center">
                                    <input class="form-check-input me-3" type="radio" name="paymentMethod" id="chuyenKhoan">
                                    <div class="bg-primary rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bx bx-credit-card text-white"></i>
                                    </div>
                                    <label class="form-check-label fw-bold" for="chuyenKhoan">Chuyển khoản</label>
                                </div>
                            </div>

                            <!-- Tiền mặt & Chuyển khoản -->
                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex align-items-center">
                                    <input class="form-check-input me-3" type="radio" name="paymentMethod" id="ketHop">
                                    <div class="bg-secondary rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bx bx-wallet text-white"></i>
                                    </div>
                                    <span class="fw-bold me-2">Tiền mặt &</span>
                                    <div class="bg-primary rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                        <i class="bx bx-credit-card text-white" style="font-size: 12px;"></i>
                                    </div>
                                    <span class="fw-bold ms-2">Chuyển khoản</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <textarea class="form-control" rows="3" placeholder="Nhập ghi chú..."></textarea>
                        </div>

                        <!-- Toggle chờ thanh toán -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="fw-bold">Chờ thanh toán</span>
                            <div class="form-check form-switch">
                                <input class="form-check-input bg-secondary" type="checkbox" id="choThanhToan">
                            </div>
                        </div>

                        <!-- Nút tạo hóa đơn -->
                        <button class="btn btn-warning w-100 fw-bold py-2">
                            Tạo hóa đơn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Sản Phẩm -->
<div class="modal fade" id="modalThemSanPham" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm sản phẩm vào hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" class="form-control" id="searchSanPham" placeholder="Tìm kiếm sản phẩm..." />
                        <button class="btn btn-outline-primary" type="button" id="btnTimKiem">
                            <i class="bx bx-search"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Giá bán</th>
                                <th>Số lượng</th>
                                <th>Kích thước</th>
                                <th>Màu sắc</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="danhSachSanPham">
                            <!-- Dữ liệu sản phẩm sẽ được thêm vào đây -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Biến toàn cục để lưu trữ danh sách hóa đơn chờ
        let danhSachHoaDon = [];
        let hoaDonHienTai = null;
        const MAX_HOA_DON = 5;

        $(document).ready(function () {
            // Khởi tạo sự kiện cho nút tạo hóa đơn
            $("#btnTaoHoaDon").click(function () {
                taoHoaDonMoi();
            });

            // Khởi tạo sự kiện cho nút thêm sản phẩm
            $("#btnThemSanPham").click(function () {
                if (!hoaDonHienTai) {
                    toastr.warning("Vui lòng tạo hóa đơn trước khi thêm sản phẩm");
                    return;
                }
                loadDanhSachSanPham();
                $("#modalThemSanPham").modal("show");
            });

            // Khởi tạo sự kiện cho nút tìm kiếm sản phẩm
            $("#btnTimKiem").click(function () {
                const keyword = $("#searchSanPham").val();
                loadDanhSachSanPham(keyword);
            });

            // Tạo hóa đơn mặc định khi trang được tải
            taoHoaDonMoi();
        });

        // Hàm tạo hóa đơn mới
        function taoHoaDonMoi() {
            if (danhSachHoaDon.length >= MAX_HOA_DON) {
                toastr.warning(`Bạn chỉ có thể tạo tối đa ${MAX_HOA_DON} hóa đơn chờ`);
                return;
            }

            // Tạo ID ngẫu nhiên cho hóa đơn mới
            const hoaDonId = 'hd-' + Date.now();
            const hoaDonMoi = {
                id: hoaDonId,
                tenHoaDon: `Hóa đơn ${danhSachHoaDon.length + 1}`,
                sanPham: [],
                tongTien: 0,
                khachHang: {
                    hoTen: "",
                    soDienThoai: "",
                    email: "",
                }
            };

            // Thêm hóa đơn mới vào danh sách
            danhSachHoaDon.push(hoaDonMoi);
            hoaDonHienTai = hoaDonMoi;

            // Cập nhật giao diện
            capNhatTabHoaDon();
            capNhatHoaDonHienTai();
        }

        // Hàm cập nhật tab hóa đơn
        function capNhatTabHoaDon() {
            const tabContainer = $("#hoaDonTabs");
            tabContainer.empty();

            danhSachHoaDon.forEach((hoaDon, index) => {
                const isActive = hoaDon.id === hoaDonHienTai.id;
                const tabItem = `
                    <li class="nav-item">
                        <a class="nav-link ${isActive ? 'active' : ''}" href="#" data-hoadon-id="${hoaDon.id}">
                            ${hoaDon.tenHoaDon}
                            <button class="btn-close btn-close-white ms-2 btn-xoa-hoadon" data-hoadon-id="${hoaDon.id}" style="font-size: 0.5rem;"></button>
                        </a>
                    </li>
                `;
                tabContainer.append(tabItem);
            });

            // Thêm sự kiện click cho tab hóa đơn
            $(".nav-link").click(function (e) {
                if (!$(e.target).hasClass('btn-xoa-hoadon')) {
                    const hoaDonId = $(this).data("hoadon-id");
                    chuyenHoaDon(hoaDonId);
                }
            });

            // Thêm sự kiện click cho nút xóa hóa đơn
            $(".btn-xoa-hoadon").click(function (e) {
                e.stopPropagation();
                const hoaDonId = $(this).data("hoadon-id");
                xoaHoaDon(hoaDonId);
            });
        }

        // Hàm chuyển đổi giữa các hóa đơn
        function chuyenHoaDon(hoaDonId) {
            const hoaDon = danhSachHoaDon.find(hd => hd.id === hoaDonId);
            if (hoaDon) {
                hoaDonHienTai = hoaDon;
                capNhatTabHoaDon();
                capNhatHoaDonHienTai();
            }
        }

        // Hàm xóa hóa đơn
        function xoaHoaDon(hoaDonId) {
            if (danhSachHoaDon.length <= 1) {
                toastr.warning("Phải có ít nhất một hóa đơn");
                return;
            }

            Swal.fire({
                title: 'Xác nhận xóa',
                text: "Bạn có chắc chắn muốn xóa hóa đơn này?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Xóa hóa đơn khỏi danh sách
                    danhSachHoaDon = danhSachHoaDon.filter(hd => hd.id !== hoaDonId);

                    // Nếu xóa hóa đơn hiện tại, chuyển sang hóa đơn đầu tiên
                    if (hoaDonHienTai.id === hoaDonId) {
                        hoaDonHienTai = danhSachHoaDon[0];
                    }

                    // Cập nhật giao diện
                    capNhatTabHoaDon();
                    capNhatHoaDonHienTai();

                    toastr.success("Xóa hóa đơn thành công");
                }
            });
        }

        // Hàm cập nhật thông tin hóa đơn hiện tại
        function capNhatHoaDonHienTai() {
            if (!hoaDonHienTai) return;

            // Cập nhật thông tin khách hàng
            $("#hoTen").val(hoaDonHienTai.khachHang.hoTen);
            $("#soDienThoai").val(hoaDonHienTai.khachHang.soDienThoai);
            $("#email").val(hoaDonHienTai.khachHang.email);
            $("#ghiChu").val(hoaDonHienTai.khachHang.ghiChu);

            // Cập nhật bảng sản phẩm
            const tableBody = $("#hoaDonChiTietTable");
            tableBody.empty();

            if (hoaDonHienTai.sanPham.length === 0) {
                tableBody.append(`
                    <tr class="no-data">
                        <td colspan="6" class="text-center">Không có sản phẩm nào trong giỏ</td>
                    </tr>
                `);
            } else {
                hoaDonHienTai.sanPham.forEach((sp, index) => {
                    const row = `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${sp.tenSanPham}</td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary btn-giam-sl" data-index="${index}">-</button>
                                    <input type="number" class="form-control text-center input-so-luong" value="${sp.soLuong}" min="1" data-index="${index}">
                                    <button class="btn btn-outline-secondary btn-tang-sl" data-index="${index}">+</button>
                                </div>
                            </td>
                            <td>${formatCurrency(sp.giaBan)}</td>
                            <td>${formatCurrency(sp.giaBan * sp.soLuong)}</td>
                            <td>
                                <button class="btn btn-sm btn-danger btn-xoa-sp" data-index="${index}">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    tableBody.append(row);
                });

                // Thêm sự kiện cho các nút tăng/giảm số lượng
                $(".btn-giam-sl").click(function() {
                    const index = $(this).data("index");
                    giamSoLuong(index);
                });

                $(".btn-tang-sl").click(function() {
                    const index = $(this).data("index");
                    tangSoLuong(index);
                });

                $(".input-so-luong").change(function() {
                    const index = $(this).data("index");
                    const soLuong = parseInt($(this).val());
                    capNhatSoLuong(index, soLuong);
                });

                $(".btn-xoa-sp").click(function() {
                    const index = $(this).data("index");
                    xoaSanPham(index);
                });
            }

            // Cập nhật tổng tiền
            $("#tongTien").text(formatCurrency(hoaDonHienTai.tongTien));
        }

        // Hàm tăng số lượng sản phẩm
        function tangSoLuong(index) {
            if (hoaDonHienTai.sanPham[index]) {
                hoaDonHienTai.sanPham[index].soLuong++;
                tinhTongTien();
                capNhatHoaDonHienTai();
            }
        }

        // Hàm giảm số lượng sản phẩm
        function giamSoLuong(index) {
            if (hoaDonHienTai.sanPham[index] && hoaDonHienTai.sanPham[index].soLuong > 1) {
                hoaDonHienTai.sanPham[index].soLuong--;
                tinhTongTien();
                capNhatHoaDonHienTai();
            }
        }

        // Hàm cập nhật số lượng sản phẩm
        function capNhatSoLuong(index, soLuong) {
            if (hoaDonHienTai.sanPham[index]) {
                if (soLuong < 1) soLuong = 1;
                hoaDonHienTai.sanPham[index].soLuong = soLuong;
                tinhTongTien();
                capNhatHoaDonHienTai();
            }
        }

        // Hàm xóa sản phẩm
        function xoaSanPham(index) {
            if (hoaDonHienTai.sanPham[index]) {
                hoaDonHienTai.sanPham.splice(index, 1);
                tinhTongTien();
                capNhatHoaDonHienTai();
            }
        }

        // Hàm tính tổng tiền
        function tinhTongTien() {
            hoaDonHienTai.tongTien = hoaDonHienTai.sanPham.reduce((total, sp) => {
                return total + (sp.giaBan * sp.soLuong);
            }, 0);
        }

        // Hàm load danh sách sản phẩm
        function loadDanhSachSanPham(keyword = "") {
            // Giả lập dữ liệu sản phẩm (sẽ được thay thế bằng API call sau)
            const dummyProducts = [
                { id: 'sp1', tenSanPham: 'Giày Nike Air Force 1', giaBan: 2500000, soLuong: 10, kichThuoc: '42', mauSac: 'Trắng', trangThai: true, anhSanPham: 'https://via.placeholder.com/50' },
                { id: 'sp2', tenSanPham: 'Giày Adidas Superstar', giaBan: 1800000, soLuong: 15, kichThuoc: '41', mauSac: 'Đen', trangThai: true, anhSanPham: 'https://via.placeholder.com/50' },
                { id: 'sp3', tenSanPham: 'Giày Puma RS-X', giaBan: 2200000, soLuong: 8, kichThuoc: '43', mauSac: 'Xanh', trangThai: true, anhSanPham: 'https://via.placeholder.com/50' },
                { id: 'sp4', tenSanPham: 'Giày Converse Chuck Taylor', giaBan: 1500000, soLuong: 20, kichThuoc: '40', mauSac: 'Đỏ', trangThai: true, anhSanPham: 'https://via.placeholder.com/50' },
                { id: 'sp5', tenSanPham: 'Giày Vans Old Skool', giaBan: 1700000, soLuong: 12, kichThuoc: '39', mauSac: 'Đen', trangThai: true, anhSanPham: 'https://via.placeholder.com/50' }
            ];

            // Lọc sản phẩm theo từ khóa nếu có
            let filteredProducts = dummyProducts;
            if (keyword) {
                filteredProducts = dummyProducts.filter(p =>
                    p.tenSanPham.toLowerCase().includes(keyword.toLowerCase())
                );
            }

            // Hiển thị danh sách sản phẩm
            const tableBody = $("#danhSachSanPham");
            tableBody.empty();

            if (filteredProducts.length === 0) {
                tableBody.append(`
                    <tr>
                        <td colspan="9" class="text-center">Không tìm thấy sản phẩm nào</td>
                    </tr>
                `);
            } else {
                filteredProducts.forEach((sp, index) => {
                    const row = `
                        <tr>
                            <td>${index + 1}</td>
                            <td><img src="${sp.anhSanPham}" alt="${sp.tenSanPham}" width="50"></td>
                            <td>${sp.tenSanPham}</td>
                            <td>${formatCurrency(sp.giaBan)}</td>
                            <td>${sp.soLuong}</td>
                            <td>${sp.kichThuoc}</td>
                            <td>${sp.mauSac}</td>
                            <td>${sp.trangThai ? '<span class="badge bg-success">Còn hàng</span>' : '<span class="badge bg-danger">Hết hàng</span>'}</td>
                            <td>
                                <button class="btn btn-sm btn-primary btn-them-vao-hoadon" data-sp-id="${sp.id}">
                                    <i class="bx bx-plus"></i> Thêm
                                </button>
                            </td>
                        </tr>
                    `;
                    tableBody.append(row);
                });

                // Thêm sự kiện cho nút thêm sản phẩm vào hóa đơn
                $(".btn-them-vao-hoadon").click(function() {
                    const spId = $(this).data("sp-id");
                    const sanPham = filteredProducts.find(sp => sp.id === spId);
                    if (sanPham) {
                        themSanPhamVaoHoaDon(sanPham);
                    }
                });
            }
        }

        // Hàm thêm sản phẩm vào hóa đơn
        function themSanPhamVaoHoaDon(sanPham) {
            // Kiểm tra xem sản phẩm đã có trong hóa đơn chưa
            const existingIndex = hoaDonHienTai.sanPham.findIndex(sp => sp.id === sanPham.id);

            if (existingIndex !== -1) {
                // Nếu sản phẩm đã có, tăng số lượng
                hoaDonHienTai.sanPham[existingIndex].soLuong++;
            } else {
                // Nếu sản phẩm chưa có, thêm mới
                hoaDonHienTai.sanPham.push({
                    id: sanPham.id,
                    tenSanPham: sanPham.tenSanPham,
                    giaBan: sanPham.giaBan,
                    soLuong: 1,
                    kichThuoc: sanPham.kichThuoc,
                    mauSac: sanPham.mauSac
                });
            }

            // Tính lại tổng tiền
            tinhTongTien();

            // Cập nhật giao diện
            capNhatHoaDonHienTai();

            // Đóng modal
            $("#modalThemSanPham").modal("hide");

            toastr.success("Thêm sản phẩm vào hóa đơn thành công");
        }

        // Hàm định dạng tiền tệ
        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        }
        // Xử lý tìm kiếm khách hàng
        $("#searchKhachHang").on("input", function() {
            const keyword = $(this).val().trim();
            if (keyword.length >= 2) {
                timKiemKhachHang(keyword);
            } else {
                $("#ketQuaTimKiemKH").addClass("d-none").empty();
            }
        });

        // Xử lý click bên ngoài dropdown kết quả tìm kiếm
        $(document).on("click", function(e) {
            if (!$(e.target).closest("#searchKhachHang, #ketQuaTimKiemKH").length) {
                $("#ketQuaTimKiemKH").addClass("d-none");
            }
        });

        // Xử lý nút tìm kiếm khách hàng
        $("#btnTimKiemKH").click(function() {
            const keyword = $("#searchKhachHang").val().trim();
            if (keyword.length >= 2) {
                timKiemKhachHang(keyword);
            } else {
                toastr.warning("Vui lòng nhập ít nhất 2 ký tự để tìm kiếm");
            }
        });

        // Xử lý nút thêm mới khách hàng
        $("#btnThemMoiKH").click(function() {
            // Mở form thêm mới khách hàng hoặc chuyển hướng đến trang thêm mới khách hàng
            // Có thể thực hiện sau khi đã có backend
            toastr.info("Chức năng thêm mới khách hàng sẽ được phát triển sau");
        });

        // Hàm tìm kiếm khách hàng
               function timKiemKhachHang(keyword) {
            // Giả lập dữ liệu khách hàng (sẽ được thay thế bằng API call sau)
            const dummyCustomers = [
                { id: 'kh1', hoTen: 'Nguyễn Anh Dũng', soDienThoai: '0387811111', email: 'DungNA29@gmail.com' },
                { id: 'kh2', hoTen: 'Vũ Nam', soDienThoai: '0395080513', email: 'namv@example.com' }
            ];

            const filteredCustomers = dummyCustomers.filter(c =>
                c.hoTen.toLowerCase().includes(keyword.toLowerCase()) ||
                c.soDienThoai.includes(keyword) ||
                c.email.toLowerCase().includes(keyword.toLowerCase())
            );

            const resultContainer = $("#ketQuaTimKiemKH");
            resultContainer.empty();

            if (filteredCustomers.length === 0) {
                resultContainer.append(`<div class="p-2 text-center">Không tìm thấy khách hàng</div>`);
            } else {
                filteredCustomers.forEach(customer => {
                    const customerItem = `
                        <div class="p-2 border-bottom customer-item" data-id="${customer.id}" style="cursor: pointer;">
                            <div class="d-flex align-items-center">
                                <div class="avatar avatar-sm me-2 bg-light rounded-circle">
                                    <span class="avatar-initial rounded-circle ${customer.gioiTinh ? 'bg-primary' : 'bg-danger'}">
                                        ${customer.hoTen.charAt(0)}
                                    </span>
                                </div>
                                <div>
                                    <div class="fw-bold">${customer.hoTen || '-'} ${customer.gioiTinh ? '- Nam' : '- Nữ'}</div>
                                    <div class="small text-muted">${customer.soDienThoai}</div>
                                </div>
                            </div>
                        </div>
                    `;
                    resultContainer.append(customerItem);
                });

                $(".customer-item").click(function() {
                    const customerId = $(this).data("id");
                    const selectedCustomer = filteredCustomers.find(c => c.id === customerId);
                    if (selectedCustomer) {
                        chonKhachHang(selectedCustomer);
                    }
                });

                resultContainer.removeClass("d-none");
            }
        }

               // Hàm chọn khách hàng
        function chonKhachHang(customer) {
            // Cập nhật thông tin khách hàng vào form
            $("#khachHangId").val(customer.id);
            $("#customerName").text(customer.hoTen);

            // Nếu có khách hàng, hiển thị các thông tin và điền vào các trường
            $("#customerPhoneRow").show();
            $("#customerEmailRow").show();

            $("#customerPhone").text(customer.soDienThoai);
            $("#customerEmail").text(customer.email);

            toastr.success(`Đã chọn khách hàng: ${customer.hoTen}`);

            // Ẩn kết quả tìm kiếm
            $("#ketQuaTimKiemKH").addClass("d-none");
            $("#searchKhachHang").val("");
        }

        // Hàm ẩn các trường thông tin khách hàng khi không có khách hàng được chọn
        function hideCustomerInfo() {
            // Ẩn các trường thông tin khi không có khách hàng
            $("#customerPhoneRow").hide();
            $("#customerEmailRow").hide();
        }
    </script>
}


