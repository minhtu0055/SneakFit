            //QR code

            function showToast(msg, isSuccess = true) {
                // Đơn giản: alert, có thể thay bằng toast đẹp hơn
                alert(msg);
            }

            function stopCamera() {
                scanning = false;
                if (scanInterval) clearInterval(scanInterval);
                if (video) video.pause();
                if (stream) {
                    stream.getTracks().forEach(track => track.stop());
                    stream = null;
                }
            }

            function startCamera() {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    showToast('Trình duyệt không hỗ trợ camera!', false);
                    return;
                }
                navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
                    .then(function (s) {
                        stream = s;
                        video.srcObject = stream;
                        video.setAttribute('playsinline', true);
                        video.play();
                        scanning = true;
                        scanInterval = setInterval(scanFrame, 500);
                    })
                    .catch(function (err) {
                        showToast('Không thể truy cập camera: ' + err, false);
                    });
            }

            function scanFrame() {
                if (!scanning || !video || video.readyState !== video.HAVE_ENOUGH_DATA) return;
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                let imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                let code = jsQR(imageData.data, imageData.width, imageData.height);
                if (code && code.data) {
                    if (code.data !== lastResult) {
                        lastResult = code.data;
                        handleQRResult(code.data);
                    }
                }
            }

            function handleQRResult(data) {
                // Giả định mã QR là GUID của SPCT
                if (!data || !/^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$/.test(data)) {
                    showToast('Mã QR không hợp lệ!', false);
                    return;
                }
                // Lấy thông tin sản phẩm chi tiết từ server
                $.ajax({
                    url: '/SPCT/GetById', // Đổi đúng route lấy SPCT theo id nếu khác
                    type: 'GET',
                    data: { id: data },
                    success: function (sanPham) {
                        if (!sanPham) {
                            toastr.error('Không tìm thấy sản phẩm!');
                            return;
                        }
                        $.ajax({
                            url: '/HoaDonChiTiet/CreateOrUpdate',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                HoaDonId: hoaDonHienTai.id,
                                SanPhamChiTietId: sanPham.id,
                                SoLuong: 1,
                                GiaBan: (sanPham.giaKhuyenMai && sanPham.giaKhuyenMai > 0 && sanPham.giaKhuyenMai < sanPham.gia) ? sanPham.giaKhuyenMai : sanPham.gia
                            }),
                            success: function (res) {
                                if (res && res.id) { // hoặc kiểm tra thuộc tính phù hợp với response thực tế
                                    $('#qr-result').text('Đã thêm vào hóa đơn chờ!');
                                    toastr.success('Đã thêm vào hóa đơn chờ!');
                                    loadChiTietHoaDonHienTai();
                                    $('#qrScanModal').modal('hide'); // Đóng modal
                                } else {
                                    toastr.error(res.message || 'Có lỗi khi thêm vào hóa đơn!');
                                }
                            },
                            error: function () {
                                toastr.error('Có lỗi khi thêm vào hóa đơn!');
                            }
                        });
                    },
                    error: function () {
                        toastr.error('Không tìm thấy sản phẩm!');
                    }
                });
            }

            // Hàm xử lý phân trang cho hóa đơn chờ
            function goToInvoicePage(page) {
                if (page < 1 || page > totalInvoicePages) return;
                currentInvoicePage = page;
                capNhatHoaDonHienTai();
            }

            // Xử lý sự kiện phân trang
            $(document).on('click', '#prevPage', function(e) {
                e.preventDefault();
                if (currentInvoicePage > 1) {
                    goToInvoicePage(currentInvoicePage - 1);
                }
            });

            $(document).on('click', '#nextPage', function(e) {
                e.preventDefault();
                if (currentInvoicePage < totalInvoicePages) {
                    goToInvoicePage(currentInvoicePage + 1);
                }
            });

            $(function () {
                // Mở modal khi bấm nút QR
                $('#qrScanBtn').on('click', function () {
                    $('#qrScanModal').modal('show');
                    $('#qr-result').text('');
                    lastResult = null;
                });

                // Tự động bật camera khi modal hiển thị
                $('#qrScanModal').on('shown.bs.modal', function () {
                    startCamera();
                });

                // Tắt camera khi modal đóng
                $('#qrScanModal').on('hidden.bs.modal', function () {
                    stopCamera();
                });
            });

            // Hàm in hóa đơn
            function printInvoice(hoaDonId) {
                $.ajax({
                    url: '/HoaDon/GetHoaDonForPrint',
                    type: 'GET',
                    data: { id: hoaDonId },
                    success: function (html) {
                        // Tạo một cửa sổ mới để in
                        var printWindow = window.open('', '_blank', 'width=800,height=600');
                        printWindow.document.write(html);
                        printWindow.document.close();
                        
                        // Đợi một chút để đảm bảo nội dung đã load
                        setTimeout(function() {
                            printWindow.print();
                            printWindow.close();
                        }, 500);
                    },
                    error: function (xhr) {
                        console.error('Lỗi khi lấy dữ liệu hóa đơn để in:', xhr);
                        toastr.error('Lỗi khi in hóa đơn!');
                    }
                });
            }
    </script>
