                $("#customerPhoneRow, #customerEmailRow").hide();
            }

            // Reset thông tin khách hàng
            function resetKhachHang() {
                $("#khachHangId").val("");
                $("#customerName").text("Khách hàng lẻ");
                $("#customerPhone").text("-");
