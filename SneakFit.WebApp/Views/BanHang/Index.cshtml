            // Lắng nghe sự kiện nhập tiền khách đưa
            $("#tienKhachDua").on("input", function () {
                let raw = $(this).val().replace(/[^0-9]/g, "");
                if (raw === "") raw = "0";
                let formatted = Number(raw).toLocaleString('vi-VN');
                $(this).val(formatted);

                // Lưu vào hóa đơn hiện tại
                if (hoaDonHienTai) {
                    hoaDonHienTai.TienKhachDua = parseInt(raw) || 0;
                }

                capNhatTienThua();
            });

            // Lắng nghe sự kiện nhập ghi chú
            $("#ghiChu").on("input", function () {
                // Lưu vào hóa đơn hiện tại
                if (hoaDonHienTai) {
                    hoaDonHienTai.ghiChu = $(this).val();
                }
            });

            function capNhatTienThua() {
                let raw = $("#tienKhachDua").val().replace(/[^0-9]/g, "");
                if (raw === "") raw = "0";
                let tienKhachDua = parseInt(raw) || 0;

                let tongTienThanhToan = 0;
                if (hoaDonHienTai && typeof hoaDonHienTai.tongTien !== "undefined") {
                    let phiVanChuyen = hoaDonHienTai.phiVanChuyen || 0;
                    let giamGia = hoaDonHienTai.giamGia || 0;
                    tongTienThanhToan = hoaDonHienTai.tongTien + phiVanChuyen - giamGia;
                    if (tongTienThanhToan < 0) tongTienThanhToan = 0;
                } else {
                    let tongTienText = $("#tongTienThanhToan").text().replace(/[^\d]/g, "");
                    tongTienThanhToan = parseInt(tongTienText) || 0;
                }

                if (tienKhachDua < tongTienThanhToan) {
                    $("#tienThua").text("0 VNĐ");
                    $("#tienKhachDua").addClass("is-invalid");
                    $("#tienKhachDua").closest('.mb-3').find('small.text-muted').text("Số tiền khách đưa phải lớn hơn hoặc bằng tổng tiền!");
                } else {
                    let tienThua = tienKhachDua - tongTienThanhToan;
                    $("#tienThua").text(formatCurrency(tienThua));
                    $("#tienKhachDua").removeClass("is-invalid");
                    $("#tienKhachDua").closest('.mb-3').find('small.text-muted').text("Vui lòng nhập đủ tiền khách đưa!");
                }
            }

            // Hàm tính phí vận chuyển
            function tinhPhiVanChuyen() {
                const districtCode = $('#districtCode').val();
                const wardCode = $('#wardCode').val();
                console.log('districtCode:', districtCode, 'wardCode:', wardCode); // Thêm dòng này
                if (!districtCode || !wardCode) {
                    console.log('Chưa chọn đủ địa chỉ để tính phí vận chuyển');
                    return;
                }

                // Hiển thị loading
                $('#phiVanChuyenRow').removeClass('d-none');
                $('#phiVanChuyenRow .fw-bold').html('<div class="spinner-border spinner-border-sm text-primary" role="status"></div> Đang tính...');

                $.ajax({
                    url: 'https://localhost:7277/api/ghn/shipping-fee',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        FromDistrictId: 0, // Sẽ được set từ server
                        ToDistrictId: parseInt(districtCode),
                        ToWardCode: wardCode,
                    }),
                    success: function(response) {
                        if (response && response.data && typeof response.data.service_fee !== "undefined") {
                            const phiVanChuyen = response.data.service_fee;
                            hoaDonHienTai.phiVanChuyen = phiVanChuyen;

                            // Cập nhật hiển thị
                            $('#phiVanChuyenRow .fw-bold').text(formatCurrency(phiVanChuyen));

                            // Cập nhật tổng tiền thanh toán
                            let tongTienThanhToan = hoaDonHienTai.tongTien + phiVanChuyen - (hoaDonHienTai.giamGia || 0);
                            if (tongTienThanhToan < 0) tongTienThanhToan = 0;
                            $('#tongTienThanhToan').text(formatCurrency(tongTienThanhToan));

                            // Cập nhật vào database
                            if (hoaDonHienTai && hoaDonHienTai.id) {
                                $.ajax({
                                    url: '/HoaDon/UpdateHoaDonCho',
                                    type: 'PUT',
                                    contentType: 'application/json',
                                    data: JSON.stringify({
                                        Id: hoaDonHienTai.id,
                                        HoTen: hoaDonHienTai.khachHang.hoTen || "",
