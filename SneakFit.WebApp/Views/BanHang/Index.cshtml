            // Xử lý form validation
            function initFormValidation() {
                const form = document.getElementById('formThemMoiKH');
                if (form) {
                    form.querySelectorAll('input, select').forEach(input => {
                        input.addEventListener('input', function() {
                            if (this.value.trim() !== '') {
                                this.classList.remove('is-invalid');
                            }
                        });
                    });

                    form.addEventListener('submit', function(event) {
                        let isValid = true;
                        form.querySelectorAll('input[required], select[required]').forEach(input => {
                            if (!input.value.trim()) {
                                input.classList.add('is-invalid');
                                isValid = false;
                            }
                        });
                        if (!isValid) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                    });
                }
            }

            function initDiaChiDropdowns(callback) {
                var $province = $('.province-dropdown');
                var $district = $('.district-dropdown');
                var $ward = $('.ward-dropdown');

                $.ajax({
                    url: 'https://localhost:7277/api/ghn/provinces',
                    type: 'GET',
                    success: function(response) {
                        const provinces = response.data;
                        let options = '<option value=\"\">Chọn Tỉnh/Thành phố</option>';
                        provinces.forEach(function(province) {
                            options += `<option value=\"${province.ProvinceID}\" data-name=\"${province.ProvinceName}\">${province.ProvinceName}</option>`;
                        });
                        $province.html(options);
                        $district.html('<option value=\"\">Chọn Quận/Huyện</option>').prop('disabled', true);
                        $ward.html('<option value=\"\">Chọn Phường/Xã</option>').prop('disabled', true);

                        if (typeof callback === 'function') callback();
                    },
                    error: function(error) {
                        toastr.error('Không thể tải danh sách tỉnh/thành phố');
                        if (typeof callback === 'function') callback();
                    }
                });

                $province.off('change').on('change', function() {
                    const provinceId = $(this).val();
                    const provinceName = $(this).find('option:selected').data('name');
                    $('#modalProvinceName').val(provinceName);
                    $('#modalProvinceCode').val(provinceId);
                    $district.html('<option value=\"\">Chọn Quận/Huyện</option>');
                    $ward.html('<option value=\"\">Chọn Phường/Xã</option>');
                    $('#modalDistrictName').val('');
                    $('#modalDistrictCode').val('');
                    $('#modalWardName').val('');
                    $('#modalWardCode').val('');
                    if (provinceId) {
                        $district.prop('disabled', false);
                        $.ajax({
                            url: 'https://localhost:7277/api/ghn/districts',
                            type: 'GET',
                            success: function(response) {
                                const districts = response.data.filter(d => d.ProvinceID == provinceId);
                                let options = '<option value=\"\">Chọn Quận/Huyện</option>';
                                districts.forEach(function(district) {
                                    options += `<option value=\"${district.DistrictID}\" data-name=\"${district.DistrictName}\">${district.DistrictName}</option>`;
                                });
                                $district.html(options);
                                $district.trigger('ajaxDistrictLoaded');
                            }
                        });
                    } else {
                        $district.prop('disabled', true);
                        $ward.prop('disabled', true);
                    }
                });

                $district.off('change').on('change', function() {
                    const districtId = $(this).val();
                    const districtName = $(this).find('option:selected').data('name');
                    $('#modalDistrictName').val(districtName);
                    $('#modalDistrictCode').val(districtId);
                    $ward.html('<option value=\"\">Chọn Phường/Xã</option>');
                    $('#modalWardName').val('');
                    $('#modalWardCode').val('');
                    if (districtId) {
                        $ward.prop('disabled', false);
                        $.ajax({
                            url: `https://localhost:7277/api/ghn/wards/${districtId}`,
                            type: 'GET',
                            success: function(response) {
                                const wards = response.data;
                                let options = '<option value=\"\">Chọn Phường/Xã</option>';
                                wards.forEach(function(ward) {
                                    options += `<option value=\"${ward.WardCode}\" data-name=\"${ward.WardName}\">${ward.WardName}</option>`;
                                });
                                $ward.html(options);
                                $ward.trigger('ajaxWardLoaded');
                            }
                        });
                    } else {
                        $ward.prop('disabled', true);
                    }
                });

                $ward.off('change').on('change', function() {
                    const wardName = $(this).find('option:selected').data('name');
                    const wardCode = $(this).val();
                    $('#modalWardName').val(wardName || '');
                    $('#modalWardCode').val(wardCode || '');
                });
            }

