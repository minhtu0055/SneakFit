            function selectVoucher(element) {
                $('.voucher-item').removeClass('selected');
                $('.voucher-item .radio-btn').removeClass('selected');
                $('.voucher-item input[type=radio]').prop('checked', false);
                $(element).addClass('selected');
                $(element).find('.radio-btn').addClass('selected');
                $(element).find('input[type=radio]').prop('checked', true);

                let maVoucher = $(element).data('voucher');
                let voucherId = $(element).data('id');
                hoaDonHienTai.maVoucherDaChon = maVoucher;
                hoaDonHienTai.voucherId = voucherId;
                // Lấy thông tin giảm giá từ data attribute
                let voucher = {
                    loaiGiamGia: parseInt($(element).data('loaigiamgia')),
                    giaTriGiamGia: parseInt($(element).data('giatri')) || 0,
                    dieuKienApDung: parseInt($(element).data('dieukienapdung')) || 0,
                    giaTriToiDa: parseInt($(element).data('giatritoida')) || 0
                };

                // Tính giảm giá thực tế
                let tongTien = hoaDonHienTai.tongTien || 0;
                let giamGia = 0;
                if (tongTien >= voucher.dieuKienApDung) {
                    if (voucher.loaiGiamGia === 0) {
                        giamGia = Math.floor(tongTien * voucher.giaTriGiamGia / 100);
                    } else {
                        giamGia = voucher.giaTriGiamGia;
                    }
                    // Áp dụng giá trị tối đa nếu có
                    if (voucher.giaTriToiDa > 0) {
                        giamGia = Math.min(giamGia, voucher.giaTriToiDa);
                    }
                }
                hoaDonHienTai.giamGia = giamGia;

                    // Hiển thị giá trị giảm giá trong modal
            $('#giamGiaValue').text(formatCurrency(giamGia));

            // Hiển thị thông báo voucher đã áp dụng
            if (giamGia > 0) {
                let voucherName = $(element).find('.voucher-code').text();
                let discountText = voucher.loaiGiamGia === 0 ? voucher.giaTriGiamGia + '%' : formatCurrency(voucher.giaTriGiamGia);
                let minOrderText = formatCurrency(voucher.dieuKienApDung);

                $('#voucherName').text(voucherName);
                $('#voucherDiscountValue').text(discountText);
                $('#voucherMinOrder').text(minOrderText);
                $('#voucherAppliedNotification').removeClass('d-none');
            } else {
                $('#voucherAppliedNotification').addClass('d-none');
            }

        // Cập nhật tổng tiền thanh toán trong modal
        let phiVanChuyen = hoaDonHienTai.phiVanChuyen || 0;
        let tongTienThanhToan = tongTien + phiVanChuyen - giamGia;
        if (tongTienThanhToan < 0) tongTienThanhToan = 0;
