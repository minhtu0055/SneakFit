@using SneakFit.Data.Enums
@model List<SneakFit.ViewModels.Catalog.HoaDonChiTiet.HoaDonChiTietViewModel>

@{
    ViewData["Title"] = "Bán hàng tại quầy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="hoa-don-tabs">
            <ul class="nav nav-pills" id="hoaDonTabs"></ul>
        </div>
        <div>
            <button id="btnTaoHoaDon" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Tạo hóa đơn
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin hóa đơn</h5>
                    <button id="btnThemSanPham" class="btn btn-primary btn-sm">
                        <i class="bx bx-plus me-1"></i> Thêm sản phẩm
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="hoaDonChiTietTable">
                                <tr class="no-data">
                                    <td colspan="6" class="text-center">Không có sản phẩm nào trong giỏ</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end"><strong>Tổng tiền:</strong></td>
                                    <td colspan="2"><span id="tongTien">0 VNĐ</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin khách hàng</h5>
                    <div class="d-flex align-items-center gap-3">
                        <span id="selectedCustomerTag" class="badge bg-danger d-none">
                            <span id="selectedCustomerName"></span>
                            <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.6em;" id="removeCustomer"></button>
                        </span>
                        <div class="position-relative">
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm" id="searchKhachHang" placeholder="Tìm kiếm theo tên hoặc số điện thoại..." style="width: 250px;" />
                                <button class="btn btn-outline-primary btn-sm" type="button" id="btnTimKiemKH">
                                    <i class="bx bx-search"></i>
                                </button>
                            </div>
                            <div id="ketQuaTimKiemKH" class="position-absolute w-100 bg-white shadow-sm rounded mt-1 d-none" style="z-index: 1000; max-height: 200px; overflow-y: auto;"></div>
                        </div>
                        <button id="btnThemMoiKH" class="btn btn-primary btn-sm">
                            <i class="bx bx-plus me-1"></i> Thêm mới KH
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <form id="formKhachHang">
                        <input type="hidden" id="khachHangId" name="khachHangId" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex align-items-center">
                                    <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Tên khách hàng:</label>
                                    <div id="customerName" class="form-control-plaintext">Khách hàng lẻ</div>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="customerEmailRow">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex align-items-center">
                                    <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Email:</label>
                                    <div id="customerEmail" class="form-control-plaintext">-</div>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="customerPhoneRow">
                            <div class="col-md-6">
                                <div class="mb-3 d-flex align-items-center">
                                    <label class="form-label fw-bold mb-0 me-3" style="min-width: 120px;">Số điện thoại:</label>
                                    <div id="customerPhone" class="form-control-plaintext">-</div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Thông tin thanh toán</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div id="giaoHangDiaChiSection">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Họ Và Tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="hoVaTen" placeholder="Họ Và Tên">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="soDienThoai" placeholder="Số điện thoại">
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label fw-bold">Thành phố/Tỉnh <span class="text-danger">*</span></label>
                                        <select id="province" class="form-select" required>
                                            <option value="">Chọn Tỉnh/Thành phố</option>
                                        </select>
                                        <input type="hidden" id="provinceName" />
                                        <input type="hidden" id="provinceCode" />
                                        <span class="invalid-feedback">Vui lòng chọn tỉnh/thành phố</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <label class="form-label fw-bold">Quận/Huyện <span class="text-danger">*</span></label>
                                        <select id="district" class="form-select" required disabled>
                                            <option value="">Chọn Quận/Huyện</option>
                                        </select>
                                        <input type="hidden" id="districtName" />
                                        <input type="hidden" id="districtCode" />
                                        <span class="invalid-feedback">Vui lòng chọn quận/huyện</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-12">    
                                        <label class="form-label fw-bold">Phường/Xã <span class="text-danger">*</span></label>
                                        <select id="ward" class="form-select" required disabled>
                                            <option value="">Chọn Phường/Xã</option>
                                        </select>
                                        <input type="hidden" id="wardName" />
                                        <input type="hidden" id="wardCode" />
                                        <span class="invalid-feedback">Vui lòng chọn phường/xã</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Địa chỉ cụ thể</label>
                                    <input type="text" class="form-control" id="diaChiCuThe" placeholder="Địa chỉ cụ thể">
                                </div>
                                <div class="d-flex align-items-center mt-4">
                                    <img src="#" alt="GHN" class="me-2">
                                    <span class="fw-bold">GIAO HÀNG NHANH TOÀN QUỐC</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-2" id="giaoHangToggleRow">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="toggleGiaoHang">
                                    <label class="form-check-label fw-bold" for="toggleGiaoHang">Giao hàng</label>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-4">
                                <i class="bx bx-discount text-primary"></i>
                                <span class="fw-bold">Phiếu giảm giá</span>
                                <a href="#" class="text-primary text-decoration-none"> Chọn hoặc nhập mã <i class="bx bx-chevron-right"></i></a>
                            </div>
                            <div class="border-0 mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tạm tính:</span>
                                    <span class="fw-bold tam-tinh-value">0 VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 d-none" id="phiVanChuyenRow">
                                    <span>Phí vận chuyển (tạm tính):</span>
                                    <span class="fw-bold">0 VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Giảm giá:</span>
                                    <span class="fw-bold">0 VNĐ</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="fw-bold" title="Tổng tiền = Tạm tính + Phí vận chuyển (nếu có) - Giảm giá (nếu có)">Tổng tiền:</span>
                                    <span class="fw-bold text-danger fs-5" id="tongTienThanhToan">0 VNĐ</span>
                                </div>
                                <div class="mb-3 tien-mat-fields">
                                    <label class="form-label fw-bold">Tiền khách đưa:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="tienKhachDua" placeholder="VND" inputmode="numeric">
                                    </div>
                                    <small class="text-muted">Vui lòng nhập đủ tiền khách đưa!</small>
                                </div>
                                <div class="d-flex justify-content-between mb-3 tien-mat-fields">
                                    <span class="fw-bold">Tiền thừa:</span>
                                    <span class="fw-bold" id="tienThua">0 VNĐ</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Chọn phương thức thanh toán:</label>
                                <div class="border rounded p-3 mb-2" style="border-color: #ffc107 !important; background-color: #fff9e6;">
                                    <div class="d-flex align-items-center">
                                        <input class="form-check-input me-3" type="radio" name="paymentMethod" id="tienMat" checked>
                                        <div class="bg-warning rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bx bx-money text-white"></i>
                                        </div>
                                        <label class="form-check-label fw-bold" for="tienMat">Tiền mặt</label>
                                    </div>
                                </div>
                                <div class="border rounded p-3 mb-2">
                                    <div class="d-flex align-items-center">
                                        <input class="form-check-input me-3" type="radio" name="paymentMethod" id="chuyenKhoan">
                                        <div class="bg-primary rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bx bx-credit-card text-white"></i>
                                        </div>
                                        <label class="form-check-label fw-bold" for="chuyenKhoan">Chuyển khoản</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <textarea class="form-control" rows="3" placeholder="Nhập ghi chú..."></textarea>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="fw-bold">Chờ thanh toán</span>
                                <div class="form-check form-switch">
                                    <input class="form-check-input bg-secondary" type="checkbox" id="choThanhToan">
                                </div>
                            </div>
                            <button class="btn btn-warning w-100 fw-bold py-2">Thanh toán</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalThemSanPham" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm sản phẩm vào hóa đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="input-group">
                            <input type="text" class="form-control" id="searchSanPham" placeholder="Tìm kiếm sản phẩm..." />
                            <button class="btn btn-outline-primary" type="button" id="btnTimKiem">
                                <i class="bx bx-search"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Giá bán</th>
                                    <th>Số lượng tồn</th>
                                    <th>Kích thước</th>
                                    <th>Màu sắc</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="danhSachSanPham"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="text-muted">
                            Hiển thị <span id="currentPageInfo">0-0</span> của <span id="totalRecords">0</span> sản phẩm
                        </div>
                        <nav aria-label="Phân trang sản phẩm">
                            <ul class="pagination pagination-sm mb-0" id="paginationSanPham"></ul>
                        </nav>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let danhSachHoaDon = [];
        let hoaDonHienTai = null;
        const MAX_HOA_DON = 5;
        let currentPage = 1;
        let pageSize = 10;
        let totalRecords = 0;
        let pageCount = 0;
        let currentKeyword = "";

        $(document).ready(function () {
            // Initialize events
            $("#btnTaoHoaDon").click(taoHoaDonMoi);
            $("#btnThemSanPham").click(function () {
                if (!hoaDonHienTai) {
                    toastr.warning("Vui lòng tạo hóa đơn trước khi thêm sản phẩm");
                    return;
                }
                currentPage = 1;
                loadDanhSachSanPham();
                $("#modalThemSanPham").modal("show");
            });

            $("#btnTimKiem").click(function () {
                currentKeyword = $("#searchSanPham").val();
                currentPage = 1;
                loadDanhSachSanPham();
            });

            $("#searchSanPham").keypress(function (e) {
                if (e.which === 13) {
                    currentKeyword = $(this).val();
                    currentPage = 1;
                    loadDanhSachSanPham();
                }
            });

            $("#modalThemSanPham").on("hidden.bs.modal", function () {
                currentPage = 1;
                currentKeyword = "";
                $("#searchSanPham").val("");
            });

            // Payment method toggle
            $('input[name="paymentMethod"]').change(function () {
                if ($('#chuyenKhoan').is(':checked')) {
                    $('.tien-mat-fields').hide();
                } else {
                    $('.tien-mat-fields').show();
                }
            });
            // Initialize visibility on page load
            if ($('#chuyenKhoan').is(':checked')) {
                $('.tien-mat-fields').hide();
            } else {
                $('.tien-mat-fields').show();
            }

            // Ẩn/hiện địa chỉ giao hàng theo trạng thái checkbox
            function toggleGiaoHangDiaChi() {
                if ($('#toggleGiaoHang').is(':checked')) {
                    $('#giaoHangDiaChiSection').show();
                    $('#phiVanChuyenRow').removeClass('d-none');
                    if (hoaDonHienTai && hoaDonHienTai.khachHang && hoaDonHienTai.khachHang.id) {
                        $.ajax({
                            url: '/BanHang/GetDiaChiByUser',
                            type: 'GET',
                            data: { userId: hoaDonHienTai.khachHang.id },
                            success: function(response) {
                                if (response && response.isSuccessed && response.resultObj && response.resultObj.length > 0) {
                                    // Tìm địa chỉ mặc định
                                    var diaChiMacDinh = response.resultObj.find(dc => dc.isDefault === true || dc.macDinh === true);
                                    if (diaChiMacDinh) {
                                        // Fill thông tin vào form
                                        $('#hoVaTen').val(diaChiMacDinh.tenNguoiNhan || '');
                                        $('#soDienThoai').val(diaChiMacDinh.soDienThoai || '');
                                        $('#diaChiCuThe').val(diaChiMacDinh.tenDiaChi || '');

                                        // Set province, district, ward
                                        $('#province').val(diaChiMacDinh.maTinh).trigger('change');

                                        // Khi load xong district (trong success của AJAX load district)
                                        $('#district').one('ajaxDistrictLoaded', function() {
                                            $('#district').val(diaChiMacDinh.maHuyen).trigger('change');
                                            $('#ward').one('ajaxWardLoaded', function() {
                                                $('#ward').val(diaChiMacDinh.maXa).trigger('change');
                                            });
                                        });

                                        $('#provinceName').val(diaChiMacDinh.tenThanhPho || '');
                                        $('#provinceCode').val(diaChiMacDinh.maTinh || '');
                                        $('#districtName').val(diaChiMacDinh.tenHuyen || '');
                                        $('#districtCode').val(diaChiMacDinh.maHuyen || '');
                                        $('#wardName').val(diaChiMacDinh.tenXa || '');
                                        $('#wardCode').val(diaChiMacDinh.maXa || '');
                                    }
                                }
                            }
                        });
                    }
                } else {
                    $('#giaoHangDiaChiSection').hide();
                    $('#phiVanChuyenRow').addClass('d-none');
                }
            }
            // Khi bật/tắt giao hàng
            $('#toggleGiaoHang').change(function() {
            if (hoaDonHienTai) {
                hoaDonHienTai.isGiaoHang = $(this).is(':checked');
                // Gọi API cập nhật trường GiaoHang cho hóa đơn chờ
                $.ajax({
                    url: '/HoaDon/UpdateHoaDonCho',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({
                    Id: hoaDonHienTai.id,
                    HoTen: hoaDonHienTai.khachHang.hoTen || "",
                    SoDienThoai: hoaDonHienTai.khachHang.soDienThoai || "",
                    Email: hoaDonHienTai.khachHang.email || "",
                    UserId: hoaDonHienTai.khachHang.id || null,
                    TongTien: hoaDonHienTai.tongTien,
                    TrangThai: hoaDonHienTai.trangThai || 0,
                    DiaChi: hoaDonHienTai.diaChi || "",
                    GhiChu: hoaDonHienTai.ghiChu || "",
                    PhuongThucThanhToan: hoaDonHienTai.phuongThucThanhToan || 1,
                    LoaiHoaDon: hoaDonHienTai.loaiHoaDon || 2,
                    NgayThanhToan: hoaDonHienTai.ngayThanhToan || null,
                    MaHoaDon: hoaDonHienTai.tenHoaDon || "",
                    PhiVanChuyen: hoaDonHienTai.phiVanChuyen || 0,
                    TrangThaiThanhToan: hoaDonHienTai.trangThaiThanhToan || 1,
                    VoucherId: hoaDonHienTai.voucherId || null,
                    GiaoHang: hoaDonHienTai.isGiaoHang || false
                }),
                    success: function(res) {
                        if (res && res.success) {
                            toastr.success("Cập nhật trạng thái giao hàng thành công!");
                            // Tính phí vận chuyển nếu bật giao hàng
                            if (hoaDonHienTai.isGiaoHang) {
                                tinhPhiVanChuyen();
                            }
                        } else {
                            toastr.error(res.message || "Cập nhật trạng thái giao hàng thất bại!");
                        }
                    },
                    error: function(xhr) {
                        toastr.error("Lỗi khi cập nhật trạng thái giao hàng: " + (xhr.responseJSON?.message || xhr.statusText));
                    }
                });
            }
            toggleGiaoHangDiaChi();
        });
            // Khi nhập địa chỉ giao hàng
            $('#hoVaTen, #soDienThoai, #province, #district, #ward, #diaChiCuThe').on('change input', function() {
                if (hoaDonHienTai) {
                    hoaDonHienTai.diaChiGiaoHang = {
                        hoVaTen: $('#hoVaTen').val(),
                        soDienThoai: $('#soDienThoai').val(),
                        province: $('#province').val(),
                        provinceName: $('#provinceName').val(),
                        district: $('#district').val(),
                        districtName: $('#districtName').val(),
                        ward: $('#ward').val(),
                        wardName: $('#wardName').val(),
                        diaChiCuThe: $('#diaChiCuThe').val()
                    };
                    
                    // Tính phí vận chuyển khi thay đổi địa chỉ và đang bật giao hàng
                    // if (hoaDonHienTai.isGiaoHang && $('#district').val() && $('#ward').val()) {
                    //     tinhPhiVanChuyen();
                    // }
                }
            });
            toggleGiaoHangDiaChi(); // Khởi tạo trạng thái ban đầu

            loadHoaDonCho();
        });

        function taoHoaDonMoi() {
            if (danhSachHoaDon.length >= MAX_HOA_DON) {
                toastr.warning(`Bạn chỉ có thể tạo tối đa ${MAX_HOA_DON} hóa đơn chờ`);
                return;
            }

            const khachHangId = $("#khachHangId").val();
            const hoTen = $("#customerName").text() || "Khách hàng lẻ";
            const soDienThoai = $("#customerPhone").text() !== "-" ? $("#customerPhone").text() : null;
            const email = $("#customerEmail").text() !== "-" ? $("#customerEmail").text() : null;
            const diaChi = $("#diaChiCuThe").val() || null;

            const hoaDonRequest = {
                tongTien: 0,
                trangThai: 0, // ChoXacNhan
                userId: khachHangId || null,
                diaChi: diaChi,
                soDienThoai: soDienThoai,
                email: email,
                hoTen: hoTen,
                ghiChu: null,
                phuongThucThanhToan: 1, // Tiền mặt
                loaiHoaDon: 2, // TaiQuay
                ngayThanhToan: null,
                phiVanChuyen: 0,
                trangThaiThanhToan: 1, // ChuaThanhToan
                voucherId: null
            };

            const $btn = $("#btnTaoHoaDon");
            $btn.prop("disabled", true).html('<i class="bx bx-loader-alt bx-spin"></i> Đang tạo...');

            $.ajax({
                url: '/HoaDon/CreateHoaDonCho',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(hoaDonRequest),
                success: function (result) {
                    $btn.prop("disabled", false).html('<i class="bx bx-plus me-1"></i> Tạo hóa đơn');
                    
                    if (result && result.id && result.maHoaDon) {
                        const hoaDonMoi = {
                            id: result.id,
                            tenHoaDon: result.maHoaDon, // Hiển thị MaHoaDon
                            sanPham: [],
                            tongTien: result.tongTien,
                            khachHang: {
                                id: khachHangId || null,
                                hoTen: hoTen || '',
                                soDienThoai: soDienThoai || '',
                                email: email || ''
                            }
                        };
                        
                        danhSachHoaDon.push(hoaDonMoi);
                        hoaDonHienTai = hoaDonMoi;
                        capNhatTabHoaDon();
                        capNhatHoaDonHienTai();
                        
                        // RESET thông tin khách hàng trên giao diện
                        resetKhachHang();
                        toastr.success("Tạo hóa đơn chờ thành công!");

                        // Reset tiền khách đưa và tiền thừa khi tạo hóa đơn mới
                        $("#tienKhachDua").val("");
                        $("#tienThua").text("0 VNĐ");
                        $("#tienKhachDua").removeClass("is-invalid");
                        $("#tienKhachDua").closest('.mb-3').find('small.text-muted').text("Vui lòng nhập đủ tiền khách đưa!");
                    } else {
                        toastr.error("Tạo hóa đơn thất bại!");
                    }
                },
                error: function (xhr) {
                    $btn.prop("disabled", false).html('<i class="bx bx-plus me-1"></i> Tạo hóa đơn');
                    toastr.error("Lỗi khi tạo hóa đơn: " + (xhr.responseJSON?.message || xhr.statusText));
                }
            });
        }

        function capNhatTabHoaDon() {
            const tabContainer = $("#hoaDonTabs").empty();
            danhSachHoaDon.forEach((hoaDon, index) => {
                const isActive = hoaDon.id === hoaDonHienTai.id;
                const tabItem = `
                    <li class="nav-item">
                        <a class="nav-link ${isActive ? 'active' : ''}"  data-hoadon-id="${hoaDon.id}">
                            ${hoaDon.tenHoaDon}
                            <button class="btn-close btn-close-white ms-2 btn-xoa-hoadon" data-hoadon-id="${hoaDon.id}" style="font-size: 0.5rem;"></button>
                        </a>
                    </li>
                `;
                tabContainer.append(tabItem);
            });

            $(".nav-link").click(function (e) {
                if (!$(e.target).hasClass('btn-xoa-hoadon')) {
                    const hoaDonId = $(this).data("hoadon-id");
                    chuyenHoaDon(hoaDonId);
                }
            });

            $(".btn-xoa-hoadon").click(function (e) {
                e.stopPropagation();
                const hoaDonId = $(this).data("hoadon-id");
                xoaHoaDon(hoaDonId);
            });
        }

        // Switch between invoices
        function chuyenHoaDon(hoaDonId) {
            const hoaDon = danhSachHoaDon.find(hd => hd.id === hoaDonId);
            if (hoaDon) {
                hoaDonHienTai = hoaDon;
                // Lưu id vào localStorage
                localStorage.setItem('hoaDonHienTaiId', hoaDonId);
                capNhatTabHoaDon();
                capNhatHoaDonHienTai();
            }
        }

        function loadHoaDonCho() {
            $.ajax({
                url: '/HoaDon/GetHoaDonCho',
                type: 'GET',
                success: function (result) {
                    if (result && result.length > 0) {
                        // Lấy chi tiết sản phẩm cho từng hóa đơn
                        let promises = result.map(hd =>
                            $.ajax({
                                url: '/HoaDonChiTiet/GetByHoaDonId',
                                type: 'GET',
                                data: { id: hd.id }
                            }).then(spList => ({
                                id: hd.id,
                                tenHoaDon: hd.maHoaDon,
                                sanPham: spList,
                                tongTien: hd.tongTien,
                                khachHang: {
                                    id: hd.userId,
                                    hoTen: hd.hoTen || '',
                                    soDienThoai: hd.soDienThoai || '',
                                    email: hd.email || ''
                                },
                                isGiaoHang: hd.giaoHang,
                                diaChiGiaoHang: {
                                hoVaTen: hd.tenNguoiNhan,
                                soDienThoai: hd.soDienThoai,
                                province: hd.maTinh,
                                provinceName: hd.tenThanhPho,
                                district: hd.maHuyen,
                                districtName: hd.tenHuyen,
                                ward: hd.maXa,
                                wardName: hd.tenXa,
                                diaChiCuThe: hd.tenDiaChi
                            }
                            }))
                        );
                       
                        Promise.all(promises).then(list => {
                            danhSachHoaDon = list; // Không map lại nữa!
                            let hoaDonIdDaLuu = localStorage.getItem('hoaDonHienTaiId');
                            if (hoaDonIdDaLuu) {
                                hoaDonHienTai = danhSachHoaDon.find(hd => hd.id === hoaDonIdDaLuu) || danhSachHoaDon[0];
                            } else {
                                hoaDonHienTai = danhSachHoaDon[0];
                            }
                            capNhatTabHoaDon();
                            capNhatHoaDonHienTai();
                            toastr.success("Đã tải " + danhSachHoaDon.length + " hóa đơn chờ");
                        });
                    } else {
                        taoHoaDonMoi();
                    }
                },
                error: function (xhr) {
                    console.error("Lỗi khi tải hóa đơn chờ:", xhr);
                    taoHoaDonMoi();
                }
            });
        }

        // Delete invoice
        function xoaHoaDon(hoaDonId) {
            if (danhSachHoaDon.length <= 1) {
                toastr.warning("Phải có ít nhất một hóa đơn");
                return;
            }

            Swal.fire({
                title: 'Xác nhận xóa',
                text: "Bạn có chắc chắn muốn xóa hóa đơn này?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gọi API xóa hóa đơn trên server
                    $.ajax({
                        url: '/HoaDon/DeleteHoaDonCho?id=' + hoaDonId,
                        type: 'DELETE',
                        success: function (res) {
                            if (res && res.success) {
                                danhSachHoaDon = danhSachHoaDon.filter(hd => hd.id !== hoaDonId);
                                if (hoaDonHienTai.id === hoaDonId) {
                                    hoaDonHienTai = danhSachHoaDon[0];
                                }
                                capNhatTabHoaDon();
                                capNhatHoaDonHienTai();
                                toastr.success("Xóa hóa đơn thành công");
                            } else {
                                toastr.error(res.message || "Xóa hóa đơn thất bại!");
                            }
                        },
                        error: function (xhr) {
                            toastr.error("Lỗi khi xóa hóa đơn: " + (xhr.responseJSON?.message || xhr.statusText));
                        }
                    });
                }
            });
        }

        function capNhatHoaDonHienTai() {
            if (!hoaDonHienTai) return;

            $("#customerName").text(hoaDonHienTai.khachHang.hoTen || "Khách hàng lẻ");
            $("#customerPhone").text(hoaDonHienTai.khachHang.soDienThoai || "-");
            $("#customerEmail").text(hoaDonHienTai.khachHang.email || "-");
            // $("#khachHangId").val(hoaDonHienTai.khachHang.id || "");

            const tableBody = $("#hoaDonChiTietTable").empty();
            if (hoaDonHienTai.sanPham.length === 0) {
                tableBody.append('<tr class="no-data"><td colspan="6" class="text-center">Không có sản phẩm nào trong giỏ</td></tr>');
            } else {
                hoaDonHienTai.sanPham.forEach((sp, index) => {
                    const row = `
                        <tr>
                            <td>${index + 1}</td>
                            <td>
                                <div>
                                    <div class="fw-bold">${sp.tenSanPham}</div>
                                    <small class="text-muted">${sp.kichThuoc} - ${sp.mauSac}</small>
                                </div>
                            </td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary btn-giam-sl" data-index="${index}" data-hoa-don-chi-tiet-id="${sp.id}">-</button>
                                    <input type="number" class="form-control text-center input-so-luong" value="${sp.soLuong}" min="1" max="${sp.soLuongTon || 999}" data-index="${index}" data-hoa-don-chi-tiet-id="${sp.id}">
                                    <button class="btn btn-outline-secondary btn-tang-sl" data-index="${index}" data-hoa-don-chi-tiet-id="${sp.id}">+</button>
                                </div>
                                <small class="text-muted">Tồn: ${sp.soLuongTon || 0}</small>
                            </td>
                            <td>${formatCurrency(sp.giaBan)}</td>
                            <td>${formatCurrency(sp.giaBan * sp.soLuong)}</td>
                            <td>
                                <button class="btn btn-sm btn-danger btn-xoa-sp" data-index="${index}" data-hoa-don-chi-tiet-id="${sp.id}">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    tableBody.append(row);
                });

                $(".btn-giam-sl").click(function () {
                    const index = $(this).data("index");
                    const id = $(this).data("hoa-don-chi-tiet-id");
                    giamSoLuong(index, id);
                });

                $(".btn-tang-sl").click(function () {
                    const index = $(this).data("index");
                    const id = $(this).data("hoa-don-chi-tiet-id");
                    tangSoLuong(index, id);
                });

                $(".input-so-luong").change(function () {
                    const index = $(this).data("index");
                    const id = $(this).data("hoa-don-chi-tiet-id");
                    const soLuong = parseInt($(this).val());
                    capNhatSoLuong(index, soLuong, id);
                });

                $(".btn-xoa-sp").click(function () {
                    const index = $(this).data("index");
                    const hoaDonChiTietId = $(this).data("hoa-don-chi-tiet-id");
                    xoaSanPham(index, hoaDonChiTietId);
                });
            }

            let tongTien = 0;
            if (hoaDonHienTai.sanPham && hoaDonHienTai.sanPham.length > 0) {
                hoaDonHienTai.sanPham.forEach(sp => {
                    tongTien += sp.giaBan * sp.soLuong;
                });
            }
            hoaDonHienTai.tongTien = tongTien;
            $("#tongTien").text(formatCurrency(tongTien));
            $(".tam-tinh-value").text(formatCurrency(tongTien));

            if (hoaDonHienTai.khachHang.id) {
                // Có khách hàng thực sự
                $("#selectedCustomerName").text(hoaDonHienTai.khachHang.hoTen);
                $("#selectedCustomerTag").removeClass("d-none");
                $("#customerPhoneRow, #customerEmailRow").show();
                $("#giaoHangToggleRow").removeClass("d-none");
            } else {
                // Khách hàng lẻ
                $("#selectedCustomerName").text("");
                $("#selectedCustomerTag").addClass("d-none");
                $("#customerPhoneRow, #customerEmailRow").hide();
                $("#giaoHangToggleRow").addClass("d-none");
                $("#giaoHangDiaChiSection").hide();
                $("#toggleGiaoHang").prop("checked", false);
                $("#phiVanChuyenRow").addClass("d-none");
            }

            // Lấy phí vận chuyển và giảm giá (nếu có)
            let phiVanChuyen = hoaDonHienTai.phiVanChuyen || 0;
            let giamGia = hoaDonHienTai.giamGia || 0;

            // Tổng tiền thanh toán cuối cùng
            let tongTienThanhToan = tongTien + phiVanChuyen - giamGia;
            if (tongTienThanhToan < 0) tongTienThanhToan = 0;

            $("#tongTienThanhToan").text(formatCurrency(tongTienThanhToan));

            capNhatTienThua();

            // RESET các trường địa chỉ giao hàng trước khi fill mới
            $('#hoVaTen').val('');
            $('#soDienThoai').val('');
            $('#province').val('').trigger('change');
            $('#district').html('<option value=\"\">Chọn Quận/Huyện</option>').prop('disabled', true);
            $('#ward').html('<option value=\"\">Chọn Phường/Xã</option>').prop('disabled', true);
            $('#diaChiCuThe').val('');
            $('#provinceName').val('');
            $('#provinceCode').val('');
            $('#districtName').val('');
            $('#districtCode').val('');
            $('#wardName').val('');
            $('#wardCode').val('');

            // Set lại trạng thái checkbox giao hàng
            $('#toggleGiaoHang').prop('checked', hoaDonHienTai.isGiaoHang || false);

            // Nếu isGiaoHang == true thì show địa chỉ giao hàng
            if (hoaDonHienTai.isGiaoHang) {
                $('#giaoHangDiaChiSection').show();
                $('#phiVanChuyenRow').removeClass('d-none');
                // Fill lại địa chỉ giao hàng nếu có
                if (hoaDonHienTai.diaChiGiaoHang) {
                    $('#hoVaTen').val(hoaDonHienTai.diaChiGiaoHang.hoVaTen || '');
                    $('#soDienThoai').val(hoaDonHienTai.diaChiGiaoHang.soDienThoai || '');
                    $('#province').val(hoaDonHienTai.diaChiGiaoHang.province || '').trigger('change');
                    $('#district').one('ajaxDistrictLoaded', function() {
                        $('#district').val(hoaDonHienTai.diaChiGiaoHang.district).trigger('change');
                        $('#ward').one('ajaxWardLoaded', function() {
                            $('#ward').val(hoaDonHienTai.diaChiGiaoHang.ward).trigger('change');
                        });
                    });
                    $('#provinceName').val(hoaDonHienTai.diaChiGiaoHang.provinceName || '');
                    $('#provinceCode').val(hoaDonHienTai.diaChiGiaoHang.province || '');
                    $('#districtName').val(hoaDonHienTai.diaChiGiaoHang.districtName || '');
                    $('#districtCode').val(hoaDonHienTai.diaChiGiaoHang.district || '');
                    $('#wardName').val(hoaDonHienTai.diaChiGiaoHang.wardName || '');
                    $('#wardCode').val(hoaDonHienTai.diaChiGiaoHang.ward || '');
                    $('#diaChiCuThe').val(hoaDonHienTai.diaChiGiaoHang.diaChiCuThe || '');
                }
            } else {
                $('#giaoHangDiaChiSection').hide();
                $('#phiVanChuyenRow').addClass('d-none');
            }
        }

        // Increase product quantity
        function tangSoLuong(index, hoaDonChiTietId) {
            let sp = hoaDonHienTai.sanPham[index];
            let newQuantity = sp.soLuong + 1;
            $.ajax({
                url: '/HoaDonChiTiet/UpdateQuantity',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ hoaDonChiTietId: hoaDonChiTietId, newQuantity: newQuantity }),
                success: function (res) {
                    if (res && res.success) {
                        loadChiTietHoaDonHienTai();
                        toastr.success("Cập nhật số lượng thành công");
                    } else {
                        toastr.error(res.message || "Cập nhật số lượng thất bại");
                    }
                },
                error: function (xhr) {
                    toastr.error("Lỗi khi cập nhật số lượng: " + (xhr.responseJSON?.message || xhr.statusText));
                }
            });
        }

        // Decrease product quantity
        function giamSoLuong(index, hoaDonChiTietId) {
            let sp = hoaDonHienTai.sanPham[index];
            if (sp.soLuong <= 1) return;
            let newQuantity = sp.soLuong - 1;
            $.ajax({
                url: '/HoaDonChiTiet/UpdateQuantity',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ hoaDonChiTietId: hoaDonChiTietId, newQuantity: newQuantity }),
                success: function (res) {
                    if (res && res.success) {
                        loadChiTietHoaDonHienTai();
                        toastr.success("Cập nhật số lượng thành công");
                    } else {
                        toastr.error(res.message || "Cập nhật số lượng thất bại");
                    }
                },
                error: function (xhr) {
                    toastr.error("Lỗi khi cập nhật số lượng: " + (xhr.responseJSON?.message || xhr.statusText));
                }
            });
        }

        // Update product quantity
        function capNhatSoLuong(index, soLuong, hoaDonChiTietId) {
            if (soLuong < 1) soLuong = 1;
            $.ajax({
                url: '/HoaDonChiTiet/UpdateQuantity',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ hoaDonChiTietId: hoaDonChiTietId, newQuantity: soLuong }),
                success: function (res) {
                    if (res && res.success) {
                        loadChiTietHoaDonHienTai();
                        toastr.success("Cập nhật số lượng thành công");
                    } else {
                        toastr.error(res.message || "Cập nhật số lượng thất bại");
                    }
                },
                error: function (xhr) {
                    toastr.error("Lỗi khi cập nhật số lượng: " + (xhr.responseJSON?.message || xhr.statusText));
                }
            });
        }

        // Remove product
        function xoaSanPham(index, hoaDonChiTietId) {
            if (!hoaDonHienTai || !hoaDonHienTai.sanPham[index]) {
                toastr.error("Không tìm thấy sản phẩm để xóa");
                return;
            }

            const sanPham = hoaDonHienTai.sanPham[index];
            
            Swal.fire({
                title: 'Xác nhận xóa',
                text: `Bạn có chắc chắn muốn xóa sản phẩm "${sanPham.tenSanPham}" khỏi hóa đơn?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gọi API xóa hóa đơn chi tiết
                    $.ajax({
                        url: '/HoaDonChiTiet/Delete',
                        type: 'DELETE',
                        data: { id: hoaDonChiTietId },
                        success: function (res) {
                            if (res && res.success) {
                                // Xóa khỏi danh sách local
                                hoaDonHienTai.sanPham.splice(index, 1);
                                tinhTongTien();
                                capNhatHoaDonHienTai();
                                toastr.success("Xóa sản phẩm khỏi hóa đơn thành công");
                            } else {
                                toastr.error(res.message || "Xóa sản phẩm thất bại");
                            }
                        },
                        error: function (xhr) {
                            toastr.error("Lỗi khi xóa sản phẩm: " + (xhr.responseJSON?.message || xhr.statusText));
                        }
                    });
                }
            });
        }

        // Calculate total amount
        function tinhTongTien() {
            hoaDonHienTai.tongTien = hoaDonHienTai.sanPham.reduce((total, sp) => total + (sp.giaBan * sp.soLuong), 0);
            
            // Cập nhật tổng tiền vào database nếu có hóa đơn hiện tại
            if (hoaDonHienTai && hoaDonHienTai.id) {
                $.ajax({
                    url: '/HoaDon/UpdateHoaDonCho',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Id: hoaDonHienTai.id,
                        HoTen: hoaDonHienTai.khachHang.hoTen || "",
                        SoDienThoai: hoaDonHienTai.khachHang.soDienThoai || "",
                        Email: hoaDonHienTai.khachHang.email || "",
                        UserId: hoaDonHienTai.khachHang.id || null,
                        TongTien: hoaDonHienTai.tongTien,
                        TrangThai: hoaDonHienTai.trangThai || 0,
                        DiaChi: hoaDonHienTai.diaChi || "",
                        GhiChu: hoaDonHienTai.ghiChu || "",
                        PhuongThucThanhToan: hoaDonHienTai.phuongThucThanhToan || 1,
                        LoaiHoaDon: hoaDonHienTai.loaiHoaDon || 2,
                        NgayThanhToan: hoaDonHienTai.ngayThanhToan || null,
                        MaHoaDon: hoaDonHienTai.tenHoaDon || "",
                        PhiVanChuyen: hoaDonHienTai.phiVanChuyen || 0,
                        TrangThaiThanhToan: hoaDonHienTai.trangThaiThanhToan || 1,
                        VoucherId: hoaDonHienTai.voucherId || null,
                        GiaoHang: hoaDonHienTai.isGiaoHang || false
                    }),
                    success: function(res) {
                        if (!res || !res.success) {
                            console.warn("Không thể cập nhật tổng tiền hóa đơn:", res?.message);
                        }
                    },
                    error: function(xhr) {
                        console.error("Lỗi khi cập nhật tổng tiền hóa đơn:", xhr.responseJSON?.message || xhr.statusText);
                    }
                });
            }
        }

        // Load product list
        function loadDanhSachSanPham() {
            const tableBody = $("#danhSachSanPham").html('<tr><td colspan="9" class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></td></tr>');

            $.ajax({
                url: '/SPCT/GetSPCTForModal',
                type: 'GET',
                data: { tuKhoa: currentKeyword, pageIndex: currentPage, pageSize: pageSize },
                success: function (response) {
                    tableBody.empty();
                    if (!response.items || response.items.length === 0) {
                        tableBody.append('<tr><td colspan="9" class="text-center">Không tìm thấy sản phẩm nào</td></tr>');
                        updatePaginationInfo(0, 0, 0);
                        return;
                    }

                    totalRecords = response.totalRecords;
                    pageCount = response.pageCount;
                    currentPage = response.pageIndex;

                    response.items.forEach((sp, index) => {
                        let anhSanPham = 'https://via.placeholder.com/50x50?text=No+Image';
                        if (sp.images && sp.images.length > 0) {
                            anhSanPham = sp.images[0].startsWith('http') ? sp.images[0] : `https://localhost:7277${sp.images[0]}`;
                        }
                        const row = `
                            <tr>
                                <td>${(currentPage - 1) * pageSize + index + 1}</td>
                                <td><img src="${anhSanPham}" alt="${sp.tenSanPham}" width="50" height="50" style="object-fit: cover;"></td>
                                <td>${sp.tenSanPham}</td>
                                <td>${formatCurrency(sp.gia)}</td>
                                <td>${sp.soLuong}</td>
                                <td>${sp.tenKichThuoc}</td>
                                <td>${sp.tenMauSac}</td>
                                <td>${sp.trangThai ? '<span class="badge bg-success">Còn hàng</span>' : '<span class="badge bg-danger">Hết hàng</span>'}</td>
                                <td>
                                    <button class="btn btn-sm btn-primary btn-them-vao-hoadon" data-sp-id="${sp.id}" ${sp.trangThai ? '' : 'disabled'}>
                                        <i class="bx bx-plus"></i> Thêm
                                    </button>
                                </td>
                            </tr>
                        `;
                        tableBody.append(row);
                    });

                    $(".btn-them-vao-hoadon").click(function () {
                        const spId = $(this).data("sp-id");
                        const sanPham = response.items.find(sp => sp.id === spId);
                        if (sanPham) {
                            themSanPhamVaoHoaDon(sanPham);
                        }
                    });

                    updatePaginationInfo();
                    createPagination();
                },
                error: function (error) {
                    tableBody.html(`<tr><td colspan="9" class="text-center text-danger">Lỗi khi tải dữ liệu: ${error.statusText}</td></tr>`);
                    console.error('Lỗi khi tải danh sách sản phẩm:', error);
                    updatePaginationInfo(0, 0, 0);
                }
            });
        }

        // Update pagination info
        function updatePaginationInfo() {
            const startRecord = totalRecords > 0 ? (currentPage - 1) * pageSize + 1 : 0;
            const endRecord = Math.min(currentPage * pageSize, totalRecords);
            $("#currentPageInfo").text(`${startRecord}-${endRecord}`);
            $("#totalRecords").text(totalRecords);
        }

        // Create pagination
        function createPagination() {
            const paginationContainer = $("#paginationSanPham").empty();
            if (pageCount <= 1) return;

            const prevDisabled = currentPage === 1 ? 'disabled' : '';
            paginationContainer.append(`
                <li class="page-item ${prevDisabled}">
                    <a class="page-link" href="#" data-page="${currentPage - 1}">Trước</a>
                </li>
            `);

            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(pageCount, currentPage + 2);

            for (let i = startPage; i <= endPage; i++) {
                const active = i === currentPage ? 'active' : '';
                paginationContainer.append(`
                    <li class="page-item ${active}">
                        <a class="page-link" href="#" data-page="${i}">${i}</a>
                    </li>
                `);
            }

            const nextDisabled = currentPage === pageCount ? 'disabled' : '';
            paginationContainer.append(`
                <li class="page-item ${nextDisabled}">
                    <a class="page-link" href="#" data-page="${currentPage + 1}">Sau</a>
                </li>
            `);

            paginationContainer.find(".page-link").click(function (e) {
                e.preventDefault();
                const page = $(this).data("page");
                if (page && page >= 1 && page <= pageCount && page !== currentPage) {
                    currentPage = page;
                    loadDanhSachSanPham();
                }
            });
        }

