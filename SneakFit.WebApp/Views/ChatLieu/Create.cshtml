@model SneakFit.ViewModels.Catalog.ChatLieu.ThemChatLieu

<form asp-controller="ChatLieu" asp-action="Create" id="createChatLieuForm" method="post" data-confirm="Bạn có chắc chắn muốn làm điều đó không?">
    <div class="mb-3">
        <label asp-for="TenChatLieu" class="form-label">Tên Chất Liệu</label>
        <input asp-for="TenChatLieu" class="form-control" placeholder="Nhập tên chất liệu" 
               pattern="^[a-zA-ZÀ-ỹ\s]+$" 
               oninput="validateInput(this)"
               maxlength="50"
               title="Vui lòng chỉ nhập chữ cái"></input>
        <span asp-validation-for="TenChatLieu" class="text-danger"></span>
        <span id="customError" class="text-danger" style="display: none;">Vui lòng chỉ nhập chữ cái</span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">Thêm</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>

<script>
function validateInput(input) {
    const pattern = /^[a-zA-ZÀ-ỹ\s]+$/;
    const errorSpan = document.getElementById('customError');
    
    if (!pattern.test(input.value) && input.value !== '') {
        errorSpan.style.display = 'block';
        input.setCustomValidity('Vui lòng chỉ nhập chữ cái');
    } else {
        errorSpan.style.display = 'none';
        input.setCustomValidity('');
    }
}
</script>