@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.ThemSPCT
@using SneakFit.ViewModels.Common

@{
    ViewData["Title"] = "Tạo mới sản phẩm chi tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold py-3 mb-4">
                <span class="text-muted fw-light">Sản phẩm chi tiết /</span> Tạo mới
            </h4>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bx bx-arrow-back me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="col-md-12 mx-auto">
                <form asp-action="Create" method="post" id="create-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Phần 1: Thông tin sản phẩm -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">THÊM SẢN PHẨM</h5>

                        <div class="mb-3">
                            <label asp-for="SanPhamId" class="form-label">Tên sản phẩm</label>
                            <div class="input-group">
                                <select asp-for="SanPhamId" class="form-select" asp-items="ViewBag.SanPhams" style=" border-radius: 8px">
                                    <option value="">-- Chọn sản phẩm --</option>
                                </select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddSanPhamModal()">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="SanPhamId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThuongHieuId" class="form-label">Thương hiệu</label>
                                <div class="input-group">
                                    <select asp-for="ThuongHieuId" class="form-select" asp-items="ViewBag.ThuongHieus" style="border-radius: 8px">
                                        <option value="">-- Chọn thương hiệu --</option>
                                    </select>
                                    <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddThuongHieuModal()">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ThuongHieuId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ChatLieuId" class="form-label">Chất liệu</label>
                                <div class="input-group">
                                    <select asp-for="ChatLieuId" class="form-select" asp-items="ViewBag.ChatLieus" style="border-radius: 8px">
                                        <option value="">-- Chọn chất liệu --</option>
                                    </select>
                                    <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddChatLieuModal()">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ChatLieuId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DeGiayId" class="form-label">Đế giày</label>
                                <div class="input-group">
                                    <select asp-for="DeGiayId" class="form-select" asp-items="ViewBag.DeGiays" style="border-radius: 8px">
                                        <option value="">-- Chọn đế giày --</option>
                                    </select>
                                    <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddDeGiayModal()">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="DeGiayId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Trạng thái</label>
                                <div class="input-group">
                                    <select class="form-select" name="TrangThai" id="trangThaiSelect" style="border-radius: 8px">
                                        <option value="true">Hoạt động</option>
                                        <option value="false">Ngưng hoạt động</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Phần 2: Kích cỡ và màu sắc -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">KÍCH CỠ VÀ MÀU SẮC</h5>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label me-3" style="min-width: 80px;">Kích cỡ</label>
                            <div id="selectedSizes" class="mb-2 d-flex flex-wrap gap-2"></div>
                            <button type="button" class="btn btn-primary ms-2" onclick="openSizeModal()" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;">
                                <i class="bx bx-plus"></i>
                            </button>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label me-3" style="min-width: 80px;">Màu sắc</label>
                            <div id="selectedColors" class="mb-2 d-flex flex-wrap gap-2"></div>
                            <button type="button" class="btn btn-primary ms-2" onclick="openColorModal()" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;">
                                <i class="bx bx-plus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Phần 3: Chi tiết sản phẩm -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">CHI TIẾT SẢN PHẨM</h5>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <button type="button" class="btn btn-primary me-2" id="btnChinhGiavaSoLuong">
                                    Sửa giá và số lượng chung
                                </button>
                                <button type="submit" class="btn btn-primary" id="btnHoanTat">
                                    <i class="bx bx-check me-1"></i> Hoàn tất
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive" style=" border-radius: 8px">
                            <table class="table table-hover">
                                <thead>
                                    <tr style="background-color: mediumpurple; color: white;">
                                        <th style="width: 30px">
                                            <input type="checkbox" id="checkAll" />
                                        </th>
                                        <th style="width: 30px">STT</th>
                                        <th>Tên Sản Phẩm</th>
                                        <th style="width: 112px">Số Lượng</th>
                                        <th style="width: 205px">Giá Bán</th>
                                        <th style="width: 123px">Hành Động</th>
                                        <th style="width: 185px">Upload Ảnh</th>
                                    </tr>
                                </thead>
                                <tbody id="productDetailList">
                                    <!-- Dữ liệu sẽ được thêm vào đây bằng JavaScript -->
                                </tbody>
                            </table>

                            <!-- Phân trang -->
                            <div id="productDetailPagination" class="mt-2"></div>

                        </div>

                        @* @await Component.InvokeAsync("Pager", Model) *@
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thêm thư viện color picker -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-minicolors/2.3.6/jquery.minicolors.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-minicolors/2.3.6/jquery.minicolors.min.js"></script>
    <style>
        .selected-item {
            position: relative;
            display: inline-flex;
            align-items: center;
            margin-top: 12px;
            margin-right: 8px;
            margin-bottom: 8px;
            padding: 2px 16px 2px 8px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background: #fff;
            min-width: 48px;
            min-height: 32px;
        }

            .selected-item .remove-x {
                position: absolute;
                top: -7px;
                right: -7px;
                width: 20px;
                height: 20px;
                background: #ff4d4f;
                color: #fff;
                border-radius: 50%;
                border: 2px solid #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                cursor: pointer;
                z-index: 2;
                box-shadow: 0 1px 4px rgba(0,0,0,0.08);
                transition: background 0.2s;
            }

                .selected-item .remove-x:hover {
                    background: #d9363e;
                }

        #selectedSizes, #selectedColors {
            margin-top: 12px;
        }
        /* Đảm bảo SweetAlert2 luôn nổi trên modal */
        .swal2-container {
            z-index: 10000 !important;
        }

        .spct-thumb-wrapper:hover .spct-thumb-delete,
        .spct-thumb-wrapper:hover .spct-thumb-view {
            display: inline-block !important;
        }

        .spct-thumb-delete, .spct-thumb-view {
            display: none;
        }
    </style>

    <script>
        // Biến toàn cục
        let selectedSizes = [];
        let selectedColors = [];
        let spctItems = [];
        let selectedColorId = null;

        // Lưu trữ ảnh tạm cho từng SPCT (key là index dòng)
        let spctImages = {};

        // CheckAll
        $('#checkAll').on('change', function() {
            $('.row-check').prop('checked', this.checked);
        });

        // Hàm mở modal thêm sản phẩm
        function openAddSanPhamModal() {
            $.get('/SanPham/Create', function(html) {
                $('#modalAddSanPhamContent').html(html);
                $('#modalAddSanPham').modal('show');
            });
        }

        // Hàm mở modal thêm thương hiệu
        function openAddThuongHieuModal() {
            $.get('/ThuongHieu/Create', function(html) {
                $('#modalAddThuongHieuContent').html(html);
                $('#modalAddThuongHieu').modal('show');
            });
        }

        // Hàm mở modal thêm đế giày
        function openAddDeGiayModal() {
            $.get('/DeGiay/Create', function(html) {
                $('#modalAddDeGiayContent').html(html);
                $('#modalAddDeGiay').modal('show');
            });
        }

        // Hàm mở modal thêm chất liệu
        function openAddChatLieuModal() {
            $.get('/ChatLieu/Create', function(html) {
                $('#modalAddChatLieuContent').html(html);
                $('#modalAddChatLieu').modal('show');
            });
        }

        // Hàm mở modal kích thước
        function openSizeModal() {
            // Kiểm tra các trường bắt buộc trước khi mở modal
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            $.get('/KichThuoc/GetAll', function(sizes) {
                const sizeGrid = $('#sizeModal .size-grid');
                sizeGrid.empty();
                sizes.forEach(size => {
                    const isSelected = selectedSizes.some(s => s.id == size.id);
                    sizeGrid.append(`
                        <button type="button" class="size-btn ${isSelected ? 'selected' : ''}"
                            style="padding: 7px; border: 2px solid ${isSelected ? '#007bff' : '#ddd'}; border-radius: 5px; background: ${isSelected ? '#e3f0ff' : 'white'}; color: ${isSelected ? '#007bff' : 'black'}; font-weight:bold; margin-bottom:4px;"
                            data-size-id="${size.id}"
                            data-size-name="${size.maKichThuoc}">${size.maKichThuoc}</button>
                    `);
                });
                $('#sizeModal').modal('show');
            });
        }

        // Hàm mở modal màu sắc (chỉ input mã màu, có thể sửa, có thể chọn)
        function openColorModal() {
            // Kiểm tra các trường bắt buộc trước khi mở modal
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            $.get('/MauSac/GetAll', function(colors) {
                const colorGrid = $('#colorModal .color-grid');
                colorGrid.empty();
                colors.forEach(color => {
                    let colorHex = color.maMauSac && /^#[0-9A-Fa-f]{6}$/.test(color.maMauSac) ? color.maMauSac : '#000000';
                    // Kiểm tra nếu màu này đã được chọn trước đó
                    const isSelected = selectedColors.some(c => c.id == color.id);
                    colorGrid.append(`
                        <input type="text"
                            class="form-control form-control-sm ma-mau-input mb-2${isSelected ? ' selected' : ''}"
                            value="${colorHex}"
                            data-color-id="${color.id}"
                            data-color-name="${color.tenMauSac}"
                            style="width:110px; background:${colorHex}; color:${getContrastYIQ(colorHex)}; font-weight:bold; text-align:center; cursor:pointer; margin-right:10px; margin-bottom:10px; border:${isSelected ? '3px solid #0056b3' : '2px solid #888'};${isSelected ? 'box-shadow:0 0 0 2px #b3d1ff;' : ''}"
                            readonly
                        />
                    `);
                });
                $('#colorModal').modal('show');
            });
        }

        // Hiệu ứng hover đậm hơn cho input mã màu
        $(document).on('mouseenter', '.ma-mau-input', function() {
            if (!$(this).hasClass('selected')) {
                $(this).css('border', '3px solid rgb(250, 121, 15)');
                $(this).css('box-shadow', '0 0 0 2px rgb(46, 190, 222)');
            }
        });
        $(document).on('mouseleave', '.ma-mau-input', function() {
            if (!$(this).hasClass('selected')) {
                $(this).css('border', '2px solid #888');
                $(this).css('box-shadow', 'none');
            }
        });
        // Cho phép chọn nhiều màu sắc 1 lúc
        $(document).on('click', '.ma-mau-input', function() {
            $(this).toggleClass('selected');
            if ($(this).hasClass('selected')) {
                $(this).css({'border':'3px solid rgb(250, 121, 15)','box-shadow':'0 0 0 2px rgb(86, 211, 57)'});
            } else {
                $(this).css({'border':'2px solid #888','box-shadow':'none'});
            }
        });
        // Khi bấm Thêm, lấy tất cả các màu đã chọn
        $('#confirmColorSelection').on('click', function() {
            let selectedInputs = $('.ma-mau-input.selected');
            if (selectedInputs.length === 0) {
                Swal.fire('Lỗi', 'Vui lòng chọn ít nhất một màu!', 'error');
                return;
            }
            selectedColors = [];
            selectedInputs.each(function() {
                selectedColors.push({
                    id: $(this).data('color-id'),
                    name: $(this).val(),
                    ten: $(this).data('color-name')
                });
            });
            $('#colorModal').modal('hide');
            renderSelectedColors();
            generateProductDetails();
        });

        // Xác nhận chọn kích thước
        $('#confirmSizeSelection').on('click', function() {
            selectedSizes = [];
            $('#sizeModal .size-btn.selected').each(function() {
                selectedSizes.push({
                    id: $(this).data('size-id'),
                    name: $(this).data('size-name')
                });
            });
            // Kiểm tra các trường bắt buộc
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            $('#sizeModal').modal('hide');
            renderSelectedSizes();
            generateProductDetails();
        });

        // Toggle chọn size với hiệu ứng
        $(document).on('click', '.size-btn', function() {
            $(this).toggleClass('selected');
            if ($(this).hasClass('selected'))
                $(this).css({'border':'2px solid #007bff','background':'#e3f0ff','color':'#007bff'});
            else
                $(this).css({'border':'2px solid #ddd','background':'white','color':'black'});
        });

        // Chọn dòng
        $('#spctTable tbody tr').on('click', function(e) {
            if (!$(e.target).is('input, button')) {
                $(this).find('.row-check').prop('checked', true);
            }
            $('#spctTable tbody tr').removeClass('table-info');
            $(this).addClass('table-info');
        });

            // CheckAll
        $('#checkAll').on('change', function() {
            $('.row-check').prop('checked', this.checked);
        });

        function generateProductDetails() {
            const tbody = $('#productDetailList');
            tbody.empty();
            let stt = 1;
            const tenSanPham = $('select[name="SanPhamId"] option:selected').text();
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            const trangThai = $('#trangThaiSelect').val();

            // Kiểm tra các trường bắt buộc
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }

            // Kiểm tra đã chọn màu sắc và kích thước
            if (selectedColors.length === 0 || selectedSizes.length === 0) {
                let msg = '';
                if (selectedColors.length === 0 && selectedSizes.length === 0) msg = 'Vui lòng chọn ít nhất một màu sắc và một kích thước';
                else if (selectedColors.length === 0) msg = 'Vui lòng chọn ít nhất một màu sắc';
                else msg = 'Vui lòng chọn ít nhất một kích thước';
                Swal.fire('Lỗi', msg, 'error');
                return;
            }

            // Nhóm sản phẩm chi tiết theo màu sắc
            let groupedItems = {};
            selectedColors.forEach(color => {
                selectedSizes.forEach(size => {
                    const groupKey = `${sanPhamId}-${color.id}`;
                    if (!groupedItems[groupKey]) {
                        groupedItems[groupKey] = {
                            color: color,
                            items: []
                        };
                    }
                    groupedItems[groupKey].items.push({
                        stt: stt++,
                        sanPhamId: sanPhamId,
                        thuongHieuId: thuongHieuId,
                        chatLieuId: chatLieuId,
                        deGiayId: deGiayId,
                        mauSacId: color.id,
                        kichThuocId: size.id,
                        tenSanPham: tenSanPham,
                        sizeName: size.name,
                        colorName: color.ten,
                        trangThai: trangThai
                    });
                });
            });

            // Render bảng với các nhóm hàng
            for (const groupKey in groupedItems) {
                const group = groupedItems[groupKey];
                const groupSize = group.items.length;
                group.items.forEach((item, index) => {
                    let isFirstInGroup = index === 0;
                    let row = $('<tr>').attr({
                        'data-sanpham-id': item.sanPhamId,
                        'data-thuonghieu-id': item.thuongHieuId,
                        'data-chatlieu-id': item.chatLieuId,
                        'data-degiay-id': item.deGiayId,
                        'data-mausac-id': item.mauSacId,
                        'data-kichthuoc-id': item.kichThuocId,
                        'data-trangthai': item.trangThai,
                        'data-color-group': groupKey
                    });

                    row.append(`<td><input type="checkbox" class="product-checkbox row-check" /></td>`);
                    row.append(`<td class="stt">${item.stt}</td>`);
                    row.append(`<td class="product-name">${item.tenSanPham} [ ${item.sizeName} - ${item.colorName} ]</td>`);
                    row.append(`<td><input type="number" class="form-control quantity-input" min="1" value="1" style="width: 80px;" /></td>`);
                    row.append(`
                        <td>
                            <div class="input-group" style="width: 200px;">
                                <input type="text" class="form-control price-input" value="1.000.000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </td>
                    `);
                    row.append(`
                        <td style="text-align: center">
                            <button type="button" class="btn btn-danger btn-sm delete-row">
                                <i class="bx bx-trash"></i>
                            </button>
                        </td>
                    `);

                    // Chỉ thêm cột upload ảnh cho hàng đầu tiên trong nhóm
                    if (isFirstInGroup) {
                        let uploadCell = $('<td>').addClass('spct-images-cell').attr('rowspan', groupSize).css({
                            'vertical-align': 'middle',
                            'text-align': 'center'
                        });
                        uploadCell.append(`
                            <div class="image-preview-container d-flex flex-wrap gap-1 justify-content-center mt-2"></div>
                            <button type="button" class="btn btn-light btn-sm upload-image" data-color-group-key="${groupKey}">
                                <i class="bx bx-upload"></i> Upload
                            </button>
                        `);
                        row.append(uploadCell);
                    }

                    tbody.append(row);
                });
            }
            //Phân trang
             renderProductDetailPagination();

        }

        // Xử lý xóa dòng
        $(document).on('click', '.delete-row', function() {
            let row = $(this).closest('tr');
            let groupKey = row.data('color-group');
            let groupRows = $(`tr[data-color-group="${groupKey}"]`);

            // Nếu chỉ còn 1 dòng trong nhóm, xóa luôn ảnh liên quan
            if (groupRows.length === 1) {
                delete spctImages[groupKey]; // Xóa ảnh khỏi spctImages
            }

            // Xóa dòng hiện tại
            row.remove();

            // Cập nhật lại rowspan và kiểm tra nếu không còn dòng nào trong nhóm
            groupRows = $(`tr[data-color-group="${groupKey}"]`); // Cập nhật lại số lượng dòng
            if (groupRows.length > 0) {
                let firstRow = groupRows.first();
                let uploadCell = firstRow.find('.spct-images-cell');
                if (uploadCell.length) {
                    uploadCell.attr('rowspan', groupRows.length);
                } else {
                    // Nếu dòng đầu tiên bị xóa, thêm lại upload cell cho dòng mới
                    let newUploadCell = $('<td>').addClass('spct-images-cell').attr('rowspan', groupRows.length).css({
                        'vertical-align': 'middle',
                        'text-align': 'center'
                    });
                    newUploadCell.append(`
                        <div class="image-preview-container d-flex flex-wrap gap-1 justify-content-center mt-2"></div>
                        <button type="button" class="btn btn-light btn-sm upload-image" data-color-group-key="${groupKey}">
                            <i class="bx bx-upload"></i> Upload
                        </button>
                    `);
                    firstRow.append(newUploadCell);

                    // Render lại ảnh nếu có
                    if (spctImages[groupKey]) {
                        let imgHtml = '';
                        spctImages[groupKey].forEach((file, idx) => {
                            let url = URL.createObjectURL(file);
                            imgHtml += `
                                <div class="spct-thumb-wrapper d-inline-block position-relative me-1 mb-1" style="width:48px;height:48px;">
                                    <img src="${url}" class="spct-thumb-img" data-idx="${idx}" style="width:100%;height:100%;object-fit:cover;border-radius:6px;cursor:pointer;" />
                                    <button type="button" class="btn btn-danger btn-sm spct-thumb-delete position-absolute top-0 end-0 d-none" data-idx="${idx}" style="z-index:2;padding:0.05px 0.05px;">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                    <button type="button" class="btn btn-light btn-sm spct-thumb-view position-absolute bottom-0 end-0 d-none" data-idx="${idx}" style="z-index:2;padding:0.05px 0.05px;">
                                        <i class="bx bx-show"></i>
                                    </button>
                                </div>
                            `;
                        });
                        firstRow.find('.image-preview-container').html(imgHtml);
                    }
                }

                // Cập nhật lại số thứ tự (STT)
                $('#productDetailList .stt').each(function(index) {
                    $(this).text(index + 1);
                });
            }
        });

        // Khi bấm upload ảnh
        $(document).on('click', '.upload-image', function() {
            let colorGroupKey = $(this).data('color-group-key');
            $('#modalUploadImage').data('colorGroupKey', colorGroupKey);
            renderSpctImagePreview(colorGroupKey);
            $('#modalUploadImage').modal('show');
        });

        // Khi chọn file ảnh
        $('#spctImageInput').on('change', function() {
            let files = Array.from(this.files);
            let colorGroupKey = $('#modalUploadImage').data('colorGroupKey');

            let currentFiles = spctImages[colorGroupKey] || [];
            if (currentFiles.length + files.length > 3) {
                Swal.fire('Lỗi', 'Chỉ được upload tối đa 3 ảnh cho mỗi nhóm sản phẩm cùng màu', 'error');
                this.value = '';
                return;
            }

            if (!spctImages[colorGroupKey]) spctImages[colorGroupKey] = [];
            spctImages[colorGroupKey] = spctImages[colorGroupKey].concat(files);
            renderSpctImagePreview(colorGroupKey);
        });

        // Hiển thị preview ảnh trong modal
        function renderSpctImagePreview(colorGroupKey) {
            let preview = $('#spctImagePreview');
            preview.empty();
            let files = spctImages[colorGroupKey] || [];
            files.forEach((file, idx) => {
                let url = URL.createObjectURL(file);
                preview.append(`
                    <div class="position-relative" style="display:inline-block;">
                        <img src="${url}" style="width:100px;height:100px;object-fit:cover;border-radius:8px;" />
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 " id="remove-spct-image" data-idx="${idx}" style="z-index:2;">
                            <i class="bx bx-trash"></i>
                        </button>
                    </div>
                `);
            });
        }

        // Xóa ảnh khỏi preview trong modal
        $(document).on('click', '#remove-spct-image', function() {
            let idx = $(this).data('idx');
            let colorGroupKey = $('#modalUploadImage').data('colorGroupKey');
            spctImages[colorGroupKey].splice(idx, 1);
            renderSpctImagePreview(colorGroupKey);
            $('#spctImageCount').text(`${spctImages[colorGroupKey].length} file(s)`);
        });

        // Lưu ảnh vào nhóm SPCT
        $('#saveSpctImages').on('click', function() {
            let colorGroupKey = $('#modalUploadImage').data('colorGroupKey');
            let files = spctImages[colorGroupKey] || [];

            if (files.length > 3) {
                Swal.fire('Lỗi', 'Chỉ được upload tối đa 3 ảnh cho mỗi nhóm sản phẩm cùng màu', 'error');
                return;
            }

            let imgHtml = '';
            files.forEach((file, idx) => {
                let url = URL.createObjectURL(file);
                imgHtml += `
                    <div class="spct-thumb-wrapper d-inline-block position-relative me-1 mb-1" style="width:48px;height:48px;">
                        <img src="${url}" class="spct-thumb-img" data-idx="${idx}" style="width:100%;height:100%;object-fit:cover;border-radius:6px;cursor:pointer;" />
                        <button type="button" class="btn btn-danger btn-sm spct-thumb-delete position-absolute top-0 end-0 d-none" data-idx="${idx}" style="z-index:2;padding:0.05px 0.05px;">
                            <i class="bx bx-trash"></i>
                        </button>
                        <button type="button" class="btn btn-light btn-sm spct-thumb-view position-absolute bottom-0 end-0 d-none" data-idx="${idx}" style="z-index:2;padding:0.05px 0.05px;">
                            <i class="bx bx-show"></i>
                        </button>
                    </div>
                `;
            });

            $(`tr[data-color-group="${colorGroupKey}"] .spct-images-cell .image-preview-container`).html(imgHtml);
            $('#modalUploadImage').modal('hide');
        });

        // Khi bấm Hoàn tất, Sửa giá, Sửa số lượng
        $('#btnHoanTat').on('click', async function(e) {
            e.preventDefault();
            // Kiểm tra các trường bắt buộc
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            if (selectedColors.length === 0 || selectedSizes.length === 0) {
                Swal.fire('Lỗi', 'Vui lòng chọn ít nhất một màu sắc và một kích thước', 'error');
                return;
            }

            let trs = $('#productDetailList tr');
            if (trs.length === 0) {
                Swal.fire('Lỗi', 'Chưa có sản phẩm chi tiết nào!', 'error');
                return;
            }

            // Tạo mảng dữ liệu JSON
            let items = [];
            trs.each(function(rowIndex) {
                let $tr = $(this);
                let item = {
                    SanPhamId: $tr.data('sanpham-id') || sanPhamId,
                    ThuongHieuId: $tr.data('thuonghieu-id') || thuongHieuId,
                    ChatLieuId: $tr.data('chatlieu-id') || chatLieuId,
                    DeGiayId: $tr.data('degiay-id') || deGiayId,
                    MauSacId: $tr.data('mausac-id'),
                    KichThuocId: $tr.data('kichthuoc-id'),
                    SoLuong: parseInt($tr.find('.quantity-input').val()) || 0,
                    Gia: parseInt($tr.find('.price-input').val().replace(/\./g, '')) || 0,
                    TrangThai: $('#trangThaiSelect').val() === "true"
                };

                if (!item.MauSacId || !item.KichThuocId) {
                    Swal.fire('Lỗi', `Lỗi thêm màu sắc và kích thước dòng ${rowIndex + 1}`, 'error');
                    return;
                }
                if (isNaN(item.Gia) || isNaN(item.SoLuong)) {
                    Swal.fire('Lỗi', `Lỗi thêm giá và số lượng dòng ${rowIndex + 1}`, 'error');
                    return;
                }
                items.push(item);
            });

            try {
                // Hiển thị loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    text: 'Vui lòng đợi trong giây lát',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Gửi yêu cầu tạo SPCT
                let response = await $.ajax({
                    url: '/SPCT/CreateMultiple',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(items)
                });

                if (!response.success) {
                    throw new Error(response.message || 'Có lỗi khi tạo sản phẩm chi tiết');
                }

                // Upload ảnh cho từng SPCT
                let uploadPromises = [];
                let uploadErrors = [];
                
                for (let i = 0; i < items.length; i++) {
                    const item = items[i];
                    const colorGroupKey = `${item.SanPhamId}-${item.MauSacId}`;
                    const files = spctImages[colorGroupKey] || [];
                    
                    if (files.length > 0) {
                        const sanPhamChiTietId = response.data[i]?.id;
                        if (!sanPhamChiTietId) {
                            console.error(`Không tìm thấy ID SPCT cho item ${i}:`, response.data[i]);
                            uploadErrors.push(`Lỗi không tìm thấy ID sản phẩm chi tiết để upload ảnh dòng ${i + 1}`);
                            continue;
                        }

                        const uploadData = new FormData();
                        uploadData.append('sanPhamChiTietId', sanPhamChiTietId);
                        files.forEach(file => {
                            uploadData.append('files', file);
                        });

                        try {
                            const uploadResponse = await $.ajax({
                                url: '/SPCT/UploadImages',
                                type: 'POST',
                                data: uploadData,
                                processData: false,
                                contentType: false
                            });

                            if (!uploadResponse.success) {
                                console.error(`Lỗi upload ảnh cho SPCT ${sanPhamChiTietId}:`, uploadResponse);
                                uploadErrors.push(`Lỗi thêm ảnh dòng ${i + 1}`);
                            }
                        } catch (uploadError) {
                            console.error(`Lỗi upload ảnh cho SPCT ${sanPhamChiTietId}:`, uploadError);
                            uploadErrors.push(`Lỗi thêm ảnh dòng ${i + 1}`);
                        }
                    }
                }

                // Hiển thị kết quả
                let message = response.message || 'Tạo mới sản phẩm chi tiết thành công!';
                if (uploadErrors.length > 0) {
                    message += `\nLỗi upload ảnh: ${uploadErrors.join('; ')}`;
                    Swal.fire('Cảnh báo', message, 'warning').then(() => {
                        window.location.href = '/SPCT/Index';
                    });
                } else {
                    Swal.fire('Thành công', message, 'success').then(() => {
                        window.location.href = '/SPCT/Index';
                    });
                }
            } catch (error) {
                console.error('Lỗi:', error);
                let errorMsg = 'Có lỗi khi tạo sản phẩm chi tiết!';
                if (error.responseJSON && error.responseJSON.message) {
                    errorMsg = error.responseJSON.message;
                }
                Swal.fire('Lỗi', errorMsg, 'error');
            }
        });

        // Xóa dòng sản phẩm chi tiết
        $(document).on('click', '.delete-row', function() {
            $(this).closest('tr').remove();
        });

        // Xử lý nút thêm kích thước mới
        $('#addNewSizeBtn').on('click', function() {
            $.get('/KichThuoc/Create', function(html) {
                $('#modalAddKichThuocContent').html(html);
                $('#modalAddKichThuoc').modal('show');
            });
        });

        // Xử lý nút thêm màu sắc mới
        $(document).on('click', '#addNewColorHex', function() {
            $('#modalAddMauSac').modal('show');
            // Reset input
            $('#addColorPicker').minicolors({
                control: 'hue',
                format: 'hex',
                theme: 'bootstrap',
                swatches: []
            });
            $('#addColorPicker').minicolors('value', '#000000');
            $('#addColorHex').val('#000000').css({'background':'#000000','color':'#fff'});
            $('#addColorName').val('');
        });

        // Xử lý submit form trong modal kích thước
        $(document).on('submit', '#createKichThuocForm', function(e) {
            e.preventDefault();
            let formData = $(this).serialize();
            $.ajax({
                url: '/KichThuoc/Create',
                type: 'POST',
                data: formData,
                success: function(res) {
                    if(res.success || res === true) {
                        $('#modalAddKichThuoc').modal('hide');
                        openSizeModal(); // Re-open size modal to refresh the list
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể thêm kích thước mới', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Lỗi', 'Không thể thêm kích thước mới', 'error');
                }
            });
        });

        // Xử lý submit form trong modal màu sắc
        $(document).on('submit', '#createMauSacForm', function(e) {
            e.preventDefault();
            handleFormSubmit(this, '/MauSac/Create', 'MauSacId', 'name');
        });

        // Hiển thị selectedSizes và selectedColors ra ngoài với nút xóa

        function renderSelectedSizes() {
            const container = $('#selectedSizes');
            container.empty();
            selectedSizes.forEach(size => {
                container.append(`
                    <div class="selected-item size-item d-inline-flex align-items-center" style="background:#fff;">
                        <span>${size.name}</span>
                        <span class="remove-x" data-size-id="${size.id}">&times;</span>
                    </div>
                `);
            });
        }
        function renderSelectedColors() {
            const container = $('#selectedColors');
            container.empty();
            selectedColors.forEach(color => {
                let colorHex = color.name && /^#[0-9A-Fa-f]{6}$/.test(color.name) ? color.name : '#000000';
                container.append(`
                    <div class="selected-item color-item d-inline-flex align-items-center" style="background:${colorHex}; color:${getContrastYIQ(colorHex)};">
                        <span>${colorHex}</span>
                        <span class="remove-x" data-color-id="${color.id}">&times;</span>
                    </div>
                `);
            });
        }
        // Hàm lấy màu chữ phù hợp với nền
        function getContrastYIQ(hexcolor){
            hexcolor = hexcolor.replace('#', '');
            if(hexcolor.length === 3) hexcolor = hexcolor[0]+hexcolor[0]+hexcolor[1]+hexcolor[1]+hexcolor[2]+hexcolor[2];
            var r = parseInt(hexcolor.substr(0,2),16);
            var g = parseInt(hexcolor.substr(2,2),16);
            var b = parseInt(hexcolor.substr(4,2),16);
            var yiq = ((r*299)+(g*587)+(b*114))/1000;
            return (yiq >= 128) ? '#000' : '#fff';
        }
        // Xóa kích thước đã chọn
        $(document).on('click', '.remove-x[data-size-id]', function() {
            const id = $(this).data('size-id');
            selectedSizes = selectedSizes.filter(s => s.id != id);
            renderSelectedSizes();
            generateProductDetails();
        });
        // Xóa màu đã chọn
        $(document).on('click', '.remove-x[data-color-id]', function() {
            const id = $(this).data('color-id');
            selectedColors = selectedColors.filter(c => c.id != id);
            renderSelectedColors();
            generateProductDetails();
        });

        // Khi chọn màu ở color picker, fill vào input mã màu
        $(document).on('change', '#addColorPicker', function() {
            let hex = $(this).val();
            $('#addColorHex').val(hex).css({'background':hex,'color':getContrastYIQ(hex)});
        });

        // Khi bấm Lưu trong modal thêm màu mới
        $(document).on('click', '#saveNewColor', function() {
            let hex = $('#addColorHex').val();
            let ten = $('#addColorName').val();
            if (!ten || ten.trim() === '') {
                Swal.fire('Lỗi', 'Vui lòng nhập tên màu!', 'error');
                return;
            }
            if (!/^#[0-9A-Fa-f]{6}$/.test(hex)) {
                Swal.fire('Lỗi', 'Vui lòng nhập đúng định dạng mã màu HEX, ví dụ: #FF0000', 'error');
                return;
            }
            $.ajax({
                url: '/MauSac/CreateColor',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ TenMauSac: ten, MaMauSac: hex }),
                success: function(res) {
                    if(res.success || res === true) {
                        $('#modalAddMauSac').modal('hide');
                        openColorModal();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể thêm màu mới', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Lỗi', 'Không thể thêm màu mới', 'error');
                }
            });
        });
        // Cho phép click vào mã màu để sửa trực tiếp
        $(document).on('click', '.color-item input[type="text"]', function() {
            $(this).removeAttr('readonly').focus();
        });
        // Khi blur hoặc Enter, cập nhật lại màu nền và mã màu
        $(document).on('blur', '.color-item input[type="text"]', function() {
            let val = $(this).val();
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                $(this).css({'background':val,'color':getContrastYIQ(val)});
                $(this).attr('readonly', true);
                // Cập nhật lại button màu phía trên nếu có
                $(this).closest('.color-item').find('.color-btn').css('background-color', val).data('color-name', val);
            }
        });
        $(document).on('keydown', '.color-item input[type="text"]', function(e) {
            if (e.key === 'Enter') {
                $(this).blur();
            }
        });

        // Mở modal sửa giá và số lượng chung
        $('#btnChinhGiavaSoLuong').on('click', function() {
            // Nếu chưa có sản phẩm chi tiết thì báo lỗi
            if ($('#productDetailList tr').length === 0) {
                Swal.fire('Lỗi', 'Chưa có sản phẩm chi tiết nào để sửa!', 'error');
                return;
            }
            // Lấy giá và số lượng đầu tiên để fill vào modal (nếu có)
            let firstPrice = $('#productDetailList .price-input').first().val() || '';
            let firstQuantity = $('#productDetailList .quantity-input').first().val() || '';
            $('#editAllPrice').val(formatMoney(firstPrice));
            $('#editAllQuantity').val(firstQuantity);
            $('#modalEditPriceQuantity').modal('show');
        });
        // Định dạng tiền khi nhập
        $('#editAllPrice').on('input', function() {
            let val = $(this).val().replace(/\D/g, '');
            $(this).val(formatMoney(val));
        });
        function formatMoney(value) {
            value = value.toString().replace(/\D/g, '');
            if (!value) return '';
            return value.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }
        // Áp dụng giá và số lượng chung cho tất cả sản phẩm chi tiết
        $('#btnApplyEditAll').on('click', function() {
            let price = $('#editAllPrice').val().replace(/\./g, '');
            let quantity = $('#editAllQuantity').val();
            if (!price || isNaN(price) || parseInt(price) <= 0) {
                Swal.fire('Lỗi', 'Vui lòng nhập giá hợp lệ!', 'error');
                return;
            }
            if (!quantity || isNaN(quantity) || parseInt(quantity) <= 0) {
                Swal.fire('Lỗi', 'Vui lòng nhập số lượng hợp lệ!', 'error');
                return;
            }
            // Cập nhật tất cả các input
            $('#productDetailList .price-input').each(function() {
                $(this).val(formatMoney(price));
            });
            $('#productDetailList .quantity-input').each(function() {
                $(this).val(quantity);
            });
            $('#modalEditPriceQuantity').modal('hide');
        });
        // Khi submit form, chuyển giá về dạng số (bỏ dấu .)
        $(document).on('submit', '#create-form', function() {
            $('#productDetailList .price-input').each(function() {
                let val = $(this).val();
                $(this).val(val.replace(/\./g, ''));
            });
        });
        // Chỉ cho nhập số và tự động format giá bán
        $(document).on('input', '.gia-ban, .price-input', function() {
            let value = $(this).val().replace(/[^0-9]/g, ''); // Loại bỏ ký tự không phải số
            if (value) {
                value = value.replace(/^0+/, ''); // Loại bỏ số 0 ở đầu
                value = value.replace(/\B(?=(\d{3})+(?!\d))/g, '.'); // Thêm dấu chấm hàng nghìn
            }
            $(this).val(value);
        });

        // Chỉ cho nhập số lượng là số nguyên dương
        $(document).on('input', '.so-luong, .quantity-input', function() {
            let value = $(this).val().replace(/[^0-9]/g, '');
            value = value.replace(/^0+/, ''); // Loại bỏ số 0 ở đầu
            value = value.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            $(this).val(value);
        });

       // --- PHÂN TRANG CHI TIẾT SẢN PHẨM ---
        function renderProductDetailPagination() {
            var $rows = $('#productDetailList tr');
            var rowsPerPage = 5;
            var totalPages = Math.ceil($rows.length / rowsPerPage);
            var currentPage = 1;

            function showPage(page) {
                $rows.hide();
                $rows.slice((page - 1) * rowsPerPage, page * rowsPerPage).show();
                $('#productDetailPagination .page-link').removeClass('active');
                $('#productDetailPagination .page-link[data-page="' + page + '"]').addClass('active');
            }

            function renderPagination() {
                if (totalPages <= 1) {
                    $('#productDetailPagination').empty();
                    return;
                }
                var html = '<nav><ul class="pagination justify-content-end">';
                for (var i = 1; i <= totalPages; i++) {
                    html += '<li class="page-item"><a class="page-link' + (i === 1 ? ' active' : '') + '" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
                html += '</ul></nav>';
                $('#productDetailPagination').html(html);
            }

            renderPagination();
            showPage(currentPage);

            $('#productDetailPagination').off('click').on('click', '.page-link', function (e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page !== currentPage) {
                    currentPage = page;
                    showPage(currentPage);
                }
            });
            

        }

        

    </script>
}

