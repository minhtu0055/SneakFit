@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.ThemSPCT

@{
    ViewData["Title"] = "Tạo mới sản phẩm chi tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold py-3 mb-4">
                <span class="text-muted fw-light">Sản phẩm chi tiết /</span> Tạo mới
            </h4>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bx bx-arrow-back me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="col-md-8 mx-auto">
                <form asp-action="Create" method="post" id="create-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <h5 class="mb-4">THÊM SẢN PHẨM</h5>

                    <div class="mb-3">
                        <label asp-for="SanPhamId" class="form-label">Tên sản phẩm</label>
                        @* <input asp-for="SanPhamId" class="form-control" placeholder="Nhập tên sản phẩm..." /> *@
                        <select asp-for="SanPhamId" class="form-select" asp-items="ViewBag.SanPhams">
                            <option value="">-- Chọn sản phẩm --</option>
                        </select>
                        <span asp-validation-for="SanPhamId" class="text-danger"></span>
                    </div>

                    @* <div class="mb-3"></div>
                        <label asp-for="SanPhamId" class="form-label">Sản phẩm</label>
                        <select asp-for="SanPhamId" class="form-select" asp-items="ViewBag.SanPhams">
                            <option value="">-- Chọn sản phẩm --</option>
                        </select>
                        <span asp-validation-for="SanPhamId" class="text-danger"></span>
                    </div> *@

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ThuongHieuId" class="form-label">Thương hiệu</label>
                            <div class="input-group">
                                <select asp-for="ThuongHieuId" class="form-select" asp-items="ViewBag.ThuongHieus">
                                    <option value="">-- Chọn thương hiệu --</option>
                                </select>
                                <button type="button" class="btn btn-primary" id="addThuongHieu">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ThuongHieuId" class="text-danger"></span>
                        </div>

                        @* <div class="col-md-6 mb-3">
                            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                            <div class="input-group">
                                <select asp-for="TrangThai" class="form-select">
                                    <option value="">-- Chọn trạng thái --</option>
                                    <option value="KinhDoanh">Kinh Doanh</option>
                                </select>
                                <button type="button" class="btn btn-primary">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="TrangThai" class="text-danger"></span>
                        </div> *@
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ChatLieuId" class="form-label">Chất liệu</label>
                            <div class="input-group">
                                <select asp-for="ChatLieuId" class="form-select" asp-items="ViewBag.ChatLieus">
                                    <option value="">-- Chọn chất liệu --</option>
                                </select>
                                <button type="button" class="btn btn-primary" id="addChatLieu">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ChatLieuId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DeGiayId" class="form-label">Đế giày</label>
                            <div class="input-group">
                                <select asp-for="DeGiayId" class="form-select" asp-items="ViewBag.DeGiays">
                                    <option value="">-- Chọn đế giày --</option>
                                </select>
                                <button type="button" class="btn btn-primary" id="addDeGiay">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="DeGiayId" class="text-danger"></span>
                        </div>
                    </div>

                    <h5 class="mt-4 mb-3">KÍCH CỠ VÀ MÀU SẮC</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kích cỡ</label>
                            <div id="selectedSizes" class="mb-2"></div>
                            <button type="button" class="btn btn-primary" id="openSizeSelector">
                                <i class="bx bx-plus"></i>
                            </button>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Màu sắc</label>
                            <div id="selectedColors" class="mb-2"></div>
                            <button type="button" class="btn btn-primary" id="openColorSelector">
                                <i class="bx bx-plus"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gia" class="form-label">Giá</label>
                        <div class="input-group">
                            <input asp-for="Gia" class="form-control" placeholder="Nhập giá sản phẩm..." />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Gia" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoLuong" class="form-label">Số lượng</label>
                        <input asp-for="SoLuong" class="form-control" placeholder="Nhập số lượng..." />
                        <span asp-validation-for="SoLuong" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bx bx-save me-1"></i> Tạo mới
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bx bx-arrow-back me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Helper để tạo thông báo
            function showToast(message, type) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: type,
                    title: message,
                    showConfirmButton: false,
                    timer: 3000
                });
            }

            // Xử lý form submit
            $("#create-form").on('submit', function(e) {
                e.preventDefault();
                var form = $(this);
                
                if (!$(this).valid()) {
                    return false;
                }

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function(result) {
                        if (result.success) {
                            showToast('Thêm mới sản phẩm chi tiết thành công', 'success');
                            setTimeout(function() {
                                window.location.href = '/SPCT/Index';
                            }, 1500);
                        } else {
                            showToast(result.message || 'Có lỗi xảy ra', 'error');
                        }
                    },
                    error: function() {
                        showToast('Có lỗi xảy ra khi xử lý yêu cầu', 'error');
                    }
                });
            });

            // Validate form
            var validator = $("#create-form").validate({
                rules: {
                    SanPhamId: {
                        required: true
                    },
                    MauSacId: {
                        required: true
                    },
                    KichThuocId: {
                        required: true
                    },
                    ChatLieuId: {
                        required: true
                    },
                    DeGiayId: {
                        required: true
                    },
                    ThuongHieuId: {
                        required: true
                    },
                    Gia: {
                        required: true,
                        min: 0,
                        number: true
                    },
                    SoLuong: {
                        required: true,
                        min: 0,
                        digits: true
                    }
                },
                messages: {
                    SanPhamId: {
                        required: "Vui lòng chọn sản phẩm"
                    },
                    MauSacId: {
                        required: "Vui lòng chọn màu sắc"
                    },
                    KichThuocId: {
                        required: "Vui lòng chọn kích thước"
                    },
                    ChatLieuId: {
                        required: "Vui lòng chọn chất liệu"
                    },
                    DeGiayId: {
                        required: "Vui lòng chọn đế giày"
                    },
                    ThuongHieuId: {
                        required: "Vui lòng chọn thương hiệu"
                    },
                    Gia: {
                        required: "Vui lòng nhập giá sản phẩm",
                        min: "Giá sản phẩm phải lớn hơn 0",
                        number: "Vui lòng nhập số hợp lệ"
                    },
                    SoLuong: {
                        required: "Vui lòng nhập số lượng",
                        min: "Số lượng phải lớn hơn 0",
                        digits: "Vui lòng nhập số nguyên"
                    }
                },
                errorElement: 'span',
                errorClass: 'text-danger',
                highlight: function(element) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function(element) {
                    $(element).removeClass('is-invalid');
                }
            });
        });
    </script>
}
