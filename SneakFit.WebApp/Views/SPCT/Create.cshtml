        // PHÂN TRANG CHI TIẾT SẢN PHẨM 
        function renderProductDetailPagination() {
            var $rows = $('#productDetailList tr');
            var rowsPerPage = 6;
            var totalPages = Math.ceil($rows.length / rowsPerPage);
            var currentPage = 1;

            function showPage(page) {
                $rows.hide();
                $rows.slice((page - 1) * rowsPerPage, page * rowsPerPage).show();
                $('#productDetailPagination .page-link').removeClass('active');
                $('#productDetailPagination .page-link[data-page="' + page + '"]').addClass('active');
            }

            function renderPagination() {
                if (totalPages <= 1) {
                    $('#productDetailPagination').empty();
                    return;
                }
                var html = '<nav><ul class="pagination justify-content-end">';
                for (var i = 1; i <= totalPages; i++) {
                    html += '<li class="page-item"><a class="page-link' + (i === 1 ? ' active' : '') + '" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
                html += '</ul></nav>';
                $('#productDetailPagination').html(html);
            }

            renderPagination();
            showPage(currentPage);

            $('#productDetailPagination').off('click').on('click', '.page-link', function (e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page !== currentPage) {
                    currentPage = page;
                    showPage(currentPage);
                }
            });
        }

