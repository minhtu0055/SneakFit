@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.ThemSPCT
@using SneakFit.ViewModels.Common

@{
    ViewData["Title"] = "Tạo mới sản phẩm chi tiết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold py-3 mb-4">
                <span class="text-muted fw-light">Sản phẩm chi tiết /</span> Tạo mới
            </h4>
        </div>
        <div>
            <a asp-action="Index" asp-controller="SPCT" class="btn btn-secondary"> @* Thêm asp-controller="SanPham" để trả về SanPham/index *@
                <i class="bx bx-arrow-back me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="col-md-12 mx-auto">
                <form asp-action="Create" method="post" id="create-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Phần 1: Thông tin sản phẩm -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">THÊM SẢN PHẨM</h5>

                        <div class="mb-3">
                            <label asp-for="SanPhamId" class="form-label">Tên sản phẩm</label>
                            <div class="input-group">
                                <select asp-for="SanPhamId" class="form-select" asp-items="ViewBag.SanPhams" style=" border-radius: 8px">
                                    <option value="">-- Chọn sản phẩm --</option>
                                </select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddSanPhamModal()">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="SanPhamId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThuongHieuId" class="form-label">Thương hiệu</label>
                                <div class="input-group">
                                    <select asp-for="ThuongHieuId" class="form-select" asp-items="ViewBag.ThuongHieus" style="border-radius: 8px">
                                        <option value="">-- Chọn thương hiệu --</option>
                                    </select>
                                    <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddThuongHieuModal()">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ThuongHieuId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ChatLieuId" class="form-label">Chất liệu</label>
                                <div class="input-group">
                                    <select asp-for="ChatLieuId" class="form-select" asp-items="ViewBag.ChatLieus" style="border-radius: 8px">
                                        <option value="">-- Chọn chất liệu --</option>
                                    </select>
                                    <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddChatLieuModal()">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ChatLieuId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DeGiayId" class="form-label">Đế giày</label>
                                <div class="input-group">
                                    <select asp-for="DeGiayId" class="form-select" asp-items="ViewBag.DeGiays" style="border-radius: 8px">
                                        <option value="">-- Chọn đế giày --</option>
                                    </select>
                                    <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddDeGiayModal()">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="DeGiayId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Trạng thái</label>
                                <div class="input-group">
                                    <select class="form-select" name="TrangThai" id="trangThaiSelect" style="border-radius: 8px">
                                        <option value="true">Hoạt động</option>
                                        <option value="false">Ngưng hoạt động</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Phần 2: Kích cỡ và màu sắc -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">KÍCH CỠ VÀ MÀU SẮC</h5>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label me-3" style="min-width: 80px;">Kích cỡ</label>
                            <div id="selectedSizes" class="mb-2 d-flex flex-wrap gap-2"></div>
                            <button type="button" class="btn btn-primary ms-2" onclick="openSizeModal()" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;">
                                <i class="bx bx-plus"></i>
                            </button>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <label class="form-label me-3" style="min-width: 80px;">Màu sắc</label>
                            <div id="selectedColors" class="mb-2 d-flex flex-wrap gap-2"></div>
                            <button type="button" class="btn btn-primary ms-2" onclick="openColorModal()" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;">
                                <i class="bx bx-plus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Phần 3: Chi tiết sản phẩm -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">CHI TIẾT SẢN PHẨM</h5>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <button type="button" class="btn btn-primary me-2" id="btnChinhGiavaSoLuong">
                                    Sửa giá và số lượng chung
                                </button>
                                <button type="submit" class="btn btn-primary" id="btnHoanTat">
                                    <i class="bx bx-check me-1"></i> Hoàn tất
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive" style=" border-radius: 8px">
                            <table class="table table-hover">
                                <thead>
                                    <tr style="background-color: #696CFF; ">
                                        <th style="width: 30px">
                                            <input type="checkbox" id="checkAll" />
                                        </th>
                                        <th style="width: 30px; color: white;">STT</th>
                                        <th style="color: white;">Tên Sản Phẩm</th>
                                        <th style="width: 112px; color: white;">Số Lượng</th>
                                        <th style="width: 205px; color: white;">Giá Bán</th>
                                        <th style="width: 123px; color: white;">Hành Động</th>
                                        <th style="width: 155px; text-align: center; color: white;">Upload Ảnh</th>
                                    </tr>
                                </thead>
                                <tbody id="productDetailList" style="background-color: #FFFFFF;">
                                    <!-- Dữ liệu sẽ được thêm vào đây bằng JavaScript -->
                                </tbody>
                            </table>

                            <!-- Phân trang -->
                            <div id="productDetailPagination" class="mt-2"></div>

                        </div>

                        @* Phân trang *@
                        <div id="productDetailPagination" class="mt-2"></div>
                        @* @await Component.InvokeAsync("Pager", Model) *@
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thêm thư viện color picker -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-minicolors/2.3.6/jquery.minicolors.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-minicolors/2.3.6/jquery.minicolors.min.js"></script>

    <style>
        .selected-item {
            position: relative;
            display: inline-flex;
            align-items: center;
            margin-top: 12px;
            margin-right: 8px;
            margin-bottom: 8px;
            padding: 2px 16px 2px 8px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background: #fff;
            min-width: 48px;
            min-height: 32px;
        }

            .selected-item .remove-x {
                position: absolute;
                top: -7px;
                right: -7px;
                width: 20px;
                height: 20px;
                background: #ff4d4f;
                color: #fff;
                border-radius: 50%;
                border: 2px solid #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                cursor: pointer;
                z-index: 2;
                box-shadow: 0 1px 4px rgba(0,0,0,0.08);
                transition: background 0.2s;
            }

                .selected-item .remove-x:hover {
                    background: #d9363e;
                }

        #selectedSizes, #selectedColors {
            margin-top: 12px;
        }
        /* Đảm bảo SweetAlert2 luôn nổi trên modal */
        .swal2-container {
            z-index: 10000 !important;
        }

        .spct-thumb-wrapper:hover .spct-thumb-delete,
        .spct-thumb-wrapper:hover .spct-thumb-view {
            display: inline-block !important;
        }

        .spct-thumb-delete, .spct-thumb-view {
            display: none;
        }
    </style>

    <script>
        // Biến toàn cục
        let selectedSizes = [];
        let selectedColors = [];
        let spctItems = [];
        let selectedColorId = null;

        // Lưu trữ ảnh tạm cho từng SPCT (key là index dòng)
        let spctImages = {};

        // CheckAll
        $('#checkAll').on('change', function() {
            $('.row-check').prop('checked', this.checked);
        });
        // Chọn dòng
        $('#spctTable tbody tr').on('click', function(e) {
            if (!$(e.target).is('input, button')) {
                $(this).find('.row-check').prop('checked', true);
                $('#spctTable tbody tr').removeClass('table-info');
                $(this).addClass('table-info');
            }
        });

        // Hàm mở modal thêm sản phẩm
        function openAddSanPhamModal() {
            $.get('/SanPham/Create', function(html) {
                $('#modalAddSanPhamContent').html(html);
                $('#modalAddSanPham').modal('show');
            });
        }

        // Hàm mở modal thêm thương hiệu
        function openAddThuongHieuModal() {
            $.get('/ThuongHieu/Create', function(html) {
                $('#modalAddThuongHieuContent').html(html);
                $('#modalAddThuongHieu').modal('show');
            });
        }

        // Hàm mở modal thêm đế giày
        function openAddDeGiayModal() {
            $.get('/DeGiay/Create', function(html) {
                $('#modalAddDeGiayContent').html(html);
                $('#modalAddDeGiay').modal('show');
            });
        }

        // Hàm mở modal thêm chất liệu
        function openAddChatLieuModal() {
            $.get('/ChatLieu/Create', function(html) {
                $('#modalAddChatLieuContent').html(html);
                $('#modalAddChatLieu').modal('show');
            });
        }

        // Hàm mở modal kích thước
        function openSizeModal() {
            // Kiểm tra các trường bắt buộc trước khi mở modal
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            $.get('/KichThuoc/GetAll', function(sizes) {
                const sizeGrid = $('#sizeModal .size-grid');
                sizeGrid.empty();
                sizes.forEach(size => {
                    const isSelected = selectedSizes.some(s => s.id == size.id);
                    sizeGrid.append(`
                        <button type="button" class="size-btn ${isSelected ? 'selected' : ''}"
                            style="padding: 7px; border: 2px solid ${isSelected ? '#007bff' : '#ddd'}; border-radius: 5px; background: ${isSelected ? '#e3f0ff' : 'white'}; color: ${isSelected ? '#007bff' : 'black'}; font-weight:bold; margin-bottom:4px;"
                            data-size-id="${size.id}"
                            data-size-name="${size.maKichThuoc}">${size.maKichThuoc}</button>
                    `);
                });
                $('#sizeModal').modal('show');
            });
        }

        // Hàm mở modal màu sắc (chỉ input mã màu, có thể sửa, có thể chọn)
        function openColorModal() {
            // Kiểm tra các trường bắt buộc trước khi mở modal
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            $.get('/MauSac/GetAll', function(colors) {
                const colorGrid = $('#colorModal .color-grid');
                colorGrid.empty();
                colors.forEach(color => {
                    let colorHex = color.maMauSac && /^#[0-9A-Fa-f]{6}$/.test(color.maMauSac) ? color.maMauSac : '#000000';
                    // Kiểm tra nếu màu này đã được chọn trước đó
                    const isSelected = selectedColors.some(c => c.id == color.id);
                    colorGrid.append(`
                        <input type="text"
                            class="form-control form-control-sm ma-mau-input mb-2${isSelected ? ' selected' : ''}"
                            value="${colorHex}"
                            data-color-id="${color.id}"
                            data-color-name="${color.tenMauSac}"
                            style="width:110px; background:${colorHex}; color:${getContrastYIQ(colorHex)}; font-weight:bold; text-align:center; cursor:pointer; margin-right:10px; margin-bottom:10px; border:${isSelected ? '3px solid #0056b3' : '2px solid #888'};${isSelected ? 'box-shadow:0 0 0 2px #b3d1ff;' : ''}"
                            readonly
                        />
                    `);
                });
                $('#colorModal').modal('show');
            });
        }

        // Hiệu ứng hover đậm hơn cho input mã màu
        $(document).on('mouseenter', '.ma-mau-input', function() {
            if (!$(this).hasClass('selected')) {
                $(this).css('border', '3px solid rgb(250, 121, 15)');
                $(this).css('box-shadow', '0 0 0 2px rgb(46, 190, 222)');
            }
        });
        $(document).on('mouseleave', '.ma-mau-input', function() {
            if (!$(this).hasClass('selected')) {
                $(this).css('border', '2px solid #888');
                $(this).css('box-shadow', 'none');
            }
        });
        // Cho phép chọn nhiều màu sắc 1 lúc
        $(document).on('click', '.ma-mau-input', function() {
            $(this).toggleClass('selected');
            if ($(this).hasClass('selected')) {
                $(this).css({'border':'3px solid rgb(250, 121, 15)','box-shadow':'0 0 0 2px rgb(86, 211, 57)'});
            } else {
                $(this).css({'border':'2px solid #888','box-shadow':'none'});
            }
        });
        // Khi bấm Thêm, lấy tất cả các màu đã chọn
        $('#confirmColorSelection').on('click', function() {
            let selectedInputs = $('.ma-mau-input.selected');
            if (selectedInputs.length === 0) {
                Swal.fire('Lỗi', 'Vui lòng chọn ít nhất một màu!', 'error');
                return;
            }
            selectedColors = [];
            selectedInputs.each(function() {
                selectedColors.push({
                    id: $(this).data('color-id'),
                    name: $(this).val(),
                    ten: $(this).data('color-name')
                });
            });
            $('#colorModal').modal('hide');
            renderSelectedColors();
            generateProductDetails();
        });

        // Xác nhận chọn kích thước
        $('#confirmSizeSelection').on('click', function() {
            selectedSizes = [];
            $('#sizeModal .size-btn.selected').each(function() {
                selectedSizes.push({
                    id: $(this).data('size-id'),
                    name: $(this).data('size-name')
                });
            });
            // Kiểm tra các trường bắt buộc
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }
            $('#sizeModal').modal('hide');
            renderSelectedSizes();
            generateProductDetails();
        });

        // Toggle chọn size với hiệu ứng
        $(document).on('click', '.size-btn', function() {
            $(this).toggleClass('selected');
            if ($(this).hasClass('selected'))
                $(this).css({'border':'2px solid #007bff','background':'#e3f0ff','color':'#007bff'});
            else
                $(this).css({'border':'2px solid #ddd','background':'white','color':'black'});
        });


        function generateProductDetails() {
            const tbody = $('#productDetailList');
            tbody.empty();
            let stt = 1;
            const tenSanPham = $('select[name="SanPhamId"] option:selected').text();
            const sanPhamId = $('select[name="SanPhamId"]').val();
            const thuongHieuId = $('select[name="ThuongHieuId"]').val();
            const chatLieuId = $('select[name="ChatLieuId"]').val();
            const deGiayId = $('select[name="DeGiayId"]').val();
            const trangThai = $('#trangThaiSelect').val();

            // Kiểm tra các trường bắt buộc
            if (!sanPhamId || !thuongHieuId || !chatLieuId || !deGiayId) {
                Swal.fire('Lỗi', 'Vui lòng chọn đầy đủ thông tin sản phẩm chi tiết', 'error');
                return;
            }

            // Kiểm tra đã chọn màu sắc và kích thước
            if (selectedColors.length === 0 || selectedSizes.length === 0) {
                let msg = '';
                if (selectedColors.length === 0 && selectedSizes.length === 0) msg = 'Vui lòng chọn ít nhất một màu sắc và một kích thước';
                else if (selectedColors.length === 0) msg = 'Vui lòng chọn ít nhất một màu sắc';
                else msg = 'Vui lòng chọn ít nhất một kích thước';
                Swal.fire('Lỗi', msg, 'error');
                return;
            }

            // Nhóm sản phẩm chi tiết theo màu sắc
            let groupedItems = {};
            selectedColors.forEach(color => {
                selectedSizes.forEach(size => {
                    const groupKey = `${sanPhamId}-${color.id}`;
                    if (!groupedItems[groupKey]) {
                        groupedItems[groupKey] = {
                            color: color,
                            items: []
                        };
                    }
                    groupedItems[groupKey].items.push({
                        stt: stt++,
                        sanPhamId: sanPhamId,
                        thuongHieuId: thuongHieuId,
                        chatLieuId: chatLieuId,
                        deGiayId: deGiayId,
                        mauSacId: color.id,
                        kichThuocId: size.id,
                        tenSanPham: tenSanPham,
                        sizeName: size.name,
                        colorName: color.ten,
                        trangThai: trangThai
                    });
                });
            });

            // Render bảng với các nhóm hàng
            for (const groupKey in groupedItems) {
                const group = groupedItems[groupKey];
                const groupSize = group.items.length;
                group.items.forEach((item, index) => {
                    let isFirstInGroup = index === 0;
                    let row = $('<tr>').attr({
                        'data-sanpham-id': item.sanPhamId,
                        'data-thuonghieu-id': item.thuongHieuId,
                        'data-chatlieu-id': item.chatLieuId,
                        'data-degiay-id': item.deGiayId,
                        'data-mausac-id': item.mauSacId,
                        'data-kichthuoc-id': item.kichThuocId,
                        'data-trangthai': item.trangThai,
                        'data-color-group': groupKey
                    });

                    row.append(`<td><input type="checkbox" class="product-checkbox row-check" /></td>`);
                    row.append(`<td class="stt">${item.stt}</td>`);
                    row.append(`<td class="product-name">${item.tenSanPham} [ ${item.sizeName} - ${item.colorName} ]</td>`);
                    row.append(`<td><input type="number" class="form-control quantity-input" min="1" value="1" style="width: 80px;" /></td>`);
                    row.append(`
                        <td>
                            <div class="input-group" style="width: 200px;">
                                <input type="text" class="form-control price-input" value="1.000.000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </td>
                    `);
                    row.append(`
                        <td style="text-align: center">
                            <button type="button" class="btn btn-danger btn-sm delete-row">
                                <i class="bx bx-trash"></i>
                            </button>
                        </td>
                    `);

                    // Chỉ thêm cột upload ảnh cho hàng đầu tiên trong nhóm
                    if (isFirstInGroup) {
                        let uploadCell = $('<td>').addClass('spct-images-cell').attr('rowspan', groupSize).css({
                            'vertical-align': 'middle',
                            'text-align': 'center'
                        });
                        uploadCell.append(`
                            <div class="image-preview-container d-flex flex-wrap gap-1 justify-content-center mt-2"></div>
                            <button type="button" class="btn btn-light btn-sm upload-image" data-color-group-key="${groupKey}">
                                <i class="bx bx-upload"></i> Upload
                            </button>
                        `);
                        row.append(uploadCell);
                    }

                    tbody.append(row);
                });
            }

            // Phân trang
            renderProductDetailPagination();
        }
        // Khi thay đổi các trường thông tin thì sẽ reload lại list danh sách SPCT new
        $(document).ready(function() {
            $('select[name="SanPhamId"], select[name="ThuongHieuId"], select[name="ChatLieuId"], select[name="DeGiayId"], #trangThaiSelect').on('change', function() {
                if (selectedColors.length > 0 && selectedSizes.length > 0) {
                    generateProductDetails();
                }
            });
        });

        // function generateProductDetails() {
        //     const tbody = $('#productDetailList');
        //     const tenSanPham = $('select[name="SanPhamId"] option:selected').text();
        //     const sanPhamId = $('select[name="SanPhamId"]').val();
        //     const thuongHieuId = $('select[name="ThuongHieuId"]').val();
        //     const chatLieuId = $('select[name="ChatLieuId"]').val();
