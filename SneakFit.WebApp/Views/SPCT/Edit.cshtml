@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.SuaSPCT

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="editSPCTForm">
    @Html.HiddenFor(m => m.Id)
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="SanPhamId" class="form-label">Sản phẩm</label>
                <select asp-for="SanPhamId" class="form-select" asp-items="@ViewBag.SanPhams">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
                <span asp-validation-for="SanPhamId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MauSacId" class="form-label">Màu sắc</label>
                <select asp-for="MauSacId" class="form-select" asp-items="@ViewBag.MauSacs">
                    <option value="">-- Chọn màu sắc --</option>
                </select>
                <span asp-validation-for="MauSacId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="KichThuocId" class="form-label">Kích thước</label>
                <select asp-for="KichThuocId" class="form-select" asp-items="@ViewBag.KichThuocs">
                    <option value="">-- Chọn kích thước --</option>
                </select>
                <span asp-validation-for="KichThuocId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChatLieuId" class="form-label">Chất liệu</label>
                <select asp-for="ChatLieuId" class="form-select" asp-items="@ViewBag.ChatLieus">
                    <option value="">-- Chọn chất liệu --</option>
                </select>
                <span asp-validation-for="ChatLieuId" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="DeGiayId" class="form-label">Đế giày</label>
                <select asp-for="DeGiayId" class="form-select" asp-items="@ViewBag.DeGiays">
                    <option value="">-- Chọn đế giày --</option>
                </select>
                <span asp-validation-for="DeGiayId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ThuongHieuId" class="form-label">Thương hiệu</label>
                <select asp-for="ThuongHieuId" class="form-select" asp-items="@ViewBag.ThuongHieus">
                    <option value="">-- Chọn thương hiệu --</option>
                </select>
                <span asp-validation-for="ThuongHieuId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Gia" class="form-label">Giá sản phẩm</label>
                <input asp-for="Gia" type="number" class="form-control" min="0" step="1000" placeholder="Nhập giá sản phẩm" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SoLuong" class="form-label">Số lượng</label>
                <input asp-for="SoLuong" type="number" class="form-control" min="0" placeholder="Nhập số lượng" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Images" class="form-label">Hình ảnh (có thể chọn nhiều)</label>
        <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
        <span asp-validation-for="Images" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
        <label asp-for="TrangThai" class="form-check-label">Hoạt động</label>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}