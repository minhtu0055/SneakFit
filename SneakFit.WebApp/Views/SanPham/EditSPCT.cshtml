@section Scripts {
    <!-- Bootstrap Icons (dùng CDN để tránh lỗi) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Thêm thư viện color picker -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-minicolors/2.3.6/jquery.minicolors.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-minicolors/2.3.6/jquery.minicolors.min.js"></script>

    <script>
        $(document).ready(function() {
            // Chọn dòng bằng double click
            $('#spctTable tbody tr').on('dblclick', function(e) {
                // Bỏ qua nếu click vào input hoặc button
                if (!$(e.target).is('input, button')) {
                    var $row = $(this);
                    var $checkbox = $row.find('.row-check');
                    var isSelected = $checkbox.prop('checked');

                    // Toggle checkbox
                    $checkbox.prop('checked', !isSelected);

                    // Toggle highlight cho dòng
                    $row.toggleClass('table-info', !isSelected);

                    // Kiểm tra và cập nhật trạng thái của checkAll
                    updateCheckAllState();
                }
                $('#spctTable tbody tr').removeClass('table-info');
                $(this).addClass('table-info');
            });

            // CheckAll: Chọn hoặc bỏ chọn tất cả
            $('#checkAll').on('change', function() {
                var isChecked = $(this).prop('checked');
                $('.row-check').prop('checked', isChecked);
                $('#spctTable tbody tr').toggleClass('table-info', isChecked);
            });

            // Thêm sự kiện change cho các checkbox .row-check
            $('#spctTable tbody').on('change', '.row-check', function() {
                updateCheckAllState();
            });
            // Hàm kiểm tra và cập nhật trạng thái checkAll
            function updateCheckAllState() {
                var allChecked = $('.row-check').length === $('.row-check:checked').length;

                // Nếu không phải tất cả đều được chọn, bỏ tích checkAll
                if (!allChecked) {
                    $('#checkAll').prop('checked', false);
                } else {
                    // Nếu tất cả đều được chọn, check lại checkAll
                    $('#checkAll').prop('checked', true);
                }
            }

            // Chỉ cho nhập số và tự động format giá bán
            $(document).on('input', '.gia-ban', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value) {
                    value = parseInt(value, 10).toLocaleString('vi-VN');
                }
                $(this).val(value);
            });

            // Thay thế sự kiện #updateAll:
            $('#updateAll').off('click').on('click', function() {
                // Kiểm tra xem có dòng nào được chọn không
                var selectedRows = $('.row-check:checked').closest('tr');
                if (selectedRows.length === 0) {
