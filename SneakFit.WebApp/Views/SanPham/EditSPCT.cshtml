<!-- Modal Sửa Giá và Số Lượng Chung -->
<div class="modal fade" id="modalEditPriceQuantity" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa giá và số lượng chung</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Giá bán (VNĐ)</label>
                    <input type="text" id="editAllPrice" class="form-control gia-ban" placeholder="Nhập giá, ví dụ: 1.000.000" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Số lượng</label>
                    <input type="number" id="editAllQuantity" class="form-control so-luong" min="10" placeholder="Nhập số lượng" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnApplyEditAll">Áp dụng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- jQuery (nên đã có) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JS (nếu dùng) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <!-- Bootstrap Colorpicker CSS & JS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-colorpicker/3.4.0/css/bootstrap-colorpicker.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-colorpicker/3.4.0/js/bootstrap-colorpicker.min.js"></script>

    <script>
        $(document).ready(function() {
            // Chọn dòng
            $('#spctTable tbody tr').on('click', function(e) {
                if (!$(e.target).is('input, button')) {
                    $(this).find('.row-check').prop('checked', true);
                }
                $('#spctTable tbody tr').removeClass('table-info');
                $(this).addClass('table-info');
            });

            // CheckAll
            $('#checkAll').on('change', function() {
                $('.row-check').prop('checked', this.checked);
            });

            // Format giá bán khi nhập
            $(document).on('input', '.gia-ban', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value) {
                    value = parseInt(value, 10).toLocaleString('vi-VN');
                }
                $(this).val(value);
            });

            // Thay thế sự kiện #updateAll:
            $('#updateAll').off('click').on('click', function() {
                // Lấy giá và số lượng đầu tiên để fill vào modal (nếu có)
                let firstPrice = $('.gia-ban').first().val() || '';
                let firstQuantity = $('.so-luong').first().val() || '';
                $('#editAllPrice').val(firstPrice);
                $('#editAllQuantity').val(firstQuantity);
                $('#modalEditPriceQuantity').modal('show');
            });

            // Xử lý khi bấm Áp dụng trong modal
            $('#btnApplyEditAll').off('click').on('click', function() {
                let price = $('#editAllPrice').val().replace(/\./g, '');
                let quantity = $('#editAllQuantity').val();
                
                if (!price || !quantity) {
                    alert('Vui lòng nhập đầy đủ giá và số lượng!');
                    return;
                }

                // Format giá trước khi hiển thị
                let formattedPrice = parseInt(price).toLocaleString('vi-VN');
                $('.gia-ban').val(formattedPrice);
                $('.so-luong').val(quantity);
                $('#modalEditPriceQuantity').modal('hide');
            });

            // Update selected
            $('#updateSelected').on('click', function() {
                var selectedRows = $('.row-check:checked').closest('tr');
                if (selectedRows.length === 0) {
                    alert('Vui lòng chọn ít nhất một sản phẩm!');
                    return;
                }

                var updates = [];
                selectedRows.each(function() {
                    var row = $(this);
                    var soLuongInput = row.find('.so-luong').val();
                    var giaBanInput = row.find('.gia-ban').val();

                    // Xử lý giá trị số lượng
                    var soLuong = parseInt(soLuongInput) || 0;

                    // Xử lý giá trị giá bán - loại bỏ dấu phẩy và chấm
                    var giaBan = parseInt(giaBanInput.replace(/[.,]/g, '')) || 0;

                    if (soLuong >= 0 && giaBan > 0) {
                        updates.push({
                            id: row.data('id'),
                            soLuong: soLuong,
                            gia: giaBan
                        });
                    }
                });

                if (updates.length > 0) {
                    $.ajax({
                        url: '/SanPham/UpdateSPCT',
                        type: 'POST',
                        data: JSON.stringify(updates),
                        contentType: 'application/json',
                        success: function(response) {
                            if (response.success) {
                                alert('Cập nhật thành công!');
                                location.reload();
                            } else {
                                alert('Có lỗi xảy ra: ' + (response.message || 'Không xác định'));
                            }
                        },
                        error: function(xhr) {
                            alert('Có lỗi xảy ra khi gửi yêu cầu! Chi tiết: ' + xhr.responseText);
                        }
                    });
                }
            });

            // Thêm xử lý format giá tiền khi nhập
            $('.gia-ban').on('input', function() {
                let value = $(this).val().replace(/[^0-9]/g, '');
                if (value) {
                    value = parseInt(value).toLocaleString('vi-VN');
                    $(this).val(value);
                }
            });

            // Format giá bán khi nhập trong modal
            $('#editAllPrice').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value) {
                    value = parseInt(value, 10).toLocaleString('vi-VN');
                }
                $(this).val(value);
            });

            // Fill combobox dữ liệu từ ViewBag khi mở modal
            function fillCombobox(selector, data, value, text) {
                var $select = $(selector);
                $select.empty();
                $select.append('<option value="">Chọn</option>');
                for (var i = 0; i < data.length; i++) {
                    $select.append('<option value="' + data[i][value] + '">' + data[i][text] + '</option>');
                }
            }

            // Khi click 👁️
            $(document).on('click', '.btn-view', function() {
                var id = $(this).closest('tr').data('id');
                // Lấy dữ liệu combobox từ ViewBag (render ra JS object ở view)
                var thuongHieus = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ThuongHieus));
                var chatLieus = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChatLieus));
                var deGiays = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DeGiays));
                var kichThuocs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.KichThuocs));
                var mauSacs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MauSacs));
                // Chuyển đổi đối tượng thành mảng để vòng lặp dễ dàng hơn
                function objToArr(obj) {
                    return Object.keys(obj).map(function(key) {
                        return { id: key, name: obj[key] };
                    });
                }
                fillCombobox("#productDetailModal select[name='ThuongHieuId']", objToArr(thuongHieus), 'id', 'name');
                fillCombobox("#productDetailModal select[name='ChatLieuId']", objToArr(chatLieus), 'id', 'name');
                fillCombobox("#productDetailModal select[name='DeGiayId']", objToArr(deGiays), 'id', 'name');
                fillCombobox("#productDetailModal select[name='KichThuocId']", objToArr(kichThuocs), 'id', 'name');
                fillCombobox("#productDetailModal select[name='MauSacId']", objToArr(mauSacs), 'id', 'name');
                // Gọi backend lấy chi tiết sản phẩm
                $.get('/SanPham/GetSPCTDetail', { id: id }, function(data) {
                    // Fill dữ liệu vào các trường như cũ
                    $("#productDetailModal input[name='TenSanPham']").val(data.tenSanPham);
                    $("#productDetailModal textarea[name='MoTa']").val(data.moTa);
                    $("#productDetailModal select[name='ThuongHieuId']").val(data.thuongHieuId);
                    $("#productDetailModal select[name='TrangThai']").val(data.trangThai ? 'true' : 'false');
                    $("#productDetailModal select[name='ChatLieuId']").val(data.chatLieuId);
                    $("#productDetailModal select[name='DeGiayId']").val(data.deGiayId);
                    $("#productDetailModal select[name='KichThuocId']").val(data.kichThuocId);
                    $("#productDetailModal select[name='MauSacId']").val(data.mauSacId).trigger('change');
                    $("#productDetailModal input[name='SoLuong']").val(data.soLuong);
                    // $("#productDetailModal input[name='SoLuongHangTra']").val(data.soLuongHangTra);
                    $("#productDetailModal input[name='GiaBan']").val(Number(data.giaBan).toLocaleString('vi-VN'));
                    // QR code
                    $("#qrCodePreview").html('<img src="' + data.qrCodeUrl + '" style="width:100px;" />');
                    // Ảnh sản phẩm
                    renderProductImages(data.images);
                    $('#productDetailModal').modal('show');
                });
            });

            // Render ảnh sản phẩm
            function renderProductImages(images) {
                var html = '';
                (images || []).forEach(function(img, idx) {
                    html += `
                        <div>
                            <img src="${img.urlHinhAnh}" style="width:180px;height:180px;object-fit:contain;" />
                            ${img.isDefault ? '<span class="badge bg-success">Mặc định</span>' : ''}
                            <button ... data-id="${img.id}">Xóa</button>
                        </div>
                    `;
                });
                $('#productImages').html(html);
            }

            // Thêm ảnh
            $('#btnUploadImage').on('click', function() {
                $('#uploadImageInput').click();
            });

            $('#uploadImageInput').on('change', function() {
                var files = this.files;
                if (!files.length) return;

                // Kiểm tra định dạng file
                var allowedExtensions = ['jpg', 'jpeg', 'png', 'gif', 'webp'];
                for (let i = 0; i < files.length; i++) {
                    let ext = files[i].name.split('.').pop().toLowerCase();
                    if (!allowedExtensions.includes(ext)) {
                        alert('Chỉ cho phép upload các file ảnh: jpg, jpeg, png, gif, webp!');
                        return;
                    }
                }

                var formData = new FormData();
                for (let i = 0; i < files.length; i++) {
                    formData.append('files', files[i]);
                }

                var spctId = $('#spctTable tr.table-info').data('id');
                formData.append('sanPhamChiTietId', spctId);

                $.ajax({
                    url: '/SanPham/UploadImages',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if(response.success) {
                            // Sau khi upload thành công, lấy lại danh sách ảnh mới
                            $.get('/SanPham/GetSPCTDetail', { id: spctId }, function(data) {
                                renderProductImages(data.images);
                            });
                        } else {
                            alert('Upload ảnh thất bại: ' + (response.message || 'Không xác định'));
                        }
                    },
                    error: function(xhr) {
                        alert('Có lỗi khi upload ảnh: ' + xhr.responseText);
                    }
                });
            });

            // Xóa ảnh
            $(document).on('click', '.btn-delete-image', function() {
                if (!confirm('Bạn có chắc muốn xóa ảnh này?')) return;

                var imageId = $(this).data('id');
                var spctId = $('#spctTable tr.table-info').data('id');

                $.ajax({
                    url: '/SanPham/DeleteImage',
                    type: 'DELETE',
                    data: { imageId: imageId, sanPhamChiTietId: spctId },
                    success: function(response) {
                        if(response.success) {
                            // Sau khi xóa thành công, lấy lại danh sách ảnh mới
                            $.get('/SanPham/GetSPCTDetail', { id: spctId }, function(data) {
                                renderProductImages(data.images);
                            });
                        } else {
                            alert('Xóa ảnh thất bại: ' + (response.message || 'Không xác định'));
                        }
                    },
                    error: function(xhr) {
                        alert('Có lỗi khi xóa ảnh: ' + xhr.responseText);
                    }
                });
            });

            // Set ảnh mặc định
            $(document).on('click', '.btn-set-default', function() {
                var imageId = $(this).data('id');
                var spctId = $('#spctTable tr.table-info').data('id');

                $.ajax({
                    url: '/SanPham/SetDefaultImage',
                    type: 'PUT',
                    data: { imageId: imageId, spctId: spctId },
                    success: function(response) {
                        if(response.success) {
                            // Sau khi set thành công, lấy lại danh sách ảnh mới
                            $.get('/SanPham/GetSPCTDetail', { id: spctId }, function(data) {
                                renderProductImages(data.images);
                            });
                        } else {
                            alert('Set ảnh mặc định thất bại: ' + (response.message || 'Không xác định'));
                        }
                    },
                    error: function(xhr) {
                        alert('Có lỗi khi set ảnh mặc định: ' + xhr.responseText);
                    }
                });
            });

            // Khi chọn màu sắc thì đổi màu preview
            $("#productDetailModal select[name='MauSacId']").on('change', function() {
                var color = $(this).find('option:selected').text();
                $('#colorPreview').css('background', color);
            });

            // Hàm mở modal thêm thương hiệu
            function openAddThuongHieuModal() {
                $.get('/ThuongHieu/Create', function(html) {
                    $('#modalAddThuongHieuContent').html(html);
                    $('#modalAddThuongHieu').modal('show');
                });
            }

            // Hàm mở modal thêm đế giày
            function openAddDeGiayModal() {
                $.get('/DeGiay/Create', function(html) {
                    $('#modalAddDeGiayContent').html(html);
                    $('#modalAddDeGiay').modal('show');
                });
            }

            // Hàm mở modal thêm chất liệu
            function openAddChatLieuModal() {
                $.get('/ChatLieu/Create', function(html) {
                    $('#modalAddChatLieuContent').html(html);
                    $('#modalAddChatLieu').modal('show');
                });
            }

            // Hàm mở modal thêm kích thước
            function openAddKichThuocModal() {
                $.get('/KichThuoc/Create', function(html) {
                    $('#modalAddKichThuocContent').html(html);
                    $('#modalAddKichThuoc').modal('show');
                });
            }

            // Xử lý sự kiện click cho các button +
            $(document).on('click', 'button[data-type]', function() {
                var type = $(this).data('type');
                switch(type) {
                    case 'thuonghieu':
                        openAddThuongHieuModal();
                        break;
                    case 'chatlieu':
                        openAddChatLieuModal();
                        break;
                    case 'degiay':
                        openAddDeGiayModal();
                        break;
                    case 'kichthuoc':
                        openAddKichThuocModal();
                        break;
                    case 'mausac':
                        $('#modalAddMauSac').modal('show');
                        break;
                }
            });

            // Handle color picker
            if ($('#addColorPicker').length) {
                $('#addColorPicker').on('input', function() {
                    $('#addColorHex').val($(this).val());
                });
            }

            // Xử lý lưu màu mới
            $('#saveNewColor').on('click', function() {
                const colorName = $('#addColorName').val();
                const colorHex = $('#addColorHex').val();
                
                if (!colorName || !colorHex) {
                    alert('Vui lòng nhập đầy đủ thông tin màu sắc!');
                    return;
                }

                $.post('/SanPham/AddMauSac', {
                    tenMauSac: colorName,
                    maMau: colorHex
                }, function(response) {
                    if (response.success) {
                        $('#modalAddMauSac').modal('hide');
                        // Làm mới danh sách thả xuống màu sắc
                        location.reload();
                    } else {
                        alert('Có lỗi xảy ra: ' + response.message);
                    }
                });
            });

            // Xử lý việc gửi biểu mẫu cho các phương thức khác
            $(document).on('submit', '#formAddThuongHieu', function(e) {
                e.preventDefault();
                const formData = $(this).serialize();
                $.post('/SanPham/AddThuongHieu', formData, function(response) {
                    if (response.success) {
                        $('#modalAddThuongHieu').modal('hide');
                        location.reload();
                    } else {
                        alert('Có lỗi xảy ra: ' + response.message);
                    }
                });
            });

            $(document).on('submit', '#formAddChatLieu', function(e) {
                e.preventDefault();
                const formData = $(this).serialize();
                $.post('/SanPham/AddChatLieu', formData, function(response) {
                    if (response.success) {
                        $('#modalAddChatLieu').modal('hide');
                        location.reload();
                    } else {
                        alert('Có lỗi xảy ra: ' + response.message);
                    }
                });
            });

            $(document).on('submit', '#formAddDeGiay', function(e) {
                e.preventDefault();
                const formData = $(this).serialize();
                $.post('/SanPham/AddDeGiay', formData, function(response) {
                    if (response.success) {
                        $('#modalAddDeGiay').modal('hide');
                        location.reload();
                    } else {
                        alert('Có lỗi xảy ra: ' + response.message);
                    }
                });
            });

            $(document).on('submit', '#formAddKichThuoc', function(e) {
                e.preventDefault();
                const formData = $(this).serialize();
                $.post('/SanPham/AddKichThuoc', formData, function(response) {
                    if (response.success) {
                        $('#modalAddKichThuoc').modal('hide');
                        location.reload();
                    } else {
                        alert('Có lỗi xảy ra: ' + response.message);
                    }
                });
            });

            $('#btnSaveProductDetail').on('click', function() {
                var spctId = $('#spctTable tr.table-info').data('id');
                var formData = {
                    Id: spctId,
                    TenSanPham: $("#productDetailModal input[name='TenSanPham']").val(),
                    MoTa: $("#productDetailModal textarea[name='MoTa']").val(),
                    ThuongHieuId: $("#productDetailModal select[name='ThuongHieuId']").val(),
                    ChatLieuId: $("#productDetailModal select[name='ChatLieuId']").val(),
                    DeGiayId: $("#productDetailModal select[name='DeGiayId']").val(),
                    KichThuocId: $("#productDetailModal select[name='KichThuocId']").val(),
                    MauSacId: $("#productDetailModal select[name='MauSacId']").val(),
                    TrangThai: $("#productDetailModal select[name='TrangThai']").val() === "true",
                    SoLuong: $("#productDetailModal input[name='SoLuong']").val(),
                    GiaBan: parseInt($("#productDetailModal input[name='GiaBan']").val().replace(/[^0-9]/g, ''), 10) || 0
                };
                $.ajax({
                    url: '/SanPham/UpdateSPCTDetail',
                    type: 'POST',
                    data: JSON.stringify(formData),
                    contentType: 'application/json',
                    success: function(response) {
                        if (response.success) {
                            alert('Cập nhật thành công!');
                            location.reload();
                        } else {
                            alert('Có lỗi xảy ra: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra khi gửi yêu cầu!');
                    }
                });
            });
        });

        // Chỉ cho nhập số và tự động format giá bán
        $(document).on('input', '.gia-ban, .price-input', function() {
            let value = $(this).val().replace(/[^0-9]/g, ''); // Loại bỏ ký tự không phải số
            if (value) {
                value = value.replace(/^0+/, ''); // Loại bỏ số 0 ở đầu
                value = value.replace(/\B(?=(\d{3})+(?!\d))/g, '.'); // Thêm dấu chấm hàng nghìn
            }
            $(this).val(value);
        });

        // Chỉ cho nhập số lượng là số nguyên dương
        $(document).on('input', '.so-luong, .quantity-input', function() {
            let value = $(this).val().replace(/[^0-9]/g, '');
            value = value.replace(/^0+/, ''); // Loại bỏ số 0 ở đầu
            $(this).val(value);
        });
    </script>
}

