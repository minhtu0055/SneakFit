@model SneakFit.ViewModels.Catalog.SanPhamChiTiet.SuaSPCT
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var baseUrl = Configuration["BaseAddress"];
}
<div class="container-fluid">
    <!-- KHỐI 1: BỘ LỌC -->
    <div class="card mb-3">
        <div class="card-header fw-bold">
            <i class="fa fa-filter"></i> Bộ lọc
        </div>
        <div class="card-body">
            <form id="filterForm" method="get">
                <!-- Hàng 1: Tên sản phẩm -->
                <div class="row mb-2">
                    <div class="col-md-12">
                        <input type="text" class="form-control" name="TuKhoa" placeholder="Nhập tên sản phẩm" value="@Context.Request.Query["TuKhoa"]" />
                    </div>
                </div>
                <!-- Hàng 2: Chất liệu, Thương hiệu, Đế giày, Khoảng giá Từ -->
                <div class="row mb-2">
                    <div class="col-md-3">
                        <select class="form-select" name="ChatLieuId">
                            <option value="">Chất liệu</option>
                            @foreach (var cl in (IDictionary<Guid, string>)ViewBag.ChatLieus)
                            {
                                var isSelected = Context.Request.Query["ChatLieuId"] == cl.Key.ToString();
                                if (isSelected)
                                {
                                    <option value="@cl.Key" selected>@cl.Value</option>
                                }
                                else
                                {
                                    <option value="@cl.Key">@cl.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="ThuongHieuId">
                            <option value="">Thương hiệu</option>
                            @foreach (var th in (IDictionary<Guid, string>)ViewBag.ThuongHieus)
                            {
                                var isSelected = Context.Request.Query["ThuongHieuId"] == th.Key.ToString();
                                if (isSelected)
                                {
                                    <option value="@th.Key" selected>@th.Value</option>
                                }
                                else
                                {
                                    <option value="@th.Key">@th.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="DeGiayId">
                            <option value="">Đế giày</option>
                            @foreach (var dg in (IDictionary<Guid, string>)ViewBag.DeGiays)
                            {
                                var isSelected = Context.Request.Query["DeGiayId"] == dg.Key.ToString();
                                if (isSelected)
                                {
                                    <option value="@dg.Key" selected>@dg.Value</option>
                                }
                                else
                                {
                                    <option value="@dg.Key">@dg.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control gia-ban" name="GiaTu" placeholder="Giá từ" value="@Context.Request.Query["GiaTu"]" />
                    </div>
                </div>
                <!-- Hàng 3: Kích cỡ, Màu sắc, Trạng thái, Khoảng giá Đến -->
                <div class="row mb-2">
                    <div class="col-md-3">
                        <select class="form-select" name="KichThuocId">
                            <option value="">Kích cỡ</option>
                            @foreach (var kt in (IDictionary<Guid, string>)ViewBag.KichThuocs)
                            {
                                var isSelected = Context.Request.Query["KichThuocId"] == kt.Key.ToString();
                                if (isSelected)
                                {
                                    <option value="@kt.Key" selected>@kt.Value</option>
                                }
                                else
                                {
                                    <option value="@kt.Key">@kt.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="MauSacId">
                            <option value="">Màu sắc</option>
                            @foreach (var ms in (IDictionary<Guid, string>)ViewBag.MauSacs)
                            {
                                var isSelected = Context.Request.Query["MauSacId"] == ms.Key.ToString();
                                if (isSelected)
                                {
                                    <option value="@ms.Key" selected>@ms.Value</option>
                                }
                                else
                                {
                                    <option value="@ms.Key">@ms.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="TrangThai">
                            <option value="">Trạng thái</option>
                            @{
                                var isSelectedTrue = Context.Request.Query["TrangThai"] == "true";
                                var isSelectedFalse = Context.Request.Query["TrangThai"] == "false";
                            }
                            @if (isSelectedTrue)
                            {
                                <option value="true" selected>Đang kinh doanh</option>
                            }
                            else
                            {
                                <option value="true">Đang kinh doanh</option>
                            }
                            @if (isSelectedFalse)
                            {
                                <option value="false" selected>Ngừng kinh doanh</option>
                            }
                            else
                            {
                                <option value="false">Ngừng kinh doanh</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control gia-ban" name="GiaDen" placeholder="Giá đến" value="@Context.Request.Query["GiaDen"]" />
                    </div>
                </div>
                <!-- Hàng 4: Tìm kiếm, Làm mới, QR Code -->
                <div class="row mb-2">
                    <div class="col-md-12 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <button type="reset" class="btn btn-dark" onclick="window.location.href=window.location.pathname">
                            <i class="bx bx-reset"></i> Reset
                        </button>
                        <button type="button" class="btn btn-primary">QR Code sản phẩm</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- KHỐI 2: DANH SÁCH SẢN PHẨM CHI TIẾT -->
    <div class="card">
        <div class="card-header fw-bold">
            <i class="fa fa-list"></i> Danh sách sản phẩm chi tiết
        </div>
        <div class="card-body">
            <div class="mb-2 text-end">
                <button class="btn btn-primary" id="updateAll">Chỉnh số lượng và giá chung</button>
                <button class="btn btn-primary" style="margin-left: 5px" id="updateSelected">Update sản phẩm</button>
            </div>
            <table class="table table-hover align-middle" id="spctTable">
                <thead class="table">
                    <tr style="background-color: mediumpurple; color: white;">
                        <th style="width: 30px;"><input type="checkbox" id="checkAll" /></th>
                        <th style="width: 30px;">STT</th>
                        <th style="width: 100px;">Ảnh</th>
                        <th style="min-width: 250px;">Tên Sản Phẩm</th>
                        <th style="width: 112px;">Số Lượng</th>
                        <th style="width: 120px;">Giá Bán</th>
                        <th style="width: 120px;">Trạng Thái</th>
                        <th style="width: 1px">@* Hành động *@</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                        var sanPhams = ViewBag.SanPhams as Dictionary<Guid, string>;
                    }
                    @foreach (var item in Model.DanhSachSPCT)
                    {
                        <tr data-id="@item.Id" data-so-luong="@item.SoLuong" data-gia-ban="@item.Gia">
                            <td><input type="checkbox" class="row-check" /></td>
                            <td>@stt</td>
                            <td>
                                @if (item.Images != null && item.Images.Any())
                                {
                                    if (item.Images.Count == 1)
                                    {
                                        <img src="@(baseUrl + item.Images.First())" alt="@item.HinhAnh" class="rounded" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='/images/no-image.png'" />
                                    }
                                    else
                                    {
                                        <div id="carousel-@item.Id" class="carousel slide" data-bs-ride="carousel" style="width: 80px; height: 80px;">
                                            <div class="carousel-inner">
                                                @for (int i = 0; i < item.Images.Count; i++)
                                                {
                                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                                        <img src="@(baseUrl + item.Images[i])" alt="@item.HinhAnh" class="d-block w-100 rounded" style="height: 80px; object-fit: cover;" onerror="this.src='/images/no-image.png'" />
                                                    </div>
                                                }
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target="#carousel-@item.Id" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon"></span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#carousel-@item.Id" data-bs-slide="next">
                                                <span class="carousel-control-next-icon"></span>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <img src="/images/no-image.png" alt="No Image" class="rounded" style="width: 80px; height: 80px; object-fit: cover;" />
                                }
                            </td>
                            <td>
                                @{
                                    var tenSanPham = (sanPhams != null && sanPhams.ContainsKey(item.SanPhamId)) ? sanPhams[item.SanPhamId] : "";
                                    var kichThuoc = ViewBag.KichThuocs[item.KichThuocId];
                                    var mauSac = ViewBag.MauSacs[item.MauSacId];
                                }
                                @($"{tenSanPham} ( {kichThuoc} - {mauSac} )")
                            </td>
                            <td style="width: 100px;">
                                <input type="number" class="form-control so-luong" value="@item.SoLuong" min="0" style="width: 70px; padding: 2px 6px; font-size: 0.95em;" />
                            </td>
                            <td style="width: 120px;">
                                <input type="text" class="form-control gia-ban" value="@item.Gia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))" style="width: 110px; padding: 2px 6px; font-size: 0.95em;" />
                            </td>
                            <td>
                                <span class="badge @(item.TrangThai ? "bg-success" : "bg-danger")">
                                    @(item.TrangThai ? "Đang kinh doanh" : "Ngừng kinh doanh")
                                </span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-primary btn-view" style="width: 40px" data-id="@item.Id">👁️</button>
                            </td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal chi tiết sản phẩm -->
<div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="min-width:900px;max-width:1200px;width:90vw;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productDetailModalLabel">Thông Tin Sản Phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height:70vh; overflow-y:auto;">
                <form id="productDetailForm">
                    <div class="mb-2">
                        <label class="form-label fw-bold">Tên sản phẩm :</label>
                        <input type="text" class="form-control" name="TenSanPham" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold">Mô tả :</label>
                        <textarea class="form-control" name="MoTa" rows="2" required></textarea>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Thương hiệu :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="ThuongHieuId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="thuonghieu">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Chất Liệu :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="ChatLieuId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="chatlieu">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Đế Giày :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="DeGiayId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="degiay">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Kích Cỡ :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="KichThuocId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="kichthuoc">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Màu Sắc :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="MauSacId" style="border-radius: 8px;" required>
                                    <span class="input-group-text" id="colorPreview" style="width:40px;"></span>
                                </select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="mausac">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Trạng thái :</label>
                            <select class="form-select" name="TrangThai" required>
                                <option value="true">Kinh Doanh</option>
                                <option value="false">Ngừng Kinh Doanh</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số Lượng đang bán :</label>
                            <input type="number" class="form-control so-luong" name="SoLuong" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá Bán :</label>
                            <input type="text" class="form-control gia-ban" name="GiaBan" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        @* <div class="col-md-6">
                            <label class="form-label fw-bold">Số Lượng Hàng Trả :</label>
                            <input type="number" class="form-control" name="SoLuongHangTra" min="0" />
                        </div> *@
                        <div class="col-md-6">
                            <label class="form-label fw-bold">QR Code :</label>
                            <div id="qrCodePreview"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold d-block text-center" style="font-size: 1.2em;">Ảnh Sản Phẩm</label>
                        <div id="productImages" class="d-flex flex-wrap gap-2 justify-content-center mb-2">
                            <!-- Ảnh sẽ được render ở đây bằng JS -->
                        </div>
                        <div class="text-center">
                            <input type="file" id="uploadImageInput" accept="image/*" style="display:none;" multiple />
                            <button type="button" class="btn btn-outline-primary" id="btnUploadImage">+ Upload</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveProductDetail">Chỉnh sửa</button>
            </div>
        </div>
    </div>
</div>

