            if (value) {
                value = value.replace(/^0+/, ''); // Loại bỏ số 0 ở đầu
                value = value.replace(/\B(?=(\d{3})+(?!\d))/g, '.'); // Thêm dấu chấm hàng nghìn
            }
            $(this).val(value);
        });

        // Chỉ cho nhập số lượng là số nguyên dương
        $(document).on('input', '.so-luong, .quantity-input', function() {
            let value = $(this).val().replace(/[^0-9]/g, '');
            // value = value.replace(/^0+/, ''); // Loại bỏ số 0 ở đầu
            $(this).val(value);
        });

        // Tự động set trạng thái khi số lượng về 0
        $(document).on('input', '.so-luong', function () {
            let row = $(this).closest('tr');
            let soLuong = parseInt($(this).val()) || 0;
            let $badge = row.find('span.badge');
            if (soLuong === 0) {
                $badge.removeClass('bg-success').addClass('bg-danger').text('Ngừng kinh doanh');
            } else {
                $badge.removeClass('bg-danger').addClass('bg-success').text('Đang kinh doanh');
            }
        });

        
        // PHÂN TRANG CHO BẢNG SẢN PHẨM CHI TIẾT
        $(document).ready(function () {
            var $table = $('#spctTable');
            var $rows = $table.find('tbody tr');
            var rowsPerPage = 5;
            var currentPage = 1;
            var totalPages = Math.ceil($rows.length / rowsPerPage);

            function renderTablePage(page) {
                $rows.hide();
                $rows.slice((page - 1) * rowsPerPage, page * rowsPerPage).show();
                $('#spctPagination .page-link').removeClass('active');
                $('#spctPagination .page-link[data-page="' + page + '"]').addClass('active');
            }

            function renderPagination() {
                if (totalPages <= 1) {
                    $('#spctPagination').remove();
                    return;
                }
                var html = '';
                for (var i = 1; i <= totalPages; i++) {
                    html += '<li class="page-item"><a class="page-link' + (i === 1 ? ' active' : '') + '" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
                $table.after('<nav><ul class="pagination justify-content-end mt-2" id="spctPagination">' + html + '</ul></nav>');
            }

            renderPagination();
            renderTablePage(currentPage);

            $(document).on('click', '#spctPagination .page-link', function (e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page !== currentPage) {
                    currentPage = page;
                    renderTablePage(currentPage);
                }
            });
        });
    </script>
}

