            // Hàm tính màu chữ tương phản
            function getContrastYIQ(hexcolor) {
                hexcolor = hexcolor.replace('#', '');
                if(hexcolor.length === 3) hexcolor = hexcolor[0]+hexcolor[0]+hexcolor[1]+hexcolor[1]+hexcolor[2]+hexcolor[2];
                var r = parseInt(hexcolor.substr(0,2),16);
                var g = parseInt(hexcolor.substr(2,2),16);
                var b = parseInt(hexcolor.substr(4,2),16);

                // Tính toán độ sáng tương đối
                var brightness = ((r * 299) + (g * 587) + (b * 114)) / 1000;

                // Tính toán độ tương phản với màu trắng và đen
                var contrastWithWhite = Math.abs(brightness - 255);
                var contrastWithBlack = brightness;

                // Chọn màu có độ tương phản cao hơn
                return (contrastWithWhite > contrastWithBlack) ? '#ffffff' : '#000000';
            }


