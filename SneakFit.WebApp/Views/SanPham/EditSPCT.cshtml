                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Thương hiệu :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="ThuongHieuId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="thuonghieu">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Chất Liệu :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="ChatLieuId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="chatlieu">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Đế Giày :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="DeGiayId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="degiay">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Kích Cỡ :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="KichThuocId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="kichthuoc">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Màu Sắc :</label>
                            <div class="input-group align-items-center">
                                <select class="form-select" name="MauSacId" style="border-radius: 8px;" required></select>
                                <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" data-type="mausac">
                                    <i class="bx bx-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Trạng thái :</label>
                            <select class="form-select" name="TrangThai" required>
                                <option value="true">Kinh Doanh</option>
                                <option value="false">Ngừng Kinh Doanh</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số Lượng đang bán :</label>
                            <input type="number" class="form-control" name="SoLuong" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá Bán :</label>
                            <input type="text" class="form-control" name="GiaBan" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold d-block">QR Code :</label>
                            <div id="qrCodePreview" style="display: block; width: 120px; margin-top: 5px;"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold d-block text-center" style="font-size: 1.2em;">Ảnh Sản Phẩm</label>
                        <div id="productImages" class="d-flex flex-wrap gap-2 justify-content-center mb-2">
                            <!-- Ảnh sẽ được render ở đây bằng JS -->
                        </div>
                        <div class="text-center">
                            <input type="file" id="uploadImageInput" accept="image" style="display:none;" multiple />
                            <button type="button" class="btn btn-outline-primary" id="btnUploadImage">+ Upload</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveProductDetail">Chỉnh sửa</button>
            </div>
        </div>
    </div>
</div>

