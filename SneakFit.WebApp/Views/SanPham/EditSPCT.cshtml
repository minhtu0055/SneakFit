@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Chọn dòng
            $('#spctTable tbody tr').on('click', function(e) {
                if (!$(e.target).is('input, button')) {
                    $(this).find('.row-check').prop('checked', true);
                }
                $('#spctTable tbody tr').removeClass('table-info');
                $(this).addClass('table-info');
            });

            // CheckAll
            $('#checkAll').on('change', function() {
                $('.row-check').prop('checked', this.checked);
            });

            // Chỉnh số lượng và giá chung
            $('#updateAll').on('click', function() {
                var soLuong = prompt("Nhập số lượng mới:");
                var giaBan = prompt("Nhập giá bán mới:");
                if (soLuong && giaBan) {
                    $('.so-luong').val(soLuong);
                    $('.gia-ban').val(giaBan);
                }
            });

            // Update selected
            $('#updateSelected').on('click', function() {
                var selectedRows = $('.row-check:checked').closest('tr');
                var updates = [];
                selectedRows.each(function() {
                    var row = $(this);
                    updates.push({
                        id: row.data('id'),
                        soLuong: row.find('.so-luong').val(),
                        giaBan: row.find('.gia-ban').val().replace(/\./g, ''),
                        trangThai: row.find('.badge').text().trim() === "Đang kinh doanh"
                    });
                });
                if (updates.length > 0) {
                    $.ajax({
                        url: '/SanPham/UpdateSPCT',
                        type: 'POST',
                        data: JSON.stringify(updates),
                        contentType: 'application/json',
                        success: function(response) {
                            if (response.success) {
                                alert('Cập nhật thành công!');
                                location.reload();
                            } else {
                                alert('Có lỗi xảy ra: ' + response.message);
                            }
                        },
                        error: function() {
                            alert('Có lỗi xảy ra khi gửi yêu cầu!');
                        }
                    });
                } else {
                    alert('Vui lòng chọn ít nhất một sản phẩm!');
                }
            });

            // Format giá bán khi nhập
            $(document).on('input', '.gia-ban', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value) {
                    value = parseInt(value, 10).toLocaleString('vi-VN');
                }
                $(this).val(value);
            });

            // Fill combobox dữ liệu từ ViewBag khi mở modal
            function fillCombobox(selector, data, value, text) {
                var $select = $(selector);
                $select.empty();
                $select.append('<option value="">Chọn</option>');
                for (var i = 0; i < data.length; i++) {
                    $select.append('<option value="' + data[i][value] + '">' + data[i][text] + '</option>');
                }
            }

            // Khi click 👁️
            $(document).on('click', '.btn-view', function() {
                var id = $(this).closest('tr').data('id');
                // Lấy dữ liệu combobox từ ViewBag (render ra JS object ở view)
                var thuongHieus = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ThuongHieus));
                var chatLieus = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChatLieus));
                var deGiays = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DeGiays));
                var kichThuocs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.KichThuocs));
                var mauSacs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MauSacs));
                // Convert object to array for easier loop
                function objToArr(obj) {
                    return Object.keys(obj).map(function(key) {
                        return { id: key, name: obj[key] };
                    });
                }
                fillCombobox("#productDetailModal select[name='ThuongHieuId']", objToArr(thuongHieus), 'id', 'name');
                fillCombobox("#productDetailModal select[name='ChatLieuId']", objToArr(chatLieus), 'id', 'name');
                fillCombobox("#productDetailModal select[name='DeGiayId']", objToArr(deGiays), 'id', 'name');
                fillCombobox("#productDetailModal select[name='KichThuocId']", objToArr(kichThuocs), 'id', 'name');
                fillCombobox("#productDetailModal select[name='MauSacId']", objToArr(mauSacs), 'id', 'name');
                // Gọi backend lấy chi tiết sản phẩm
                $.get('/SanPham/GetSPCTDetail', { id: id }, function(data) {
                    // Fill dữ liệu vào các trường như cũ
                    $("#productDetailModal input[name='TenSanPham']").val(data.tenSanPham);
                    $("#productDetailModal textarea[name='MoTa']").val(data.moTa);
                    $("#productDetailModal select[name='ThuongHieuId']").val(data.thuongHieuId);
                    $("#productDetailModal select[name='TrangThai']").val(data.trangThai ? 'true' : 'false');
                    $("#productDetailModal select[name='ChatLieuId']").val(data.chatLieuId);
                    $("#productDetailModal select[name='DeGiayId']").val(data.deGiayId);
                    $("#productDetailModal select[name='KichThuocId']").val(data.kichThuocId);
                    $("#productDetailModal select[name='MauSacId']").val(data.mauSacId).trigger('change');
                    $("#productDetailModal input[name='SoLuong']").val(data.soLuong);
                    $("#productDetailModal input[name='SoLuongHangTra']").val(data.soLuongHangTra);
                    $("#productDetailModal input[name='GiaBan']").val(Number(data.giaBan).toLocaleString('vi-VN'));
                    // QR code
                    $("#qrCodePreview").html('<img src="' + data.qrCodeUrl + '" style="width:100px;" />');
                    // Ảnh sản phẩm
                    renderProductImages(data.images);
                    $('#productDetailModal').modal('show');
                });
            });

            // Render ảnh sản phẩm
            function renderProductImages(images) {
                var html = '';
                (images || []).forEach(function(img, idx) {
                    html += `
                        <div class="position-relative" style="display:inline-block;">
                            <img src="${img.url}" style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid #ccc;">
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 btn-delete-image" data-idx="${idx}" style="padding:2px 6px;">&times;</button>
                        </div>
                    `;
                });
                $('#productImages').html(html);
            }

            // Thêm ảnh
            $('#btnUploadImage').on('click', function() {
                $('#uploadImageInput').click();
            });

            $('#uploadImageInput').on('change', function() {
                var files = this.files;
                if (!files.length) return;
                var formData = new FormData();
                for (let i = 0; i < files.length; i++) {
                    formData.append('files', files[i]);
                }
                // Gửi lên backend (ví dụ: /SanPham/UploadImage?spctId=...)
                // Lấy id SPCT hiện tại (nên lưu lại khi mở modal)
                var spctId = $('#spctTable tr.table-info').data('id');
                $.ajax({
                    url: '/SanPham/UploadImage?spctId=' + spctId,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if(res.success) {
                            // Sau khi upload thành công, reload lại danh sách ảnh
                            renderProductImages(res.images);
                        } else {
                            alert('Upload ảnh thất bại!');
                        }
                    },
                    error: function() {
                        alert('Có lỗi khi upload ảnh!');
                    }
                });
            });

            // Xóa ảnh
            $(document).on('click', '.btn-delete-image', function() {
                var idx = $(this).data('idx');
                // Lấy id ảnh hoặc url ảnh
                var imgId = $(this).data('imgid');
                // Gửi AJAX xóa ảnh
                $.post('/SanPham/DeleteImage', { id: imgId }, function(res) {
                    if(res.success) {
                        // Reload lại danh sách ảnh
                        renderProductImages(res.images);
                    } else {
                        alert('Xóa ảnh thất bại!');
                    }
                });
            });

            // Khi chọn màu sắc thì đổi màu preview
            $("#productDetailModal select[name='MauSacId']").on('change', function() {
                var color = $(this).find('option:selected').text();
                $('#colorPreview').css('background', color);
            });

            // Sửa lại sự kiện click cho từng nút +
            $(document).on('click', '.btn-add-sub', function() {
                var type = $(this).data('type');
                if(type === 'thuonghieu') $('#modalAddThuongHieu').modal('show');
                if(type === 'chatlieu') $('#modalAddChatLieu').modal('show');
                if(type === 'degiay') $('#modalAddDeGiay').modal('show');
                if(type === 'kichthuoc') $('#modalAddKichThuoc').modal('show');
                if(type === 'mausac') $('#modalAddMauSac').modal('show');
            });
        });
    </script>
}

