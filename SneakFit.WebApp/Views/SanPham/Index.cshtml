@using SneakFit.ViewModels.Common
@model PagedResult<SneakFit.ViewModels.Catalog.SanPham.SanPhamViewModels>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="text-end mb-4">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#taoSanPhamModal">
        <i class="bx bx-plus me-1"></i> Thêm mới sản phẩm
    </button>
    <a type="button" class="btn btn-primary" id="btnAddNew" asp-action="Create" asp-controller="SPCT">
        <i class="bx bx-plus me-1"></i> Thêm mới sản phẩm chi tiết
    </a>
</div>
<!-- Modal -->
<div class="modal fade" id="taoSanPhamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm mới sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="createModalContent">
                <!-- Nội dung form sẽ được load bằng Ajax -->
            </div>
        </div>
    </div>
</div>
<!-- Modal Edit -->
<div class="modal fade" id="editSanPhamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editModalContent">
                <!-- Nội dung form sẽ được load bằng Ajax -->
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-12 col-xs-12">
                <form asp-action="Index" method="get">
                    <div class="row">
                        <div class="col-md-3">
                            <input type="text" value="@ViewBag.Keyword" placeholder="Tìm kiếm theo tên sản phẩm" name="Keyword" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <select name="danhMucId" class="form-control" asp-items="@ViewBag.DanhMucs">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="trangThai" class="form-control">
                                <option value="">-- Trạng thái --</option>
                                @if (ViewBag.TrangThai == true)
                                {
                                    <option value="true" selected>Hoạt động</option>
                                    <option value="false">Ngừng hoạt động</option>
                                }
                                else if (ViewBag.TrangThai == false)
                                {
                                    <option value="true">Hoạt động</option>
                                    <option value="false" selected>Ngừng hoạt động</option>
                                }
                                else
                                {
                                    <option value="true">Hoạt động</option>
                                    <option value="false">Ngừng hoạt động</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 mb-2 d-flex align-items-end">
                            <div class="btn-group w-100">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bx bx-search"></i> Tìm
                                </button>
                                <button type="button" onclick="window.location.href='/SanPham/Index'" class="btn btn-dark">
                                    <i class="bx bx-reset"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Tên Sản Phẩm</th>
                    <th>Danh Mục</th>
                    <th>Tổng số SP</th>
                    <th>Mô Tả</th>
                    <th style="width: 310px">Trạng Thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.TenSanPham</td>
                        <td>@item.TenDanhMuc</td>
                        <td>
                            <span class="badge bg-label-primary" data-bs-toggle="tooltip" data-bs-placement="top" >
                                @item.TongSoSanPham
                            </span>
                        </td>
                        <td>@item.Mota</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="switch-@item.Id"
                                @(item.TrangThai ? "checked" : "") onchange="capNhatTrangThai('@item.Id', this.checked)">
                                <label class="form-check-label" for="switch-@item.Id">
                                    @(item.TrangThai ? "Hoạt động" : "Ngưng hoạt động")
                                </label>
                            </div>
                        </td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item edit-sanpham" href="javascript:void(0)" data-id="@item.Id" data-bs-toggle="modal" data-bs-target="#editSanPhamModal">
                                        <i class="bx bx-edit-alt me-1"></i> Sửa
                                    </a>
                                    <a class="dropdown-item" href="/SanPham/EditSPCT/@item.Id">
                                        <i class="bx bx-detail me-1"></i> Sửa SPCT
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Component.InvokeAsync("Pager", Model)
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // Css cho tổng số sản phẩm chi tiết đang kinh doanh
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Thêm mới
            $('[data-bs-target="#taoSanPhamModal"]').click(function () {
                $.ajax({
                    url: '/SanPham/Create',
                    type: 'GET',
                    success: function (result) {
                        $('#createModalContent').html(result);
                    },
                    error: function (err) {
                        toastr.error('Có lỗi xảy ra khi tải form');
                    }
                });
            });
            // Submit create
            $(document).on('submit', '#createSanPhamForm', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                $.ajax({
                    url: '/SanPham/Create',
                    type: 'POST',
                    data: formData,
                    success: function (result) {
                        if (result.success) {
                            $('#taoSanPhamModal').modal('hide');
                            toastr.success('Thêm mới thành công');
                            setTimeout(function() {
                                window.location.reload();
                            }, 1000);
                        } else {
                            toastr.error(result.message);
                        }
                    },
                    error: function (err) {
                        toastr.error('Có lỗi xảy ra khi thêm mới');
                    }
                });
            });
            // Edit
            $('.edit-sanpham').click(function () {
                var id = $(this).data('id');
                $.ajax({
                    url: '/SanPham/Edit/' + id,
                    type: 'GET',
                    success: function (result) {
                        $('#editModalContent').html(result);
                    },
                    error: function (err) {
                        toastr.error('Có lỗi xảy ra khi tải form');
                    }
                });
            });
            // Submit edit
            $(document).on('submit', '#editSanPhamForm', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                $.ajax({
                    url: '/SanPham/Edit',
                    type: 'POST',
                    data: formData,
                    success: function (result) {
                        if (result.success) {
                            $('#editSanPhamModal').modal('hide');
                            toastr.success('Cập nhật thành công');
                            setTimeout(function() {
                                window.location.reload();
                            }, 1000);
                        } else {
                            toastr.error(result.message);
                        }
                    },
                    error: function (err) {
                        toastr.error('Có lỗi xảy ra khi cập nhật');
                    }
                });
            });
            // Toast
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                toastr.success(successMessage);
            }
            var errorMessage = '@TempData["ErrorMessage"]';
            if (errorMessage) {
                toastr.error(errorMessage);
            }
        });

        function capNhatTrangThai(id, trangThai) {
            $.ajax({
                url: '/SanPham/CapNhatTrangThai',
                type: 'POST',
                data: { id: id, trangThai: trangThai },
                success: function (result) {
                    if (result.success) {
                        toastr.success('Cập nhật trạng thái thành công');
                        // Cập nhật label
                        var label = $(`label[for="switch-${id}"]`);
                        label.text(trangThai ? 'Hoạt động' : 'Ngưng hoạt động');
                    } else {
                        toastr.error(result.message || 'Cập nhật trạng thái thất bại');
                        // Revert switch state if failed
                        $(`#switch-${id}`).prop('checked', !trangThai);
                    }
                },
                error: function () {
                    toastr.error('Có lỗi xảy ra khi cập nhật trạng thái');
                    // Revert switch state if error
                    $(`#switch-${id}`).prop('checked', !trangThai);
                }
            });
        }
    </script>
}