@model List<SneakFit.ViewModels.System.DiaChi.DiaChiViewModel>
@foreach (var diaChi in Model)
{
    <div class="address-item border rounded p-2 mb-2 @(diaChi.MacDinh ? "border-primary" : "")"
         data-id="@diaChi.Id"
         data-ten="@diaChi.TenNguoiNhan"
         data-sdt="@diaChi.SoDienThoai"
         data-tenthanhpho="@diaChi.TenThanhPho"
         data-matinh="@diaChi.MaTinh"
         data-tenhuyen="@diaChi.TenHuyen"
         data-mahuyen="@diaChi.MaHuyen"
         data-tenxa="@diaChi.TenXa"
         data-maxa="@diaChi.MaXa"
         data-tendiachi="@diaChi.TenDiaChi">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <b>@diaChi.TenNguoiNhan</b> - @diaChi.SoDienThoai
                @if (diaChi.MacDinh) { <span class="badge bg-primary ms-2">Mặc định</span> }
            </div>
            <button type="button" class="btn btn-link p-0 btn-edit-diachi" data-id="@diaChi.Id" title="Chỉnh sửa địa chỉ">
                <i class="bx bx-edit" style="font-size: 1.2em;"></i>
            </button>
        </div>
        <div>
            @diaChi.TenDiaChi, @diaChi.TenXa, @diaChi.TenHuyen, @diaChi.TenThanhPho
        </div>
        <button class="btn btn-outline-primary btn-sm btn-chon-diachi mt-2" data-id="@diaChi.Id">Chọn địa chỉ này</button>
    </div>
}
@if (!Model.Any())
{
    <div class="text-center text-muted">Không có địa chỉ nào</div>
}