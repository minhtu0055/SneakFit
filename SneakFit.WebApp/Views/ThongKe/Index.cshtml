@model SneakFit.ViewModels.Catalog.ThongKe.ThongKeTongQuanViewModel

<div class="container-fluid py-4">
    <!-- Thống kê tổng quan -->
    <div class="row g-4 mb-4">
        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="mb-2"><i class="bx bx-bar-chart-alt-2 fs-2 text-primary"></i></div>
                    <h6 class="text-muted">Doanh số @ViewBag.FilterTitle</h6>
                    <div class="h4 fw-bold text-primary">@Model.SoDonThangNay đơn / @Model.DoanhSoThangNay.ToString("N0") VND</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="mb-2"><i class="bx bx-calendar-check fs-2 text-success"></i></div>
                    @{
                        var thongKeHomNay = ViewBag.ThongKeHomNay as SneakFit.ViewModels.Catalog.ThongKe.ThongKeTongQuanViewModel;
                    }
                    <h6 class="text-muted">Doanh số hôm nay</h6>
                    <div class="h4 fw-bold text-success">
                        @(thongKeHomNay != null ? $"{thongKeHomNay.SoDonHomNay} đơn / {thongKeHomNay.DoanhSoHomNay.ToString("N0")} VND" : "0 đơn / 0 VND")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="mb-2"><i class="bx bx-cube fs-2 text-warning"></i></div>
                    <h6 class="text-muted">Hàng bán được @ViewBag.FilterTitle</h6>
                    <div class="h4 fw-bold text-warning">@Model.SoLuongSanPhamBanThangNay sản phẩm</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nút điều hướng -->
    <div class="d-flex justify-content-end gap-2 mb-4 flex-wrap">
        @* <a class="btn btn-outline-dark btn-sm" asp-action="ExportExcel"> *@
        @*     <i class="bx bx-download"></i> Excel *@
        @* </a> *@
        <button class="btn @(ViewBag.Filter == "homnay" ? "btn-primary" : "btn-outline-secondary") btn-sm filter-btn" data-type="homnay">Hôm nay</button>
        <button class="btn @(ViewBag.Filter == "homqua" ? "btn-primary" : "btn-outline-secondary") btn-sm filter-btn" data-type="homqua">Hôm qua</button>
        <button class="btn @(ViewBag.Filter == "7ngay" ? "btn-primary" : "btn-outline-secondary") btn-sm filter-btn" data-type="7ngay">7 Ngày</button>
        <button class="btn @(ViewBag.Filter == "thang" ? "btn-primary" : "btn-outline-secondary") btn-sm filter-btn" data-type="thang">Tháng này</button>
        <button class="btn @(ViewBag.Filter == "nam" ? "btn-primary" : "btn-outline-secondary") btn-sm filter-btn" data-type="nam">Năm nay</button>
        <button class="btn @(ViewBag.Filter == "tuychinh" ? "btn-primary" : "btn-outline-secondary") btn-sm" id="btnFilterTuyChinh">Tuỳ chỉnh</button>
    </div>

    <!-- Biểu đồ -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="section-title">Biểu Đồ Thống Kê Hóa Đơn Và Sản Phẩm @ViewBag.FilterTitle</h5>
            <canvas id="hoaDonSanPhamChart" height="150"></canvas>
        </div>
    </div>

    <!-- Top sản phẩm & Trạng thái đơn hàng -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                   
                    <h5 class="section-title">Top Sản Phẩm Bán Chạy @ViewBag.FilterTitle</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle rounded">
                            <thead class="custom-table-header">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Mô tả</th>
                                    <th>Danh mục</th>
                                    <th>Số sản phẩm chi tiết</th>
                                   
                                </tr>
                            </thead>
                            <tbody id="topSanPhamTable"></tbody>
                            <tbody id="topSanPhamTable">
                                <!-- Dữ liệu sẽ được render bằng JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                   
                    <h5 class="section-title">Trạng Thái Đơn Hàng @ViewBag.FilterTitle</h5>
                    <div class="d-flex justify-content-center">
                        <canvas id="trangThaiDonHangChart" style="height:320px;max-width:420px;"></canvas>
                    </div>
                    <div id="customLegendTrangThai" class="d-flex flex-wrap justify-content-center mt-2"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm sắp hết hàng & Tốc độ tăng trưởng -->
    <div class="row g-4">
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="section-title">Sản phẩm sắp hết hàng</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle rounded">
                            <thead class="custom-table-header">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Mô tả</th>
                                    <th>Danh mục</th>
                                    <th>Số sản phẩm chi tiết</th>
                                   
                                </tr>
                            </thead>
                            <tbody id="sanPhamSapHetHangTable"></tbody>
                                <!-- Dữ liệu sẽ được render bằng JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-12">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="section-title">Tốc Độ Tăng Trưởng Cửa Hàng</h5>
                    <div id="tocDoTangTruongList"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal xem chi tiết sản phẩm -->
    <div class="modal fade" id="modalChiTietSanPham" tabindex="-1" aria-labelledby="modalChiTietSanPhamLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-full-w">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalChiTietSanPhamLabel">Chi tiết sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div id="chiTietSanPhamContent">
                        <!-- Bảng chi tiết sẽ render ở đây -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Tuỳ chỉnh filter -->
    <div class="modal fade" id="modalFilterTuyChinh" tabindex="-1" aria-labelledby="modalFilterTuyChinhLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalFilterTuyChinhLabel">Lọc Tuỳ chỉnh</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Chọn kiểu lọc</label>
                        <select class="form-select" id="tuyChinhType">
                            <option value="ngay">Ngày</option>
                            <option value="tuan">Tuần</option>
                            <option value="thang">Tháng</option>
                            <option value="khoang">Khoảng ngày</option>
                        </select>
                    </div>
                    <div id="tuyChinhInputs">
                        <!-- Các input sẽ được render bằng JS -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btnApDungTuyChinh">Áp dụng</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    
    <script>
        $(document).ready(function() {
            // Xử lý filter
            $('.filter-btn').on('click', function() {
                var type = $(this).data('type');
                window.location.href = '@Url.Action("Index", "ThongKe")' + '?filter=' + type;
            });

            $('#btnFilter').on('click', function() {
                alert('Hiển thị modal bộ lọc nâng cao!');
            });

            // Vẽ biểu đồ
                   // Lấy toàn bộ query string hiện tại (bắt đầu từ ?)
        var queryString = window.location.search;
        // Gọi API biểu đồ với đúng các tham số lọc hiện tại
        $.get('/ThongKe/GetHoaDonSanPhamChart' + queryString, function (data) {
                var ctx = document.getElementById('hoaDonSanPhamChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.labels,
                        datasets: [
                            {
                                label: 'Hóa đơn',
                                data: data.soLuongHoaDon,
                                backgroundColor: 'rgba(255, 159, 64, 0.7)'
                            },
                            {
                                label: 'Sản phẩm',
                                data: data.soLuongSanPham,
                                backgroundColor: 'rgba(54, 162, 235, 0.7)'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            x: { stacked: false },
                            y: { beginAtZero: true, title: { display: true, text: 'Số lượng' } }
                        },
                        plugins: { legend: { position: 'top' } }
                    }
                });
            });

            // Top sản phẩm bán chạy tháng này
            $.get('/ThongKe/GetTopSanPhamBanChay' + window.location.search, function (data) {
                var tbody = $('#topSanPhamTable');
                tbody.empty();
                data.forEach(function (item) {
                var row = `<tr class="row-sanpham" data-sanphamid="${item.sanPhamId}" data-type="banchay" style="position:relative;">
                    <td>${item.stt}</td>
                    <td>${item.tenSanPham}</td>
                    <td>${item.moTa || ''}</td>
                    <td>${item.danhMuc || ''}</td>
                    <td>
                        ${item.soLuongSanPhamChiTiet}
                        <button class="btn btn-sm btn-info btn-xem-chi-tiet d-none" style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:2;">Xem chi tiết</button>
                    </td>
                </tr>`;
                    tbody.append(row);
                });
            });

            // Trạng Thái Đơn Hàng Tháng Này
                   // Trạng Thái Đơn Hàng Tháng Này (Pie chart có % trên lát cắt, legend đẹp)
            $.get('/ThongKe/GetTrangThaiDonHang' + window.location.search, function (data) {
                var trangThaiVN = {
                    "ChoXacNhan": "Chờ xác nhận",
                    "DaXacNhan": "Xác nhận",
                    "ChoVanChuyen": "Chờ vận chuyển",
                    "DangVanChuyen": "Vận chuyển",
                    "DaThanhToan": "Đã thanh toán",
                    "HoanThanh": "Thành công",
                    "DaHuy": "Đã hủy"
                };
                var labels = data.map(x => trangThaiVN[x.trangThai] || x.trangThai);
                var values = data.map(x => x.soLuong);
                var percents = data.map(x => x.tiLe);
                var colors = [
                    "#36A2EB", // Chờ xác nhận
                    "#FF6384", // Xác nhận
                    "#FFCE56", // Chờ vận chuyển
                    "#4BC0C0", // Vận chuyển
                    "#9966FF", // Đã thanh toán
                    "#FF9F40", // Thành công
                    "#C9CBCF"  // Đã hủy
                ];
                if(window.trangThaiDonHangChartObj) window.trangThaiDonHangChartObj.destroy();
                var ctx = document.getElementById('trangThaiDonHangChart').getContext('2d');
                        window.trangThaiDonHangChartObj = new Chart(ctx, {
                        type: 'pie',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: values,
                                backgroundColor: colors
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                // datalabels: {
                                //     color: '#222',
                                //     font: { weight: 'bold', size: 14 },
                                //     formatter: function(value, context) {
                                //         var percent = percents[context.dataIndex];
                                //         var label = labels[context.dataIndex];
                                //         return percent > 0 ? `${label}: ${percent}%` : '';
                                //     },
                                //     align: 'outside',
                                //     anchor: 'end',
                                //     offset: 20,
                                //     clamp: false,
                                //     display: function(context) {
                                //         return context.dataset.data[context.dataIndex] > 0;
                                //     },
                                //     callout: {
                                //         display: true,         BẮT BUỘC phải có
                                //         side: 'border',        Mũi tên từ border lát cắt ra ngoài
                                //         start: '50%',          Bắt đầu từ giữa lát cắt
                                //         borderColor: '#888',
                                //         borderWidth: 1,
                                //         margin: 4,
                                //         length: 50             Độ dài mũi tên, tăng lên nếu cần
                                //     }
                                // },
                                datalabels: {
                                    display: false
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            var label = context.label || '';
                                            var value = context.parsed || 0;
                                            var percent = percents[context.dataIndex];
                                            return `${label}: ${value} đơn (${percent}%)`;
                                        }
                                    }
                                }
                            }
                        },
                        plugins: [ChartDataLabels]
                    });
                        // Render legend custom
                var legendHtml = '';
                for (let i = 0; i < labels.length; i++) {
                    legendHtml += `
                        <div style="display:flex;align-items:center;margin:4px 12px 4px 0;min-width:150px;">
                            <span style="display:inline-block;width:18px;height:18px;background:${colors[i]};border-radius:3px;margin-right:6px;"></span>
                            <span style="font-size:15px;">${labels[i]}: ${percents[i]}%</span>
                        </div>
                    `;
                }
             $('#customLegendTrangThai').html(legendHtml);
            });

            // Sản phẩm sắp hết hàng
            $.get('/ThongKe/GetSanPhamSapHetHang', function (data) {
                var tbody = $('#sanPhamSapHetHangTable');
                tbody.empty();
                data.forEach(function (item) {
                var row = `<tr class="row-sanpham" data-sanphamid="${item.sanPhamId}" data-type="hethang" style="position:relative;">
                    <td>${item.stt}</td>
                    <td>${item.tenSanPham}</td>
                    <td>${item.moTa || ''}</td>
                    <td>${item.danhMuc || ''}</td>
                    <td>
                        ${item.soLuongSanPhamChiTiet}
                        <button class="btn btn-sm btn-info btn-xem-chi-tiet d-none" style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:2;">Xem chi tiết</button>
                    </td>
                </tr>`;
                    tbody.append(row);
                });
            });

            // Tốc Độ Tăng Trưởng Cửa Hàng (giao diện nền đen, icon màu)
            $.get('/ThongKe/GetTocDoTangTruong', function (data) {
                var container = $('#tocDoTangTruongList');
                container.empty();
                data.forEach(function (item) {
                    var percent = item.phanTramTangTruong;
                      var color = percent > 0 ? 'text-success' : (percent < 0 ? 'text-danger' : 'text-secondary');
                    var icon = percent > 0 ? '<i class="bx bx-trending-up"></i>' : percent < 0 ? '<i class="bx bx-trending-down"></i>' : '<i class="bx bx-minus"></i>';
                    var html = `
                        <div class="growth-item d-flex justify-content-between align-items-center mb-2 p-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bx bx-bar-chart-alt-2 fs-5"></i>
                                <span class="fw-bold">${item.tenChiSo}</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold">${item.giaTriHienTai.toLocaleString('vi-VN')} ${item.donVi}</span>
                                <span class="percent ${color}">
                                    ${icon} ${Math.abs(percent)}%
                                </span>
                            </div>
                        </div>
                    `;
                    container.append(html);
                });
            });


                    // Khi bấm nút Tuỳ chỉnh
        $('#btnFilterTuyChinh').on('click', function() {
            $('#modalFilterTuyChinh').modal('show');
            $('#tuyChinhType').val('ngay').trigger('change');
        });

        // Render input theo kiểu lọc
        $('#tuyChinhType').on('change', function() {
            var type = $(this).val();
            var html = '';
            var today = new Date().toISOString().slice(0,10);
            if(type === 'ngay') {
                html = `<label class="form-label">Chọn ngày</label>
                        <input type="date" class="form-control" id="tuyChinhNgay" value="${today}">`;
            } else if(type === 'tuan') {
                html = `<label class="form-label">Chọn tuần</label>
                        <input type="week" class="form-control" id="tuyChinhTuan" value="${today.slice(0,8)}">`;
            } else if(type === 'thang') {
                html = `<label class="form-label">Chọn tháng</label>
                        <input type="month" class="form-control" id="tuyChinhThang" value="${today.slice(0,7)}">`;
            } else if(type === 'khoang') {
                html = `<label class="form-label">Từ ngày</label>
                        <input type="date" class="form-control mb-2" id="tuyChinhTuNgay" value="${today}">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" class="form-control" id="tuyChinhDenNgay" value="${today}">`;
            }
            $('#tuyChinhInputs').html(html);
        });
        $('#tuyChinhType').trigger('change');

        // Khi bấm Áp dụng
        $('#btnApDungTuyChinh').on('click', function() {
            var type = $('#tuyChinhType').val();
            var url = '@Url.Action("Index", "ThongKe")' + '?filter=tuychinh';
            if(type === 'ngay') {
                var ngay = $('#tuyChinhNgay').val();
                url += '&ngay=' + ngay;
            } else if(type === 'tuan') {
                var tuan = $('#tuyChinhTuan').val();
                url += '&tuan=' + tuan;
            } else if(type === 'thang') {
                var thang = $('#tuyChinhThang').val();
                url += '&thang=' + thang;
            } else if(type === 'khoang') {
                var tuNgay = $('#tuyChinhTuNgay').val();
                var denNgay = $('#tuyChinhDenNgay').val();
                url += '&tuNgay=' + tuNgay + '&denNgay=' + denNgay;
            }
            window.location.href = url;
        });

        });

        // Hiện nút khi hover (nếu dùng d-none)
        $(document).on('mouseenter', '.row-sanpham', function() {
            $(this).find('.btn-xem-chi-tiet').removeClass('d-none');
        });
        $(document).on('mouseleave', '.row-sanpham', function() {
            $(this).find('.btn-xem-chi-tiet').addClass('d-none');
        });

        // Xử lý click "Xem chi tiết"
        $(document).on('click', '.btn-xem-chi-tiet', function(e) {
            e.stopPropagation();
            var $row = $(this).closest('tr');
            var sanPhamId = $row.data('sanphamid');
            var type = $row.data('type');
            var url = "";

            if (type === "banchay") {
                // Lấy query string hiện tại (bắt đầu từ ?)
                var queryString = window.location.search;
                // Nếu đã có ? thì thay &sanPhamId=..., nếu chưa thì thêm ?
                if (queryString) {
                    url = '/ThongKe/GetSanPhamChiTietBanChayThongKe' + queryString + '&sanPhamId=' + sanPhamId;
                } else {
                    url = '/ThongKe/GetSanPhamChiTietBanChayThongKe?sanPhamId=' + sanPhamId;
                }
            } else if (type === "hethang") {
                url = '/ThongKe/GetSanPhamChiTietHetHangThongKe?sanPhamId=' + sanPhamId;
            }

            $.get(url, function(data) {
                // ... (giữ nguyên phần render modal)
                       var html = "";
                if (type === "banchay") {
            html = `
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="custom-table-header">
                            <tr>
                                <th>STT</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Màu sắc</th>
                                <th>Kích thước</th>
                                <th>Chất liệu</th>
                                <th>Đế giày</th>
                                <th>Thương hiệu</th>
                                <th>Giá</th>
                                <th>Số lượng đã bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${data.map(item => `
                                <tr>
                                    <td>${item.stt}</td>
                                    <td style="width:60px; text-align:center;">
                                        <img src="${item.anh || '/images/no-image.png'}" style="width:50px;height:50px;object-fit:cover;display:block;margin:auto;" />
                                    </td>
                                    <td>${item.tenSanPham}</td>
                                    <td>${item.mauSac || ''}</td>
                                    <td>${item.kichThuoc || ''}</td>
                                    <td>${item.chatLieu || ''}</td>
                                    <td>${item.deGiay || ''}</td>
                                    <td>${item.thuongHieu || ''}</td>
                                    <td>${item.gia ? item.gia.toLocaleString('vi-VN') + ' VND' : ''}</td>
                                    <td>${item.soLuongDaBan}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        } else if (type === "hethang") {
            html = `
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="custom-table-header">
                            <tr>
                                <th>STT</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Màu sắc</th>
                                <th>Kích thước</th>
                                <th>Chất liệu</th>
                                <th>Đế giày</th>
                                <th>Thương hiệu</th>
                                <th>Giá</th>
                                <th>Còn lại</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${data.map(item => `
                                <tr>
                                    <td>${item.stt}</td>
                                    <td style="width:60px; text-align:center;">
                                        <img src="${item.anh || '/images/no-image.png'}" style="width:50px;height:50px;object-fit:cover;display:block;margin:auto;" />
                                    </td>
                                    <td>${item.tenSanPham}</td>
                                    <td>${item.mauSac || ''}</td>
                                    <td>${item.kichThuoc || ''}</td>
                                    <td>${item.chatLieu || ''}</td>
                                    <td>${item.deGiay || ''}</td>
                                    <td>${item.thuongHieu || ''}</td>
                                    <td>${item.gia ? item.gia.toLocaleString('vi-VN') + ' VND' : ''}</td>
                                    <td>${item.soLuongConLai}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        }
                $('#chiTietSanPhamContent').html(html);
                $('#modalChiTietSanPham').modal('show');
            });
        });

    </script>
}

