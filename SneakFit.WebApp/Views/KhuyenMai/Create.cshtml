@using SneakFit.Data.Enums
@model SneakFit.ViewModels.Catalog.KhuyenMai.ThemKhuyenMai
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <h3 class="mt-4">Tạo mới khuyến mại</h3>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active">Tạo mới khuyến mại</li>
    </ol>
    <div class="card mb-4">
        <div class="card-body">
            <div class="col-md-8 mx-auto">
                <form asp-action="Create" method="post" id="create-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3 row">
                        <label asp-for="TenKhuyenMai" class="col-sm-3 col-form-label">Tên khuyến mại</label>
                        <div class="col-sm-9">
                            <input asp-for="TenKhuyenMai" class="form-control" placeholder="Nhập tên khuyến mãi..." />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="MoTa" class="col-sm-3 col-form-label">Mô tả</label>
                        <div class="col-sm-9">
                            <textarea asp-for="MoTa" rows="5" class="form-control" placeholder="Nhập mô tả khuyến mãi..."></textarea>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="LoaiGiamGia" class="col-sm-3 col-form-label">Loại giảm giá</label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiGiamGia" asp-items="@ViewBag.LoaiGiamGia" class="form-select">
                            </select>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="GiaTriGiamGia" class="col-sm-3 col-form-label">Giá trị giảm</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input asp-for="GiaTriGiamGia" type="number" min="0" step="1" class="form-control gia-tri-giam-input" placeholder="Nhập giá trị giảm..." />
                                <span class="input-group-text discount-unit">VNĐ</span>
                            </div>
                            <span class="text-danger d-block mt-1"></span> @* <-- THÊM class "d-block" và "mt-1" *@
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="ThoiGianBatDau" class="col-sm-3 col-form-label">Ngày bắt đầu</label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="ThoiGianKetThuc" class="col-sm-3 col-form-label">Ngày kết thúc</label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Sản phẩm áp dụng</label>
                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm</label>
                            <div class="input-group">
                                <select id="sanPhamSelect" class="form-select" asp-items="@ViewBag.SanPhams" style="border-radius: 8px">
                                    <option value="">-- Chọn sản phẩm --</option>
                                </select>
                                @* <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddSanPhamModal()"> *@
                                @*     <i class="bx bx-plus"></i> *@
                                @* </button> *@
                            </div>  
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <input type="hidden" name="SanPhamIds" id="sanPhamChiTietIdsInput" />

                    <!-- Phần Chi tiết sản phẩm -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">CHI TIẾT SẢN PHẨM</h5>
                        <div class="table-responsive" style="border-radius: 8px">
                            <table class="table table-hover" id="productDetailList">
                                <thead style="background-color: mediumpurple; color: white;">
                                    <tr>
                                        <th style="width: 30px;"><input type="checkbox" id="checkAllProducts" /></th>
                                        <th style="width: 30px">STT</th>
                                        <th>Tên sản phẩm</th>
                                        <th style="width: 112px">Số lượng</th>
                                        <th style="width: 205px">Giá bán</th>
                                        <th style="width: 123px">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dữ liệu sẽ được thêm vào bằng JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <div class="col-sm-9 offset-sm-8">
                            <button type="submit" class="btn btn-primary me-4">
                                <i class="bx bx-save me-1"></i> Tạo mới
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bx bx-arrow-back me-1"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/additional-methods.min.js"></script>

    <script>
        $(document).ready(function () {
            let selectedSpctIds = []; // Mảng mới để lưu các ID của sản phẩm chi tiết được chọn

            function capNhatLoaiGiamGia() {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                var unit = loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)" ? "%" : "VNĐ";
                $(".discount-unit").text(unit);
            }
            $("#LoaiGiamGia").change(capNhatLoaiGiamGia);
            capNhatLoaiGiamGia();

            // Xử lý sự kiện khi checkbox "Chọn tất cả" thay đổi
            $('#checkAllProducts').on('change', function () {
                $('.product-checkbox').prop('checked', $(this).prop('checked'));
                selectedSpctIds = []; // Xóa tất cả các ID cũ
                if ($(this).prop('checked')) {
                    $('.product-checkbox').each(function () {
                        selectedSpctIds.push($(this).data('id'));
                    });
                }
                console.log('Sản phẩm chi tiết đã chọn (tất cả):', selectedSpctIds);
                $('#sanPhamChiTietIdsInput').val(selectedSpctIds.join(',')); // Cập nhật trường ẩn
            });

            // Xử lý sự kiện khi checkbox của từng sản phẩm thay đổi
            $('#productDetailList tbody').on('change', '.product-checkbox', function () {
                let spctId = $(this).data('id');
                if ($(this).is(':checked')) {
                    if (!selectedSpctIds.includes(spctId)) {
                        selectedSpctIds.push(spctId);
                    }
                } else {
                    selectedSpctIds = selectedSpctIds.filter(id => id !== spctId);
                    // Nếu có bất kỳ checkbox nào không được chọn, bỏ chọn "Chọn tất cả"
                    $('#checkAllProducts').prop('checked', false);
                }
                console.log('Sản phẩm chi tiết đã chọn (từng cái):', selectedSpctIds);
                $('#sanPhamChiTietIdsInput').val(selectedSpctIds.join(',')); // Cập nhật trường ẩn
            });

            $("#create-form").validate({
                rules: {
                    TenKhuyenMai: { required: true, minlength: 3 },
                    MoTa: { required: true },
                    LoaiGiamGia: { required: true },
                    GiaTriGiamGia: { required: true, min: 0, number: true },
                    ThoiGianBatDau: { required: true },
                    ThoiGianKetThuc: { required: true, greaterThan: "#ThoiGianBatDau" },
                    SanPhamChiTietIds: { required: true, minlength: 1 } // Đã sửa tên trường
                },
                messages: {
                    TenKhuyenMai: {
                        required: "Vui lòng điền tên khuyến mãi.",
                        minlength: "Tên khuyến mãi phải có ít nhất 3 ký tự."
                    },
                    MoTa: {
                        required: "Vui lòng điền mô tả khuyến mãi."
                    },
                    LoaiGiamGia: {
                        required: "Vui lòng chọn loại giảm giá."
                    },
                    GiaTriGiamGia: {
                        required: "Vui lòng điền giá trị giảm.",
                        min: "Giá trị giảm phải lớn hơn hoặc bằng 0.",
                        number: "Giá trị giảm phải là một số hợp lệ."
                    },
                    ThoiGianBatDau: {
                        required: "Vui lòng chọn ngày bắt đầu."
                    },
                    ThoiGianKetThuc: {
                        required: "Vui lòng chọn ngày kết thúc.",
                        greaterThan: "Ngày kết thúc phải sau ngày bắt đầu."
                    },
                    SanPhamChiTietIds: { // Đã sửa tên trường
                        required: "Vui lòng chọn ít nhất một sản phẩm áp dụng.",
                        minlength: "Vui lòng chọn ít nhất một sản phẩm áp dụng."
                    }
                },
                 submitHandler: function (form) {
                    form.submit(); // Gửi form sau khi cập nhật
                },
                // THÊM (HOẶC SỬA) ĐOẠN SAU ĐÂY
                errorPlacement: function (error, element) {
                    if (element.parent('.input-group').length) {
                        // Nếu phần tử đang được validate nằm trong một .input-group
                        error.insertAfter(element.parent('.input-group')); // Chèn thông báo lỗi sau div .input-group
                        error.addClass('d-block mt-1'); // Đảm bảo nó hiển thị là block và có margin top
                    } else if (element.attr("name") == "SanPhamChiTietIds") { // Xử lý lỗi cho trường ẩn
                        error.insertAfter("#productDetailList"); // Chèn lỗi sau bảng
                        error.addClass('d-block text-danger mt-1');
                    }
                    else {
                        // Mặc định cho các phần tử khác (chèn sau chính phần tử)
                        error.insertAfter(element);
                    }
                },

            });

            $.validator.addMethod("greaterThan", function (value, element, param) {
                var $min = $(param);
                if (this.settings.onfocusout) {
                    $min.off(".validate-greaterThan").on("blur.validate-greaterThan", function () {
                        $(element).valid();
                    });
                }
                return parseInt(value.replace(/[^0-9]/g, '')) > parseInt($min.val().replace(/[^0-9]/g, ''));
            }, "");

            // Xử lý khi chọn sản phẩm từ combobox
            $('#sanPhamSelect').on('change', function () {
                let productName = $(this).find('option:selected').text(); // Lấy tên sản phẩm từ option được chọn
                if (productName && productName !== '-- Chọn sản phẩm --') { // Đảm bảo không gọi API khi chọn option mặc định
                    fetchProductDetailsByProductName(productName);
                } else {
                    $('#productDetailList tbody').empty(); // Xóa bảng nếu chọn lại option mặc định
                    toastr.info('Vui lòng chọn một sản phẩm.');
                }
            });

            // Fetch product details from API
            function fetchProductDetailsByProductName(productName) {
                $.ajax({
                    url: '/SanPham/GetSPCTByProductName', // Đã sửa API call
                    type: 'GET',
                    data: { productName: productName }, // Đã sửa tên tham số
                    success: function (response) {
                        if (response && response.length > 0) {
                            renderProductDetailsTable(response);
                        } else {
                            $('#productDetailList tbody').empty();
                            toastr.warning('Không tìm thấy thông tin chi tiết sản phẩm cho tên này');
                        }
                    },
                    error: function (xhr) {
                        console.error('Lỗi khi gọi API chi tiết sản phẩm:', xhr);
                        toastr.error('Lỗi khi lấy thông tin chi tiết sản phẩm');
                    }
                });
            }

            // Generate product details row
            function renderProductDetailsTable(data) {
                let tbody = $('#productDetailList tbody');
                tbody.empty();
                selectedSpctIds = []; // Reset mảng khi bảng được render lại
                $('#checkAllProducts').prop('checked', false); // Bỏ tích "Chọn tất cả"

                data.forEach((item, idx) => {
                    let row = `<tr>
                        <td><input type="checkbox" class="product-checkbox" data-id="${item.id}" /></td>
                        <td>${idx + 1}</td>
                        <td>${item.tenSanPham}</td>
                        <td>${item.soLuong}</td>
                        <td>${item.gia ? item.gia.toLocaleString('vi-VN') : 'N/A'} VNĐ</td>
                        <td>${item.trangThai ? 'Đang kinh doanh' : 'Ngừng kinh doanh'}</td>
                    </tr>`;
                    tbody.append(row);
                });
            }

            // Format giá tiền khi nhập
            $(document).on('input', '.price-input', function () {
                let value = $(this).val().replace(/\D/g, '');
                if (value) {
                    value = parseInt(value).toLocaleString('vi-VN');
                }
                $(this).val(value);
            });
        });

        function openAddSanPhamModal() {
            alert('Chức năng thêm sản phẩm mới sẽ được tích hợp tại đây!');
            // Thêm logic gọi API hoặc modal sau
        }

        // Xử lý khi nhập vào trường Giá trị giảm để chỉ cho phép số nguyên dương
        $(document).on('input', '.gia-tri-giam-input', function () {
            let value = $(this).val();
            // Loại bỏ tất cả các ký tự không phải số
            value = value.replace(/[^0-9]/g, '');
            // Chuyển đổi sang số nguyên và đảm bảo không âm
            value = parseInt(value);
            if (isNaN(value) || value < 0) {
                value = 0; // Đặt về 0 nếu không hợp lệ hoặc âm
            }
            $(this).val(value);
        });
    </script>
}
