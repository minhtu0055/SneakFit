@using SneakFit.Data.Enums
@model SneakFit.ViewModels.Catalog.KhuyenMai.ThemKhuyenMai
@{
    ViewData["Title"] = "Tạo khuyến mãi";
}

<h2>Tạo khuyến mãi</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="TenKhuyenMai">Tên khuyến mãi</label>
        <input asp-for="TenKhuyenMai" class="form-control" />
        <span asp-validation-for="TenKhuyenMai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MoTa">Mô tả</label>
        <textarea asp-for="MoTa" class="form-control"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ThoiGianBatDau">Thời gian bắt đầu</label>
        <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
        <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ThoiGianKetThuc">Thời gian kết thúc</label>
        <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
        <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LoaiGiamGia">Loại giảm giá</label>
        <select asp-for="LoaiGiamGia" class="form-control" asp-items="ViewBag.DiscountTypes">
            <option value="">-- Chọn loại giảm giá --</option>
        </select>
        <span asp-validation-for="LoaiGiamGia" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="GiaTriGiamGia">Giá trị giảm giá</label>
        <input asp-for="GiaTriGiamGia" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="GiaTriGiamGia" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Sản phẩm áp dụng</label>
        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
            <table class="table table-bordered">
                <thead style="position: sticky; top: 0; background-color: white; z-index: 1;">
                    <tr>
                        <th>Chọn</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Danh mục</th>
                    </tr>
                </thead>
                @* <tbody> *@
                @*     @foreach (var product in ViewBag.Products) *@
                @*     { *@
                @*         <tr> *@
                @*             <td class="text-center" style="width: 50px;"> *@
                @*                 <input type="checkbox" name="SanPhamIds" value="@product.Id" class="form-check-input" /> *@
                @*             </td> *@
                @*             <td>@product.Name</td> *@
                @*             <td>@product.Price.ToString("N0") đ</td> *@
                @*             <td>@product.CategoryName</td> *@
                @*         </tr> *@
                @*     } *@
                @* </tbody> *@
            </table>
        </div>
        <span class="text-danger" asp-validation-for="SanPhamIds"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Tạo</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
