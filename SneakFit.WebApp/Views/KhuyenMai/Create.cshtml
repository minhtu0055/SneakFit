@using SneakFit.Data.Enums
@model SneakFit.ViewModels.Catalog.KhuyenMai.ThemKhuyenMai
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <h3 class="mt-4">Tạo mới khuyến mại</h3>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active">Tạo mới khuyến mại</li>
    </ol>
    <div class="card mb-4">
        <div class="card-body">
            <div class="col-md-8 mx-auto">
               
                <form asp-action="Create" method="post" id="create-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger d-none"></div>

                    <div class="mb-3 row">
                        <label asp-for="TenKhuyenMai" class="col-sm-3 col-form-label">Tên khuyến mại</label>
                        <div class="col-sm-9">
                            <input asp-for="TenKhuyenMai" class="form-control" placeholder="Nhập tên khuyến mãi..." />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="MoTa" class="col-sm-3 col-form-label">Mô tả</label>
                        <div class="col-sm-9">
                            <textarea asp-for="MoTa" rows="5" class="form-control" placeholder="Nhập mô tả khuyến mãi..."></textarea>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="LoaiGiamGia" class="col-sm-3 col-form-label">Loại giảm giá</label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiGiamGia" asp-items="@ViewBag.LoaiGiamGia" class="form-select">
                            </select>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="GiaTriGiamGia" class="col-sm-3 col-form-label">Giá trị giảm</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input asp-for="GiaTriGiamGia" type="number" min="0" step="1" class="form-control gia-tri-giam-input" placeholder="Nhập giá trị giảm..." />
                                <span class="input-group-text discount-unit">VNĐ</span>
                            </div>
                            <span class="text-danger d-block mt-1"></span> @* <-- THÊM class "d-block" và "mt-1" *@
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="ThoiGianBatDau" class="col-sm-3 col-form-label">Ngày bắt đầu</label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="ThoiGianKetThuc" class="col-sm-3 col-form-label">Ngày kết thúc</label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Sản phẩm áp dụng</label>
                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm</label>
                            <div class="input-group">
                                <select id="sanPhamSelect" class="form-select" asp-items="@ViewBag.SanPhams" style="border-radius: 8px">
                                    <option value="">-- Chọn sản phẩm --</option>
                                </select>
                                @* <button type="button" class="btn btn-primary ms-2" style="border-radius: 8px; width: 40px; height: 40px; padding: 0;" onclick="openAddSanPhamModal()"> *@
                                @*     <i class="bx bx-plus"></i> *@
                                @* </button> *@
                            </div>  
                            <span class="text-danger"></span>
                        </div>
                    </div>
                   @* <input type="hidden" name="SanPhamIds" id="sanPhamChiTietIdsInput" />*@
                    <div id="hiddenInputsContainer"></div>

                    <!-- Phần Chi tiết sản phẩm -->
                    <div class="section-block mb-4" style="background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
                        <h5 class="mb-4" style="text-align: center;">CHI TIẾT SẢN PHẨM</h5>
                        <div class="table-responsive" style="border-radius: 8px">
                            <table class="table table-hover" id="productDetailList">
                                <thead style="background-color: mediumpurple; color: white;">
                                    <tr>
                                        <th style="width: 30px;"><input type="checkbox" id="checkAllProducts" /></th>
                                        <th style="width: 30px">STT</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Màu sắc</th>
                                        <th>Kích thước</th>
                                        <th>Chất liệu</th>
                                        <th>Đế giày</th>
                                        <th>Thương hiệu</th>
                                        <th style="width: 112px">Số lượng</th>
                                        <th style="width: 205px">Giá bán</th>
                                        <th style="width: 123px">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dữ liệu sẽ được thêm vào bằng JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <div class="col-sm-9 offset-sm-8">
                            <button type="submit" class="btn btn-primary me-4">
                                <i class="bx bx-save me-1"></i> Tạo mới
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bx bx-arrow-back me-1"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/additional-methods.min.js"></script>
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        let allProductDetails = [];
        let currentPage = 1;
        const pageSize = 5;
        $(document).ready(function () {
            let selectedSpctIdsByProduct = {}; // key: productName, value: array of selected ids
            let selectedSpctIds = [];
            let currentProductName = "";
            let spctPrices = {};

            function updateHiddenInputs() {
                $('#hiddenInputsContainer').empty();
                Object.values(selectedSpctIdsByProduct).forEach(function(idArr) {
                    idArr.forEach(function(id) {
                        $('#hiddenInputsContainer').append('<input type="hidden" name="SanPhamIds" value="' + id + '" />');
                    });
                });
            }

            function capNhatLoaiGiamGia() {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                var unit = loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)" ? "%" : "VNĐ";
                $(".discount-unit").text(unit);
            }
            $("#LoaiGiamGia").change(function() {
                capNhatLoaiGiamGia();
                triggerGiaTriGiamGiaValidate();
            });
            capNhatLoaiGiamGia();

            // Chọn tất cả
            $('#checkAllProducts').on('change', function () {
                if ($(this).prop('checked')) {
                    selectedSpctIds = allProductDetails.map(x => x.id);
                } else {
                    selectedSpctIds = [];
                }
                selectedSpctIdsByProduct[currentProductName] = [...selectedSpctIds];
                renderProductDetailsTable(allProductDetails, currentPage);
                updateHiddenInputs();
                triggerGiaTriGiamGiaValidate();
            });

            // Tick từng sản phẩm
            $('#productDetailList tbody').on('change', '.product-checkbox', function () {
                let spctId = $(this).data('id');
                let gia = allProductDetails.find(x => x.id === spctId)?.gia || 0;
                if ($(this).is(':checked')) {
                    if (!selectedSpctIds.includes(spctId)) {
                        selectedSpctIds.push(spctId);
                    }
                    spctPrices[spctId] = gia;
                } else {
                    selectedSpctIds = selectedSpctIds.filter(id => id !== spctId);
                    delete spctPrices[spctId];
                }
                selectedSpctIdsByProduct[currentProductName] = [...selectedSpctIds];
                let pageData = allProductDetails.slice((currentPage - 1) * pageSize, currentPage * pageSize);
                let allChecked = pageData.every(item => selectedSpctIds.includes(item.id));
                $('#checkAllProducts').prop('checked', allChecked);
                updateHiddenInputs();
                triggerGiaTriGiamGiaValidate();
            });

            // Đổi tên sản phẩm
            $('#sanPhamSelect').on('change', function () {
                if (currentProductName) {
                    selectedSpctIdsByProduct[currentProductName] = [...selectedSpctIds];
                }
                let productName = $(this).find('option:selected').text();
                currentProductName = productName;
                if (productName && productName !== '-- Chọn sản phẩm --') {
                    if (selectedSpctIdsByProduct[productName]) {
                        selectedSpctIds = [...selectedSpctIdsByProduct[productName]];
                    } else {
                        selectedSpctIds = [];
                        selectedSpctIdsByProduct[productName] = [];
                    }
                    fetchProductDetailsByProductName(productName, selectedSpctIds);
                } else {
                    selectedSpctIds = [];
                    $('#productDetailList tbody').empty();
                    toastr.info('Vui lòng chọn một sản phẩm.');
                }
                spctPrices = {};
                updateHiddenInputs();
                triggerGiaTriGiamGiaValidate();
            });

            // Fetch product details from API
            function fetchProductDetailsByProductName(productName, preSelectedIds = []) {
                $.ajax({
                    url: '/SanPham/GetSPCTByProductName',
                    type: 'GET',
                    data: { productName: productName },
                    success: function (response) {
                        var filtered = response.filter(x => x.trangThai === true);
                        response.forEach(item => {
                            spctPrices[item.id] = item.gia;
                        });
                        if (preSelectedIds.length > 0) {
                            selectedSpctIds = preSelectedIds;
                        }
                        renderProductDetailsTable(filtered, 1);
                    },
                    error: function (xhr) {
                        console.error('Lỗi khi gọi API chi tiết sản phẩm:', xhr);
                        toastr.error('Lỗi khi lấy thông tin chi tiết sản phẩm');
                    }
                });
            }

            // Render bảng chi tiết sản phẩm
            function renderProductDetailsTable(data, page = 1) {
                currentPage = page;
                let tbody = $('#productDetailList tbody');
                tbody.empty();
                allProductDetails = data;
                spctPrices = {};
                let start = (page - 1) * pageSize;
                let end = start + pageSize;
                let pageData = data.slice(start, end);
                pageData.forEach((item, idx) => {
                    spctPrices[item.id] = item.gia;
                    let checked = selectedSpctIds && selectedSpctIds.includes(item.id) ? 'checked' : '';
                    let row = `<tr>
                        <td><input type="checkbox" class="product-checkbox" data-id="${item.id}" ${checked} /></td>
                        <td>${start + idx + 1}</td>
                        <td>${item.tenSanPham}</td>
                        <td>${item.tenMauSac || ''}</td>
                        <td>${item.maKichThuoc || ''}</td>
                        <td>${item.tenChatLieu || ''}</td>
                        <td>${item.tenDeGiay || ''}</td>
                        <td>${item.tenThuongHieu || ''}</td>
                        <td>${item.soLuong}</td>
                        <td>${item.gia ? item.gia.toLocaleString('vi-VN') : 'N/A'} VNĐ</td>
                        <td>${item.trangThai ? 'Đang kinh doanh' : 'Ngừng kinh doanh'}</td>
                    </tr>`;
                    tbody.append(row);
                });
                let allChecked = pageData.length > 0 && pageData.every(item => selectedSpctIds.includes(item.id));
                $('#checkAllProducts').prop('checked', allChecked);
                renderPagination(data.length, page);
                updateHiddenInputs();
                triggerGiaTriGiamGiaValidate();
            }

            function renderPagination(totalItems, currentPage) {
                let totalPages = Math.ceil(totalItems / pageSize);
                let paginationHtml = '';
                if (totalPages > 1) {
                    paginationHtml += '<nav><ul class="pagination justify-content-center">';
                    for (let i = 1; i <= totalPages; i++) {
                        paginationHtml += `<li class="page-item${i === currentPage ? ' active' : ''}"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
                    }
                    paginationHtml += '</ul></nav>';
                }
                $('#productDetailList').nextAll('nav').remove();
                $('#productDetailList').after(paginationHtml);
                $('.page-link').off('click').on('click', function (e) {
                    e.preventDefault();
                    let page = parseInt($(this).data('page'));
                    renderProductDetailsTable(allProductDetails, page);
                });
            }

            // Format giá tiền khi nhập
            $(document).on('input', '.price-input', function () {
                let value = $(this).val().replace(/\D/g, '');
                if (value) {
                    value = parseInt(value).toLocaleString('vi-VN');
                }
                $(this).val(value);
            });

            // Chỉ cho phép số nguyên dương cho giá trị giảm
            $(document).on('input', '.gia-tri-giam-input', function () {
                let value = $(this).val();
                value = value.replace(/[^0-9]/g, '');
                value = parseInt(value);
                if (isNaN(value) || value < 0) {
                    value = 0;
                }
                $(this).val(value);
            });

            // Validate
            $("#create-form").validate({
                rules: {
                    TenKhuyenMai: { required: true, minlength: 3 },
                    MoTa: { required: true },
                    LoaiGiamGia: { required: true },
                    GiaTriGiamGia: { required: true, min: 0, number: true, maxDiscountPercent: true, maxDiscountAmount: true },
                    ThoiGianBatDau: { required: true },
                    ThoiGianKetThuc: { required: true, greaterThan: "#ThoiGianBatDau" },
                    SanPhamIds: { required: true, minlength: 1 }
                },
                messages: {
                    TenKhuyenMai: {
                        required: "Vui lòng điền tên khuyến mãi.",
                        minlength: "Tên khuyến mãi phải có ít nhất 3 ký tự."
                    },
                    MoTa: {
                        required: "Vui lòng điền mô tả khuyến mãi."
                    },
                    LoaiGiamGia: {
                        required: "Vui lòng chọn loại giảm giá."
                    },
                    GiaTriGiamGia: {
                        required: "Vui lòng điền giá trị giảm.",
                        min: "Giá trị giảm phải lớn hơn hoặc bằng 0.",
                        number: "Giá trị giảm phải là một số hợp lệ."
                    },
                    ThoiGianBatDau: {
                        required: "Vui lòng chọn ngày bắt đầu."
                    },
                    ThoiGianKetThuc: {
                        required: "Vui lòng chọn ngày kết thúc.",
                        greaterThan: "Ngày kết thúc phải sau ngày bắt đầu."
                    },
                    SanPhamIds: {
                        required: "Vui lòng chọn ít nhất một sản phẩm áp dụng.",
                        minlength: "Vui lòng chọn ít nhất một sản phẩm áp dụng."
                    }
                },
                submitHandler: function (form) {
                    form.submit();
                },
                errorPlacement: function (error, element) {
                    if (element.parent('.input-group').length) {
                        error.insertAfter(element.parent('.input-group'));
                        error.addClass('d-block mt-1');
                    } else if (element.attr("name") == "SanPhamChiTietIds") {
                        error.insertAfter("#productDetailList");
                        error.addClass('d-block text-danger mt-1');
                    } else {
                        error.insertAfter(element);
                    }
                }
            });

            $.validator.addMethod("greaterThan", function (value, element, param) {
                var $min = $(param);
                if (this.settings.onfocusout) {
                    $min.off(".validate-greaterThan").on("blur.validate-greaterThan", function () {
                        $(element).valid();
                    });
                }
                return parseInt(value.replace(/[^0-9]/g, '')) > parseInt($min.val().replace(/[^0-9]/g, ''));
            }, "");

            $.validator.addMethod("maxDiscountPercent", function (value, element) {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                if (loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)") {
                    return parseFloat(value) <= 100;
                }
                return true;
            }, "Giá trị giảm theo phần trăm không được vượt quá 100%");

            $.validator.addMethod("maxDiscountAmount", function (value, element) {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                if (loaiGiamGia == "@((int)LoaiGiamGia.SoTien)") {
                    let ids = [];
                    $("input[name='SanPhamIds']").each(function() {
                        if ($(this).val()) ids.push($(this).val());
                    });
                    if (ids.length === 0) return true;
                    let minPrice = Math.min(...ids.map(id => spctPrices[id] || Infinity));
                    return parseFloat(value) <= minPrice;
                }
                return true;
            }, "Giá trị giảm không được vượt quá giá bán của sản phẩm áp dụng!");

            // Gọi lại validate khi thay đổi
            $('#GiaTriGiamGia').on('input', function() {
                triggerGiaTriGiamGiaValidate();
            });

        //         toastr.options = {
        //   "positionClass": "toast-top-center",
        //   "timeOut": "5000"
        // };

                // Hiển thị toastr nếu có lỗi ModelState
        var errorSummary = $('.validation-summary-errors ul li').map(function () {
            return $(this).text();
        }).get().join('<br/>');
        if (errorSummary) {
            toastr.error(errorSummary, 'Lỗi!');
        }
        });

        function triggerGiaTriGiamGiaValidate() {
            setTimeout(function() {
                $("#GiaTriGiamGia").valid();
            }, 0);
        }
    </script>
}

