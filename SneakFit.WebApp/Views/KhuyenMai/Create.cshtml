@using SneakFit.Data.Enums
@model SneakFit.ViewModels.Catalog.KhuyenMai.ThemKhuyenMai
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active">Tạo mới khuyến mại</li>
    </ol>
    <div class="card mb-4">
        <div class="card-body">
            <div class="col-md-8 mx-auto">
                <form asp-action="Create" method="post" id="create-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3 row">
                        <label asp-for="TenKhuyenMai" class="col-sm-3 col-form-label">Tên khuyến mại</label>
                        <div class="col-sm-9">
                            <input asp-for="TenKhuyenMai" class="form-control" placeholder="Nhập tên khuyến mãi..." />
                            <span asp-validation-for="TenKhuyenMai" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="MoTa" class="col-sm-3 col-form-label">Mô tả</label>
                        <div class="col-sm-9">
                            <textarea asp-for="MoTa" rows="5" class="form-control" placeholder="Nhập mô tả khuyến mãi..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="LoaiGiamGia" class="col-sm-3 col-form-label">Loại giảm giá</label>
                        <div class="col-sm-9">
                            <select asp-for="LoaiGiamGia" asp-items="@ViewBag.LoaiGiamGia" class="form-select">
                            </select>
                            <span asp-validation-for="LoaiGiamGia" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="GiaTriGiamGia" class="col-sm-3 col-form-label">Giá trị giảm</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input asp-for="GiaTriGiamGia" class="form-control" placeholder="Nhập giá trị giảm..." />
                                <span class="input-group-text discount-unit">VNĐ</span>
                            </div>
                            <span asp-validation-for="GiaTriGiamGia" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="ThoiGianBatDau" class="col-sm-3 col-form-label">Ngày bắt đầu</label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="ThoiGianKetThuc" class="col-sm-3 col-form-label">Ngày kết thúc</label>
                        <div class="col-sm-9">
                            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
                        </div>
                    </div>                   
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Sản phẩm áp dụng</label>
                        <div class="col-sm-9">
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-bordered">
                                    <thead style="position: sticky; top: 0; background-color: white; z-index: 1;">
                                        <tr>
                                            <th>CHỌN</th>
                                            <th>ẢNH</th>
                                            <th>TÊN</th>
                                            <th>GIÁ</th>
                                            <th>DANH MỤC</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                       
                                        
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-sm-9 offset-sm-8">
                            <button type="submit" class="btn btn-primary me-4">
                                <i class="bx bx-save me-1"></i> Tạo mới
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bx bx-arrow-back me-1"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // Cập nhật đơn vị giảm giá khi thay đổi loại giảm giá
            function capNhatLoaiGiamGia() {
                var loaiGiamGia = $("#LoaiGiamGia").val();
                var unit = loaiGiamGia == "@((int)LoaiGiamGia.PhamTram)" ? "%" : "VNĐ";
                $(".discount-unit").text(unit);
            }           
            $("#LoaiGiamGia").change(capNhatLoaiGiamGia);
            capNhatLoaiGiamGia();
            
            // Validate form
            $("#create-form").validate({
                rules: {
                    Name: {
                        required: true,
                        minlength: 3
                    },
                    StartDate: {
                        required: true
                    },
                    EndDate: {
                        required: true
                    },
                    DiscountValue: {
                        required: true,
                        min: 0
                    },
                    MinimumOrderValue: {
                        required: true,
                        min: 0
                    },
                    "ProductIds": {
                        required: true,
                        minlength: 1
                    }
                },
                messages: {
                    Name: {
                        required: "Vui lòng nhập tên khuyến mãi",
                        minlength: "Tên khuyến mãi phải có ít nhất 3 ký tự"
                    },
                    StartDate: {
                        required: "Vui lòng chọn ngày bắt đầu"
                    },
                    EndDate: {
                        required: "Vui lòng chọn ngày kết thúc"
                    },
                    DiscountValue: {
                        required: "Vui lòng nhập giá trị giảm",
                        min: "Giá trị giảm phải lớn hơn 0"
                    },
                    MinimumOrderValue: {
                        required: "Vui lòng nhập giá trị đơn tối thiểu",
                        min: "Giá trị đơn tối thiểu phải lớn hơn 0"
                    },
                    "ProductIds": {
                        required: "Vui lòng chọn ít nhất một sản phẩm",
                        minlength: "Vui lòng chọn ít nhất một sản phẩm"
                    }
                }
            });
        });
    </script>
}
