@model SneakFit.ViewModels.Catalog.KhuyenMai.KhuyenMaiViewModels


@{
    ViewData["Title"] = "Chi tiết khuyến mãi";
}

<h2>Chi tiết khuyến mãi</h2>

<dl class="row">
    <dt class="col-sm-3">Tên khuyến mãi</dt>
    <dd class="col-sm-9">@Model.TenKhuyenMai</dd>

    <dt class="col-sm-3">Loại giảm giá</dt>
    <dd class="col-sm-9">@Model.LoaiGiamGia</dd>

    <dt class="col-sm-3">Giá trị giảm giá</dt>
    <dd class="col-sm-9">@Model.GiaTriGiamGia</dd>

    <dt class="col-sm-3">Ngày bắt đầu</dt>
    <dd class="col-sm-9">@Model.ThoiGianBatDau.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Ngày kết thúc</dt>
    <dd class="col-sm-9">@Model.ThoiGianKetThuc.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@Model.TrangThai</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
