@model SneakFit.ViewModels.Catalog.KhuyenMai.KhuyenMaiViewModels
@using SneakFit.Data.Enums
@{
    ViewData["Title"] = "Chi tiết khuyến mãi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/">Khuyến mại</a></li>
            <li class="breadcrumb-item active">Chi tiết khuyến mại</li>
        </ol>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                <i class="bx bx-edit-alt me-1"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bx bx-arrow-back me-1"></i> Quay lại
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">Thông tin khuyến mãi</h5>
                    <small class="text-muted float-end">
                        @switch (Model.TrangThai)
                        {
                            case TrangThaiGiamGia.HoatDong:
                                <span class="badge bg-label-success">Đang hoạt động</span>
                                break;
                            case TrangThaiGiamGia.KhongHoatDong:
                                <span class="badge bg-label-warning">Không hoạt động</span>
                                break;
                            case TrangThaiGiamGia.HetHan:
                                <span class="badge bg-label-danger">Đã hết hạn</span>
                                break;
                        }
                    </small>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Tên khuyến mãi</label>
                                <p class="form-control-static">@Model.TenKhuyenMai</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Mô tả</label>
                                <p class="form-control-static">@Model.MoTa</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Loại giảm giá</label>
                                <p class="form-control-static">
                                    @if (Model.LoaiGiamGia == LoaiGiamGia.PhamTram)
                                    {
                                        <span class="badge bg-label-info">Giảm @Model.GiaTriGiamGia%</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-primary">Giảm @Model.GiaTriGiamGia.ToString("N0") VNĐ</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Thời gian áp dụng</label>
                                <p class="form-control-static">
                                    <i class="bx bx-calendar text-primary me-1"></i>
                                    Từ: @Model.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")
                                    <br />
                                    <i class="bx bx-calendar text-primary me-1"></i>
                                    Đến: @Model.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Thời gian tạo/cập nhật</label>
                                <p class="form-control-static">
                                    <i class="bx bx-time-five text-primary me-1"></i>
                                    Tạo: @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                    <br />
                                    <i class="bx bx-revision text-primary me-1"></i>
                                    Cập nhật: @(Model.NgaySuaDoi?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Danh sách sản phẩm áp dụng</h5>
                </div>
                <div class="table-responsive text-nowrap">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>SẢN PHẨM</th>
                                <th>GIÁ GỐC</th>
                                <th>GIẢM GIÁ</th>
                                <th>GIÁ CUỐI</th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @if (Model.SanPhams != null && Model.SanPhams.Any())
                            {
                                foreach (var sanPham in Model.SanPhams)
                                {
                                    var discountAmount = sanPham.GiaGoc - sanPham.GiaKhuyenMai;
                                    var discountPercent = (int)((discountAmount / sanPham.GiaGoc) * 100);

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @* <img src="@(string.IsNullOrEmpty(sanPham.ProductImage) ? "/images/no-image.png" : baseUrl + sanPham.ProductImage)" *@
                                                @*      class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;" /> *@
                                                <div>
                                                    <strong>@sanPham.TenSanPham</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@sanPham.GiaGoc.ToString("N0") VNĐ</td>
                                        <td>
                                            <span class="badge bg-label-danger">-@discountPercent%</span>
                                            <small class="text-muted">(-@discountAmount.ToString("N0") VNĐ)</small>
                                        </td>
                                        <td>
                                            <strong class="text-primary">@sanPham.GiaKhuyenMai.ToString("N0") VNĐ</strong>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Không có sản phẩm nào được áp dụng</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>