@model SneakFit.ViewModels.Catalog.KichThuoc.ThemKichThuoc

<form asp-controller="KichThuoc" asp-action="Create" id="createKichThuocForm" method="post" data-confirm="Bạn có chắc chắn muốn làm điều đó không?">
    <div class="mb-3">
        <label asp-for="MaKichThuoc" class="form-label">Kích Thước</label>
        <input asp-for="MaKichThuoc" class="form-control" placeholder="Nhập kích thước"
               pattern="^[0-9]+$" 
               oninput="validateInput(this)"
               maxlength="50"
               title="Vui lòng chỉ nhập số"></input>
        <span asp-validation-for="MaKichThuoc" class="text-danger"></span>
        <span id="customError" class="text-danger" style="display: none;">Vui lòng chỉ nhập số</span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">Thêm</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>

<script>
function validateInput(input) {
    const pattern = /^[0-9]+$/;
    const errorSpan = document.getElementById('customError');
    
    if (!pattern.test(input.value) && input.value !== '') {
        errorSpan.style.display = 'block';
        input.setCustomValidity('Vui lòng chỉ nhập số');
    } else {
        errorSpan.style.display = 'none';
        input.setCustomValidity('');
    }
}
</script>