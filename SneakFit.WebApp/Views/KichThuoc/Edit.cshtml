@model SneakFit.ViewModels.Catalog.KichThuoc.SuaKichThuoc

<form asp-controller="KichThuoc" asp-action="Edit" method="post" id="editKichThuocForm">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="MaKichThuoc" class="form-label">Tên kích thước</label>
        <input asp-for="MaKichThuoc" class="form-control" placeholder="Nhập kích thước"
               pattern="^[0-9]+$" 
               oninput="validateInput(this)"
               maxlength="50"
               title="Vui lòng chỉ nhập số" />
        <span asp-validation-for="MaKichThuoc" class="text-danger"></span>
        <span id="customError" class="text-danger" style="display: none;">Vui lòng chỉ nhập số</span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">
            <i class="bx bx-save me-1"></i> Lưu
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bx bx-x me-1"></i> Hủy
        </button>
    </div>
</form>

<script>
function validateInput(input) {
    const pattern = /^[0-9]+$/;
    const errorSpan = document.getElementById('customError');
    
    if (!pattern.test(input.value) && input.value !== '') {
        errorSpan.style.display = 'block';
        input.setCustomValidity('Vui lòng chỉ nhập số');
    } else {
        errorSpan.style.display = 'none';
        input.setCustomValidity('');
    }
}
</script>