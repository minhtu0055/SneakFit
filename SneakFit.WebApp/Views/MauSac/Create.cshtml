@model SneakFit.ViewModels.Catalog.MauSac.ThemMauSac

<div class="mb-3">
    <label for="create_TenMauSac" class="form-label">Tên Màu Sắc</label>
    <input type="text" id="create_TenMauSac" name="TenMauSac" class="form-control" placeholder="Nhập tên màu sắc" maxlength="50" required />
    <span data-valmsg-for="TenMauSac" class="text-danger"></span>
</div>
<div class="mb-3">
    <label for="create_MaMauSac" class="form-label">Mã Màu</label>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="createColorPicker" class="form-control" style="width: 120px;" />
        <input type="text" id="create_MaMauSac" name="MaMauSac" class="form-control" style="width: 120px;" readonly required />
    </div>
    <span data-valmsg-for="MaMauSac" class="text-danger"></span>
</div>