@model SneakFit.ViewModels.Catalog.MauSac.SuaMauSac

<form id="editColorForm" asp-action="Edit" method="post">
    <input type="hidden" id="edit_Id" name="Id" value="@Model.Id" />
    <div class="mb-3">
        <label class="form-label">Tên màu sắc</label>
        <input type="text" id="edit_TenMauSac" name="TenMauSac" class="form-control" placeholder="Nhập tên màu sắc" maxlength="50" value="@Model.TenMauSac" />
        <span data-valmsg-for="TenMauSac" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Chọn màu sắc</label>
        <div class="d-flex align-items-center gap-2">
            <input type="text" id="editColorPicker" class="form-control minicolors-input" style="width: 120px;" value="@Model.MaMauSac" />
            <div style="width: 40px; height: 40px; border: 1px solid #ddd;" id="editColorPreview"></div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Mã màu</label>
        <input type="text" id="edit_MaMauSac" name="MaMauSac" class="form-control" style="width: 120px;" readonly value="@Model.MaMauSac" />
        <span data-valmsg-for="MaMauSac" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>