@model SneakFit.ViewModels.Catalog.MauSac.SuaMauSac

<form asp-controller="MauSac" asp-action="Edit" id="editColorForm" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="TenMauSac" class="form-label">Tên màu sắc</label>
        <input asp-for="TenMauSac" class="form-control" placeholder="Nhập tên màu sắc"
               pattern="^[a-zA-ZÀ-ỹ\s]+$" 
               oninput="validateColorInput(this)"
               maxlength="50"
               title="Vui lòng chỉ nhập chữ cái" />
        <span asp-validation-for="TenMauSac" class="text-danger"></span>
        <span id="editColorValidationError" class="text-danger" style="display: none;">Vui lòng chỉ nhập chữ cái</span>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">
            <i class="bx bx-save me-1"></i> Lưu
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bx bx-x me-1"></i> Hủy
        </button>
    </div>
</form>

<script>
function validateColorInput(input) {
    const pattern = /^[a-zA-ZÀ-ỹ\s]+$/;
    const errorSpan = document.getElementById('editColorValidationError');
    
    if (!pattern.test(input.value) && input.value !== '') {
        errorSpan.style.display = 'block';
        input.setCustomValidity('Vui lòng chỉ nhập chữ cái');
    } else {
        errorSpan.style.display = 'none';
        input.setCustomValidity('');
    }
}
</script>