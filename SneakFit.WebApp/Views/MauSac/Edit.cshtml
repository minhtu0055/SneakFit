@model SneakFit.ViewModels.Catalog.MauSac.SuaMauSac

<input type="hidden" id="edit_Id" name="Id" />
<div class="mb-3">
    <label for="edit_TenMauSac" class="form-label">Tên màu sắc</label>
    <input type="text" id="edit_TenMauSac" name="TenMauSac" class="form-control" placeholder="Nhập tên màu sắc" maxlength="50" required />
    <span data-valmsg-for="TenMauSac" class="text-danger"></span>
</div>
<div class="mb-3">
    <label for="edit_MaMauSac" class="form-label">Mã Màu</label>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="editColorPicker" class="form-control" style="width: 120px;" />
        <input type="text" id="edit_MaMauSac" name="MaMauSac" class="form-control" style="width: 120px;" readonly required />
    </div>
    <span data-valmsg-for="MaMauSac" class="text-danger"></span>
</div>