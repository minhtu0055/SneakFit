@using SneakFit.ViewModels.Catalog.HoaDon
@model IEnumerable<HoaDonViewModels>
@{
    ViewData["Title"] = "Quản lý Hóa đơn";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    .nav-tabs .nav-link.active {
        border-bottom: 3px solid #696cff !important;
        color: #696cff !important;
        background: #f6f6fe;
    }
    .nav-tabs .nav-link {
        border: none;
        color: #222;
    }
    .filter-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 16px;
    }
    .list-title {
        font-weight: 600;
        font-size: 1.1rem;
    }
</style>
<div class="container-fluid mt-4">
    <h2 class="mb-4">Quản lý Hóa đơn</h2>
    <!-- Bộ lọc -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="filter-title">Bộ lọc</div>
            <form class="row g-3 align-items-end" method="get">
                <div class="col-md-6">
                    <label class="form-label">Tìm kiếm:</label>
                    <input type="text" class="form-control" placeholder="Nhập" name="search" value="@(Context.Request.Query["search"])" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Loại đơn:</label>
                    @{
                        var orderType = Context.Request.Query["orderType"].ToString();
                    }
                    <select class="form-select" name="orderType">
                        <option value="">--Tất cả--</option>
                        <option value="online" selected="@(orderType == "online" ? "selected" : null)">Online</option>
                        <option value="store" selected="@(orderType == "store" ? "selected" : null)">Tại quầy</option>

                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ngày bắt đầu:</label>
                    <input type="date" class="form-control" name="startDate" value="@(Context.Request.Query["startDate"])" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ngày kết thúc:</label>
                    <input type="date" class="form-control" name="endDate" value="@(Context.Request.Query["endDate"])" />
                </div>
                <div class="col-12 d-flex gap-2 justify-content-center mt-2">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    <a href="/HoaDon/Index" class="btn btn-danger">Làm mới</a>
                </div>
            </form>
        </div>
    </div>
    <!-- Danh sách hóa đơn + nút tạo đơn hàng -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="list-title">
            <i class="bx bx-list-ul"></i> Danh sách Hóa đơn
        </div>
        <a href="#" class="btn btn-primary">+ Tạo đơn hàng</a>
    </div>
    <!-- Tabs trạng thái -->
    <ul class="nav nav-tabs mb-3" id="billStatusTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(string.IsNullOrEmpty(Context.Request.Query["status"]) ? "active" : "")" href="?status=">Tất cả <span class="badge bg-secondary">@ViewBag.CountAll</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="pending" ? "active" : "")" href="?status=pending">Chờ xác nhận <span class="badge bg-warning">@ViewBag.CountPending</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="confirmed" ? "active" : "")" href="?status=confirmed">Đã xác nhận <span class="badge bg-info">@ViewBag.CountConfirmed</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="shipping_wait" ? "active" : "")" href="?status=shipping_wait">Chờ vận chuyển <span class="badge bg-primary">@ViewBag.CountShippingWait</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="shipping" ? "active" : "")" href="?status=shipping">Vận chuyển <span class="badge bg-primary">@ViewBag.CountShipping</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="paid" ? "active" : "")" href="?status=paid">Thanh toán <span class="badge bg-success">@ViewBag.CountPaid</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="completed" ? "active" : "")" href="?status=completed">Hoàn thành <span class="badge bg-success">@ViewBag.CountCompleted</span></a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(Context.Request.Query["status"]=="cancelled" ? "active" : "")" href="?status=cancelled">Hủy <span class="badge bg-danger">@ViewBag.CountCancelled</span></a>
        </li>
    </ul>
    <!-- Danh sách hóa đơn table giữ nguyên như cũ -->
    <div class="tab-content" id="billStatusTabsContent">
        <div class="tab-pane fade show active" id="all" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>STT</th>
                            <th>Mã hóa đơn</th>
                            <th>Tên khách hàng</th>
                            <th>Tên nhân viên</th>
                            <th>Loại</th>
                            <th>Ngày tạo</th>
                            <th>Tiền giảm</th>
                            <th>Tổng tiền</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int stt = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(stt++)</td>
                                    <td>@item.MaHoaDon</td>
                                    <td>@item.TenKhachHang</td>
                                    <td>@item.TenNhanVien</td>
                                    <td>@item.LoaiDon</td>
                                    <td>@item.NgayTao.ToString("HH:mm dd-MM-yyyy")</td>
                                    <td>@item.TienGiam.ToString("N0") VND</td>
                                    <td>@item.TongTien.ToString("N0") VND</td>
                                    <td><a href="/HoaDon/Details/@item.Id" class="btn btn-warning btn-sm">Xem</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center">Không có hóa đơn nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> 