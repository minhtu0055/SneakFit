        #lichSuModal .modal-content {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        #lichSuModal .modal-header {
            border-bottom: 1px solid #e9ecef;
            padding: 20px 25px;
        }

        #lichSuModal .modal-title {
            font-weight: 600;
            color: #333;
            font-size: 18px;
        }

        #lichSuModal .modal-body {
            padding: 25px;
        }

        #lichSuModal .table {
            margin-bottom: 0;
        }

        #lichSuModal .table th {
            border: none;
            font-weight: 600;
            color: #495057;
            font-size: 14px;
            padding: 15px 10px;
        }

        #lichSuModal .table td {
            border: none;
            padding: 15px 10px;
            vertical-align: middle;
        }

        #lichSuModal .table tbody tr {
            transition: background-color 0.2s ease;
        }

        #lichSuModal .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        #lichSuModal .table tbody tr:last-child {
