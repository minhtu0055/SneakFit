@using SneakFit.Data.Enums
@using SneakFit.ViewModels.Catalog.LichSuHoaDon
@model SneakFit.ViewModels.Catalog.HoaDon.HoaDonViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isTaiQuay = (int)Model.LoaiHoaDon == 2 && (Model.GiaoHang != true);
    
    // Kiểm tra xem có phải hóa đơn cần ẩn trạng thái "Đã thanh toán" không
    // (Online VNPay hoặc tại quầy có giao hàng + VNPay)
    var shouldSkipPaidStatus = ((int)Model.LoaiHoaDon == 1 && Model.PhuongThucThanhToan == PhuongThucThanhToan.VnPay) ||
                               ((int)Model.LoaiHoaDon == 2 && Model.GiaoHang == true );
    
    // Lấy lịch sử hóa đơn từ ViewBag hoặc Model (sẽ được set trong controller)
    var lichSuHoaDon = ViewBag.LichSuHoaDon as List<LichSuHoaDonViewModel> ?? new List<LichSuHoaDonViewModel>();
    
    // Tạo dictionary để map trạng thái với thời gian từ lịch sử
    var statusTimeMap = new Dictionary<TrangThaiHoaDon, DateTime>();
    
    // Thêm thời gian tạo hóa đơn cho trạng thái đầu tiên
    statusTimeMap[TrangThaiHoaDon.ChoXacNhan] = Model.NgayTao;
    
    // Map thời gian từ lịch sử cho các trạng thái khác
    foreach (var lichSu in lichSuHoaDon.OrderBy(x => x.NgayTao))
    {
        if (!statusTimeMap.ContainsKey(lichSu.TrangThaiMoi))
        {
            statusTimeMap[lichSu.TrangThaiMoi] = lichSu.NgayTao;
        }
    }
    
    // Đặc biệt xử lý cho hóa đơn tại quầy với trạng thái thành công
    if (isTaiQuay && Model.NgayThanhToan.HasValue)
    {
        statusTimeMap[TrangThaiHoaDon.ThanhCong] = Model.NgayThanhToan.Value;
    }
    
    // Hàm helper để lấy thời gian cho trạng thái
    DateTime GetTimeForStatus(TrangThaiHoaDon status)
    {
        if (statusTimeMap.ContainsKey(status))
        {
            return statusTimeMap[status];
        }
        
        // Nếu không có lịch sử cho trạng thái này, sử dụng logic fallback
        if (status == TrangThaiHoaDon.ChoXacNhan)
        {
            return Model.NgayTao; // Thời gian tạo hóa đơn
        }
        
        // Đặc biệt xử lý cho hóa đơn tại quầy với trạng thái thành công
        if (isTaiQuay && status == TrangThaiHoaDon.ThanhCong && Model.NgayThanhToan.HasValue)
        {
            return Model.NgayThanhToan.Value;
        }
        
        // Với các trạng thái khác, nếu chưa có lịch sử thì không hiển thị thời gian
        return Model.NgayTao; // Fallback về thời gian tạo hóa đơn
    }
    
    var steps = isTaiQuay
        ? new[] {
            new { Status = TrangThaiHoaDon.ChoXacNhan, Color = "royal-blue", Icon = "icon-file", Title = "Chờ xác nhận", Time = GetTimeForStatus(TrangThaiHoaDon.ChoXacNhan).ToString("HH:mm:ss dd/MM/yyyy") },
            new { Status = TrangThaiHoaDon.ThanhCong, Color = "emerald", Icon = "icon-check", Title = "Thành công", Time = Model.NgayThanhToan?.ToString("HH:mm:ss dd/MM/yyyy") ?? GetTimeForStatus(TrangThaiHoaDon.ThanhCong).ToString("HH:mm:ss dd/MM/yyyy") }
        }
        : new[] {
            new { Status = TrangThaiHoaDon.ChoXacNhan, Color = "royal-blue", Icon = "icon-file", Title = "Chờ xác nhận", Time = GetTimeForStatus(TrangThaiHoaDon.ChoXacNhan).ToString("HH:mm:ss dd/MM/yyyy") },
            new { Status = TrangThaiHoaDon.DaXacNhan, Color = "indigo", Icon = "icon-file-check", Title = "Đã xác nhận", Time = GetTimeForStatus(TrangThaiHoaDon.DaXacNhan).ToString("HH:mm:ss dd/MM/yyyy") },
            new { Status = TrangThaiHoaDon.ChoVanChuyen, Color = "purple", Icon = "icon-truck", Title = "Chờ vận chuyển", Time = GetTimeForStatus(TrangThaiHoaDon.ChoVanChuyen).ToString("HH:mm:ss dd/MM/yyyy") },
            new { Status = TrangThaiHoaDon.DangVanChuyen, Color = "orange", Icon = "icon-delivery", Title = "Đang vận chuyển", Time = GetTimeForStatus(TrangThaiHoaDon.DangVanChuyen).ToString("HH:mm:ss dd/MM/yyyy") },
            new { Status = TrangThaiHoaDon.DaThanhToan, Color = "emerald", Icon = "icon-payment", Title = "Đã thanh toán", Time = GetTimeForStatus(TrangThaiHoaDon.DaThanhToan).ToString("HH:mm:ss dd/MM/yyyy") },
            new { Status = TrangThaiHoaDon.ThanhCong, Color = "emerald", Icon = "icon-check", Title = "Thành công", Time = GetTimeForStatus(TrangThaiHoaDon.ThanhCong).ToString("HH:mm:ss dd/MM/yyyy") }
        };
    
    // Lọc bỏ trạng thái "Đã thanh toán" cho hóa đơn cần ẩn trạng thái này
    if (shouldSkipPaidStatus)
    {
        steps = steps.Where(s => s.Status != TrangThaiHoaDon.DaThanhToan).ToArray();
    }
    
    // Chỉ hiển thị các bước có thời gian thực tế hoặc đã đạt đến
    var visibleSteps = steps.Where(s => 
        (int)s.Status <= (int)Model.TrangThai || 
        statusTimeMap.ContainsKey(s.Status) ||
        s.Status == TrangThaiHoaDon.ChoXacNhan // Luôn hiển thị bước đầu tiên
    ).Distinct().OrderBy(s => (int)s.Status).ToList();
    
    // Nếu hóa đơn mới tạo và chưa có lịch sử, chỉ hiển thị bước đầu tiên
    if (lichSuHoaDon.Count == 0 && Model.TrangThai == TrangThaiHoaDon.ChoXacNhan)
    {
        visibleSteps = visibleSteps.Where(s => s.Status == TrangThaiHoaDon.ChoXacNhan).ToList();
    }
    // Nếu hóa đơn đã hoàn thành nhưng chưa có lịch sử đầy đủ, hiển thị tất cả các bước đến trạng thái hiện tại
    else if (lichSuHoaDon.Count == 0 && Model.TrangThai > TrangThaiHoaDon.ChoXacNhan)
    {
        visibleSteps = visibleSteps.Where(s => (int)s.Status <= (int)Model.TrangThai).ToList();
    }
    // Nếu có lịch sử, hiển thị các bước có lịch sử và các bước đến trạng thái hiện tại
    else if (lichSuHoaDon.Count > 0)
    {
        var statusesWithHistory = lichSuHoaDon.Select(x => x.TrangThaiMoi).Distinct().ToList();
        statusesWithHistory.Add(TrangThaiHoaDon.ChoXacNhan); // Luôn thêm bước đầu tiên
        
        visibleSteps = visibleSteps.Where(s => 
            statusesWithHistory.Contains(s.Status) || 
            (int)s.Status <= (int)Model.TrangThai
        ).Distinct().OrderBy(s => (int)s.Status).ToList();
    }
}
<head>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        /* Thanh xanh lá trên cùng */
