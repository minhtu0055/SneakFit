@using SneakFit.ViewModels.Catalog.HoaDon
@model HoaDonChiTietViewModels
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

<style>
    .stepper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .step {
        text-align: center;
        flex: 1;
        position: relative;
    }

        .step .icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #e3e6fc;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px auto;
            font-size: 2rem;
            color: #696cff;
        }

        .step.active .icon {
            background: #696cff;
            color: #fff;
        }

        .step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 24px;
            right: -50%;
            width: 100%;
            height: 4px;
            background: #e3e6fc;
            z-index: 0;
        }

        .step.active:not(:last-child)::after {
            background: #696cff;
        }

    .table-orange thead {
        background: #f57c00;
        color: #fff;
    }

    .badge-status {
        font-size: 1rem;
        padding: 0.5em 1em;
        border-radius: 1em;
    }
</style>
<div class="container-fluid mt-4">
    <h2 class="mb-4">Chi tiết hóa đơn</h2>
    <!-- PHẦN 1: Trạng thái hóa đơn + Lịch sử thanh toán -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3"><b>Trạng thái đơn hàng</b></div>
            <div class="stepper">
                @foreach (var step in Model.TrangThaiSteps)
                {
                    <div class="step @(step.IsActive ? "active" : "")">
                        <div class="icon"><i class="bx @step.Icon"></i></div>
                        <div>@step.Label</div>
                        <div style="font-size:0.85em; color:#888">@step.Time</div>
                    </div>
                }
            </div>
            <div class="mb-3"><b>Lịch sử thanh toán</b></div>
            <div class="table-responsive">
                <table class="table table-bordered table-orange">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã giao dịch</th>
                            <th>Số tiền</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                            <th>Loại giao dịch</th>
                            <th>Phương thức thanh toán</th>
                            <th>Ghi chú</th>
                            <th>Người xác nhận</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.LichSuThanhToan.Count; i++)
                        {
                            var item = Model.LichSuThanhToan[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.MaGiaoDich</td>
                                <td>@item.SoTien.ToString("N0") VND</td>
                                <td>@item.TrangThai</td>
                                <td>@item.ThoiGian.ToString("dd-MM-yyyy HH:mm")</td>
                                <td>@item.LoaiGiaoDich</td>
                                <td>@item.PhuongThucThanhToan</td>
                                <td>@item.GhiChu</td>
                                <td>@item.NguoiXacNhan</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- PHẦN 2: Thông tin đơn hàng -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3"><b>Thông tin đơn hàng: @Model.MaHoaDon</b></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div><b>Trạng thái:</b> <span class="badge badge-status bg-info">@Model.TrangThai</span></div>
                    <div><b>Loại:</b> <span class="badge badge-status bg-primary">@Model.LoaiDon</span></div>
                    <div><b>Địa chỉ:</b> @Model.DiaChi</div>
                    <div><b>Ghi chú:</b> @Model.GhiChu</div>
                </div>
                <div class="col-md-6">
                    <div><b>Tên khách hàng:</b> @Model.TenKhachHang</div>
                    <div><b>Số điện thoại:</b> @Model.SoDienThoai</div>
                    <div><b>Thời gian dự kiến nhận:</b> @Model.ThoiGianDuKienNhan?.ToString("dd-MM-yyyy")</div>
                </div>
            </div>
        </div>
    </div>
    <!-- PHẦN 3: Thông tin sản phẩm đã mua -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <b>Thông tin sản phẩm đã mua</b>
                <a href="#" class="btn btn-primary">+ Thêm sản phẩm</a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-orange">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Ảnh Sản Phẩm</th>
                            <th>Thông tin sản phẩm</th>
                            <th>Màu sắc</th>
                            <th>Số lượng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng Thái</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.SanPhamMua.Count; i++)
                        {
                            var sp = Model.SanPhamMua[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td><img src="@sp.AnhSanPham" style="width:60px;height:60px;object-fit:cover;" /></td>
                                <td>
                                    <b>@sp.TenSanPham</b><br />
                                    <span style="color:#f57c00;font-weight:600">@sp.GiaBan.ToString("N0") VND</span><br />
                                    Kích cỡ: @sp.KichCo
                                </td>
                                <td>
                                    <span style="display:inline-block;width:24px;height:24px;border-radius:4px;border:1px solid #ccc;vertical-align:middle;background:@sp.MaMau;"></span>
                                    <span style="margin-left:8px;vertical-align:middle;">@sp.TenMau</span>
                                </td>
                                <td>
                                    <input type="number" class="form-control" value="@sp.SoLuong" min="1" style="width:60px;display:inline-block;" />
                                </td>
                                <td>@sp.ThanhTien.ToString("N0") VND</td>
                                <td><span class="badge bg-success">@sp.TrangThai</span></td>
                                <td>
                                    <a href="#" title="Sửa" class="btn btn-sm btn-light border"><i class="bx bx-edit"></i></a>
                                    <a href="#" title="Xoá" class="btn btn-sm btn-light border text-danger"><i class="bx bx-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3 text-end">
                <div><b>Tổng tiền hàng:</b> <span style="color:blue">@Model.TongTienHang.ToString("N0") VND</span></div>
                <div><b>Phí vận chuyển:</b> @Model.PhiVanChuyen.ToString("N0") VND</div>
                <div><b>Voucher giảm giá:</b> @Model.VoucherGiamGia.ToString("N0") VND</div>
                <div><b>Tổng tiền giảm:</b> @Model.TongTienGiam.ToString("N0") VND</div>
                <div><b>Tổng tiền thanh toán:</b> <span style="color:blue;font-weight:600">@Model.TongTienThanhToan.ToString("N0") VND</span></div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>