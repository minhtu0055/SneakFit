  </div>
</div>

<!-- Modal nhập ghi chú khi chuyển trạng thái -->
<div class="modal fade" id="modalGhiChu" tabindex="-1" aria-labelledby="modalGhiChuLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalGhiChuLabel">Xác nhận Đơn hàng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <textarea class="form-control" id="txtGhiChu" rows="3" placeholder="Nhập ghi chú..." required></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary" id="btnXacNhanGhiChu">Xác nhận</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="~/js/invoice-print.js"></script>
    <script>
        // Show success/error messages
        @if (TempData["success"] != null)
        {
            <text>
            toastr.success('@TempData["success"]');
            </text>
        }
        @if (TempData["error"] != null)
        {
            <text>
            toastr.error('@TempData["error"]');
            </text>
        }
        // Xử lý nút Lịch sử
        $(document).ready(function () {
            $('#btnLichSu').on('click', function () {
                var hoaDonId = '@Model.Id';
                $('#lichSuTableBody').html('<tr><td colspan="4" class="text-center">Đang tải...</td></tr>');
                $.ajax({
                    url: '/HoaDon/GetHistoryByHoaDonId?hoaDonId=' + hoaDonId,
                    method: 'GET',
                    success: function (data) {
                        if (data && data.length > 0) {
                            // Sắp xếp dữ liệu theo thời gian từ cũ đến mới
                            data.sort(function(a, b) {
                                return new Date(a.ngayTao) - new Date(b.ngayTao);
                            });                           
                            var rows = '';
                            data.forEach(function (item) {
                                rows += '<tr class="border-bottom">' +
                                    '<td class="text-center">' +
                                        '<div class="d-flex align-items-center justify-content-center">' +
                                            '<span>' + getStatusName(item.trangThaiMoi || '') + '</span>' +
                                        '</div>' +
                                    '</td>' +
                                    '<td class="text-center">' + formatDateTime(item.ngayTao) + '</td>' +
                                    '<td class="text-center">' + (item.nguoiChinhSua || '') + '</td>' +
                                    '<td class="text-center">' + (item.ghiChu || '') + '</td>' +
                                    '</tr>';
                            });
                            $('#lichSuTableBody').html(rows);
                        } else {
                            $('#lichSuTableBody').html('<tr><td colspan="4" class="text-center">Không có lịch sử.</td></tr>');
                        }
                        $('#lichSuModal').modal('show');
                    },
                    error: function () {
                        $('#lichSuTableBody').html('<tr><td colspan="4" class="text-center">Lỗi khi tải lịch sử.</td></tr>');
                        $('#lichSuModal').modal('show');
                    }
                });
            });

            // Xử lý nút Xác nhận (chuyển trạng thái tiếp theo và lưu lịch sử)
            var nextStatus = null;
            $('#btnXacNhan').on('click', function () {
                var hoaDonId = '@Model.Id';
                var userId = '@(Model.UserId ?? Guid.Empty)';
                var nguoiChinhSua = '@User.Identity.Name';
                var currentStatus = @((int)Model.TrangThai);
                var shouldSkipPaidStatus = @(shouldSkipPaidStatus.ToString().ToLower());
                nextStatus = currentStatus;
                
                // Xác định trạng thái tiếp theo
                switch (currentStatus) {
                    case 0: nextStatus = 1; break; // ChoXacNhan -> DaXacNhan
                    case 1: nextStatus = 2; break; // DaXacNhan -> ChoVanChuyen
                    case 2: nextStatus = 3; break; // ChoVanChuyen -> DangVanChuyen
                    case 3: 
                        if (shouldSkipPaidStatus) {
                            nextStatus = 5; // DangVanChuyen -> ThanhCong (bỏ qua DaThanhToan)
                        } else {
                            nextStatus = 4; // DangVanChuyen -> DaThanhToan
                        }
                        break;
                    case 4: nextStatus = 5; break; // DaThanhToan -> ThanhCong
                    default: toastr.error('Không thể chuyển trạng thái!'); return;
                }
                // Hiển thị modal nhập ghi chú
                $('#txtGhiChu').val('');
                $('#modalGhiChu').modal('show');
            });

            // Xác nhận ghi chú và gửi ajax
            $('#btnXacNhanGhiChu').on('click', function () {
                var hoaDonId = '@Model.Id';
                var userId = '@(Model.UserId ?? Guid.Empty)';
                var nguoiChinhSua = '@User.Identity.Name';
                var ghiChu = $('#txtGhiChu').val();
                if (!ghiChu || ghiChu.trim() === '') {
                    toastr.error('Vui lòng nhập ghi chú!');
                    return;
                }
                if (nextStatus === null) {
                    toastr.error('Không xác định trạng thái tiếp theo!');
                    return;
                }
                $.ajax({
                    url: '/HoaDon/UpdateStatusAndLog',
                    method: 'POST',
                    data: {
                        hoaDonId: hoaDonId,
                        newStatus: nextStatus,
                        userId: userId,
                        nguoiChinhSua: nguoiChinhSua,
                        ghiChu: ghiChu
                    },
                    success: function (res) {
                        if (res.success) {
                            setTimeout(function () { location.reload(); }, 1000);
                            toastr.success('Cập nhật trạng thái thành công!');
                            
                        } else {
                            toastr.error(res.message || 'Có lỗi xảy ra!');
                        }
                        $('#modalGhiChu').modal('hide');
                    },
                    error: function () {
                        toastr.error('Có lỗi xảy ra!');
                        $('#modalGhiChu').modal('hide');
                    }
                });
            });

            // Xử lý nút Quay lại (hoàn tác trạng thái)
            $('#btnQuayLai').on('click', function () {
                var hoaDonId = '@Model.Id';
                $.ajax({
                    url: '/HoaDon/RevertToPreviousStatus',
                    method: 'POST',
                    data: { hoaDonId: hoaDonId },
                    success: function (res) {
                        if (res.success) {
                            toastr.success('Hoàn tác trạng thái thành công!');
                            setTimeout(function () { location.reload(); }, 1000);
                        } else {
                            toastr.error(res.message || 'Không thể hoàn tác trạng thái!');
                        }
                    },
                    error: function () {
                        toastr.error('Có lỗi xảy ra!');
                    }
                });
            });
        });
        // Hàm chuyển enum sang tên tiếng Việt
        function getStatusName(status) {
            switch (status) {
                case 0: return 'Chờ xác nhận';
                case 1: return 'Đã xác nhận';
                case 2: return 'Chờ vận chuyển';
                case 3: return 'Đang vận chuyển';
                case 4: return 'Đã thanh toán';
                case 5: return 'Thành Công';
                case 6: return 'Đã hủy';
                case 7: return 'Trả hàng';
                default: return status;
            }
        }
        // Hàm định dạng ngày giờ
        function formatDateTime(dateStr) {
            var d = new Date(dateStr);
            if (isNaN(d)) return '';
            var hours = d.getHours().toString().padStart(2, '0');
            var minutes = d.getMinutes().toString().padStart(2, '0');
            var seconds = d.getSeconds().toString().padStart(2, '0');
            var day = d.getDate().toString().padStart(2, '0');
            var month = (d.getMonth() + 1).toString().padStart(2, '0');
            var year = d.getFullYear();
            return hours + ':' + minutes + ':' + seconds + ' ' + day + '/' + month + '/' + year;
        }

        // Xử lý nút In hóa đơn với logic mới
        $('#btnInHoaDon').on('click', function() {
            var hoaDonId = '@Model.Id';
            var loaiHoaDon = @((int)Model.LoaiHoaDon);
            var coGiaoHang = @(Model.GiaoHang?.ToString().ToLower() ?? "false");
            
            console.log('Thông tin hóa đơn:', {
                hoaDonId: hoaDonId,
                loaiHoaDon: loaiHoaDon,
                coGiaoHang: coGiaoHang
            });
            
            // Kiểm tra xem invoicePrinter có tồn tại không
            if (typeof window.invoicePrinter === 'undefined') {
                toastr.error('Lỗi: Không tìm thấy module in hóa đơn!');
                return;
            }
            
            // Xác định loại template in dựa trên loại hóa đơn và giao hàng
            if (loaiHoaDon === 1) { // Online
                console.log('In hóa đơn Online');
                window.invoicePrinter.printOnlineInvoice(hoaDonId);
            } else if (loaiHoaDon === 2 && coGiaoHang === true) { // Tại quầy có ship
                console.log('In hóa đơn Ship');
                window.invoicePrinter.printShipInvoice(hoaDonId);
            } else { // Tại quầy không ship
                console.log('In hóa đơn Tại quầy');
                window.invoicePrinter.printInvoice(hoaDonId);
            }
        });
    </script>
}
@functions {
    string GetStatusName(LoaiHoaDon status)
    {
        switch (status)
        {
            case LoaiHoaDon.Online:
                return "Online";
            case LoaiHoaDon.TaiQuay:
                return "Tại Quầy";
            default:
                return status.ToString();
        }
    }
    string GetStatusColor(LoaiHoaDon status)
    {
        switch (status)
        {
            case LoaiHoaDon.Online:
                return "success";
            case LoaiHoaDon.TaiQuay:
                return "warning";
            default:
                return "danger";
        }
    }
    string GetStatusTTName(PhuongThucThanhToan status)
    {
        switch (status)
        {
            case PhuongThucThanhToan.TienMat:
                return "Tiền Mặt";
            case PhuongThucThanhToan.VnPay:
                return "VNPay";
            default:
                return status.ToString();
        }
    }
    string GetStatusDisplayName(object trangThai)
    {
        switch (trangThai.ToString())
        {
            case "ChoXacNhan":
                return "Chờ xác nhận";
            case "ThanhCong":
                return "Thành Công";
            case "DaHuy":
                return "Đã hủy";
            case "TraHang":
                return "Trả hàng";
            case "DaXacNhan":
                return "Đã xác nhận";
            case "ChoVanChuyen":
                return "Chờ vận chuyển";
            case "DangVanChuyen":
                return "Đang vận chuyển";
            case "DaThanhToan":
                return "Đã thanh toán";
            default:
                return trangThai.ToString();
        }
    }
}
    