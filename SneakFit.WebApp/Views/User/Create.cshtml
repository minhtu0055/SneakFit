@model SneakFit.ViewModels.System.User.RegisterRequest

<form asp-controller="User" asp-action="Create" method="post" data-confirm="Are you sure you want to do that?">
    <div class="mb-3">
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" class="form-control" placeholder="Nhập tên người dùng"></input>
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="Nhập email"></input>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NgaySinh" class="form-label"></label>
        <input asp-for="NgaySinh" type="date" class="form-control" placeholder="Ngày sinh" required="required" data-validation-required-message="Vui lòng nhập ngày sinh" />
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TrangThai" class="form-label"></label>
        <div class="form-check">
            <input asp-for="TrangThai" class="form-check-input" type="radio" value="true" checked />
            <label class="form-check-label">Hoạt Động</label>
        </div>
        <div class="form-check">
            <input asp-for="TrangThai" class="form-check-input" type="radio" value="false" />
            <label class="form-check-label">Ngưng Hoạt Động</label>
        </div>
    </div>
    <div class="text-end">
        <button type="submit" class="btn btn-primary">Create</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>